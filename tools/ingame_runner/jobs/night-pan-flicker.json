{
  "id": "night-pan-flicker",
  "description": "Cause run for lights and terrain that flash at night: a pan over the town's lots with two F8 recordings, then the camera circling the active lot while the floor goes up and down (Page Up, Page Down) in a third recording. Developer mode on, so the log keeps the active lot switches, dropped relit maps, terrain lamp changes and room solves. Needs a night save. Read the recordings and the log, not the frame times.",
  "save": "Claude teste",
  "toml": {
    "ui": {
      "developer_mode": true
    }
  },
  "variants": {
    "on": {
      "expect": [
        "\\[Recorder\\] Recording started",
        "\\[Recorder\\] Recording stopped"
      ]
    }
  },
  "steps": [
    {
      "do": "speed",
      "speed": "normal"
    },
    {
      "do": "camera_pan",
      "lots": 8,
      "height": 40,
      "seconds": 45,
      "passes": 8
    },
    {
      "do": "wait",
      "minutes": 1
    },
    {
      "do": "key",
      "vk": 119
    },
    {
      "do": "wait",
      "minutes": 0.85
    },
    {
      "do": "key",
      "vk": 119
    },
