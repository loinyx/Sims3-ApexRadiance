{
  "id": "realtime-gi-pan",
  "description": "Real-time GI camera pan ABBA over the night save: 40 m (near) then 150 m (far), 4 passes of 60 s each, GI off against on (stage 1, solve capped). Read frame time p50/p99/p99.9, frames over 50 ms and hitches per minute with -AB -Profiler Both, and the address-space readings. Both frame limiters are lifted. Do not combine with the Frame Profiler (profile job).",
  "save": "ApexTest-Night",
  "toml": {
    "ui": {
      "developer_mode": false
    },
    "screen": {
      "fps_limit": 0,
      "background_fps_limit": 0
    }
  },
  "variants": {
    "off": {
      "toml": {
        "patches.RealtimeGI": {
          "enabled": false
        }
      },
      "fail": [
        "\\[RealtimeGI\\] On: lots=\\d+ cap=(off|class0|hold) scale=[124] indirect=(off|bounce1|multiBounce) backend=(auto|serverRays|serverCompute|d3d9)"
      ]
    },
    "on": {
      "toml": {
        "patches.RealtimeGI": {
          "enabled": true,
          "solveCap": "class0",
          "nightOnly": true
        }
      },
      "expect": [
        "\\[RealtimeGI\\] On: lots=\\d+ cap=(off|class0|hold) scale=[124] indirect=(off|bounce1|multiBounce) backend=(auto|serverRays|serverCompute|d3d9)"
      ]
    }
  },
  "fail": [
    "\\[RealtimeGI\\] .*(did not start|Verification mismatch|class 1-2 solve)"
  ],
  "s3ss": {
    "patches.SmoothPatchPrecise": {
      "frameRateLimit": 999.5,
      "frameRateLimitInactive": 999.5
    }
  },
  "steps": [
    {
      "do": "speed",
      "speed": "normal"
    },
    {
      "do": "memory",
      "label": "start"
    },
    {
      "do": "camera_pan",
      "lots": 8,
      "height": 40,
      "seconds": 60,
      "passes": 4
    },
    {
      "do": "wait",
      "minutes": 4,
      "measure": true
    },
    {
      "do": "memory",
      "label": "after 40 m"
    },
    {
      "do": "camera_pan",
      "lots": 8,
      "height": 150,
      "seconds": 60,
      "passes": 4
    },
    {
      "do": "wait",
      "minutes": 4,
      "measure": true
    },
    {
      "do": "memory",
      "label": "end"
    }
  ]
}
