{
  "id": "night-gpu-calibration",
  "description": "Calibration data for the real-time outdoor lamps: at night the camera circles the household's lot (the active lot), then the gym and the square, while the developer log compares each relit map with the game's own map of the same room 0 every 10 s (RtOutdoorLamps \"GPU against the game\"). Developer mode on, the background frame limit lifted; needs a build with that comparison. Variants: the physical room lamp model (the default since 3.0.0) and the replica model (the parts of the game's own solve). An outdoor light of the household's lot is dragged toward the house and back (lamp_drag) while a recording (its shortcut F6 for the run) takes the lot's Wall seams.csv, the light either side of each story line (profilers/seam_report.py).",
  "save": "ApexTest-Night",
  "toml": {
    "ui": {
      "developer_mode": true,
      "recorder_key": "F6"
    },
    "screen": {
      "background_fps_limit": 0
    }
  },
  "variants": {
    "physical": {
      "toml": {
        "patches.NightTerrainRelight": {
          "roomLampModel": "physical"
        }
      },
      "expect": [
        "\\[RtOutdoorLamps\\] GPU against the game"
      ]
    },
    "replica": {
