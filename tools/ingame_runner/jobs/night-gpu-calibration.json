  "toml": {
    "ui": {
      "developer_mode": true
    },
    "screen": {
      "background_fps_limit": 0
    }
  },
  "variants": {
    "on": {
      "expect": [
        "\\[RtOutdoorLamps\\] GPU against the game"
      ]
    }
  },
  "steps": [
    {
      "do": "speed",
      "speed": "normal"
    },
    {
      "do": "camera_orbit",
      "radius": 18,
      "height": 12,
      "seconds": 40,
      "turns": 4
    },
    {
      "do": "wait",
      "minutes": 2.8
    },
    {
      "do": "lights_on",
      "lot": "kGym"
    },
    {
      "do": "camera_orbit",
      "lot": "kGym",
      "radius": 22,
      "height": 14,
      "seconds": 40,
      "turns": 2
    },
    {
      "do": "wait",
      "minutes": 1.4
    },
    {
      "do": "camera_orbit",
      "lot": "pra\u00e7a|praca|square|plaza|central|kBigPark",
      "radius": 30,
      "height": 15,
      "seconds": 40,
      "turns": 2
    },
    {
