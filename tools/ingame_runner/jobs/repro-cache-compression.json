      "order": "populated",
      "lots": 8,
      "dwellS": 6,
      "outfits": 3,
      "spawn": 3
    },
    {
      "do": "wait",
      "minutes": 15,
      "measure": true,
      "until": {
        "jumps": 100
      }
    },
    {
      "do": "stop_repros"
    },
    {
