      "toml": {
        "patches.FastCacheCompression": {
          "enabled": false
        }
      }
    },
    "on": {
      "toml": {
        "patches.FastCacheCompression": {
          "enabled": true
        }
      },
      "expect": [
        "\\[FastRefPack\\] On:"
      ]
    }
  },
  "steps": [
    {
      "do": "speed",
      "speed": "normal"
    },
    {
