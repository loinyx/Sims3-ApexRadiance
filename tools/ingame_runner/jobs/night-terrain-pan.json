{
  "id": "night-terrain-pan",
  "description": "Terrain light at night under the benchmark's pan (8 lots at 40 m, 60 s passes): four back-to-back recordings of the mod (its shortcut set to F6 for the run), whose Screen pixels.csv samples the screen every frame without touching the game; flashes are read from it (flash_scan.py over the grid points) next to the log's NightTerrainRelight lines. Developer mode on, the background frame limit lifted. Variants switch off the lot detail range or the lot visibility override, to find which one the one-frame bright lot squares come from.",
  "save": "Claude teste",
  "toml": {
    "ui": {
      "developer_mode": true,
      "recorder_key": "F6"
    },
    "screen": {
      "background_fps_limit": 0
    }
  },
  "variants": {
    "all": {
      "expect": [
        "\\[Recorder\\] Recording started"
      ]
    },
    "no-detail-range": {
      "toml": {
        "patches.LotDetailRange": {
          "enabled": false
        }
      },
      "expect": [
        "\\[Recorder\\] Recording started"
      ]
    },
    "no-visibility-override": {
      "toml": {
        "patches.LotVisibilityOverride": {
          "enabled": false
        }
      },
      "expect": [
        "\\[Recorder\\] Recording started"
      ]
    },
    "no-lot-grass-light": {
      "toml": {
        "patches.NightTerrainRelight": {
          "gramaDoLoteUsaLuzDoLote": false
        }
      },
      "expect": [
        "\\[Recorder\\] Recording started"
      ]
    },
    "no-gpu-smooth": {
      "toml": {
        "patches.NightTerrainRelight": {
          "mapaDeLuzSuavizadoNaGpu": false
        }
      },
      "expect": [
        "\\[Recorder\\] Recording started"
      ]
    },
    "classic-lamps": {
      "toml": {
        "patches.NightTerrainRelight": {
          "lampLightingMode": "classic"
        }
      },
      "expect": [
        "\\[Recorder\\] Recording started"
      ]
    }
  },
  "steps": [
    {
      "do": "speed",
      "speed": "normal"
    },
    {
      "do": "camera_pan",
      "lots": 8,
      "height": 40,
      "seconds": 60,
      "passes": 6
    },
    {
      "do": "wait",
      "minutes": 0.3
    },
    {
