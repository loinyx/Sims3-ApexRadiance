      "lot": "kGym",
      "radius": 20,
      "height": 11,
      "seconds": 3600,
      "turns": 0.001
    },
    {
      "do": "wait",
      "minutes": 0.8
    },
    {
      "do": "key",
      "vk": 117
    },
    {
      "do": "wait",
      "minutes": 0.25
    },
    {
      "do": "key",
      "vk": 117
    },
    {
