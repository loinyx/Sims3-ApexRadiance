      "lot": "pra\u00e7a|praca|square|plaza|central|kBigPark",
      "radius": 30,
      "height": 15,
      "seconds": 3600,
      "turns": 0.001
    },
    {
      "do": "wait",
      "minutes": 0.5
    },
    {
      "do": "camera_orbit",
      "lot": "kGym",
      "radius": 20,
      "height": 11,
      "seconds": 3600,
      "turns": 0.001
    },
    {
      "do": "key",
      "vk": 117
    },
    {
      "do": "wait",
      "minutes": 0.4
    },
