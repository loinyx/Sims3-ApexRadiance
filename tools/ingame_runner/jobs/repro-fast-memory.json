{
  "id": "repro-fast-memory",
  "description": "Faster Memory Handling under allocation churn: far camera jumps (lot streaming), 2 outfit changes and 4 new Sims per jump, with the Sims of the previous loop removed. A/B metric: frame time p99, frames over 50 ms per minute, visible freezes.",
  "save": "ApexTest-Town",
  "variants": {
    "off": {
      "toml": {
        "patches.FastMemory": {
          "enabled": false
        }
      },
      "fail": [
        "\\[FastMemory\\] On:"
      ]
    },
    "on": {
      "toml": {
        "patches.FastMemory": {
          "enabled": true
        }
      },
      "expect": [
        "\\[FastMemory\\] On:"
      ]
    }
  },
  "steps": [
    {
      "do": "speed",
      "speed": "fast"
    },
    {
      "do": "camera_jumps",
      "order": "far",
      "lots": 10,
      "dwellS": 6,
      "outfits": 2,
      "spawn": 4
    },
    {
      "do": "wait",
      "minutes": 15,
      "measure": true,
      "until": {
        "jumps": 100
      }
    },
    {
      "do": "stop_repros"
    }
  ]
}
