{
  "id": "file-list-cache",
  "description": "File List Cache while lots load during a camera pan. Pass: the cache logs On, no verification mismatch.",
  "save": "ApexTest-Town",
  "variants": {
    "off": {
      "toml": {
        "patches.FileListCache": {
          "enabled": false
        }
      }
    },
    "on": {
      "toml": {
        "patches.FileListCache": {
          "enabled": true
        }
      },
      "expect": [
        "\\[FileListCache\\] On:"
      ]
    }
  },
  "steps": [
    {
      "do": "speed",
      "speed": "fast"
    },
    {
      "do": "camera_pan",
      "lots": 8,
      "seconds": 40,
      "passes": 15
    },
    {
      "do": "wait",
      "minutes": 10,
      "measure": true
    }
  ]
}
