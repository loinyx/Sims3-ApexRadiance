// Version information of ApexRadiance.asi (Windows file properties). The numbers come from apex_version.h.
// Added in 2.7.1: an unsigned DLL with no version information weighs on antivirus heuristics (2.7.0 was flagged).
#include <winver.h>
#include "apex_version.h"

#define APEX_RC_VERSION APEX_STRINGIZE(APEX_VERSION_MAJOR.APEX_VERSION_MINOR.APEX_VERSION_PATCH)

VS_VERSION_INFO VERSIONINFO
 FILEVERSION APEX_VERSION_MAJOR,APEX_VERSION_MINOR,APEX_VERSION_PATCH,0
 PRODUCTVERSION APEX_VERSION_MAJOR,APEX_VERSION_MINOR,APEX_VERSION_PATCH,0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DLL
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "loinyx"
            VALUE "FileDescription", "Apex Radiance: lighting, visuals and performance for The Sims 3"
            VALUE "FileVersion", APEX_RC_VERSION
            VALUE "InternalName", "ApexRadiance"
            VALUE "LegalCopyright", "Copyright (C) 2026 loinyx. Open source: github.com/loinyx/Sims3-ApexRadiance"
            VALUE "OriginalFilename", "ApexRadiance.asi"
            VALUE "ProductName", "Apex Radiance"
            VALUE "ProductVersion", APEX_RC_VERSION
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

// Apex's own shaders, compiled with Microsoft's d3dcompiler_47 (framework/shader_cache.cpp, LoadEmbedded): used where the
// player's cache lacks them, so Wine / Proton never needs its builtin compiler for them
APEX_RC_SHADER_CACHE RCDATA "resources/ApexRadiance_ShaderCache.bin"
