<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ApexSetup</RootNamespace>
    <!-- NVAPI function pointers (SmoothMotion.cs) -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <!-- the mod-vs-mod rule table (ModConflicts.cs) -->
    <EmbeddedResource Include="ModConflicts.json" LogicalName="ModConflicts.json" />
    <!-- the native hook table, generated by sims3-modernization's tools/hook-table-export.ts -->
    <EmbeddedResource Include="ModConflicts.hooks.csv" LogicalName="ModConflicts.hooks.csv" />
  </ItemGroup>
</Project>
