{
  "comment": "Rule table of ModConflicts.cs, from sims3-modernization's compat-scan. Deterministic. A script call is 'Owner::Name' (owner = full game type name, '+' for nested). It counts when the owner matches gameOwner and the call is write-type: a field store, an event listener, or a method whose name matches writeVerb and not readVerb. Each area matches calls (regex on 'Owner::Name'), event names (EventTypeId member names) and native strings (ASI imports and strings). Two or more mods with write evidence in one area = WARNING with the area's risk text. cases: examples checked by ApexSetup.Tests.",
  "gameOwner": "^(Sims3|ScriptCore|SimIFace|UI)\\.",
  "writeVerb": "^(set_|add_|remove_|(Add|Remove|Cancel|Clear|Set|Push|Insert|Destroy|Delete|Dispose|Reset|Kill|Force|Change|Modify|Start|Stop|Enable|Disable|Run|Plan|Route|DoRoute|Teleport|Increase|Decrease|Update|Apply|Replace|Move|Spawn|Create|Make|Age|Die|Fire|Promote|Demote|Quit|Pay|Give|Take|Store|Place|Schedule|Register|Unregister|Inject|Override|Queue|Enqueue|Trigger|Show|Hide|Save|Load)([A-Z_0-9]|$))",
  "readVerb": "^(get_|(Get|Is|Has|Can|Find|Test|Contains|Count|Compare|Equals|ToString|Try|Should|Was|Lookup|Calculate|Compute|Score)([A-Z_0-9]|$))",
  "ignoreCalls": "::(add_OnWorldLoadFinishedEventHandler|add_OnStartupAppEventHandler|add_OnWorldQuitEventHandler|\\.ctor|\\.cctor)$|(StyledNotification|\\w*Dialog\\w*|ObjectPicker\\w*|SimplePicker\\w*)::",
  "exeText": [4198400, 16338943],
  "areas": [
    { "id": "routing", "label": "routing",
      "calls": ["(^|[.+])(Route|RoutingComponent|SimRoutingComponent|Routing\\w*|PathPlan\\w*|RouteManager)::\\w+ \\(store\\)$", "(^|[.+])(RoutingComponent|SimRoutingComponent|Routing\\w*|RouteManager)::(set_|Set|Enable|Disable|Add|Remove|Push|Clear|Register)\\w*$", "(^|[.+])GoHere\\w*::"],
      "events": [],
      "native": ["(?i)route|routing|pathfind|pathplan|plandeadline|rtsites|steer"],
      "risk": "Both change how Sims route. Sims may stand still, re-route or teleport differently than either mod intends." },
    { "id": "autonomy", "label": "autonomy / interaction queue",
      "calls": ["(^|[.+])(Autonomy\\w*|ScoringFunction\\w*|Scoring\\w*|AutonomyManager)::", "(^|[.+])InteractionQueue::(Cancel|Remove|Clear|add_|remove_)\\w*$"],
      "events": [],
      "native": ["(?i)autonomy|autshadow|autlive|autledger"],
      "risk": "Both change what Sims choose to do or how their queues run. Sims may pick odd actions, idle, or drop queued actions." },
    { "id": "interactions", "label": "interaction replacement",
      "calls": ["::(RemoveInteractionByType|RemoveInteractionsByType)$"],
      "events": [],
      "native": [],
      "risk": "Both remove or replace game interactions. One mod's menu entry or behaviour may vanish, or the game runs the other mod's version." },
    { "id": "motives", "label": "motives / moodlets",
      "calls": ["(^|[.+])(Motive\\w*|Motives|BuffManager|Buff\\w*|Moodlet\\w*)::"],
      "events": ["^k(Buff\\w*|Moodlet\\w*|\\w*Motive\\w*)$"],
      "native": ["(?i)motive"],
      "risk": "Both change needs or moodlets. Needs may decay, refill or freeze in ways neither mod expects." },
    { "id": "relationships", "label": "relationships",
      "calls": ["(^|[.+])(Relationship\\w*|LongTermRelationship|SocialComponent|Romance\\w*|Genealogy)::"],
      "events": ["^k(Relationship\\w*|\\w*Romance\\w*|GotMarried|\\w*Divorce\\w*|\\w*WooHoo\\w*|\\w*Breakup\\w*)$"],
      "native": [],
      "risk": "Both change relationships. Values, family links or romance states may be overwritten by the other mod." },
    { "id": "careers", "label": "careers / money",
      "calls": ["(^|[.+])(Career\\w*|Occupation\\w*|Job\\w*|School\\w*|Bill\\w*|RealEstate\\w*)::", "::(ModifyFamilyFunds|set_FamilyFunds|PayBills\\w*)$"],
      "events": ["^k(Career\\w*|\\w*Promot\\w*|\\w*Job\\w*|\\w*Money\\w*|\\w*Fired\\w*|\\w*Paid\\w*|\\w*Bill\\w*)$"],
      "native": [],
      "risk": "Both change careers, jobs or household money. Pay, promotions or bills may be applied twice or not at all." },
    { "id": "aging", "label": "aging / death",
      "calls": ["(^|[.+])(AgingManager|AgingState|Urnstone|Death\\w*|Ghost\\w*)::", "SimDescription::(Age\\w*|set_Age\\w*|\\w*Aging\\w*)$", "::(Kill\\w*|AgeUp\\w*|Die)$"],
      "events": ["^k(SimDied|SimAgeTransition|\\w*Aged\\w*|AgeTransition\\w*|\\w*Death\\w*|\\w*Born\\w*)$"],
      "native": ["(?i)ageup|aging"],
      "risk": "Both change aging or death. Sims may age, die or turn into ghosts differently than either mod intends." },
    { "id": "story", "label": "story progression / households",
      "calls": ["(^|[.+])(Situation\\w*|Pregnancy\\w*|Service\\w*|StoryProgression\\w*)::", "Household::(Add\\w*|Remove\\w*|Create\\w*|Move\\w*|Destroy\\w*)$", "::(PlaceHousehold\\w*|MoveIn\\w*|MoveOut\\w*|CreateNewHousehold\\w*)$"],
      "events": ["^k(SimMoved\\w*|\\w*Household\\w*|\\w*Pregnan\\w*|\\w*Adopt\\w*)$"],
      "native": [],
      "risk": "Both drive town life (moves, births, services, situations). Households may be moved, filled or emptied twice." },
    { "id": "streaming", "label": "lot / world streaming",
      "calls": ["(^|[.+])(LotManager|WorldStreaming\\w*|Terrain|Camera\\w*)::", "(^|[.+])World::(\\w*Lot\\w*|\\w*Stream\\w*)$", "(^|[.+])Lot::(\\w*Load\\w*|\\w*Stream\\w*|\\w*Unload\\w*)$"],
      "events": [],
      "native": ["(?i)lotstream|worldstream|stalelot|lotfd|lotuse"],
      "risk": "Both change how lots or the world load. Lots may load late, pop in, or stay loaded longer than either mod expects." },
    { "id": "saveload", "label": "save / load",
      "calls": ["(^|[.+])(GameStates|SaveGame\\w*|Persist\\w*|SaveLoad\\w*)::", "(^|[.+])World::add_On(Pre)?Save\\w*$"],
      "events": [],
      "native": ["(?i)\\.sims3\\b|savegame|savewrite|saveslim|savecompress|saveframes"],
      "risk": "Both change saving or loading. A save may miss one mod's data, or the other mod's cleanup may run on it." },
    { "id": "ui", "label": "UI",
      "calls": ["^(Sims3\\.UI|Sims3\\.Gameplay\\.UI|UI)\\.[\\w.+]*(Controller|Panel|Window\\w*|Hud\\w*|Layout\\w*|Manager)::(set_|add_|remove_|Add|Remove|Set|Replace|Insert)\\w*$"],
      "events": [],
      "native": ["(?i)scaleform"],
      "risk": "Both change the same UI. Panels may overlap, lose buttons, or one mod's change may undo the other's." },
    { "id": "rendering", "label": "rendering (native)",
      "calls": [],
      "events": [],
      "native": ["(?i)^d3d9\\.dll$|^dxgi\\.dll$|^d3dx9\\w*\\.dll$|Direct3DCreate9|IDirect3DDevice9|\\bdxvk\\b|remix"],
      "risk": "Both hook the renderer. Expect black screens, missing effects or crashes at startup if their hooks chain badly." },
    { "id": "mono", "label": "script runtime (native)",
      "calls": [],
      "events": [],
      "native": ["(?i)\\bmono_\\w+|mono\\.dll|monojit|monothread|monosig|ilpatch|\\bgc(gate|grow|mark|roots|threads)\\b"],
      "risk": "Both patch the Mono script runtime. Script calls may run twice, be skipped, or crash when both rewrite the same code path." }
  ],
