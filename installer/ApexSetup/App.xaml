<Application
    x:Class="ApexSetup.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedTheme="Dark">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Apex's Violet theme (ui/violet_theme.h) as the accent: buttons, toggles, the selection pill, progress -->
            <Color x:Key="SystemAccentColor">#7F77DD</Color>
            <Color x:Key="SystemAccentColorLight1">#8F88E2</Color>
            <Color x:Key="SystemAccentColorLight2">#7F77DD</Color>
            <Color x:Key="SystemAccentColorLight3">#CECBF6</Color>
            <Color x:Key="SystemAccentColorDark1">#6A61CC</Color>
            <Color x:Key="SystemAccentColorDark2">#534AB7</Color>
            <Color x:Key="SystemAccentColorDark3">#3A3570</Color>

            <SolidColorBrush x:Key="ApexContentBrush" Color="#E60B0C0E" />
            <SolidColorBrush x:Key="ApexCardBrush" Color="#131417" />
            <SolidColorBrush x:Key="ApexCardBorderBrush" Color="#1F2025" />
            <SolidColorBrush x:Key="ApexMutedBrush" Color="#8B8C96" />
            <SolidColorBrush x:Key="ApexSoftTextBrush" Color="#B9BAC2" />
            <SolidColorBrush x:Key="ApexAccentBrush" Color="#7F77DD" />
            <SolidColorBrush x:Key="ApexSuccessBrush" Color="#7DBE9A" />
            <SolidColorBrush x:Key="ApexWarningBrush" Color="#E0A84F" />
            <SolidColorBrush x:Key="ApexErrorBrush" Color="#E8716B" />
            <SolidColorBrush x:Key="ApexPillBrush" Color="#1C1D22" />

            <Style x:Key="ApexCard" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource ApexCardBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource ApexCardBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="18,14" />
            </Style>
            <Style x:Key="ApexTitle" TargetType="TextBlock" BasedOn="{StaticResource SubtitleTextBlockStyle}">
                <Setter Property="FontSize" Value="24" />
            </Style>
            <Style x:Key="ApexMuted" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="Foreground" Value="{StaticResource ApexMutedBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="FontSize" Value="12" />
            </Style>
            <Style x:Key="ApexBody" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
            <Style x:Key="ApexStrong" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
                <Setter Property="FontSize" Value="14" />
            </Style>
            <Style x:Key="ApexPill" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource ApexPillBrush}" />
                <Setter Property="CornerRadius" Value="11" />
                <Setter Property="Padding" Value="9,3" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
