<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>ApexSetup</RootNamespace>
    <AssemblyName>ApexRadianceSetup</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWinUI>true</UseWinUI>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\apex.ico</ApplicationIcon>
    <!-- one exe the player double-clicks: no MSIX, no runtime to install -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishReadyToRun>false</PublishReadyToRun>
    <EnableMsixTooling>true</EnableMsixTooling>
    <!-- the XAML resources as resources.pri, the name an unpackaged app finds whatever its exe is called: as ApexRadianceSetup.pri,
         a renamed download ("ApexRadianceSetup (1).exe") looked for its own name and failed its XAML parse at start -->
    <ProjectPriFileName>resources.pri</ProjectPriFileName>
    <Version>1.1.1</Version>
    <Product>Apex Radiance Setup</Product>
    <Company>loinyx</Company>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260921001" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.4654" />
    <ProjectReference Include="..\ApexSetup.Core\ApexSetup.Core.csproj" />
    <Content Include="Assets\apex_logo.png;Assets\apex.ico" CopyToOutputDirectory="PreserveNewest" />
    <EmbeddedResource Include="Licenses\*.txt" LogicalName="Licenses.%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
