     return m_device->WaitForResource(*GetDxvkResource(pResource), DxvkCsThread::SynchronizeAll, MapFlags);
   }
 
+  BOOL STDMETHODCALLTYPE D3D9VkInteropDevice::SupportsRayQuery() {
+    const auto& features = m_device->GetDXVKDevice()->features();
+    return features.khrAccelerationStructure.accelerationStructure
+        && features.khrRayQuery.rayQuery;
+  }
+
+  HRESULT STDMETHODCALLTYPE D3D9VkInteropDevice::ExecuteExternal(
+          PFN_D3D9VkExternalPass    pfnPass,
+    const void*                     pData,
+          UINT                      DataSize,
+          UINT                      ResourceCount,
+          IDirect3DResource9* const* ppResources,
+    const VkImageLayout*            pLayouts) {
+    if (!pfnPass || (DataSize && !pData) || (ResourceCount && (!ppResources || !pLayouts)))
+      return D3DERR_INVALIDCALL;
+
+    std::vector<std::pair<Rc<DxvkPagedResource>, VkImageLayout>> resources;
+    resources.reserve(ResourceCount);
+
+    for (UINT i = 0; i < ResourceCount; i++) {
+      Rc<DxvkPagedResource> resource = ppResources[i] ? GetDxvkResource(ppResources[i]) : nullptr;
+
+      if (resource == nullptr)
+        return D3DERR_INVALIDCALL;
+
+      resources.emplace_back(std::move(resource), pLayouts[i]);
+    }
+
+    // The callback runs later on the CS thread, so it gets a copy
+    std::vector<uint8_t> data(DataSize);
+
+    if (DataSize)
+      std::memcpy(data.data(), pData, DataSize);
+
+    D3D9DeviceLock lock = m_device->LockDevice();
+
+    m_device->EmitCs([
+      cPass      = pfnPass,
+      cData      = std::move(data),
+      cResources = std::move(resources)
+    ] (DxvkContext* ctx) {
+      for (const auto& r : cResources)
+        ctx->releaseExternalResource(r.first, r.second);
+
+      Rc<DxvkCommandList> cmd = ctx->beginExternalRendering();
+      cPass(cmd->getExternalCmdBuffer(), cData.data());
+
+      for (const auto& r : cResources)
+        ctx->acquireExternalResource(r.first, r.second);
+    });
+
+    return D3D_OK;
+  }
+
   HRESULT STDMETHODCALLTYPE D3D9VkInteropDevice::CreateImage(
           const D3D9VkExtImageDesc* params,
           IDirect3DResource9**      ppResult) {
