+/**
+ * \brief Callback of an external pass
+ *
+ * Runs on DXVK's command stream thread, in stream order.
+ * \param [in] CommandBuffer Command buffer to record into
+ * \param [in] pData The caller's data, copied at submission
+ */
+typedef void (STDMETHODCALLTYPE *PFN_D3D9VkExternalPass)(
+        VkCommandBuffer           CommandBuffer,
+  const void*                     pData);
+
+/**
+ * \brief D3D9 external pass interface
+ *
+ * Records the caller's Vulkan commands into DXVK's
+ * command stream between the device's own work.
+ */
+MIDL_INTERFACE("7daa16ca-164c-44ea-b567-7f73c71ddaf8")
+ID3D9VkExternalPass : public IUnknown {
+  /**
+   * \brief Checks whether ray queries can be used
+   *
+   * \returns \c TRUE if the device was created with
+   *   acceleration structures and ray queries enabled
+   */
+  virtual BOOL STDMETHODCALLTYPE SupportsRayQuery() = 0;
+
+  /**
+   * \brief Records an external pass
+   *
+   * Copies \c pData, then, on DXVK's command thread,
+   * moves each resource into its layout, ends DXVK's
+   * current commands, calls \c pfnPass with the command
+   * buffer and the copy, and takes the resources back.
+   * DXVK re-binds all of its state afterwards.
+   * \param [in] pfnPass Callback that records the commands
+   * \param [in] pData Data passed to the callback
+   * \param [in] DataSize Size of \c pData in bytes
+   * \param [in] ResourceCount Number of resources
+   * \param [in] ppResources Resources the pass reads or writes
+   * \param [in] pLayouts Image layout per resource (ignored for buffers)
+   */
+  virtual HRESULT STDMETHODCALLTYPE ExecuteExternal(
+          PFN_D3D9VkExternalPass    pfnPass,
+    const void*                     pData,
+          UINT                      DataSize,
+          UINT                      ResourceCount,
+          IDirect3DResource9* const* ppResources,
+    const VkImageLayout*            pLayouts) = 0;
+};
+
 /**
  * \brief D3D9 extended interface
  */
@@ -301,4 +352,5 @@ __CRT_UUID_DECL(ID3D9VkInteropTexture,     0xd56344f5,0x8d35,0x46fd,0x80,0x6d,0x
 __CRT_UUID_DECL(ID3D9VkInteropDevice,      0x2eaa4b89,0x0107,0x4bdb,0x87,0xf7,0x0f,0x54,0x1c,0x49,0x3c,0xe0);
 __CRT_UUID_DECL(ID3D9VkExtSwapchain,       0x13776e93,0x4aa9,0x430a,0xa4,0xec,0xfe,0x9e,0x28,0x11,0x81,0xd5);
 __CRT_UUID_DECL(ID3D9VkExtInterface,       0x65b55086,0xe3e3,0x4c3e,0xb3,0xa0,0x86,0x81,0x5c,0xce,0x2c,0x4c);
