+  // Bridge_GiPixelView (WP11): the server's view of a client texture. Counted; a refused view logs its first fault.
+  inline void view(const ResourceMap& resources, uint32_t srcId, uint32_t dstId) {
+    if (!g_pass.ready()) {
+      return;
+    }
+    const uint32_t faults = g_pass.viewFaults();
+    g_pass.view(find(resources, srcId), find(resources, dstId));
+    if (g_pass.viewFaults() == 1 && faults == 0) {
+      bridge_util::Logger::info(bridge_util::format_string("[GiPixel] view refused: %s", g_pass.lastFault()));
+    }
+    publish(false);
+    const uint32_t views = g_pass.views();
+    if (views == 60 || (views != 0 && views % 3600 == 0)) {
+      bridge_util::Logger::info(bridge_util::format_string("[GiPixel] views=%u viewFaults=%u", views, g_pass.viewFaults()));
+    }
+  }
