+  // The server's view of a client texture: left half one colour, right half another (alpha = a material id byte).
+  void checkView(IDirect3DDevice9* pDevice) {
+    ComPtr<IDirect3DTexture9> pSrc;
+    ComPtr<IDirect3DSurface9> pSrcSurface;
+    check(pDevice->CreateTexture(kWidthFull, kHeightFull, 1, D3DUSAGE_RENDERTARGET, D3DFMT_A8R8G8B8, D3DPOOL_DEFAULT, &pSrc, nullptr), "CreateTexture (view source)");
+    check(pSrc->GetSurfaceLevel(0, &pSrcSurface), "GetSurfaceLevel (view source)");
+    const RECT left = { 0, 0, LONG(kWidthFull / 2), LONG(kHeightFull) };
+    const RECT right = { LONG(kWidthFull / 2), 0, LONG(kWidthFull), LONG(kHeightFull) };
+    const D3DCOLOR colours[2] = { D3DCOLOR_ARGB(0x07, 0x40, 0x80, 0xC0), D3DCOLOR_ARGB(0xFE, 0xFF, 0x20, 0x00) };
+    check(pDevice->ColorFill(pSrcSurface.Get(), &left, colours[0]), "ColorFill (left)");
+    check(pDevice->ColorFill(pSrcSurface.Get(), &right, colours[1]), "ColorFill (right)");
+    const UINT sizes[2][2] = { { kWidthFull, kHeightFull }, { kWidthQuarter, kHeightQuarter } };
+    for (const auto& size : sizes) {
+      ComPtr<IDirect3DTexture9> pDst;
+      ComPtr<IDirect3DSurface9> pDstSurface;
+      ComPtr<IDirect3DSurface9> pReadback;
+      check(pDevice->CreateTexture(size[0], size[1], 1, D3DUSAGE_RENDERTARGET, D3DFMT_A16B16G16R16F, D3DPOOL_DEFAULT, &pDst, nullptr), "CreateTexture (view target)");
+      check(pDst->GetSurfaceLevel(0, &pDstSurface), "GetSurfaceLevel (view target)");
+      check(pDevice->CreateOffscreenPlainSurface(size[0], size[1], D3DFMT_A16B16G16R16F, D3DPOOL_SYSTEMMEM, &pReadback, nullptr), "CreateOffscreenPlainSurface (view)");
+      check(g_view(pSrc.Get(), pDst.Get()), "RemixBridge_GiPixelView");
+      check(pDevice->GetRenderTargetData(pDstSurface.Get(), pReadback.Get()), "GetRenderTargetData (view)");
+      D3DLOCKED_RECT locked;
+      check(pReadback->LockRect(&locked, nullptr, D3DLOCK_READONLY), "LockRect (view)");
+      // A pixel well inside each half; the half-float target keeps an 8-bit value within 1/1024
+      const UINT xs[2] = { size[0] / 4, size[0] * 3 / 4 };
+      float worst = 0;
+      for (int half = 0; half < 2; ++half) {
+        const uint16_t* const pHalf = reinterpret_cast<const uint16_t*>(static_cast<const uint8_t*>(locked.pBits) + (size[1] / 2) * locked.Pitch) + xs[half] * 4;
+        const D3DCOLOR c = colours[half];
+        const float want[4] = { ((c >> 16) & 255) / 255.0f, ((c >> 8) & 255) / 255.0f, (c & 255) / 255.0f, (c >> 24) / 255.0f };
+        for (int channel = 0; channel < 4; ++channel) {
+          worst = std::fmax(worst, std::fabs(halfToFloat(pHalf[channel]) - want[channel]));
+        }
+      }
+      pReadback->UnlockRect();
+      std::printf("View %ux%u: worst channel error %.5f.\n", size[0], size[1], worst);
