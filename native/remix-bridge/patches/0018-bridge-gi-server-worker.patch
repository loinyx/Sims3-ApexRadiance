+    bool hasExtension(const std::vector<VkExtensionProperties>& extensions, const char* pName) {
+      for (const auto& extension : extensions) {
+        if (strcmp(extension.extensionName, pName) == 0) {
+          return true;
+        }
+      }
+      return false;
+    }
