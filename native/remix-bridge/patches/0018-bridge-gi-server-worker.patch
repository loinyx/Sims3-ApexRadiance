+    uint32_t Device::create(VkInstance dxvkInstance, VkPhysicalDevice dxvkPhysicalDevice, uint32_t& capBits, int32_t& lastError) {
+      VkResult result = volkInitialize();
+      if (result != VK_SUCCESS) {
+        lastError = result;
+        return bridge_util::GiLevelNone;
+      }
+
+      // DXVK's GPU by its deviceUUID, read through DXVK's own instance.
+      uint8_t dxvkUuid[VK_UUID_SIZE];
+      const uint8_t* pDxvkDeviceUuid = nullptr;
+      const auto pfnProperties2 = dxvkInstance != VK_NULL_HANDLE
+        ? (PFN_vkGetPhysicalDeviceProperties2) vkGetInstanceProcAddr(dxvkInstance, "vkGetPhysicalDeviceProperties2")
+        : nullptr;
+      if (pfnProperties2 != nullptr) {
+        VkPhysicalDeviceIDProperties ids { VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_ID_PROPERTIES };
+        VkPhysicalDeviceProperties2 properties { VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_PROPERTIES_2, &ids };
+        pfnProperties2(dxvkPhysicalDevice, &properties);
+        memcpy(dxvkUuid, ids.deviceUUID, VK_UUID_SIZE);
+        pDxvkDeviceUuid = dxvkUuid;
+      }
+
+      VkApplicationInfo application { VK_STRUCTURE_TYPE_APPLICATION_INFO };
+      application.pApplicationName = "NvRemixBridge GI";
+      application.apiVersion = VK_API_VERSION_1_2;
+      VkInstanceCreateInfo instanceInfo { VK_STRUCTURE_TYPE_INSTANCE_CREATE_INFO };
+      instanceInfo.pApplicationInfo = &application;
+      result = vkCreateInstance(&instanceInfo, nullptr, &m_instance);
+      if (result != VK_SUCCESS) {
+        lastError = result;
+        return bridge_util::GiLevelNone;
+      }
+      volkLoadInstanceOnly(m_instance);
+
+      // The GPU DXVK renders on, else the first discrete one, else the first one.
+      uint32_t count = 0;
+      vkEnumeratePhysicalDevices(m_instance, &count, nullptr);
+      std::vector<VkPhysicalDevice> physicalDevices(count);
+      vkEnumeratePhysicalDevices(m_instance, &count, physicalDevices.data());
+      VkPhysicalDevice discrete = VK_NULL_HANDLE;
+      for (VkPhysicalDevice physicalDevice : physicalDevices) {
+        VkPhysicalDeviceIDProperties ids { VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_ID_PROPERTIES };
+        VkPhysicalDeviceProperties2 properties { VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_PROPERTIES_2, &ids };
+        vkGetPhysicalDeviceProperties2(physicalDevice, &properties);
+        if (pDxvkDeviceUuid != nullptr && memcmp(ids.deviceUUID, pDxvkDeviceUuid, VK_UUID_SIZE) == 0) {
+          m_physicalDevice = physicalDevice;
+          capBits |= bridge_util::GiCapMatchedDxvkDevice;
+          break;
+        }
+        if (discrete == VK_NULL_HANDLE && properties.properties.deviceType == VK_PHYSICAL_DEVICE_TYPE_DISCRETE_GPU) {
+          discrete = physicalDevice;
+        }
+      }
+      if (m_physicalDevice == VK_NULL_HANDLE) {
+        m_physicalDevice = discrete != VK_NULL_HANDLE ? discrete : (count ? physicalDevices[0] : VK_NULL_HANDLE);
+      }
+      if (m_physicalDevice == VK_NULL_HANDLE) {
+        lastError = VK_ERROR_INITIALIZATION_FAILED;
+        return bridge_util::GiLevelNone;
+      }
+      VkPhysicalDeviceProperties properties;
+      vkGetPhysicalDeviceProperties(m_physicalDevice, &properties);
+
+      vkGetPhysicalDeviceQueueFamilyProperties(m_physicalDevice, &count, nullptr);
+      std::vector<VkQueueFamilyProperties> families(count);
+      vkGetPhysicalDeviceQueueFamilyProperties(m_physicalDevice, &count, families.data());
+      m_queueFamily = count;
+      for (uint32_t i = 0; i < count; ++i) {
+        // A compute-only family, when there is one, keeps the worker off the graphics queue DXVK uses.
+        if ((families[i].queueFlags & VK_QUEUE_COMPUTE_BIT) &&
+            (m_queueFamily == count || !(families[i].queueFlags & VK_QUEUE_GRAPHICS_BIT))) {
+          m_queueFamily = i;
+        }
+      }
+      if (m_queueFamily == count) {
+        lastError = VK_ERROR_FEATURE_NOT_PRESENT;
+        return bridge_util::GiLevelNone;
+      }
+
+      // Rays when the GPU has ray query and acceleration structures. R-04's kernel uses them.
+      vkEnumerateDeviceExtensionProperties(m_physicalDevice, nullptr, &count, nullptr);
+      std::vector<VkExtensionProperties> extensions(count);
+      vkEnumerateDeviceExtensionProperties(m_physicalDevice, nullptr, &count, extensions.data());
+      VkPhysicalDeviceRayQueryFeaturesKHR rayQuery { VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_RAY_QUERY_FEATURES_KHR };
+      VkPhysicalDeviceAccelerationStructureFeaturesKHR accelerationStructure { VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_ACCELERATION_STRUCTURE_FEATURES_KHR, &rayQuery };
+      VkPhysicalDeviceVulkan12Features vulkan12 { VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_VULKAN_1_2_FEATURES, &accelerationStructure };
+      VkPhysicalDeviceFeatures2 features { VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_FEATURES_2, &vulkan12 };
+      const bool rayExtensions = properties.apiVersion >= VK_API_VERSION_1_2 &&
+        hasExtension(extensions, VK_KHR_ACCELERATION_STRUCTURE_EXTENSION_NAME) &&
+        hasExtension(extensions, VK_KHR_RAY_QUERY_EXTENSION_NAME) &&
+        hasExtension(extensions, VK_KHR_DEFERRED_HOST_OPERATIONS_EXTENSION_NAME);
+      if (rayExtensions) {
+        vkGetPhysicalDeviceFeatures2(m_physicalDevice, &features);
+      }
+      // server.giMaxLevel = 1 keeps a GPU with ray queries on the compute level, for parity checks.
+      const bool rays = rayExtensions && rayQuery.rayQuery && accelerationStructure.accelerationStructure &&
+        vulkan12.bufferDeviceAddress && bridge_util::Config::getOption<uint32_t>("server.giMaxLevel", 2) >= 2;
+      m_rays = rays;
+      m_timestampBits = families[m_queueFamily].timestampValidBits;
+      m_timestampPeriod = properties.limits.timestampPeriod;
+      m_sliceUs = std::max<uint32_t>(bridge_util::Config::getOption<uint32_t>("server.giSliceUs", 2000), 50);
+      m_sliceIdleUs = bridge_util::Config::getOption<uint32_t>("server.giSliceIdleUs", 0);
+
+      const float priority = 0.0f;
+      VkDeviceQueueCreateInfo queueInfo { VK_STRUCTURE_TYPE_DEVICE_QUEUE_CREATE_INFO };
+      queueInfo.queueFamilyIndex = m_queueFamily;
+      queueInfo.queueCount = 1;
+      queueInfo.pQueuePriorities = &priority;
+      const char* rayExtensionNames[] = { VK_KHR_ACCELERATION_STRUCTURE_EXTENSION_NAME, VK_KHR_RAY_QUERY_EXTENSION_NAME,
+                                          VK_KHR_DEFERRED_HOST_OPERATIONS_EXTENSION_NAME };
+      VkDeviceCreateInfo deviceInfo { VK_STRUCTURE_TYPE_DEVICE_CREATE_INFO };
+      deviceInfo.queueCreateInfoCount = 1;
+      deviceInfo.pQueueCreateInfos = &queueInfo;
+      if (rays) {
+        // Only the features rays need, so the device costs no more than it must.
+        VkPhysicalDeviceRayQueryFeaturesKHR enabledRayQuery { VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_RAY_QUERY_FEATURES_KHR };
+        enabledRayQuery.rayQuery = VK_TRUE;
+        VkPhysicalDeviceAccelerationStructureFeaturesKHR enabledAs { VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_ACCELERATION_STRUCTURE_FEATURES_KHR, &enabledRayQuery };
+        enabledAs.accelerationStructure = VK_TRUE;
+        VkPhysicalDeviceVulkan12Features enabled12 { VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_VULKAN_1_2_FEATURES, &enabledAs };
+        enabled12.bufferDeviceAddress = VK_TRUE;
+        deviceInfo.pNext = &enabled12;
+        deviceInfo.enabledExtensionCount = 3;
+        deviceInfo.ppEnabledExtensionNames = rayExtensionNames;
+        result = vkCreateDevice(m_physicalDevice, &deviceInfo, nullptr, &m_device);
+      } else {
+        result = vkCreateDevice(m_physicalDevice, &deviceInfo, nullptr, &m_device);
+      }
+      if (result != VK_SUCCESS) {
+        lastError = result;
+        return bridge_util::GiLevelNone;
+      }
+      volkLoadDevice(m_device);
+      vkGetDeviceQueue(m_device, m_queueFamily, 0, &m_queue);
+      result = createPipeline();
+      if (result != VK_SUCCESS) {
+        lastError = result;
+        return bridge_util::GiLevelNone;
+      }
+      if (rays) {
+        capBits |= bridge_util::GiCapRayQuery | bridge_util::GiCapAccelerationStructure;
+      }
+      Logger::info(format_string("[Gi] Worker device: %s, queue family %u, %s, %s, GPU slices of %u us.", properties.deviceName, m_queueFamily,
+                                 rays ? "rays" : "compute only",
+                                 (capBits & bridge_util::GiCapMatchedDxvkDevice) ? "same GPU as DXVK" : "GPU not matched to DXVK", m_sliceUs));
+      return rays ? bridge_util::GiLevelRays : bridge_util::GiLevelCompute;
+    }
+
+    VkResult Device::createPipeline() {
+      VkDescriptorSetLayoutBinding binding { 0, VK_DESCRIPTOR_TYPE_STORAGE_BUFFER, 1, VK_SHADER_STAGE_COMPUTE_BIT };
+      VkDescriptorSetLayoutCreateInfo setLayoutInfo { VK_STRUCTURE_TYPE_DESCRIPTOR_SET_LAYOUT_CREATE_INFO };
+      setLayoutInfo.bindingCount = 1;
+      setLayoutInfo.pBindings = &binding;
+      VkResult result = vkCreateDescriptorSetLayout(m_device, &setLayoutInfo, nullptr, &m_setLayout);
+      if (result != VK_SUCCESS) {
+        return result;
+      }
+      VkPushConstantRange pushRange { VK_SHADER_STAGE_COMPUTE_BIT, 0, 5 * sizeof(uint32_t) };
+      VkPipelineLayoutCreateInfo layoutInfo { VK_STRUCTURE_TYPE_PIPELINE_LAYOUT_CREATE_INFO };
+      layoutInfo.setLayoutCount = 1;
+      layoutInfo.pSetLayouts = &m_setLayout;
+      layoutInfo.pushConstantRangeCount = 1;
+      layoutInfo.pPushConstantRanges = &pushRange;
+      result = vkCreatePipelineLayout(m_device, &layoutInfo, nullptr, &m_pipelineLayout);
+      if (result != VK_SUCCESS) {
+        return result;
+      }
+      VkShaderModuleCreateInfo moduleInfo { VK_STRUCTURE_TYPE_SHADER_MODULE_CREATE_INFO };
+      moduleInfo.codeSize = sizeof(g_giPatternSpv);
+      moduleInfo.pCode = g_giPatternSpv;
+      VkShaderModule module = VK_NULL_HANDLE;
+      result = vkCreateShaderModule(m_device, &moduleInfo, nullptr, &module);
+      if (result != VK_SUCCESS) {
+        return result;
+      }
+      VkComputePipelineCreateInfo pipelineInfo { VK_STRUCTURE_TYPE_COMPUTE_PIPELINE_CREATE_INFO };
+      pipelineInfo.stage = { VK_STRUCTURE_TYPE_PIPELINE_SHADER_STAGE_CREATE_INFO, nullptr, 0, VK_SHADER_STAGE_COMPUTE_BIT, module, "main" };
+      pipelineInfo.layout = m_pipelineLayout;
+      result = vkCreateComputePipelines(m_device, VK_NULL_HANDLE, 1, &pipelineInfo, nullptr, &m_pipeline);
+      vkDestroyShaderModule(m_device, module, nullptr);
+      if (result != VK_SUCCESS) {
+        return result;
+      }
+      VkDescriptorPoolSize poolSize { VK_DESCRIPTOR_TYPE_STORAGE_BUFFER, 1 };
+      VkDescriptorPoolCreateInfo poolInfo { VK_STRUCTURE_TYPE_DESCRIPTOR_POOL_CREATE_INFO };
+      poolInfo.maxSets = 1;
+      poolInfo.poolSizeCount = 1;
+      poolInfo.pPoolSizes = &poolSize;
+      result = vkCreateDescriptorPool(m_device, &poolInfo, nullptr, &m_descriptorPool);
+      if (result != VK_SUCCESS) {
+        return result;
+      }
+      VkDescriptorSetAllocateInfo setInfo { VK_STRUCTURE_TYPE_DESCRIPTOR_SET_ALLOCATE_INFO };
+      setInfo.descriptorPool = m_descriptorPool;
+      setInfo.descriptorSetCount = 1;
+      setInfo.pSetLayouts = &m_setLayout;
+      result = vkAllocateDescriptorSets(m_device, &setInfo, &m_set);
+      if (result != VK_SUCCESS) {
+        return result;
+      }
+      VkCommandPoolCreateInfo commandPoolInfo { VK_STRUCTURE_TYPE_COMMAND_POOL_CREATE_INFO };
+      commandPoolInfo.flags = VK_COMMAND_POOL_CREATE_RESET_COMMAND_BUFFER_BIT;
+      commandPoolInfo.queueFamilyIndex = m_queueFamily;
+      result = vkCreateCommandPool(m_device, &commandPoolInfo, nullptr, &m_commandPool);
+      if (result != VK_SUCCESS) {
+        return result;
+      }
+      VkCommandBufferAllocateInfo commandBufferInfo { VK_STRUCTURE_TYPE_COMMAND_BUFFER_ALLOCATE_INFO };
+      commandBufferInfo.commandPool = m_commandPool;
+      commandBufferInfo.level = VK_COMMAND_BUFFER_LEVEL_PRIMARY;
+      commandBufferInfo.commandBufferCount = 1;
+      result = vkAllocateCommandBuffers(m_device, &commandBufferInfo, &m_commandBuffer);
+      if (result != VK_SUCCESS) {
+        return result;
+      }
+      VkFenceCreateInfo fenceInfo { VK_STRUCTURE_TYPE_FENCE_CREATE_INFO };
+      result = vkCreateFence(m_device, &fenceInfo, nullptr, &m_fence);
+      return result == VK_SUCCESS ? createSolvePipelines() : result;
+    }
+
+    // Grows the host-visible result buffer. Host-cached memory is preferred, since the worker reads it back.
+    VkResult Device::reserve(VkDeviceSize size) {
+      if (size <= m_bufferSize) {
+        return VK_SUCCESS;
+      }
+      if (m_buffer != VK_NULL_HANDLE) {
+        vkDestroyBuffer(m_device, m_buffer, nullptr);
+        vkFreeMemory(m_device, m_memory, nullptr);
+        m_buffer = VK_NULL_HANDLE;
+        m_memory = VK_NULL_HANDLE;
+        m_bufferSize = 0;
+      }
+      VkBufferCreateInfo bufferInfo { VK_STRUCTURE_TYPE_BUFFER_CREATE_INFO };
+      bufferInfo.size = size;
+      bufferInfo.usage = VK_BUFFER_USAGE_STORAGE_BUFFER_BIT | VK_BUFFER_USAGE_TRANSFER_SRC_BIT | VK_BUFFER_USAGE_TRANSFER_DST_BIT;
+      VkResult result = vkCreateBuffer(m_device, &bufferInfo, nullptr, &m_buffer);
+      if (result != VK_SUCCESS) {
+        return result;
+      }
+      VkMemoryRequirements requirements;
+      vkGetBufferMemoryRequirements(m_device, m_buffer, &requirements);
+      VkPhysicalDeviceMemoryProperties memoryProperties;
+      vkGetPhysicalDeviceMemoryProperties(m_physicalDevice, &memoryProperties);
+      const VkMemoryPropertyFlags wanted[] = {
+        VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT | VK_MEMORY_PROPERTY_HOST_COHERENT_BIT | VK_MEMORY_PROPERTY_HOST_CACHED_BIT,
+        VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT | VK_MEMORY_PROPERTY_HOST_COHERENT_BIT };
+      uint32_t typeIndex = memoryProperties.memoryTypeCount;
+      for (VkMemoryPropertyFlags flags : wanted) {
+        for (uint32_t i = 0; i < memoryProperties.memoryTypeCount && typeIndex == memoryProperties.memoryTypeCount; ++i) {
+          if ((requirements.memoryTypeBits & (1u << i)) && (memoryProperties.memoryTypes[i].propertyFlags & flags) == flags) {
+            typeIndex = i;
+          }
+        }
+      }
+      if (typeIndex == memoryProperties.memoryTypeCount) {
+        return VK_ERROR_OUT_OF_HOST_MEMORY;
+      }
+      VkMemoryAllocateInfo allocateInfo { VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO };
+      allocateInfo.allocationSize = requirements.size;
+      allocateInfo.memoryTypeIndex = typeIndex;
+      result = vkAllocateMemory(m_device, &allocateInfo, nullptr, &m_memory);
+      if (result == VK_SUCCESS) {
+        result = vkBindBufferMemory(m_device, m_buffer, m_memory, 0);
+      }
+      if (result == VK_SUCCESS) {
+        result = vkMapMemory(m_device, m_memory, 0, VK_WHOLE_SIZE, 0, &m_pMapped);
+      }
+      if (result != VK_SUCCESS) {
+        return result;
+      }
+      m_bufferSize = size;
+      VkDescriptorBufferInfo bufferDescriptor { m_buffer, 0, VK_WHOLE_SIZE };
+      VkWriteDescriptorSet write { VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET };
+      write.dstSet = m_set;
+      write.descriptorCount = 1;
+      write.descriptorType = VK_DESCRIPTOR_TYPE_STORAGE_BUFFER;
+      write.pBufferInfo = &bufferDescriptor;
+      vkUpdateDescriptorSets(m_device, 1, &write, 0, nullptr);
+      return VK_SUCCESS;
+    }
+
+    // Starts the worker's command buffer, with the first GPU timestamp when the queue has them.
+    void Device::begin() {
+      VkCommandBufferBeginInfo beginInfo { VK_STRUCTURE_TYPE_COMMAND_BUFFER_BEGIN_INFO };
+      beginInfo.flags = VK_COMMAND_BUFFER_USAGE_ONE_TIME_SUBMIT_BIT;
+      vkBeginCommandBuffer(m_commandBuffer, &beginInfo);
+      if (m_timestampBits) {
+        vkCmdResetQueryPool(m_commandBuffer, m_queryPool, 0, 2);
+        vkCmdWriteTimestamp(m_commandBuffer, VK_PIPELINE_STAGE_TOP_OF_PIPE_BIT, m_queryPool, 0);
+      }
+    }
+
+    // Submits the command buffer and waits for it. The time is the GPU's own between the two timestamps,
+    // or submit to fence on a queue without timestamps.
+    VkResult Device::end(uint32_t* pGpuUs) {
+      if (m_timestampBits) {
+        vkCmdWriteTimestamp(m_commandBuffer, VK_PIPELINE_STAGE_BOTTOM_OF_PIPE_BIT, m_queryPool, 1);
+      }
+      vkEndCommandBuffer(m_commandBuffer);
+      VkSubmitInfo submit { VK_STRUCTURE_TYPE_SUBMIT_INFO };
+      submit.commandBufferCount = 1;
+      submit.pCommandBuffers = &m_commandBuffer;
+      vkResetFences(m_device, 1, &m_fence);
+      const auto start = std::chrono::steady_clock::now();
+      VkResult result = vkQueueSubmit(m_queue, 1, &submit, m_fence);
+      if (result == VK_SUCCESS) {
+        result = vkWaitForFences(m_device, 1, &m_fence, VK_TRUE, 2'000'000'000ull);
+      }
+      if (result != VK_SUCCESS) {
+        return result == VK_TIMEOUT ? VK_ERROR_DEVICE_LOST : result;
+      }
+      uint32_t us = uint32_t(std::chrono::duration_cast<std::chrono::microseconds>(std::chrono::steady_clock::now() - start).count());
+      uint64_t ticks[2] = {};
+      if (m_timestampBits &&
+          vkGetQueryPoolResults(m_device, m_queryPool, 0, 2, sizeof(ticks), ticks, sizeof(uint64_t), VK_QUERY_RESULT_64_BIT) == VK_SUCCESS) {
+        const uint64_t mask = m_timestampBits >= 64 ? ~0ull : (1ull << m_timestampBits) - 1;
+        us = uint32_t(double((ticks[1] - ticks[0]) & mask) * m_timestampPeriod / 1000.0);
+      }
+      if (pGpuUs != nullptr) {
+        *pGpuUs = us;
+      }
+      return VK_SUCCESS;
+    }
+
+    // The prototype's pattern pass: one dispatch for the whole target, kept for solves without a scene.
+    VkResult Device::runPattern(Job& job) {
+      const uint32_t bytesPerTexel = job.format == TexelFormat::Rgba16f ? 8 : 4;
+      const VkDeviceSize size = VkDeviceSize(job.width) * job.height * bytesPerTexel;
+      VkResult result = reserve(size);
+      if (result != VK_SUCCESS) {
+        return result;
+      }
+      begin();
+      vkCmdBindPipeline(m_commandBuffer, VK_PIPELINE_BIND_POINT_COMPUTE, m_pipeline);
+      vkCmdBindDescriptorSets(m_commandBuffer, VK_PIPELINE_BIND_POINT_COMPUTE, m_pipelineLayout, 0, 1, &m_set, 0, nullptr);
+      const uint32_t pass[5] = { job.width, job.height, job.layer, job.seq, uint32_t(job.format) };
+      vkCmdPushConstants(m_commandBuffer, m_pipelineLayout, VK_SHADER_STAGE_COMPUTE_BIT, 0, sizeof(pass), pass);
+      vkCmdDispatch(m_commandBuffer, (job.width + 7) / 8, (job.height + 7) / 8, 1);
+      VkMemoryBarrier barrier { VK_STRUCTURE_TYPE_MEMORY_BARRIER, nullptr, VK_ACCESS_SHADER_WRITE_BIT, VK_ACCESS_HOST_READ_BIT };
+      vkCmdPipelineBarrier(m_commandBuffer, VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT, VK_PIPELINE_STAGE_HOST_BIT, 0, 1, &barrier, 0, nullptr, 0, nullptr);
+      result = end(&job.gpuUs);
+      if (result != VK_SUCCESS) {
+        return result;
+      }
+      job.texels.resize(size_t(size));
+      memcpy(job.texels.data(), m_pMapped, size_t(size));
+      return VK_SUCCESS;
+    }
+
+    VkResult Device::createSolvePipelines() {
+      VkQueryPoolCreateInfo queryInfo { VK_STRUCTURE_TYPE_QUERY_POOL_CREATE_INFO };
+      queryInfo.queryType = VK_QUERY_TYPE_TIMESTAMP;
+      queryInfo.queryCount = 2;
+      if (m_timestampBits && vkCreateQueryPool(m_device, &queryInfo, nullptr, &m_queryPool) != VK_SUCCESS) {
+        m_timestampBits = 0;
+      }
+
+      // Binding 0 is the acceleration structure, at the rays level only. Bindings 1 to 9 are the buffers of gi_solve.comp.
+      std::vector<VkDescriptorSetLayoutBinding> bindings;
+      if (m_rays) {
+        bindings.push_back({ 0, VK_DESCRIPTOR_TYPE_ACCELERATION_STRUCTURE_KHR, 1, VK_SHADER_STAGE_COMPUTE_BIT });
+      }
+      for (uint32_t i = 1; i <= kSolveBuffers; ++i) {
+        bindings.push_back({ i, VK_DESCRIPTOR_TYPE_STORAGE_BUFFER, 1, VK_SHADER_STAGE_COMPUTE_BIT });
+      }
+      VkDescriptorSetLayoutCreateInfo setLayoutInfo { VK_STRUCTURE_TYPE_DESCRIPTOR_SET_LAYOUT_CREATE_INFO };
+      setLayoutInfo.bindingCount = uint32_t(bindings.size());
+      setLayoutInfo.pBindings = bindings.data();
+      VkResult result = vkCreateDescriptorSetLayout(m_device, &setLayoutInfo, nullptr, &m_solveSetLayout);
+      if (result != VK_SUCCESS) {
+        return result;
+      }
+      VkPushConstantRange pushRange { VK_SHADER_STAGE_COMPUTE_BIT, 0, sizeof(Push) };
+      VkPipelineLayoutCreateInfo layoutInfo { VK_STRUCTURE_TYPE_PIPELINE_LAYOUT_CREATE_INFO };
+      layoutInfo.setLayoutCount = 1;
+      layoutInfo.pSetLayouts = &m_solveSetLayout;
+      layoutInfo.pushConstantRangeCount = 1;
+      layoutInfo.pPushConstantRanges = &pushRange;
+      result = vkCreatePipelineLayout(m_device, &layoutInfo, nullptr, &m_solveLayout);
+      if (result != VK_SUCCESS) {
+        return result;
+      }
+      const struct { const uint32_t* pCode; size_t size; } shaders[kPassCount] = {
+        { m_rays ? g_giLinksRqSpv : g_giLinksSwSpv, m_rays ? sizeof(g_giLinksRqSpv) : sizeof(g_giLinksSwSpv) },
+        { m_rays ? g_giDirectRqSpv : g_giDirectSwSpv, m_rays ? sizeof(g_giDirectRqSpv) : sizeof(g_giDirectSwSpv) },
+        { g_giBounceSpv, sizeof(g_giBounceSpv) } };
+      for (uint32_t i = 0; i < kPassCount; ++i) {
+        VkShaderModuleCreateInfo moduleInfo { VK_STRUCTURE_TYPE_SHADER_MODULE_CREATE_INFO };
+        moduleInfo.codeSize = shaders[i].size;
+        moduleInfo.pCode = shaders[i].pCode;
+        VkShaderModule module = VK_NULL_HANDLE;
+        result = vkCreateShaderModule(m_device, &moduleInfo, nullptr, &module);
+        if (result != VK_SUCCESS) {
+          return result;
+        }
+        VkComputePipelineCreateInfo pipelineInfo { VK_STRUCTURE_TYPE_COMPUTE_PIPELINE_CREATE_INFO };
+        pipelineInfo.stage = { VK_STRUCTURE_TYPE_PIPELINE_SHADER_STAGE_CREATE_INFO, nullptr, 0, VK_SHADER_STAGE_COMPUTE_BIT, module, "main" };
+        pipelineInfo.layout = m_solveLayout;
+        result = vkCreateComputePipelines(m_device, VK_NULL_HANDLE, 1, &pipelineInfo, nullptr, &m_solvePipelines[i]);
+        vkDestroyShaderModule(m_device, module, nullptr);
+        if (result != VK_SUCCESS) {
+          return result;
+        }
+      }
+      const VkDescriptorPoolSize poolSizes[2] = { { VK_DESCRIPTOR_TYPE_STORAGE_BUFFER, kSolveBuffers },
+                                                  { VK_DESCRIPTOR_TYPE_ACCELERATION_STRUCTURE_KHR, 1 } };
+      VkDescriptorPoolCreateInfo poolInfo { VK_STRUCTURE_TYPE_DESCRIPTOR_POOL_CREATE_INFO };
+      poolInfo.maxSets = 1;
+      poolInfo.poolSizeCount = m_rays ? 2 : 1;
+      poolInfo.pPoolSizes = poolSizes;
+      result = vkCreateDescriptorPool(m_device, &poolInfo, nullptr, &m_solvePool);
+      if (result != VK_SUCCESS) {
+        return result;
+      }
+      VkDescriptorSetAllocateInfo setInfo { VK_STRUCTURE_TYPE_DESCRIPTOR_SET_ALLOCATE_INFO };
+      setInfo.descriptorPool = m_solvePool;
+      setInfo.descriptorSetCount = 1;
+      setInfo.pSetLayouts = &m_solveSetLayout;
+      return vkAllocateDescriptorSets(m_device, &setInfo, &m_solveSet);
+    }
+
+    // A buffer in device memory: a shader reading host memory runs the gathers many times slower.
+    VkResult Device::makeBuffer(VkDeviceSize size, VkBufferUsageFlags usage, Buffer& buffer) {
+      buffer.size = std::max<VkDeviceSize>(size, 16);
+      VkBufferCreateInfo bufferInfo { VK_STRUCTURE_TYPE_BUFFER_CREATE_INFO };
+      bufferInfo.size = buffer.size;
+      bufferInfo.usage = usage | VK_BUFFER_USAGE_STORAGE_BUFFER_BIT | VK_BUFFER_USAGE_TRANSFER_SRC_BIT | VK_BUFFER_USAGE_TRANSFER_DST_BIT |
+        (m_rays ? VK_BUFFER_USAGE_SHADER_DEVICE_ADDRESS_BIT : 0);
+      VkResult result = vkCreateBuffer(m_device, &bufferInfo, nullptr, &buffer.buffer);
+      if (result != VK_SUCCESS) {
+        return result;
+      }
+      VkMemoryRequirements requirements;
+      vkGetBufferMemoryRequirements(m_device, buffer.buffer, &requirements);
+      VkPhysicalDeviceMemoryProperties memoryProperties;
+      vkGetPhysicalDeviceMemoryProperties(m_physicalDevice, &memoryProperties);
+      uint32_t typeIndex = memoryProperties.memoryTypeCount;
+      for (uint32_t i = 0; i < memoryProperties.memoryTypeCount && typeIndex == memoryProperties.memoryTypeCount; ++i) {
+        if ((requirements.memoryTypeBits & (1u << i)) && (memoryProperties.memoryTypes[i].propertyFlags & VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT)) {
+          typeIndex = i;
+        }
+      }
+      if (typeIndex == memoryProperties.memoryTypeCount) {
+        return VK_ERROR_OUT_OF_DEVICE_MEMORY;
+      }
+      VkMemoryAllocateFlagsInfo flagsInfo { VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_FLAGS_INFO };
+      flagsInfo.flags = VK_MEMORY_ALLOCATE_DEVICE_ADDRESS_BIT;
+      VkMemoryAllocateInfo allocateInfo { VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO, m_rays ? &flagsInfo : nullptr };
+      allocateInfo.allocationSize = requirements.size;
+      allocateInfo.memoryTypeIndex = typeIndex;
+      result = vkAllocateMemory(m_device, &allocateInfo, nullptr, &buffer.memory);
+      if (result == VK_SUCCESS) {
+        result = vkBindBufferMemory(m_device, buffer.buffer, buffer.memory, 0);
+      }
+      return result;
+    }
+
+    // A device buffer holding the data, copied through the host buffer.
+    VkResult Device::makeBuffer(const void* pData, size_t size, VkBufferUsageFlags usage, Buffer& buffer) {
+      VkResult result = makeBuffer(size, usage, buffer);
+      if (result == VK_SUCCESS) {
+        result = reserve(buffer.size);
+      }
+      if (result != VK_SUCCESS) {
+        return result;
+      }
+      memset(m_pMapped, 0, size_t(buffer.size));
+      memcpy(m_pMapped, pData, size);
+      begin();
+      const VkBufferCopy all { 0, 0, buffer.size };
+      vkCmdCopyBuffer(m_commandBuffer, m_buffer, buffer.buffer, 1, &all);
+      return end(nullptr);
+    }
+
+    void Device::destroy(Buffer& buffer) {
+      if (buffer.buffer != VK_NULL_HANDLE) {
+        vkDestroyBuffer(m_device, buffer.buffer, nullptr);
+      }
+      if (buffer.memory != VK_NULL_HANDLE) {
+        vkFreeMemory(m_device, buffer.memory, nullptr);
+      }
+      buffer = Buffer();
+    }
+
+    void Device::destroyScene() {
+      for (VkAccelerationStructureKHR structure : m_structures) {
+        if (structure != VK_NULL_HANDLE) {
+          vkDestroyAccelerationStructureKHR(m_device, structure, nullptr);
+        }
+      }
+      m_structures[0] = m_structures[1] = VK_NULL_HANDLE;
+      for (Buffer& buffer : m_sceneBuffers) {
+        destroy(buffer);
+      }
+      for (Buffer& buffer : m_structureBuffers) {
+        destroy(buffer);
+      }
+      m_sceneSeq = 0;
+    }
+
+    VkDeviceAddress Device::address(const Buffer& buffer) {
+      VkBufferDeviceAddressInfo info { VK_STRUCTURE_TYPE_BUFFER_DEVICE_ADDRESS_INFO };
+      info.buffer = buffer.buffer;
+      return vkGetBufferDeviceAddress(m_device, &info);
+    }
+
+    // One bottom-level structure over the scene's triangles and a top level with its one instance.
+    // shortcut: built in one submit of a few milliseconds for a 10 k triangle proxy; slice it by geometry when scenes grow.
+    VkResult Device::buildStructures(uint32_t triangles, uint32_t& gpuUs) {
+      for (uint32_t level = 0; level < 2; ++level) {
+        VkAccelerationStructureGeometryKHR geometry { VK_STRUCTURE_TYPE_ACCELERATION_STRUCTURE_GEOMETRY_KHR };
+        geometry.flags = VK_GEOMETRY_OPAQUE_BIT_KHR;
+        uint32_t count = triangles;
+        if (level == 0) {
+          geometry.geometryType = VK_GEOMETRY_TYPE_TRIANGLES_KHR;
+          geometry.geometry.triangles = { VK_STRUCTURE_TYPE_ACCELERATION_STRUCTURE_GEOMETRY_TRIANGLES_DATA_KHR };
+          geometry.geometry.triangles.vertexFormat = VK_FORMAT_R32G32B32_SFLOAT;
+          geometry.geometry.triangles.vertexStride = 16;
+          geometry.geometry.triangles.vertexData.deviceAddress = address(m_sceneBuffers[kTris]);
+          geometry.geometry.triangles.maxVertex = triangles * 3 - 1;
+          geometry.geometry.triangles.indexType = VK_INDEX_TYPE_NONE_KHR;
+        } else {
+          VkAccelerationStructureDeviceAddressInfoKHR addressInfo { VK_STRUCTURE_TYPE_ACCELERATION_STRUCTURE_DEVICE_ADDRESS_INFO_KHR };
+          addressInfo.accelerationStructure = m_structures[0];
+          VkAccelerationStructureInstanceKHR instance = {};
+          instance.transform.matrix[0][0] = instance.transform.matrix[1][1] = instance.transform.matrix[2][2] = 1.0f;
+          instance.mask = 0xFF;
+          instance.flags = VK_GEOMETRY_INSTANCE_TRIANGLE_FACING_CULL_DISABLE_BIT_KHR;
+          instance.accelerationStructureReference = vkGetAccelerationStructureDeviceAddressKHR(m_device, &addressInfo);
+          const VkResult result = makeBuffer(&instance, sizeof(instance), VK_BUFFER_USAGE_ACCELERATION_STRUCTURE_BUILD_INPUT_READ_ONLY_BIT_KHR, m_structureBuffers[4]);
+          if (result != VK_SUCCESS) {
+            return result;
+          }
+          geometry.geometryType = VK_GEOMETRY_TYPE_INSTANCES_KHR;
+          geometry.geometry.instances = { VK_STRUCTURE_TYPE_ACCELERATION_STRUCTURE_GEOMETRY_INSTANCES_DATA_KHR };
+          geometry.geometry.instances.data.deviceAddress = address(m_structureBuffers[4]);
+          count = 1;
+        }
+        VkAccelerationStructureBuildGeometryInfoKHR buildInfo { VK_STRUCTURE_TYPE_ACCELERATION_STRUCTURE_BUILD_GEOMETRY_INFO_KHR };
+        buildInfo.type = level == 0 ? VK_ACCELERATION_STRUCTURE_TYPE_BOTTOM_LEVEL_KHR : VK_ACCELERATION_STRUCTURE_TYPE_TOP_LEVEL_KHR;
+        buildInfo.flags = VK_BUILD_ACCELERATION_STRUCTURE_PREFER_FAST_TRACE_BIT_KHR;
+        buildInfo.mode = VK_BUILD_ACCELERATION_STRUCTURE_MODE_BUILD_KHR;
+        buildInfo.geometryCount = 1;
+        buildInfo.pGeometries = &geometry;
+        VkAccelerationStructureBuildSizesInfoKHR sizes { VK_STRUCTURE_TYPE_ACCELERATION_STRUCTURE_BUILD_SIZES_INFO_KHR };
+        vkGetAccelerationStructureBuildSizesKHR(m_device, VK_ACCELERATION_STRUCTURE_BUILD_TYPE_DEVICE_KHR, &buildInfo, &count, &sizes);
+        Buffer& store = m_structureBuffers[level * 2];
+        Buffer& scratch = m_structureBuffers[level * 2 + 1];
+        VkResult result = makeBuffer(sizes.accelerationStructureSize, VK_BUFFER_USAGE_ACCELERATION_STRUCTURE_STORAGE_BIT_KHR, store);
+        if (result == VK_SUCCESS) {
+          result = makeBuffer(sizes.buildScratchSize + 256, 0, scratch);
+        }
+        if (result != VK_SUCCESS) {
+          return result;
+        }
+        VkAccelerationStructureCreateInfoKHR createInfo { VK_STRUCTURE_TYPE_ACCELERATION_STRUCTURE_CREATE_INFO_KHR };
+        createInfo.buffer = store.buffer;
+        createInfo.size = sizes.accelerationStructureSize;
+        createInfo.type = buildInfo.type;
+        result = vkCreateAccelerationStructureKHR(m_device, &createInfo, nullptr, &m_structures[level]);
+        if (result != VK_SUCCESS) {
+          return result;
+        }
+        buildInfo.dstAccelerationStructure = m_structures[level];
+        buildInfo.scratchData.deviceAddress = (address(scratch) + 255) & ~VkDeviceAddress(255);  // The scratch alignment is at most 256.
+        const VkAccelerationStructureBuildRangeInfoKHR range { count, 0, 0, 0 };
+        const VkAccelerationStructureBuildRangeInfoKHR* pRange = &range;
+        begin();
+        vkCmdBuildAccelerationStructuresKHR(m_commandBuffer, 1, &buildInfo, &pRange);
+        uint32_t us = 0;
+        result = end(&us);
+        if (result != VK_SUCCESS) {
+          return result;
+        }
+        gpuUs += us;
+        destroy(scratch);
+      }
+      return VK_SUCCESS;
+    }
+
+    // The 1 m grid over x and z the compute level walks: cell c holds cellTris[cellStart[c] .. cellStart[c + 1]).
+    // Returns false when the scene is wider than the grid allows.
+    bool Device::buildGrid(const bridge_util::GiSceneTriangle* pTriangles, uint32_t triangles, std::vector<uint32_t>& cellStart, std::vector<uint32_t>& cellTris) {
+      float lowX = 1e30f, highX = -1e30f, lowZ = 1e30f, highZ = -1e30f;
+      for (uint32_t i = 0; i < triangles; ++i) {
+        for (const auto& vertex : pTriangles[i].v) {
+          lowX = std::min(lowX, vertex[0]);
+          highX = std::max(highX, vertex[0]);
+          lowZ = std::min(lowZ, vertex[2]);
+          highZ = std::max(highZ, vertex[2]);
+        }
+      }
+      if (!(highX - lowX < 2000.0f && highZ - lowZ < 2000.0f && std::fabs(lowX) < 1e6f && std::fabs(lowZ) < 1e6f)) {
+        return false;
+      }
+      m_push.gx0 = int32_t(std::floor(lowX)) - 1;
+      m_push.gz0 = int32_t(std::floor(lowZ)) - 1;
+      m_push.gw = int32_t(std::floor(highX)) - m_push.gx0 + 2;
+      m_push.gh = int32_t(std::floor(highZ)) - m_push.gz0 + 2;
+      const size_t cells = size_t(m_push.gw) * m_push.gh;
+      cellStart.assign(cells + 1, 0);
+      const auto range = [&](const bridge_util::GiSceneTriangle& triangle, int32_t cell[4]) {
+        float low[2] = { 1e30f, 1e30f }, high[2] = { -1e30f, -1e30f };
+        for (const auto& vertex : triangle.v) {
+          low[0] = std::min(low[0], vertex[0]);
+          high[0] = std::max(high[0], vertex[0]);
+          low[1] = std::min(low[1], vertex[2]);
+          high[1] = std::max(high[1], vertex[2]);
+        }
+        cell[0] = std::clamp(int32_t(std::floor(low[0] - 1e-3f)) - m_push.gx0, 0, m_push.gw - 1);
+        cell[1] = std::clamp(int32_t(std::floor(high[0] + 1e-3f)) - m_push.gx0, 0, m_push.gw - 1);
+        cell[2] = std::clamp(int32_t(std::floor(low[1] - 1e-3f)) - m_push.gz0, 0, m_push.gh - 1);
+        cell[3] = std::clamp(int32_t(std::floor(high[1] + 1e-3f)) - m_push.gz0, 0, m_push.gh - 1);
+      };
+      // Two rounds: the first counts a cell's triangles, the second fills them in.
+      for (int round = 0; round < 2; ++round) {
+        std::vector<uint32_t> fill(cellStart.begin(), cellStart.end() - 1);
+        for (uint32_t i = 0; i < triangles; ++i) {
+          int32_t cell[4];
+          range(pTriangles[i], cell);
+          for (int32_t z = cell[2]; z <= cell[3]; ++z) {
+            for (int32_t x = cell[0]; x <= cell[1]; ++x) {
+              const size_t c = size_t(z) * m_push.gw + x;
+              if (round == 0) {
+                ++cellStart[c + 1];
+              } else {
+                cellTris[fill[c]++] = i;
+              }
+            }
+          }
+        }
+        if (round == 0) {
+          for (size_t c = 0; c < cells; ++c) {
+            cellStart[c + 1] += cellStart[c];
+          }
+          cellTris.assign(std::max<size_t>(cellStart[cells], 1), 0);
+        }
+      }
+      return true;
+    }
+
+    // The direct and indirect buffers of every lamp, for the scene's texel count. No lamp's layer is valid afterwards.
+    VkResult Device::allocateLamps() {
+      destroy(m_sceneBuffers[kDirect]);
+      destroy(m_sceneBuffers[kIndirect]);
+      const VkDeviceSize layer = VkDeviceSize(m_push.texels) * 16;
+      const uint32_t lamps = std::max<uint32_t>(uint32_t(m_lamps.size()), 1);
+      m_push.lamps = lamps;
+      m_directValid.assign(lamps, 0);
+      m_indirectHalf.assign(lamps, -1);
+      VkResult result = makeBuffer(layer * lamps, 0, m_sceneBuffers[kDirect]);
+      if (result == VK_SUCCESS) {
+        result = makeBuffer(layer * lamps * 2, 0, m_sceneBuffers[kIndirect]);
+      }
+      if (result != VK_SUCCESS) {
+        return result;
+      }
+      VkDescriptorBufferInfo bufferInfos[kSolveBuffers];
+      std::vector<VkWriteDescriptorSet> writes;
+      for (uint32_t i = 0; i < kSolveBuffers; ++i) {
+        bufferInfos[i] = { m_sceneBuffers[i].buffer, 0, VK_WHOLE_SIZE };
+        VkWriteDescriptorSet write { VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET };
+        write.dstSet = m_solveSet;
+        write.dstBinding = i + 1;
+        write.descriptorCount = 1;
+        write.descriptorType = VK_DESCRIPTOR_TYPE_STORAGE_BUFFER;
+        write.pBufferInfo = &bufferInfos[i];
+        writes.push_back(write);
+      }
+      VkWriteDescriptorSetAccelerationStructureKHR structureWrite { VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET_ACCELERATION_STRUCTURE_KHR };
+      structureWrite.accelerationStructureCount = 1;
+      structureWrite.pAccelerationStructures = &m_structures[1];
+      if (m_rays) {
+        VkWriteDescriptorSet write { VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET, &structureWrite };
+        write.dstSet = m_solveSet;
+        write.dstBinding = 0;
+        write.descriptorCount = 1;
+        write.descriptorType = VK_DESCRIPTOR_TYPE_ACCELERATION_STRUCTURE_KHR;
+        writes.push_back(write);
+      }
+      vkUpdateDescriptorSets(m_device, uint32_t(writes.size()), writes.data(), 0, nullptr);
+      return VK_SUCCESS;
+    }
+
+    // Runs a pass over groupsX columns of 64 texels and rowsY rays in slices of about the GPU budget each.
+    // A slice is whole columns, or a run of rays of one column when a column is over the budget.
+    // The slice size follows the measured GPU time. Returns VK_NOT_READY when the job was cancelled between slices.
+    VkResult Device::runSliced(uint32_t pass, uint32_t rowsY, Job& job) {
+      const uint32_t groupsX = (m_push.texels + 63) / 64;
+      uint32_t& units = m_sliceUnits[pass];
+      for (uint32_t x = 0, y = 0; x < groupsX;) {
+        if (job.cancelled.load(std::memory_order_acquire)) {
+          return VK_NOT_READY;
+        }
+        uint32_t columns = 1;
+        uint32_t rows = std::min(units, rowsY - y);
+        if (y == 0 && units >= rowsY) {
+          columns = std::min(units / rowsY, groupsX - x);
+          rows = rowsY;
+        }
+        m_push.texel0 = x * 64;
+        m_push.ray0 = y;
+        begin();
+        vkCmdBindPipeline(m_commandBuffer, VK_PIPELINE_BIND_POINT_COMPUTE, m_solvePipelines[pass]);
+        vkCmdBindDescriptorSets(m_commandBuffer, VK_PIPELINE_BIND_POINT_COMPUTE, m_solveLayout, 0, 1, &m_solveSet, 0, nullptr);
+        vkCmdPushConstants(m_commandBuffer, m_solveLayout, VK_SHADER_STAGE_COMPUTE_BIT, 0, sizeof(m_push), &m_push);
+        vkCmdDispatch(m_commandBuffer, columns, rows, 1);
+        uint32_t us = 0;
+        const VkResult result = end(&us);
+        if (result != VK_SUCCESS) {
+          return result;
+        }
+        job.gpuUs += us;
+        job.slices += 1;
+        job.sliceUsMax = std::max(job.sliceUsMax, us);
+        if (y == 0 && rows == rowsY) {
+          x += columns;
+        } else if ((y += rows) == rowsY) {
+          y = 0;
+          x += 1;
+        }
+        // At most double or halve a slice, so one odd timestamp does not swing the size.
+        const uint64_t wanted = uint64_t(columns) * rows * m_sliceUs / std::max<uint32_t>(us, 1);
+        units = uint32_t(std::clamp<uint64_t>(wanted, std::max<uint32_t>(units / 2, 1), std::min<uint64_t>(uint64_t(units) * 2, 1u << 24)));
+        if (m_sliceIdleUs) {
+          std::this_thread::sleep_for(std::chrono::microseconds(m_sliceIdleUs));
+        }
+      }
+      return VK_SUCCESS;
+    }
+
+    // GiSubmitScene: checks the blob, moves it to the device, builds the ray structure or the grid and traces the links.
+    // A blob that fails a check sets job.hresult and leaves the scene the worker holds.
+    VkResult Device::setScene(Job& job) {
+      using namespace bridge_util;
+      job.hresult = D3DERR_INVALIDCALL;
+      GiSceneHeader header;
+      if (job.blob.size() < sizeof(header)) {
+        return VK_SUCCESS;
+      }
+      memcpy(&header, job.blob.data(), sizeof(header));
+      const uint64_t size = sizeof(header) + uint64_t(header.triangles) * sizeof(GiSceneTriangle) + uint64_t(header.patches) * sizeof(GiScenePatch) +
+        uint64_t(header.mapEntries) * 4 + uint64_t(header.texels) * sizeof(GiSceneTexel);
+      if (header.magic != GiSceneHeader::kMagic || header.version != 1 || size != job.blob.size() ||
+          header.triangles == 0 || header.texels == 0 || header.rays == 0 || header.rays > 1024 ||
+          header.shadowRays == 0 || header.shadowRays > 64 || header.bounces > 64 ||
+          uint64_t(header.texels) * header.rays > kMaxLinks) {
+        return VK_SUCCESS;
+      }
+      // The blob is packed, so its parts are copied out before they are read.
+      const uint8_t* pRead = job.blob.data() + sizeof(header);
+      std::vector<GiSceneTriangle> triangles(header.triangles);
+      memcpy(triangles.data(), pRead, triangles.size() * sizeof(GiSceneTriangle));
+      pRead += triangles.size() * sizeof(GiSceneTriangle);
+      std::vector<GiScenePatch> patches(header.patches);
+      memcpy(patches.data(), pRead, patches.size() * sizeof(GiScenePatch));
+      pRead += patches.size() * sizeof(GiScenePatch);
+      std::vector<int32_t> map(header.mapEntries);
+      memcpy(map.data(), pRead, map.size() * 4);
+      pRead += map.size() * 4;
+      std::vector<GiSceneTexel> texels(header.texels);
+      memcpy(texels.data(), pRead, texels.size() * sizeof(GiSceneTexel));
+
+      // Every index the shader follows is checked here, so the kernel never reads outside its buffers.
+      struct Vertex { float position[3]; int32_t patch; };
+      std::vector<Vertex> vertices(size_t(header.triangles) * 3);
+      for (uint32_t i = 0; i < header.triangles; ++i) {
+        const GiSceneTriangle& triangle = triangles[i];
+        if (triangle.patchFront < -1 || triangle.patchFront >= int32_t(header.patches) ||
+            triangle.patchBack < -1 || triangle.patchBack >= int32_t(header.patches)) {
+          return VK_SUCCESS;
+        }
+        for (uint32_t k = 0; k < 3; ++k) {
+          memcpy(vertices[size_t(i) * 3 + k].position, triangle.v[k], sizeof(float) * 3);
+          vertices[size_t(i) * 3 + k].patch = k == 0 ? triangle.patchFront : triangle.patchBack;
+        }
+      }
+      struct Patch { float origin[3]; int32_t mapOffset; float u[3]; int32_t nu; float v[3]; int32_t nv; };
+      std::vector<Patch> gpuPatches(std::max<size_t>(header.patches, 1));
+      for (uint32_t i = 0; i < header.patches; ++i) {
+        const GiScenePatch& patch = patches[i];
+        if (patch.nu == 0 || patch.nv == 0 || patch.nu > 65536 || patch.nv > 65536 ||
+            uint64_t(patch.mapOffset) + uint64_t(patch.nu) * patch.nv > header.mapEntries) {
+          return VK_SUCCESS;
+        }
+        Patch& gpuPatch = gpuPatches[i];
+        memcpy(gpuPatch.origin, patch.origin, sizeof(float) * 3);
+        memcpy(gpuPatch.u, patch.u, sizeof(float) * 3);
+        memcpy(gpuPatch.v, patch.v, sizeof(float) * 3);
+        gpuPatch.mapOffset = int32_t(patch.mapOffset);
+        gpuPatch.nu = int32_t(patch.nu);
+        gpuPatch.nv = int32_t(patch.nv);
+      }
+      for (int32_t entry : map) {
+        if (entry < -1 || entry >= int32_t(header.texels)) {
+          return VK_SUCCESS;
+        }
+      }
+      // The blob passed its checks, so it replaces the scene the worker holds.
+      destroyScene();
+      struct Texel { float position[4]; float normal[4]; float albedo[4]; };
+      std::vector<Texel> gpuTexels(header.texels);
+      m_pixels.resize(header.texels);
+      for (uint32_t i = 0; i < header.texels; ++i) {
+        memcpy(gpuTexels[i].position, texels[i].position, sizeof(float) * 3);
+        memcpy(gpuTexels[i].normal, texels[i].normal, sizeof(float) * 3);
+        memcpy(gpuTexels[i].albedo, texels[i].albedo, sizeof(float) * 3);
+        gpuTexels[i].position[3] = gpuTexels[i].normal[3] = gpuTexels[i].albedo[3] = 0.0f;
+        m_pixels[i] = texels[i].pixel;
+      }
+      map.resize(std::max<size_t>(map.size(), 1), -1);
+
+      m_push = Push();
+      m_push.texels = header.texels;
+      m_push.rays = header.rays;
+      m_push.shadowRays = header.shadowRays;
+      m_bounces = header.bounces;
+      std::vector<uint32_t> cellStart(1, 0), cellTris(1, 0);
+      if (!m_rays && !buildGrid(triangles.data(), header.triangles, cellStart, cellTris)) {
+        return VK_SUCCESS;
+      }
+      job.hresult = S_OK;
+      VkResult result = makeBuffer(vertices.data(), vertices.size() * sizeof(Vertex),
+                                   m_rays ? VK_BUFFER_USAGE_ACCELERATION_STRUCTURE_BUILD_INPUT_READ_ONLY_BIT_KHR : 0, m_sceneBuffers[kTris]);
+      if (result == VK_SUCCESS) {
+        result = makeBuffer(cellStart.data(), cellStart.size() * 4, 0, m_sceneBuffers[kCellStart]);
+      }
+      if (result == VK_SUCCESS) {
+        result = makeBuffer(cellTris.data(), cellTris.size() * 4, 0, m_sceneBuffers[kCellTris]);
+      }
+      if (result == VK_SUCCESS) {
+        result = makeBuffer(gpuTexels.data(), gpuTexels.size() * sizeof(Texel), 0, m_sceneBuffers[kTexels]);
+      }
+      if (result == VK_SUCCESS) {
+        result = makeBuffer(gpuPatches.data(), gpuPatches.size() * sizeof(Patch), 0, m_sceneBuffers[kPatches]);
+      }
+      if (result == VK_SUCCESS) {
+        result = makeBuffer(map.data(), map.size() * 4, 0, m_sceneBuffers[kPatchMap]);
+      }
+      if (result == VK_SUCCESS) {
+        result = makeBuffer(VkDeviceSize(header.texels) * header.rays * 4, 0, m_sceneBuffers[kLinks]);
+      }
+      uint32_t structureUs = 0;
+      if (result == VK_SUCCESS && m_rays) {
+        result = buildStructures(header.triangles, structureUs);
+      }
+      if (result == VK_SUCCESS) {
+        result = allocateLamps();
+      }
+      if (result == VK_SUCCESS) {
+        job.gpuUs = structureUs;
+        result = runSliced(kPassLinks, header.rays, job);
+      }
+      if (result != VK_SUCCESS) {
+        destroyScene();
+        return result;
+      }
+      m_sceneSeq = job.seq;
+      Logger::info(format_string("[Gi] Scene %u: %u triangles, %u texels, %u rays a texel. Structures %u us, links %u us of GPU time in %u slices, longest %u us.",
+                                 job.seq, header.triangles, header.texels, header.rays, structureUs, job.gpuUs - structureUs, job.slices, job.sliceUsMax));
+      return VK_SUCCESS;
+    }
+
+    // GiSubmitLamps: lamp i is layer i. A lamp whose bytes did not change keeps its solved layer.
+    VkResult Device::setLamps(Job& job) {
+      const size_t count = job.blob.size() / sizeof(bridge_util::GiLamp);
+      if (count == 0 || count > kMaxLamps || job.blob.size() % sizeof(bridge_util::GiLamp) != 0) {
+        job.hresult = D3DERR_INVALIDCALL;
+        return VK_SUCCESS;
+      }
+      std::vector<bridge_util::GiLamp> lamps(count);
+      memcpy(lamps.data(), job.blob.data(), job.blob.size());
+      const bool resized = count != m_lamps.size() || count != m_directValid.size();
+      for (size_t i = 0; i < count && !resized; ++i) {
+        if (memcmp(&lamps[i], &m_lamps[i], sizeof(bridge_util::GiLamp)) != 0) {
+          m_directValid[i] = 0;
+          m_indirectHalf[i] = -1;
+        }
+      }
+      m_lamps = std::move(lamps);
+      return resized && m_sceneSeq != 0 ? allocateLamps() : VK_SUCCESS;
+    }
+
+    uint16_t toHalf(float value) {
+      uint32_t bits;
+      memcpy(&bits, &value, sizeof(bits));
+      const uint32_t sign = (bits >> 16) & 0x8000;
+      const int32_t exponent = int32_t((bits >> 23) & 0xff) - 127 + 15;
+      uint32_t mantissa = bits & 0x7fffff;
+      if (exponent >= 31) {
+        return uint16_t(sign | 0x7bff);  // The largest half, also for infinities and NaNs.
+      }
+      if (exponent <= 0) {
+        if (exponent < -10) {
+          return uint16_t(sign);
+        }
+        mantissa |= 0x800000;
+        const uint32_t shift = uint32_t(14 - exponent);
+        return uint16_t(sign | ((mantissa >> shift) + ((mantissa >> (shift - 1)) & 1)));
+      }
+      const uint32_t half = (uint32_t(exponent) << 10 | (mantissa >> 13)) + ((mantissa >> 12) & 1);
+      return uint16_t(sign | std::min<uint32_t>(half, 0x7bff));
+    }
+
+    // A solve against the scene: the lamp's direct light and bounces when they are not settled yet, then the layer
+    // read back and written to each texel's pixel of the target.
+    VkResult Device::solve(Job& job) {
+      const uint32_t lamp = job.layer & 0xffff;
+      const uint32_t what = job.layer >> 16;
+      if (m_sceneSeq == 0 || job.sceneSeq != m_sceneSeq || lamp >= m_lamps.size() || what > bridge_util::GiLayerSum) {
+        job.hresult = D3DERR_INVALIDCALL;
+        return VK_SUCCESS;
+      }
+      const bridge_util::GiLamp& source = m_lamps[lamp];
+      memcpy(m_push.lampPos, source.position, sizeof(float) * 3);
+      m_push.lampPos[3] = source.radius;
+      memcpy(m_push.lampCol, source.colour, sizeof(float) * 3);
+      const bool scoped = source.boxMin[0] <= source.boxMax[0] && source.boxMin[1] <= source.boxMax[1] && source.boxMin[2] <= source.boxMax[2];
+      for (uint32_t c = 0; c < 3; ++c) {
+        m_push.boxMin[c] = scoped ? source.boxMin[c] : -1e30f;
+        m_push.boxMax[c] = scoped ? source.boxMax[c] : 1e30f;
+      }
+      m_push.lamp = lamp;
+      const VkDeviceSize layer = VkDeviceSize(m_push.texels) * 16;
+      VkResult result = VK_SUCCESS;
+      if (!m_directValid[lamp]) {
+        m_indirectHalf[lamp] = -1;
+        result = runSliced(kPassDirect, 1, job);
+        if (result != VK_SUCCESS) {
+          return result;
+        }
+        m_directValid[lamp] = 1;
+      }
+      if (m_indirectHalf[lamp] < 0 && what != bridge_util::GiLayerDirect) {
+        // The first gather reads half 0 as the previous bounce, which is none.
+        begin();
+        vkCmdFillBuffer(m_commandBuffer, m_sceneBuffers[kIndirect].buffer, lamp * layer, layer, 0);
+        result = end(nullptr);
+        m_push.src = 0;
+        const uint32_t groupsX = (m_push.texels + 63) / 64;
+        for (uint32_t bounce = 0; bounce < m_bounces && result == VK_SUCCESS;) {
+          uint32_t& units = m_sliceUnits[kPassBounce];
+          const uint32_t batch = std::min(units / groupsX, m_bounces - bounce);
+          if (batch < 2) {
+            result = runSliced(kPassBounce, 1, job);
+            m_push.src ^= 1;
+            ++bounce;
+            continue;
+          }
+          // Several whole gathers fit the GPU budget, so they go in one submission: a gather a submission is bound
+          // by the submit and wait, not by its work.
+          if (job.cancelled.load(std::memory_order_acquire)) {
+            return VK_NOT_READY;
+          }
+          m_push.texel0 = 0;
+          m_push.ray0 = 0;
+          begin();
+          vkCmdBindPipeline(m_commandBuffer, VK_PIPELINE_BIND_POINT_COMPUTE, m_solvePipelines[kPassBounce]);
+          vkCmdBindDescriptorSets(m_commandBuffer, VK_PIPELINE_BIND_POINT_COMPUTE, m_solveLayout, 0, 1, &m_solveSet, 0, nullptr);
+          for (uint32_t i = 0; i < batch; ++i) {
+            vkCmdPushConstants(m_commandBuffer, m_solveLayout, VK_SHADER_STAGE_COMPUTE_BIT, 0, sizeof(m_push), &m_push);
+            vkCmdDispatch(m_commandBuffer, groupsX, 1, 1);
+            VkMemoryBarrier barrier { VK_STRUCTURE_TYPE_MEMORY_BARRIER, nullptr, VK_ACCESS_SHADER_WRITE_BIT, VK_ACCESS_SHADER_READ_BIT };
+            vkCmdPipelineBarrier(m_commandBuffer, VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT, VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT, 0, 1, &barrier, 0, nullptr, 0, nullptr);
+            m_push.src ^= 1;
+          }
+          uint32_t us = 0;
+          result = end(&us);
+          bounce += batch;
+          job.gpuUs += us;
+          job.slices += 1;
+          job.sliceUsMax = std::max(job.sliceUsMax, us);
+          const uint64_t wanted = uint64_t(groupsX) * batch * m_sliceUs / std::max<uint32_t>(us, 1);
+          units = uint32_t(std::clamp<uint64_t>(wanted, std::max<uint32_t>(units / 2, 1), std::min<uint64_t>(uint64_t(units) * 2, 1u << 24)));
+          if (m_sliceIdleUs) {
+            std::this_thread::sleep_for(std::chrono::microseconds(m_sliceIdleUs));
+          }
+        }
+        if (result != VK_SUCCESS) {
+          return result;
+        }
+        m_indirectHalf[lamp] = int8_t(m_push.src);
+      }
+
+      result = reserve(layer * 2);
+      if (result != VK_SUCCESS) {
+        return result;
+      }
+      begin();
+      const VkBufferCopy directCopy { lamp * layer, 0, layer };
+      // A direct layer may come before the lamp's bounces: its indirect half is then read but not used.
+      const VkBufferCopy indirectCopy { (VkDeviceSize(std::max<int8_t>(m_indirectHalf[lamp], 0)) * m_push.lamps + lamp) * layer, layer, layer };
+      vkCmdCopyBuffer(m_commandBuffer, m_sceneBuffers[kDirect].buffer, m_buffer, 1, &directCopy);
+      vkCmdCopyBuffer(m_commandBuffer, m_sceneBuffers[kIndirect].buffer, m_buffer, 1, &indirectCopy);
+      VkMemoryBarrier barrier { VK_STRUCTURE_TYPE_MEMORY_BARRIER, nullptr, VK_ACCESS_TRANSFER_WRITE_BIT, VK_ACCESS_HOST_READ_BIT };
+      vkCmdPipelineBarrier(m_commandBuffer, VK_PIPELINE_STAGE_TRANSFER_BIT, VK_PIPELINE_STAGE_HOST_BIT, 0, 1, &barrier, 0, nullptr, 0, nullptr);
+      result = end(nullptr);
+      if (result != VK_SUCCESS) {
+        return result;
+      }
+      const float* const pDirect = static_cast<const float*>(m_pMapped);
+      const float* const pIndirect = pDirect + size_t(m_push.texels) * 4;
+      const size_t pixels = size_t(job.width) * job.height;
+      const bool half = job.format == TexelFormat::Rgba16f;
+      job.texels.assign(pixels * (half ? 8 : 4), 0);
+      for (uint32_t i = 0; i < m_push.texels; ++i) {
+        if (m_pixels[i] >= pixels) {
+          continue;
+        }
+        float value[4];
+        for (uint32_t c = 0; c < 3; ++c) {
+          value[c] = (what != bridge_util::GiLayerIndirect ? pDirect[size_t(i) * 4 + c] : 0.0f) +
+                     (what != bridge_util::GiLayerDirect ? pIndirect[size_t(i) * 4 + c] : 0.0f);
+        }
+        value[3] = what == bridge_util::GiLayerDirect ? pDirect[size_t(i) * 4 + 3] : 1.0f;
+        if (half) {
+          uint16_t* const pTexel = reinterpret_cast<uint16_t*>(job.texels.data()) + size_t(m_pixels[i]) * 4;
+          for (uint32_t c = 0; c < 4; ++c) {
+            pTexel[c] = toHalf(value[c]);
+          }
+        } else {
+          uint32_t byte[4];
+          for (uint32_t c = 0; c < 4; ++c) {
+            byte[c] = uint32_t(std::clamp(value[c], 0.0f, 1.0f) * 255.0f + 0.5f);
+          }
+          reinterpret_cast<uint32_t*>(job.texels.data())[m_pixels[i]] = (byte[3] << 24) | (byte[0] << 16) | (byte[1] << 8) | byte[2];
+        }
+      }
+      return VK_SUCCESS;
+    }
+
+    VkResult Device::run(Job& job) {
+      switch (job.kind) {
+      case JobKind::Scene: return setScene(job);
+      case JobKind::Lamps: return setLamps(job);
+      case JobKind::Solve: return solve(job);
+      default: return runPattern(job);
+      }
+    }
+
+    void workerMain(VkInstance dxvkInstance, VkPhysicalDevice dxvkPhysicalDevice) {
+      GiSharedBlock* const pBlock = bridge_util::giBlock();
+      Device device;
+      uint32_t capBits = 0;
+      int32_t lastError = 0;
+      uint32_t level = device.create(dxvkInstance, dxvkPhysicalDevice, capBits, lastError);
+      pBlock->capBits = capBits;
+      pBlock->lastError = lastError;
+      pBlock->level.store(level, std::memory_order_release);
+      if (level == bridge_util::GiLevelNone) {
+        Logger::err(format_string("[Gi] The worker could not create its Vulkan device (VkResult %d), so the GI server is off.", lastError));
+      }
+      for (;;) {
+        std::shared_ptr<Job> job;
+        {
+          std::unique_lock<std::mutex> lock(s_mutex);
+          s_wake.wait(lock, [] { return !s_jobs.empty(); });
+          job = std::move(s_jobs.front());
+          s_jobs.pop_front();
+        }
+        if (job->cancelled.load(std::memory_order_acquire)) {
+          continue;
+        }
+        HRESULT hresult = E_FAIL;
+        if (level != bridge_util::GiLevelNone) {
+          const VkResult result = device.run(*job);
+          if (result == VK_NOT_READY) {
+            continue;  // Cancelled between slices. A cancelled job is never answered.
+          }
+          if (result == VK_SUCCESS) {
+            hresult = job->hresult;
+          } else {
+            // A lost or failing device turns the server off. The client falls back.
+            pBlock->lastError = result;
+            level = bridge_util::GiLevelNone;
+            pBlock->level.store(level, std::memory_order_release);
+            Logger::err(format_string("[Gi] The worker's pass failed (VkResult %d), so the GI server is off.", int(result)));
+          }
+        }
+        job->hresult = hresult;
+        job->blob = std::vector<uint8_t>();
+        pBlock->gpuUsLast = job->gpuUs;
+        if (job->kind != JobKind::Pattern) {
+          pBlock->sliceUsMax = job->sliceUsMax;
+          pBlock->slicesLast = job->slices;
+        }
+        pBlock->workerHeartbeat.fetch_add(1, std::memory_order_relaxed);
+        job->ready.store(true, std::memory_order_release);
+      }
+    }
+  }
+
+  void startWorker(void* pDxvkInstance, void* pDxvkPhysicalDevice) {
+    // Detached: the worker waits for jobs until the server process exits.
+    std::thread(workerMain, (VkInstance) pDxvkInstance, (VkPhysicalDevice) pDxvkPhysicalDevice).detach();
+  }
+
+  void queueJob(const std::shared_ptr<Job>& job) {
+    {
+      std::lock_guard<std::mutex> lock(s_mutex);
+      s_jobs.push_back(job);
+    }
+    s_wake.notify_one();
+  }
+}
