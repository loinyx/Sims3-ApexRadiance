+ * IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY,
+ * FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT.  IN NO EVENT SHALL
+ * THE AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER
+ * LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING
+ * FROM, OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER
+ * DEALINGS IN THE SOFTWARE.
+ */
+#include "pch.h"
+
+#include <cstring>
+#include <mutex>
+
+#include "d3d9_texture.h"
+#include "util_devicecommand.h"
+#include "util_gi.h"
+
+// GI server exports (client.giServer). A worker in the server computes into a DEFAULT-pool texture the caller names,
+// and the server copies the result into it on its play thread. The caller polls without waiting.
+//
+// RemixBridge_GiOpen(&level) starts the worker on the first call:
+//   S_OK with the level: 0 none, 1 compute, 2 rays. A server without GI support gives none after 2 s.
+//   S_FALSE until the server has answered and the worker has created its device. Call again a frame later.
+//   It never waits, since the open command may only reach the server with the next Present.
+//   E_NOTIMPL when client.giServer is off. D3DERR_DEVICELOST without a server.
+// RemixBridge_GiSolve(texture, layer, sceneTicket, &ticket) queues a pass into the texture:
+//   S_OK with a ticket.
+//   E_NOTIMPL before RemixBridge_GiOpen. D3DERR_WASSTILLDRAWING when all tickets are in flight.
+//   D3DERR_INVALIDCALL for a texture that is not DEFAULT pool.
+// RemixBridge_GiPoll(ticket) returns S_FALSE while pending.
+//   It returns S_OK once a draw sent after the call samples the new contents.
+//   It returns the server's error, D3DERR_INVALIDCALL for an unknown ticket, or D3DERR_DEVICELOST without a server.
+// RemixBridge_GiCancel(ticket) frees a ticket the caller gives up on.
+// RemixBridge_GiReadCounters(out, count) copies the block's counters from its level field on.
+// A finished, failed or cancelled ticket is unknown afterwards.
+
+namespace {
+  using bridge_util::GiSharedBlock;
+
+  std::mutex s_mutex;
+  uint32_t s_pending[GiSharedBlock::kMaxTickets] = {};  // ticket a slot, 0 when free
+  uint32_t s_seq = 0;
+  bool s_openSent = false;
+  bool s_noServer = false;
+  ULONGLONG s_openDeadline = 0;
+
+  bool giEnabled() {
+    static const bool enabled = bridge_util::Config::getOption<bool>("client.giServer", false);
+    return enabled;
+  }
+
+  // The block when the server has answered Bridge_GiOpen, else nullptr.
+  GiSharedBlock* openedBlock() {
+    GiSharedBlock* const pBlock = bridge_util::giBlock();
+    return pBlock != nullptr && pBlock->magic.load(std::memory_order_acquire) == GiSharedBlock::kMagic ? pBlock : nullptr;
+  }
+
+  uint32_t* findTicket(uint32_t ticket) {
+    for (uint32_t& pending : s_pending) {
+      if (pending != 0 && pending == ticket) {
+        return &pending;
+      }
+    }
+    return nullptr;
+  }
+}
+
+// Exported by name through d3d9_lss.def.
+extern "C" {
+
+  HRESULT __stdcall RemixBridge_GiOpen(uint32_t* pLevel) {
+    if (pLevel == nullptr) {
+      return D3DERR_INVALIDCALL;
+    }
+    if (!giEnabled() || bridge_util::giBlock() == nullptr) {
+      return E_NOTIMPL;
+    }
+    if (!gbBridgeRunning) {
+      return D3DERR_DEVICELOST;
+    }
+    std::lock_guard<std::mutex> lock(s_mutex);
+    if (!s_openSent) {
+      s_openSent = true;
+      s_openDeadline = GetTickCount64() + 2000;
+      ClientMessage { Commands::Bridge_GiOpen, 0, Commands::FlagBits::AsyncResult };
+    }
+
+    GiSharedBlock* const pBlock = openedBlock();
+    if (pBlock == nullptr && !s_noServer && GetTickCount64() >= s_openDeadline) {
+      s_noServer = true;
+      bridge_util::Logger::info("[Gi] The server did not answer the GI open, so the GI level is none.");
+    }
+    if (pBlock == nullptr) {
+      *pLevel = bridge_util::GiLevelNone;
+      return s_noServer ? S_OK : S_FALSE;
+    }
+    const uint32_t level = pBlock->level.load(std::memory_order_acquire);
+    if (level == bridge_util::GiLevelStarting) {
+      return S_FALSE;
+    }
+    *pLevel = level;
+    return S_OK;
+  }
+
+  HRESULT __stdcall RemixBridge_GiSolve(IDirect3DTexture9* pTexture, uint32_t layer, uint32_t sceneTicket, uint32_t* pTicket) {
+    if (pTexture == nullptr || pTicket == nullptr) {
+      return D3DERR_INVALIDCALL;
+    }
+    if (!giEnabled() || openedBlock() == nullptr) {
+      return E_NOTIMPL;
+    }
+    if (!gbBridgeRunning) {
+      return D3DERR_DEVICELOST;
+    }
+    D3DSURFACE_DESC desc;
+    if (FAILED(pTexture->GetLevelDesc(0, &desc)) || desc.Pool != D3DPOOL_DEFAULT) {
+      return D3DERR_INVALIDCALL;
+    }
+    const auto pLssTexture = bridge_cast<Direct3DTexture9_LSS*>(pTexture);
+
+    std::lock_guard<std::mutex> lock(s_mutex);
+    uint32_t slot = GiSharedBlock::kMaxTickets;
+    for (uint32_t i = 0; i < GiSharedBlock::kMaxTickets; ++i) {
+      if (s_pending[i] == 0) {
+        slot = i;
+        break;
+      }
+    }
+    if (slot == GiSharedBlock::kMaxTickets) {
+      return D3DERR_WASSTILLDRAWING;
+    }
+
+    // Tickets are never 0, because 0 marks a free slot.
+    if (++s_seq == 0) {
+      ++s_seq;
+    }
+    s_pending[slot] = s_seq;
+    {
+      ClientMessage c(Commands::Bridge_GiSolve, pLssTexture->getId(), Commands::FlagBits::AsyncResult);
+      c.send_data(layer);
+      c.send_data(sceneTicket);
+      c.send_data(slot);
+      c.send_data(s_seq);
+    }
+    *pTicket = s_seq;
+    return S_OK;
+  }
+
+  HRESULT __stdcall RemixBridge_GiPoll(uint32_t ticket) {
+    std::lock_guard<std::mutex> lock(s_mutex);
+    uint32_t* const pPending = findTicket(ticket);
+    GiSharedBlock* const pBlock = openedBlock();
+    if (pPending == nullptr || pBlock == nullptr) {
+      return D3DERR_INVALIDCALL;
+    }
+    const bridge_util::GiAnswerSlot& slot = pBlock->answers[pPending - s_pending];
+    if (slot.answeredSeq.load(std::memory_order_acquire) != ticket) {
+      if (gbBridgeRunning) {
+        return S_FALSE;
+      }
+      *pPending = 0;
+      return D3DERR_DEVICELOST;
+    }
+    *pPending = 0;
+    return (HRESULT) slot.hresult;
+  }
+
+  HRESULT __stdcall RemixBridge_GiCancel(uint32_t ticket) {
+    std::lock_guard<std::mutex> lock(s_mutex);
+    uint32_t* const pPending = findTicket(ticket);
+    if (pPending == nullptr) {
+      return D3DERR_INVALIDCALL;
+    }
+    *pPending = 0;
+    ClientMessage { Commands::Bridge_GiCancel, ticket, Commands::FlagBits::AsyncResult };
+    return S_OK;
+  }
+
+  HRESULT __stdcall RemixBridge_GiReadCounters(uint32_t* pCounters, uint32_t count) {
+    GiSharedBlock* const pBlock = openedBlock();
+    if (pCounters == nullptr) {
+      return D3DERR_INVALIDCALL;
+    }
+    if (pBlock == nullptr) {
+      return E_NOTIMPL;
+    }
+    const uint32_t* const pWords = reinterpret_cast<const uint32_t*>(&pBlock->level);
+    for (uint32_t i = 0; i < count && i < GiSharedBlock::kCounterWords; ++i) {
+      pCounters[i] = pWords[i];
+    }
+    return S_OK;
+  }
+}
