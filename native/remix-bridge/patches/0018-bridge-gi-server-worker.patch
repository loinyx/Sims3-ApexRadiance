diff --git a/bridge/src/util/util_gi.h b/bridge/src/util/util_gi.h
new file mode 100644
index 0000000000000000000000000000000000000000..d8a80a71f57adbd1428c427f79ddb8e8f91663c4
--- /dev/null
+++ b/bridge/src/util/util_gi.h
@@ -0,0 +1,161 @@
+#pragma once
+
+#include <atomic>
+#include <cstddef>
+#include <cstdint>
+#include <memory>
+#include <mutex>
+
+#include "util_sharedmemory.h"
+
+// Shared memory of the GI server exports (client/d3d9_gi.cpp, server/gi_server.h). Modelled on
+// QuerySharedBlock and ReadbackSharedBlock: the server writes a slot's fields, then publishes answeredSeq
+// with release; the client reads them after an acquire load sees its ticket. All fields are 32-bit, so the
+// layout is the same in the 32-bit client and the 64-bit server.
+
+namespace bridge_util {
+
+  enum GiLevel : uint32_t {
+    GiLevelNone = 0,
+    GiLevelCompute = 1,
+    GiLevelRays = 2,
+    GiLevelStarting = 0xffffffffu,  // the worker is still creating its device
+  };
+
+  enum GiCapBits : uint32_t {
+    GiCapRayQuery = 1u << 0,
+    GiCapAccelerationStructure = 1u << 1,
+    GiCapMatchedDxvkDevice = 1u << 2,  // the worker's GPU is the one DXVK renders on (deviceUUID match)
+  };
+
+  enum GiAnswerKind : uint32_t {
+    GiAnswerCopied = 0,
+    GiAnswerSuperseded = 1,  // a later solve for the same target and layer replaced this one; nothing copied
+  };
+
+  struct GiAnswerSlot {
+    std::atomic<uint32_t> answeredSeq;
+    int32_t hresult;
+    uint32_t kind;      // GiAnswerKind
+    uint32_t size;      // bytes copied into the target
+    uint32_t gpuUs;     // worker: GPU time of the job, microseconds
+    uint32_t uploadUs;  // play thread: staging copy and UpdateSurface, microseconds
+    uint32_t reserved[2];
+  };
+  static_assert(sizeof(GiAnswerSlot) == 32, "GiAnswerSlot must have the same layout in both processes");
+
+  // RemixBridge_GiSubmit kinds. A blob larger than a submit slot goes in parts: every part but the last carries
+  // GiSubmitMore and gets no ticket; the last part's ticket answers for the whole blob.
+  enum GiSubmitKind : uint32_t {
+    GiSubmitScene = 1,       // GiSceneHeader, triangles, patches, patch map, texels
+    GiSubmitLamps = 2,       // GiLamp[]; lamp i is layer i. Only lamps whose bytes changed are solved again
+    GiSubmitKindMask = 0xff,
+    GiSubmitMore = 0x100,
+  };
+
+  // RemixBridge_GiSolve's layer for a solve against a scene: the lamp index in the low 16 bits, GiLayerWhat above.
+  enum GiLayerWhat : uint32_t {
+    GiLayerIndirect = 0,  // rgb: the settled bounce light, alpha 1
+    GiLayerDirect = 1,    // rgb: direct light, alpha: the share of the lamp's ball the texel sees
+    GiLayerSum = 2,       // rgb: direct + indirect, alpha 1
+  };
+
+  // The scene blob. Light is colour x cos / distance^2 x the visible share of the lamp's ball (the caller folds its own
+  // law into the colour). A hit triangle names its texel through a patch: a planar grid over the surface, one for each
+  // side, so the index holds for any story height, split level or diagonal wall.
+  struct GiSceneHeader {
+    static constexpr uint32_t kMagic = 0x43534947;  // "GISC"
+    uint32_t magic;
+    uint32_t version;     // 1
+    uint32_t triangles;
+    uint32_t patches;
+    uint32_t mapEntries;
+    uint32_t texels;
+    uint32_t rays;        // gather rays a texel (the links), 1 to 1024
+    uint32_t shadowRays;  // points on the lamp's ball, 1 to 64
+    uint32_t bounces;     // gathers a lamp, a fixed count, 0 to 64
+    uint32_t reserved[3];
+  };
+  struct GiSceneTriangle {
+    float v[3][3];
+    int32_t patchFront;  // the patch a ray hits on the side cross(v1 - v0, v2 - v0) points to; -1: no texel (blocks, returns no light)
+    int32_t patchBack;
+  };
+  // A patch must cover every triangle that names it: a hit outside the patch reads the nearest cell.
+  struct GiScenePatch {
+    float origin[3];
+    float u[3];  // cell = floor(dot(P - origin, u)), floor(dot(P - origin, v)), clamped to the patch
+    float v[3];
+    uint32_t nu;
+    uint32_t nv;
+    uint32_t mapOffset;  // map[mapOffset + cellV * nu + cellU]: the texel, or -1
+  };
+  struct GiSceneTexel {
+    float position[3];  // off its surface, on the lit side
+    float normal[3];
+    float albedo[3];    // reflectance
+    uint32_t pixel;     // y * width + x in the solve's target; texels outside the target are not written
+  };
+  struct GiLamp {
+    float position[3];
+    float radius;
+    float colour[3];
+    uint32_t reserved;
+    // The solve's region scope: texels outside the box get no light and cost no gather. An empty box (min > max) is the whole scene.
+    float boxMin[3];
+    float boxMax[3];
+  };
+  static_assert(sizeof(GiSceneHeader) == 48 && sizeof(GiSceneTriangle) == 44 && sizeof(GiScenePatch) == 48 &&
+                sizeof(GiSceneTexel) == 40 && sizeof(GiLamp) == 56, "The GI scene blob must have the same layout in both processes");
+
+  struct GiSubmitSlot {
+    static constexpr uint32_t kBytes = 448 * 1024;
+    std::atomic<uint32_t> consumedSeq;  // the play thread stores the part's sequence once it has copied the data out
+    uint32_t reserved[3];
+    uint8_t data[kBytes];
+  };
+
+  struct GiSharedBlock {
+    static constexpr uint32_t kMagic = 0x31304947;  // "GI01"
+    static constexpr uint32_t kLayoutVersion = 2;
+    static constexpr uint32_t kMaxTickets = 64;
+    static constexpr uint32_t kSubmitSlots = 2;
+    static constexpr uint32_t kCounterWords = 22;   // level .. objectCounters, read by RemixBridge_GiReadCounters
+
+    std::atomic<uint32_t> magic;        // 0: written last by the play thread on the first Bridge_GiOpen
+    uint32_t layoutVersion;             // 4
+    std::atomic<uint32_t> level;        // 8: GiLevel
+    uint32_t capBits;                   // 12: GiCapBits
+    std::atomic<uint32_t> heartbeat;    // 16: play thread, every poll pass
+    std::atomic<uint32_t> workerHeartbeat;  // 20: worker, every job
+    int32_t lastError;                  // 24: worker's last VkResult or HRESULT
+    uint32_t jobsQueued;                // 28
+    uint32_t jobsDone;                  // 32
+    uint32_t gpuUsLast;                 // 36
+    uint32_t uploadUsLast;              // 40
+    uint32_t uploadUsMax;               // 44
+    uint32_t uploadBytesMax;            // 48: largest single copy
+    uint32_t behaviorFlags;             // 52: the server device's D3DCREATE_* flags
+    uint32_t sliceUsMax;                // 56: longest GPU slice of the last solve, microseconds
+    uint32_t slicesLast;                // 60: GPU slices of the last solve
+    uint32_t objectCounters[8];         // 64: counter words 14 to 21, kept for the object export (objects, models resolved, models missing, index ready, four spare)
+    GiAnswerSlot answers[kMaxTickets];  // 96
+    GiSubmitSlot submits[kSubmitSlots]; // 2144
+    // R-06 adds the point-query slot here (layoutVersion 3).
+  };
+  static_assert(offsetof(GiSharedBlock, level) == 8 && offsetof(GiSharedBlock, answers) == 96 && offsetof(GiSharedBlock, submits) == 2144,
+                "GiSharedBlock must have the same layout in both processes");
+
+  // Maps the block on first use; nullptr when the mapping failed.
+  inline GiSharedBlock* giBlock() {
+    static std::once_flag once;
+    static std::unique_ptr<SharedMemory> s_memory;
+    std::call_once(once, [] {
+      s_memory = std::make_unique<SharedMemory>("Gi", sizeof(GiSharedBlock));
+      if (s_memory->data() == nullptr) {
+        Logger::err("[Gi] The GI block could not be mapped, so the GI server is off.");
+      }
+    });
+    return static_cast<GiSharedBlock*>(s_memory->data());
+  }
+}
