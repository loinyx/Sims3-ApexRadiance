+ * IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY,
+ * FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT.  IN NO EVENT SHALL
+ * THE AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER
+ * LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING
+ * FROM, OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER
+ * DEALINGS IN THE SOFTWARE.
+ */
+#pragma once
+
+#include <atomic>
+#include <cstdint>
+#include <memory>
+#include <vector>
+
+// The GI worker: a thread with its own Vulkan device on the GPU DXVK renders on. It never calls Direct3D 9.
+// The play thread queues jobs and applies the finished ones (gi_server.h).
+namespace gi {
+  enum class TexelFormat : uint32_t {
+    Rgba16f = 0,  // D3DFMT_A16B16G16R16F
+    Bgra8 = 1,    // D3DFMT_A8R8G8B8
+  };
+
+  enum class JobKind : uint32_t {
+    Pattern,  // a solve without a scene: the prototype's pattern
+    Solve,    // one lamp's layer of the scene into the target
+    Scene,    // GiSubmitScene: blob holds the scene
+    Lamps,    // GiSubmitLamps: blob holds the lamp table
+  };
+
+  struct Job {
+    JobKind kind = JobKind::Pattern;
+    uint32_t sceneSeq = 0;      // Solve: the ticket of the scene the caller solved against
+    std::vector<uint8_t> blob;  // Scene, Lamps
+    uint32_t rowsDone = 0;      // play thread: rows of the result already copied into the target
+    uint32_t uploadUs = 0;      // play thread: time of those copies
+    uint32_t targetId = 0;
+    uint32_t layer = 0;
+    uint32_t seq = 0;
+    uint32_t slot = 0;
+    uint32_t width = 0;
+    uint32_t height = 0;
+    TexelFormat format = TexelFormat::Rgba16f;
+    std::atomic<bool> cancelled { false };
+    std::atomic<bool> ready { false };  // set last by the worker, with release
+
+    // Written by the worker before ready.
+    int32_t hresult = 0;
+    uint32_t gpuUs = 0;
+    uint32_t slices = 0;
+    uint32_t sliceUsMax = 0;
+    std::vector<uint8_t> texels;  // tightly packed rows
+  };
+
+  // Starts the worker once. The handles are DXVK's VkInstance and VkPhysicalDevice, or nullptr when the server's
+  // renderer is not DXVK. The worker writes the level and capabilities into the GI block when its device is ready.
+  void startWorker(void* pDxvkInstance, void* pDxvkPhysicalDevice);
+
+  void queueJob(const std::shared_ptr<Job>& job);
+}
