+    class Device {
+    public:
+      // Creates the instance and device. Returns the level, or GiLevelNone with lastError set.
+      uint32_t create(VkInstance dxvkInstance, VkPhysicalDevice dxvkPhysicalDevice, uint32_t& capBits, int32_t& lastError);
+      VkResult run(Job& job);
+
+    private:
+      // The buffers of gi_solve.comp, in the order of its bindings 1 to 9.
+      enum : uint32_t { kTris, kCellStart, kCellTris, kTexels, kPatches, kPatchMap, kLinks, kDirect, kIndirect, kSolveBuffers };
+      enum : uint32_t { kPassLinks, kPassDirect, kPassBounce, kPassCount };
+      static constexpr uint64_t kMaxLinks = 128ull << 20;  // texels x rays, 512 MB of device memory
+      static constexpr size_t kMaxLamps = 256;
+
+      struct Buffer {
+        VkBuffer buffer = VK_NULL_HANDLE;
+        VkDeviceMemory memory = VK_NULL_HANDLE;
+        VkDeviceSize size = 0;
+      };
+      struct Push {  // gi_solve.comp PC
+        float lampPos[4];
+        float lampCol[4];
+        float boxMin[4];
+        float boxMax[4];
+        uint32_t texels, rays, lamp, src;
+        uint32_t shadowRays, lamps, texel0, ray0;
+        int32_t gx0, gz0, gw, gh;
+      };
+
+      VkResult createPipeline();
+      VkResult createSolvePipelines();
+      VkResult reserve(VkDeviceSize size);
+      void begin();
+      VkResult end(uint32_t* pGpuUs);
+      VkResult makeBuffer(VkDeviceSize size, VkBufferUsageFlags usage, Buffer& buffer);
+      VkResult makeBuffer(const void* pData, size_t size, VkBufferUsageFlags usage, Buffer& buffer);
+      void destroy(Buffer& buffer);
+      void destroyScene();
+      VkDeviceAddress address(const Buffer& buffer);
+      VkResult buildStructures(uint32_t triangles, uint32_t& gpuUs);
+      bool buildGrid(const bridge_util::GiSceneTriangle* pTriangles, uint32_t triangles, std::vector<uint32_t>& cellStart, std::vector<uint32_t>& cellTris);
+      VkResult allocateLamps();
+      VkResult runSliced(uint32_t pass, uint32_t rowsY, Job& job);
+      VkResult runPattern(Job& job);
+      VkResult setScene(Job& job);
+      VkResult setLamps(Job& job);
+      VkResult solve(Job& job);
+
+      VkInstance m_instance = VK_NULL_HANDLE;
+      VkPhysicalDevice m_physicalDevice = VK_NULL_HANDLE;
+      VkDevice m_device = VK_NULL_HANDLE;
+      VkQueue m_queue = VK_NULL_HANDLE;
+      uint32_t m_queueFamily = 0;
+      VkDescriptorSetLayout m_setLayout = VK_NULL_HANDLE;
+      VkPipelineLayout m_pipelineLayout = VK_NULL_HANDLE;
+      VkPipeline m_pipeline = VK_NULL_HANDLE;
+      VkDescriptorPool m_descriptorPool = VK_NULL_HANDLE;
+      VkDescriptorSet m_set = VK_NULL_HANDLE;
+      VkCommandPool m_commandPool = VK_NULL_HANDLE;
+      VkCommandBuffer m_commandBuffer = VK_NULL_HANDLE;
+      VkFence m_fence = VK_NULL_HANDLE;
+      VkBuffer m_buffer = VK_NULL_HANDLE;
+      VkDeviceMemory m_memory = VK_NULL_HANDLE;
+      VkDeviceSize m_bufferSize = 0;
+      void* m_pMapped = nullptr;
+
+      bool m_rays = false;
+      uint32_t m_timestampBits = 0;
+      float m_timestampPeriod = 1.0f;
+      uint32_t m_sliceUs = 2000;
+      uint32_t m_sliceIdleUs = 0;
+      uint32_t m_sliceUnits[kPassCount] = { 16, 16, 16 };  // columns x rays a slice, adapted to the GPU budget
+      VkQueryPool m_queryPool = VK_NULL_HANDLE;
+      VkDescriptorSetLayout m_solveSetLayout = VK_NULL_HANDLE;
+      VkPipelineLayout m_solveLayout = VK_NULL_HANDLE;
+      VkPipeline m_solvePipelines[kPassCount] = {};
