--- a/bridge/bridge.conf
+++ b/bridge/bridge.conf
@@ -139,4 +139,28 @@
 # client.asyncReadback = False
 
+#
+# Lets callers of the client exports RemixBridge_GiOpen, RemixBridge_GiSolve and RemixBridge_GiPoll
+# have a worker in the server, on its own Vulkan device, compute into a DEFAULT-pool texture they name.
+# The server copies results in on its command thread. Its GI block takes 4 KB of the client's address
+# space once RemixBridge_GiOpen maps it.
+#
+# Supported values: True, False
+
+# client.giServer = False
+
+#
+# The server answers RemixBridge_GiOpen only while this is True. With False the client reports
+# the GI level none, as with a server without GI support.
+#
+# Supported values: True, False
+
+# server.giServer = True
+
+#
+# Bytes of GI results the server copies into textures in one pass, at Present and every 64 commands.
+# A result larger than the budget is copied alone in its pass.
+
+# server.giUploadBudgetKB = 1024
+
 
 #
