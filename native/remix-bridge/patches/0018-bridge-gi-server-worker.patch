diff --git a/bridge/src/server/gi_pattern.comp b/bridge/src/server/gi_pattern.comp
new file mode 100644
index 0000000000000000000000000000000000000000..4aaed1e2749350039baec30e387489b7460b2929
--- /dev/null
+++ b/bridge/src/server/gi_pattern.comp
@@ -0,0 +1,41 @@
+#version 450
+// The GI worker's prototype pass: fills a target's texels with a pattern of its ticket and layer, so a
+// self-test can recognise a stale, shifted or swapped result. R-04 replaces it with the texel solve.
+// Every channel is k / 256 with k < 256, which float16 and 8-bit unorm both hold exactly.
+
+layout(local_size_x = 8, local_size_y = 8) in;
+
+layout(std430, binding = 0) writeonly buffer Texels {
+  uint words[];
+};
+
+layout(push_constant) uniform Pass {
+  uint width;
+  uint height;
+  uint layer;
+  uint seq;
+  uint format;  // 0: A16B16G16R16F, two words a texel. 1: A8R8G8B8, one word a texel.
+} pass;
+
+void main()
+{
+  const uvec2 texel = gl_GlobalInvocationID.xy;
+  if (texel.x >= pass.width || texel.y >= pass.height)
+  {
+    return;
+  }
+  const uint r = (texel.x + pass.seq) & 255u;
+  const uint g = (texel.y + pass.layer * 37u) & 255u;
+  const uint b = (texel.x ^ texel.y) & 255u;
+  const uint a = 255u;
+  const uint index = texel.y * pass.width + texel.x;
+  if (pass.format == 0u)
+  {
+    words[2u * index] = packHalf2x16(vec2(r, g) / 256.0);
+    words[2u * index + 1u] = packHalf2x16(vec2(b, a) / 256.0);
+  }
+  else
+  {
+    words[index] = (a << 24) | (r << 16) | (g << 8) | b;
+  }
+}
diff --git a/bridge/src/server/gi_server.h b/bridge/src/server/gi_server.h
new file mode 100644
index 0000000000000000000000000000000000000000..ca962e3c237e589c0b8773d3f72ca16cb741969e
--- /dev/null
+++ b/bridge/src/server/gi_server.h
@@ -0,0 +1,364 @@
+/*
+ * Permission is hereby granted, free of charge, to any person obtaining a
+ * copy of this software and associated documentation files (the "Software"),
+ * to deal in the Software without restriction, including without limitation
+ * the rights to use, copy, modify, merge, publish, distribute, sublicense,
+ * and/or sell copies of the Software, and to permit persons to whom the
+ * Software is furnished to do so, subject to the following conditions:
+ *
+ * The above copyright notice and this permission notice shall be included in
+ * all copies or substantial portions of the Software.
+ *
+ * THE SOFTWARE IS PROVIDED "AS IS", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR
+ * IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY,
+ * FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT.  IN NO EVENT SHALL
+ * THE AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER
+ * LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING
+ * FROM, OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER
+ * DEALINGS IN THE SOFTWARE.
+ */
+#pragma once
+
+#include <algorithm>
+#include <cstring>
+#include <deque>
+#include <iterator>
+#include <memory>
+#include <unordered_map>
+#include <vector>
+
+#include <d3d9.h>
+
+#include "gi_worker.h"
+#include "util_common.h"
+#include "util_gi.h"
+#include "config/config.h"
+#include "log/log.h"
+
+// DXVK's interop interface (DXVK src/d3d9/d3d9_interfaces.h). Only its first method is called here.
+struct __declspec(uuid("2eaa4b89-0107-4bdb-87f7-0f541c493ce0")) ID3D9VkInteropDevice : public IUnknown {
+  virtual void STDMETHODCALLTYPE GetVulkanHandles(void** pInstance, void** pPhysicalDevice, void** pDevice) = 0;
+};
+
+// Play-thread side of the GI server exports (client/d3d9_gi.cpp). Every Direct3D 9 call here runs on the play thread.
+// The worker (gi_worker.cpp) computes into its own memory, and finished results are copied into the target with
+// UpdateSurface at Present and every 64 commands, at most server.giUploadBudgetKB a pass: a larger result goes in
+// bands of rows over several passes.
+namespace gi_server {
+  using bridge_util::GiSharedBlock;
+  using ResourceMap = std::unordered_map<uint32_t, IDirect3DResource9*>;
+
+  struct Staging {
+    UINT width;
+    UINT height;
+    D3DFORMAT format;
+    IDirect3DTexture9* pTexture;
+  };
+
+  inline std::deque<std::shared_ptr<gi::Job>> g_jobs;  // in request order
+  inline std::vector<Staging> g_staging;
+  inline std::vector<uint8_t> g_parts[bridge_util::GiSubmitLamps + 1];  // a blob's parts so far, by submit kind
+  inline bool g_partsBad[bridge_util::GiSubmitLamps + 1] = {};         // a part of the blob was refused
+  inline bool g_started = false;
+  inline uint32_t g_commandsSincePoll = 0;
+
+  inline bool serverEnabled() {
+    static const bool enabled = bridge_util::Config::getOption<bool>("server.giServer", true);
+    return enabled;
+  }
+
+  inline uint32_t uploadBudgetBytes() {
+    static const uint32_t budget = bridge_util::Config::getOption<uint32_t>("server.giUploadBudgetKB", 1024) * 1024;
+    return budget;
+  }
+
+  inline void answer(const gi::Job& job, HRESULT hresult, uint32_t kind = bridge_util::GiAnswerCopied,
+                     uint32_t size = 0, uint32_t uploadUs = 0) {
+    GiSharedBlock* const pBlock = bridge_util::giBlock();
+    bridge_util::GiAnswerSlot& slot = pBlock->answers[job.slot];
+    slot.hresult = (int32_t) hresult;
+    slot.kind = kind;
+    slot.size = size;
+    slot.gpuUs = job.gpuUs;
+    slot.uploadUs = uploadUs;
+    slot.answeredSeq.store(job.seq, std::memory_order_release);
+    ++pBlock->jobsDone;
+  }
+
+  // Returns the texture under a client id, or nullptr when the id names none (destroyed, unlinked or not a texture).
+  inline IDirect3DTexture9* findTexture(const ResourceMap& resources, uint32_t id) {
+    const auto it = resources.find(id);
+    if (it == resources.end() || it->second == nullptr || it->second->GetType() != D3DRTYPE_TEXTURE) {
+      return nullptr;
+    }
+    return static_cast<IDirect3DTexture9*>(it->second);
+  }
+
+  inline HRESULT describe(IDirect3DTexture9* pTexture, gi::Job& job) {
+    D3DSURFACE_DESC desc;
+    if (pTexture == nullptr || FAILED(pTexture->GetLevelDesc(0, &desc)) || desc.Pool != D3DPOOL_DEFAULT) {
+      return D3DERR_INVALIDCALL;
+    }
+    if (desc.Format == D3DFMT_A16B16G16R16F) {
+      job.format = gi::TexelFormat::Rgba16f;
+    } else if (desc.Format == D3DFMT_A8R8G8B8) {
+      job.format = gi::TexelFormat::Bgra8;
+    } else {
+      return D3DERR_INVALIDCALL;
+    }
+    job.width = desc.Width;
+    job.height = desc.Height;
+    return S_OK;
+  }
+
+  // A SYSTEMMEM texture a size and format, kept for the next copy. The eight most recently created are kept.
+  inline IDirect3DTexture9* staging(IDirect3DDevice9* pDevice, UINT width, UINT height, D3DFORMAT format) {
+    for (const Staging& entry : g_staging) {
+      if (entry.width == width && entry.height == height && entry.format == format) {
+        return entry.pTexture;
+      }
+    }
+    if (g_staging.size() >= 8) {
+      g_staging.front().pTexture->Release();
+      g_staging.erase(g_staging.begin());
+    }
+    IDirect3DTexture9* pTexture = nullptr;
+    if (FAILED(pDevice->CreateTexture(width, height, 1, 0, format, D3DPOOL_SYSTEMMEM, &pTexture, nullptr))) {
+      return nullptr;
+    }
+    g_staging.push_back(Staging { width, height, format, pTexture });
+    return pTexture;
+  }
+
+  // Copies rows of a finished job into its target. The target is looked up again, so a destroyed or reused id gets no stale result.
+  inline HRESULT upload(const ResourceMap& resources, const gi::Job& job, uint32_t firstRow, uint32_t rows) {
+    IDirect3DTexture9* const pTarget = findTexture(resources, job.targetId);
+    gi::Job now;
+    if (FAILED(describe(pTarget, now)) || now.width != job.width || now.height != job.height || now.format != job.format) {
+      return D3DERR_INVALIDCALL;
+    }
+    const D3DFORMAT format = job.format == gi::TexelFormat::Rgba16f ? D3DFMT_A16B16G16R16F : D3DFMT_A8R8G8B8;
+    const size_t rowSize = size_t(job.width) * (job.format == gi::TexelFormat::Rgba16f ? 8 : 4);
+    IDirect3DDevice9* pDevice = nullptr;
+    if (FAILED(pTarget->GetDevice(&pDevice))) {
+      return D3DERR_INVALIDCALL;
+    }
+    HRESULT hresult = E_OUTOFMEMORY;
+    IDirect3DTexture9* const pStaging = staging(pDevice, job.width, job.height, format);
+    D3DLOCKED_RECT lockedRect;
+    const RECT band { 0, LONG(firstRow), LONG(job.width), LONG(firstRow + rows) };
+    const POINT corner { 0, LONG(firstRow) };
+    if (pStaging != nullptr && SUCCEEDED(hresult = pStaging->LockRect(0, &lockedRect, &band, 0))) {
+      for (uint32_t y = 0; y < rows; ++y) {
+        memcpy((uint8_t*) lockedRect.pBits + size_t(y) * lockedRect.Pitch, job.texels.data() + (firstRow + y) * rowSize, rowSize);
+      }
+      pStaging->UnlockRect(0);
+      IDirect3DSurface9* pSource = nullptr;
+      IDirect3DSurface9* pDest = nullptr;
+      pStaging->GetSurfaceLevel(0, &pSource);
+      pTarget->GetSurfaceLevel(0, &pDest);
+      hresult = pDevice->UpdateSurface(pSource, &band, pDest, &corner);
+      pSource->Release();
+      pDest->Release();
+    }
+    pDevice->Release();
+    return hresult;
+  }
+
+  // Bridge_GiOpen: starts the worker once, with DXVK's GPU when the server renders through DXVK.
+  inline void open(const std::unordered_map<uint32_t, IDirect3DDevice9*>& devices) {
+    GiSharedBlock* const pBlock = bridge_util::giBlock();
+    if (g_started || !serverEnabled() || pBlock == nullptr) {
+      return;
+    }
+    g_started = true;
+    void* pInstance = nullptr;
+    void* pPhysicalDevice = nullptr;
+    void* pVkDevice = nullptr;
+    if (!devices.empty()) {
+      IDirect3DDevice9* const pDevice = devices.begin()->second;
+      D3DDEVICE_CREATION_PARAMETERS parameters;
+      if (SUCCEEDED(pDevice->GetCreationParameters(&parameters))) {
+        pBlock->behaviorFlags = parameters.BehaviorFlags;
+      }
+      ID3D9VkInteropDevice* pInterop = nullptr;
+      if (SUCCEEDED(pDevice->QueryInterface(__uuidof(ID3D9VkInteropDevice), (void**) &pInterop))) {
+        pInterop->GetVulkanHandles(&pInstance, &pPhysicalDevice, &pVkDevice);
+        pInterop->Release();
+      }
+    }
+    bridge_util::Logger::info(bridge_util::format_string(
+      "[Gi] Starting the GI worker. Device BehaviorFlags 0x%08x (%s), %s.", pBlock->behaviorFlags,
+      (pBlock->behaviorFlags & D3DCREATE_MULTITHREADED) ? "multithreaded" : "not multithreaded",
+      pInstance != nullptr ? "DXVK interop found" : "no DXVK interop"));
+    pBlock->layoutVersion = GiSharedBlock::kLayoutVersion;
+    pBlock->level.store(bridge_util::GiLevelStarting, std::memory_order_relaxed);
+    pBlock->magic.store(GiSharedBlock::kMagic, std::memory_order_release);
+    gi::startWorker(pInstance, pPhysicalDevice);
+  }
+
+  // Bridge_GiSubmit: copies a part out of its submit slot, which the client may then reuse.
+  // The last part of a blob hands the whole blob to the worker under its ticket.
+  inline void submit(uint32_t submitSlot, uint32_t kind, uint32_t size, uint32_t ticketSlot, uint32_t seq) {
+    GiSharedBlock* const pBlock = bridge_util::giBlock();
+    if (!g_started || pBlock == nullptr || submitSlot >= GiSharedBlock::kSubmitSlots) {
+      return;
+    }
+    const uint32_t what = kind & bridge_util::GiSubmitKindMask;
+    const bool known = what == bridge_util::GiSubmitScene || what == bridge_util::GiSubmitLamps;
+    if (known) {
+      std::vector<uint8_t>& parts = g_parts[what];
+      if (size <= bridge_util::GiSubmitSlot::kBytes && parts.size() + size <= (256u << 20)) {
+        const uint8_t* const pData = pBlock->submits[submitSlot].data;
+        parts.insert(parts.end(), pData, pData + size);
+      } else {
+        g_partsBad[what] = true;
+      }
+    }
+    pBlock->submits[submitSlot].consumedSeq.store(seq, std::memory_order_release);
+    if ((kind & bridge_util::GiSubmitMore) || ticketSlot >= GiSharedBlock::kMaxTickets) {
+      return;
+    }
+    auto job = std::make_shared<gi::Job>();
+    job->kind = what == bridge_util::GiSubmitScene ? gi::JobKind::Scene : gi::JobKind::Lamps;
+    job->slot = ticketSlot;
+    job->seq = seq;
+    bool bad = !known;
+    if (known) {
+      job->blob = std::move(g_parts[what]);
+      g_parts[what].clear();
+      bad = g_partsBad[what];
+      g_partsBad[what] = false;
+    }
+    if (bad || pBlock->level.load(std::memory_order_acquire) == bridge_util::GiLevelNone) {
+      answer(*job, bad ? D3DERR_INVALIDCALL : E_FAIL);
+      return;
+    }
+    ++pBlock->jobsQueued;
+    g_jobs.push_back(job);
+    gi::queueJob(job);
+  }
+
+  // Bridge_GiSolve: queues a pass into the texture under targetId. With a scene ticket it is one lamp's layer of
+  // that scene, without one the prototype's pattern.
+  inline void solve(const ResourceMap& resources, uint32_t targetId, uint32_t layer, uint32_t sceneSeq, uint32_t slot, uint32_t seq) {
+    GiSharedBlock* const pBlock = bridge_util::giBlock();
+    if (!g_started || pBlock == nullptr || slot >= GiSharedBlock::kMaxTickets) {
+      return;
+    }
+    auto job = std::make_shared<gi::Job>();
+    job->kind = sceneSeq != 0 ? gi::JobKind::Solve : gi::JobKind::Pattern;
+    job->sceneSeq = sceneSeq;
+    job->targetId = targetId;
+    job->layer = layer;
+    job->slot = slot;
+    job->seq = seq;
+    const HRESULT hresult = describe(findTexture(resources, targetId), *job);
+    if (FAILED(hresult)) {
+      answer(*job, hresult);
+      return;
+    }
+    if (pBlock->level.load(std::memory_order_acquire) == bridge_util::GiLevelNone) {
+      answer(*job, E_FAIL);
+      return;
+    }
+    ++pBlock->jobsQueued;
+    g_jobs.push_back(job);
+    gi::queueJob(job);
+  }
+
+  // Bridge_GiCancel: a cancelled job is never answered, so its slot can take the next ticket at once.
+  inline void cancel(uint32_t seq) {
+    for (auto it = g_jobs.begin(); it != g_jobs.end(); ++it) {
+      if ((*it)->seq == seq) {
+        (*it)->cancelled.store(true, std::memory_order_release);
+        g_jobs.erase(it);
+        return;
+      }
+    }
+  }
+
+  // Applies finished jobs within the byte budget. A job larger than what is left of it goes in bands of rows,
+  // the rest in later passes, so the target shows old rows below new ones for those passes.
+  inline void poll(const ResourceMap& resources) {
+    g_commandsSincePoll = 0;
+    GiSharedBlock* const pBlock = g_started ? bridge_util::giBlock() : nullptr;
+    if (pBlock == nullptr) {
+      return;
+    }
+    pBlock->heartbeat.fetch_add(1, std::memory_order_relaxed);
+    uint32_t applied = 0;
+    for (auto it = g_jobs.begin(); it != g_jobs.end();) {
+      gi::Job& job = **it;
+      if (!job.ready.load(std::memory_order_acquire)) {
+        ++it;
+        continue;
+      }
+      const auto hasTarget = [](const gi::Job& j) { return j.kind == gi::JobKind::Pattern || j.kind == gi::JobKind::Solve; };
+      bool superseded = false;
+      for (auto later = std::next(it); hasTarget(job) && later != g_jobs.end() && !superseded; ++later) {
+        superseded = hasTarget(**later) && (*later)->targetId == job.targetId && (*later)->layer == job.layer;
+      }
+      if (superseded || FAILED(job.hresult) || !hasTarget(job)) {
+        answer(job, superseded ? S_OK : job.hresult, superseded ? bridge_util::GiAnswerSuperseded : bridge_util::GiAnswerCopied);
+        it = g_jobs.erase(it);
+        continue;
+      }
+      const uint32_t rowSize = job.width * (job.format == gi::TexelFormat::Rgba16f ? 8 : 4);
+      uint32_t rows = std::min(job.height - job.rowsDone, (uploadBudgetBytes() - std::min(applied, uploadBudgetBytes())) / rowSize);
+      if (rows == 0 && applied == 0) {
+        rows = 1;  // A row over the whole budget still goes, alone in its pass.
+      }
+      if (rows == 0) {
+        break;
+      }
+      const uint32_t size = rows * rowSize;
+      LARGE_INTEGER start, end, frequency;
+      QueryPerformanceCounter(&start);
+      const HRESULT hresult = upload(resources, job, job.rowsDone, rows);
+      QueryPerformanceCounter(&end);
+      QueryPerformanceFrequency(&frequency);
+      const uint32_t us = uint32_t((end.QuadPart - start.QuadPart) * 1000000 / frequency.QuadPart);
+      applied += size;
+      job.rowsDone += rows;
+      job.uploadUs += us;
+      pBlock->uploadUsLast = us;
+      if (us > pBlock->uploadUsMax) {
+        pBlock->uploadUsMax = us;
+        bridge_util::Logger::info(bridge_util::format_string("[Gi] Longest upload so far: %u bytes in %u us.", size, us));
+      }
+      if (size > pBlock->uploadBytesMax) {
+        pBlock->uploadBytesMax = size;
+      }
+      if (SUCCEEDED(hresult) && job.rowsDone < job.height) {
+        break;
+      }
+      answer(job, hresult, bridge_util::GiAnswerCopied, SUCCEEDED(hresult) ? uint32_t(job.texels.size()) : 0, job.uploadUs);
+      it = g_jobs.erase(it);
+    }
+  }
+
+  inline void onCommand(const ResourceMap& resources) {
+    if (!g_jobs.empty() && ++g_commandsSincePoll >= 64) {
+      poll(resources);
+    }
+  }
+
+  // A device reset or destroy fails the open jobs, submits included. The worker keeps its device and the scene
+  // it has built, and the client submits what was open and solves again.
+  inline void dropAll() {
+    for (const auto& job : g_jobs) {
+      job->cancelled.store(true, std::memory_order_release);
+      answer(*job, D3DERR_DEVICELOST);
+    }
+    g_jobs.clear();
+    for (size_t kind = 0; kind < std::size(g_parts); ++kind) {
+      g_parts[kind].clear();
+      g_partsBad[kind] = false;
+    }
+    for (const Staging& entry : g_staging) {
+      entry.pTexture->Release();
+    }
+    g_staging.clear();
+  }
+}
diff --git a/bridge/src/server/gi_solve.comp b/bridge/src/server/gi_solve.comp
new file mode 100644
index 0000000000000000000000000000000000000000..b1fd992c06a681c7341b7f5df971f4a3ab32bcc9
--- /dev/null
+++ b/bridge/src/server/gi_solve.comp
@@ -0,0 +1,181 @@
+#version 460
+// The GI worker's texel solve, one source for both levels. RAYQUERY: hardware ray queries against the scene's
+// acceleration structure. Without it the same kernel walks a 1 m grid over x and z in software.
+// PASS 0: the links. For each texel and ray, the texel a cosine-weighted ray hits. Lamp independent, traced once a scene.
+// PASS 1: one lamp's direct light, by shadow rays to points on its ball.
+// PASS 2: one bounce of one lamp's layer: a gather over the links with no ray.
+// A pass is dispatched in slices: texel0 and ray0 are the slice's first texel and ray.
+#ifdef RAYQUERY
+#extension GL_EXT_ray_query : require
+layout(set = 0, binding = 0) uniform accelerationStructureEXT tlas;
+#endif
+layout(local_size_x = 64) in;
+
+struct Texel {
+  vec4 pos;
+  vec4 nrm;
+  vec4 alb;
+};
+struct Patch {
+  vec3 origin;
+  int mapOffset;  // the patch's first map entry
+  vec3 u;
+  int nu;
+  vec3 v;
+  int nv;
+};
+struct Vertex {
+  vec3 p;
+  int patchId;  // the triangle's first vertex holds its front patch and the second its back patch, -1 = none
+};
+layout(std430, set = 0, binding = 1) readonly buffer Tris { Vertex tris[]; };  // three a triangle
+layout(std430, set = 0, binding = 2) readonly buffer CellStart { uint cellStart[]; };
+layout(std430, set = 0, binding = 3) readonly buffer CellTris { uint cellTris[]; };
+layout(std430, set = 0, binding = 4) readonly buffer Texels { Texel texel[]; };
+layout(std430, set = 0, binding = 5) readonly buffer Patches { Patch patches[]; };
+layout(std430, set = 0, binding = 6) readonly buffer PatchMap { int patchMap[]; };  // the texel of a patch cell, -1 = none
+layout(std430, set = 0, binding = 7) buffer Links { uint link[]; };                 // texels x rays
+layout(std430, set = 0, binding = 8) buffer Direct { vec4 direct[]; };              // lamps x texels
+layout(std430, set = 0, binding = 9) buffer Ind { vec4 ind[]; };                    // 2 (feedback halves) x lamps x texels
+layout(push_constant) uniform PC {
+  vec4 lampPos;  // w: the ball's radius
+  vec4 lampCol;
+  vec4 boxMin;   // the lamp's region scope: texels outside it hold no light of this lamp
+  vec4 boxMax;
+  uint texels, rays, lamp, src;
+  uint shadowRays, lamps, texel0, ray0;
+  int gx0, gz0, gw, gh;
+} pc;
+
+const uint kNone = 0xFFFFFFFFu;
+
+#ifdef RAYQUERY
+bool Trace(vec3 o, vec3 d, float tMin, float tMax, out float t, out uint prim) {
+  rayQueryEXT q;
+  rayQueryInitializeEXT(q, tlas, gl_RayFlagsOpaqueEXT, 0xFF, o, tMin, d, tMax);
+  while (rayQueryProceedEXT(q)) {}
+  if (rayQueryGetIntersectionTypeEXT(q, true) != gl_RayQueryCommittedIntersectionTriangleEXT) return false;
+  t = rayQueryGetIntersectionTEXT(q, true);
+  prim = uint(rayQueryGetIntersectionPrimitiveIndexEXT(q, true));
+  return true;
+}
+#else
+// Moller-Trumbore, both sides. The edges are taken a little wide, so a ray along a shared edge is blocked, never passed.
+bool TriHit(uint i, vec3 o, vec3 d, float tMin, float tMax, out float t) {
+  const vec3 a = tris[3 * i].p, e1 = tris[3 * i + 1].p - a, e2 = tris[3 * i + 2].p - a;
+  const vec3 p = cross(d, e2);
+  const float det = dot(e1, p);
+  if (abs(det) < 1e-12) return false;
+  const float inv = 1.0 / det, kEdge = 1e-5;
+  const vec3 s = o - a;
+  const float u = dot(s, p) * inv;
+  if (u < -kEdge || u > 1.0 + kEdge) return false;
+  const vec3 q = cross(s, e1);
+  const float v = dot(d, q) * inv;
+  if (v < -kEdge || u + v > 1.0 + kEdge) return false;
+  t = dot(e2, q) * inv;
+  return t > tMin && t < tMax;
+}
+// The nearest hit: a 2D walk over the grid's 1 m cells the ray's xz crosses.
+bool Trace(vec3 o, vec3 d, float tMin, float tMax, out float t, out uint prim) {
+  bool hit = false;
+  t = tMax;
+  const vec2 p = o.xz - vec2(pc.gx0, pc.gz0);
+  ivec2 c = ivec2(floor(p));
+  const ivec2 st = ivec2(d.x > 0.0 ? 1 : -1, d.z > 0.0 ? 1 : -1);
+  const vec2 td = vec2(abs(d.x) > 1e-9 ? 1.0 / abs(d.x) : 1e30, abs(d.z) > 1e-9 ? 1.0 / abs(d.z) : 1e30);
+  vec2 tn = vec2(td.x < 1e29 ? (st.x > 0 ? float(c.x + 1) - p.x : p.x - float(c.x)) * td.x : 1e30,
+                 td.y < 1e29 ? (st.y > 0 ? float(c.y + 1) - p.y : p.y - float(c.y)) * td.y : 1e30);
+  for (int n = 0; n < pc.gw + pc.gh + 2; n++) {
+    if (c.x >= 0 && c.y >= 0 && c.x < pc.gw && c.y < pc.gh) {
+      const uint ci = uint(c.y * pc.gw + c.x);
+      for (uint k = cellStart[ci]; k < cellStart[ci + 1]; k++) {
+        float tt;
+        const uint ti = cellTris[k];
+        if (TriHit(ti, o, d, tMin, t, tt)) t = tt, prim = ti, hit = true;
+      }
+    }
+    const float tExit = min(tn.x, tn.y);
+    if (t <= tExit || tExit >= tMax) break;
+    if (tn.x < tn.y) c.x += st.x, tn.x += td.x;
+    else c.y += st.y, tn.y += td.y;
+    if ((c.x < 0 && st.x < 0) || (c.x >= pc.gw && st.x > 0) || (c.y < 0 && st.y < 0) || (c.y >= pc.gh && st.y > 0)) break;
+  }
+  return hit;
+}
+#endif
+
+// The texel under a hit at P on triangle prim, from the side the ray d came from. The light buffer is read at the hit,
+// so the server needs no material. A side without a patch holds no texel: it blocks bounce light and returns none.
+int TexelAt(vec3 P, vec3 d, uint prim) {
+  const vec3 n = cross(tris[3 * prim + 1].p - tris[3 * prim].p, tris[3 * prim + 2].p - tris[3 * prim].p);
+  const int id = dot(n, d) < 0.0 ? tris[3 * prim].patchId : tris[3 * prim + 1].patchId;
+  if (id < 0) return -1;
+  const Patch p = patches[id];
+  const vec3 r = P - p.origin;
+  const ivec2 c = clamp(ivec2(floor(vec2(dot(r, p.u), dot(r, p.v)))), ivec2(0), ivec2(p.nu, p.nv) - 1);
+  return patchMap[p.mapOffset + c.y * p.nu + c.x];
+}
+
+uint Pcg(uint v) {
+  uint s = v * 747796405u + 2891336453u;
+  uint w = ((s >> ((s >> 28u) + 4u)) ^ s) * 277803737u;
+  return (w >> 22u) ^ w;
+}
+
+void main() {
+  const uint i = gl_GlobalInvocationID.x + pc.texel0;
+  if (i >= pc.texels) return;
+  const vec3 P = texel[i].pos.xyz, N = texel[i].nrm.xyz;
+#if PASS == 0
+  // Ray r of texel i is the same every solve: the result is a fixed linear system, so a settled layer holds no noise in time.
+  const uint r = gl_GlobalInvocationID.y + pc.ray0;
+  if (r >= pc.rays) return;
+  const uint h1 = Pcg(i * pc.rays + r), h2 = Pcg(h1);
+  const float u1 = (float(h1 >> 8) + 0.5) / 16777216.0, phi = 6.2831853 * (float(h2 >> 8) + 0.5) / 16777216.0;
+  const vec3 T = normalize(cross(abs(N.y) < 0.9 ? vec3(0, 1, 0) : vec3(1, 0, 0), N)), B = cross(N, T);
+  const float rad = sqrt(u1);
+  const vec3 d = normalize(T * (rad * cos(phi)) + B * (rad * sin(phi)) + N * sqrt(1.0 - u1));
+  float t;
+  uint prim;
+  uint to = kNone;
+  if (Trace(P, d, 1e-3, 1e4, t, prim)) {
+    const int j = TexelAt(P + d * t, d, prim);
+    if (j >= 0) to = uint(j);
+  }
+  link[i * pc.rays + r] = to;
+#elif PASS == 1
+  if (any(lessThan(P, pc.boxMin.xyz)) || any(greaterThan(P, pc.boxMax.xyz))) {
+    direct[pc.lamp * pc.texels + i] = vec4(0.0);
+    return;
+  }
+  const vec3 L = pc.lampPos.xyz - P;
+  const float d2 = dot(L, L), c = dot(N, L) * inversesqrt(d2);
+  float share = 0.0;
+  if (c > 0.0) {
+    for (uint k = 0u; k < pc.shadowRays; k++) {  // a Fibonacci sphere on the lamp's ball
+      const float y = 1.0 - (2.0 * float(k) + 1.0) / float(pc.shadowRays), rr = sqrt(1.0 - y * y), a = 2.39996323 * float(k);
+      const vec3 e = pc.lampPos.xyz + pc.lampPos.w * vec3(rr * cos(a), y, rr * sin(a)) - P;
+      const float len = length(e);
+      float t;
+      uint prim;
+      if (!Trace(P, e / len, 1e-3, len - 1e-3, t, prim)) share += 1.0;
+    }
+    share /= float(pc.shadowRays);
+  }
+  direct[pc.lamp * pc.texels + i] = vec4(pc.lampCol.rgb * (max(c, 0.0) / d2 * share), share);
+#else
+  // Cosine-weighted rays: irradiance = the mean of the hit texels' albedo x (direct + the previous indirect).
+  const uint from = (pc.src * pc.lamps + pc.lamp) * pc.texels, to = ((1u - pc.src) * pc.lamps + pc.lamp) * pc.texels;
+  if (any(lessThan(P, pc.boxMin.xyz)) || any(greaterThan(P, pc.boxMax.xyz))) {
+    ind[to + i] = vec4(0.0, 0.0, 0.0, 1.0);
+    return;
+  }
+  vec3 sum = vec3(0.0);
+  for (uint r = 0u; r < pc.rays; r++) {
+    const uint j = link[i * pc.rays + r];
+    if (j != kNone) sum += texel[j].alb.rgb * (direct[pc.lamp * pc.texels + j].rgb + ind[from + j].rgb);
+  }
+  ind[to + i] = vec4(sum / float(pc.rays), 1.0);
+#endif
+}
