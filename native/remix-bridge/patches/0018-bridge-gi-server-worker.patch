diff --git a/bridge/test/rtx/unit/test_gi_device.cpp b/bridge/test/rtx/unit/test_gi_device.cpp
new file mode 100644
index 00000000..680778a7
--- /dev/null
+++ b/bridge/test/rtx/unit/test_gi_device.cpp
@@ -0,0 +1,379 @@
+/*
+ * Permission is hereby granted, free of charge, to any person obtaining a
+ * copy of this software and associated documentation files (the "Software"),
+ * to deal in the Software without restriction, including without limitation
+ * the rights to use, copy, modify, merge, publish, distribute, sublicense,
+ * and/or sell copies of the Software, and to permit persons to whom the
+ * Software is furnished to do so, subject to the following conditions:
+ *
+ * The above copyright notice and this permission notice shall be included in
+ * all copies or substantial portions of the Software.
+ *
+ * THE SOFTWARE IS PROVIDED "AS IS", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR
+ * IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY,
+ * FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT.  IN NO EVENT SHALL
+ * THE AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER
+ * LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING
+ * FROM, OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER
+ * DEALINGS IN THE SOFTWARE.
+ */
+
+// Runs the GI worker's pattern pass into DEFAULT-pool render target textures through RemixBridge_GiOpen /
+// RemixBridge_GiSolve / RemixBridge_GiPoll, reads them back with GetRenderTargetData and checks every texel.
+// REMIX_GI_TEST_CASE: on (default), off (client.giServer = False, expects E_NOTIMPL), stock (server.giServer = False,
+// expects level none). REMIX_GI_TEST_DXVK: a d3d9vk_x64.dll for the server, so the worker matches DXVK's GPU.
+
+#include <algorithm>
+#include <cmath>
+#include <cstdio>
+#include <cstring>
+#include <fstream>
+#include <stdexcept>
+#include <string>
+#include <vector>
+
+#include <wrl/client.h>
+
+#include "test_remix_api_bridge_app.h"
+
+using Microsoft::WRL::ComPtr;
+using namespace bridge_app_test;
+
+namespace {
+  using PFN_GiOpen = HRESULT (__stdcall*)(uint32_t*);
+  using PFN_GiSolve = HRESULT (__stdcall*)(IDirect3DTexture9*, uint32_t, uint32_t, uint32_t*);
+  using PFN_GiTicket = HRESULT (__stdcall*)(uint32_t);
+  using PFN_GiReadCounters = HRESULT (__stdcall*)(uint32_t*, uint32_t);
+
+  // Word indices of RemixBridge_GiReadCounters, from the block's level field on (util_gi.h).
+  enum Counter { kLevel, kCapBits, kHeartbeat, kWorkerHeartbeat, kLastError, kJobsQueued, kJobsDone, kGpuUsLast,
+                 kUploadUsLast, kUploadUsMax, kUploadBytesMax, kBehaviorFlags, kCounterCount = 14 };
+
+  constexpr UINT kWindowSize = 64;
+
+  PFN_GiOpen g_open = nullptr;
+  PFN_GiSolve g_solve = nullptr;
+  PFN_GiTicket g_poll = nullptr;
+  PFN_GiTicket g_cancel = nullptr;
+  PFN_GiReadCounters g_readCounters = nullptr;
+
+  void check(HRESULT result, const char* pCall) {
+    if (FAILED(result)) {
+      std::printf("FAILED: %s returned 0x%08lX.\n", pCall, static_cast<unsigned long>(result));
+      throw std::runtime_error(pCall);
+    }
+  }
+
+  void expect(HRESULT result, HRESULT expected, const char* pCall) {
+    if (result != expected) {
+      std::printf("FAILED: %s returned 0x%08lX, expected 0x%08lX.\n", pCall,
+                  static_cast<unsigned long>(result), static_cast<unsigned long>(expected));
+      throw std::runtime_error(pCall);
+    }
+  }
+
+  HWND createWindow() {
+    WNDCLASSW windowClass = {};
+    windowClass.lpfnWndProc = DefWindowProcW;
+    windowClass.hInstance = GetModuleHandleW(nullptr);
+    windowClass.lpszClassName = L"BridgeGiTest";
+    RegisterClassW(&windowClass);
+    return CreateWindowExW(0, windowClass.lpszClassName, L"", WS_OVERLAPPEDWINDOW,
+                           0, 0, kWindowSize, kWindowSize, nullptr, nullptr, windowClass.hInstance, nullptr);
+  }
+
+  std::vector<uint32_t> counters() {
+    std::vector<uint32_t> values(kCounterCount);
+    check(g_readCounters(values.data(), kCounterCount), "RemixBridge_GiReadCounters");
+    return values;
+  }
+
+  float halfToFloat(uint16_t half) {
+    const int exponent = (half >> 10) & 31;
+    const int mantissa = half & 1023;
+    const float value = exponent == 0 ? std::ldexp(float(mantissa), -24) : std::ldexp(float(mantissa | 1024), exponent - 25);
+    return (half & 0x8000) ? -value : value;
+  }
+
+  struct Target {
+    ComPtr<IDirect3DTexture9> pTexture;
+    ComPtr<IDirect3DSurface9> pReadback;
+    UINT width = 0;
+    UINT height = 0;
+    D3DFORMAT format = D3DFMT_A16B16G16R16F;
+  };
+
+  Target createTarget(IDirect3DDevice9* pDevice, UINT width, UINT height, D3DFORMAT format) {
+    Target target;
+    target.width = width;
+    target.height = height;
+    target.format = format;
+    check(pDevice->CreateTexture(width, height, 1, D3DUSAGE_RENDERTARGET, format, D3DPOOL_DEFAULT, &target.pTexture, nullptr),
+          "CreateTexture (target)");
+    check(pDevice->CreateOffscreenPlainSurface(width, height, format, D3DPOOL_SYSTEMMEM, &target.pReadback, nullptr),
+          "CreateOffscreenPlainSurface (read-back)");
+    // A colour the pattern never has, so a missing copy fails the check.
+    ComPtr<IDirect3DSurface9> pLevel;
+    check(target.pTexture->GetSurfaceLevel(0, &pLevel), "GetSurfaceLevel");
+    check(pDevice->ColorFill(pLevel.Get(), nullptr, 0x00000000), "ColorFill");
+    return target;
+  }
+
+  // Presents between polls, as a game does, so the server reaches its poll points.
+  unsigned waitForTicket(IDirect3DDevice9* pDevice, uint32_t ticket) {
+    const ULONGLONG deadline = GetTickCount64() + 10000;
+    for (unsigned polls = 1;; ++polls) {
+      const HRESULT result = g_poll(ticket);
+      if (result == S_OK) {
+        return polls;
+      }
+      if (result != S_FALSE) {
+        expect(result, S_OK, "RemixBridge_GiPoll");
+      }
+      if (GetTickCount64() >= deadline) {
+        throw std::runtime_error("The GI pass did not finish within ten seconds");
+      }
+      check(pDevice->Present(nullptr, nullptr, nullptr, nullptr), "Present");
+    }
+  }
+
+  // Compares every texel with the pattern of gi_pattern.comp for this ticket and layer.
+  void checkPattern(IDirect3DDevice9* pDevice, const Target& target, uint32_t layer, uint32_t ticket) {
+    ComPtr<IDirect3DSurface9> pLevel;
+    check(target.pTexture->GetSurfaceLevel(0, &pLevel), "GetSurfaceLevel");
+    check(pDevice->GetRenderTargetData(pLevel.Get(), target.pReadback.Get()), "GetRenderTargetData");
+    D3DLOCKED_RECT lockedRect;
+    check(target.pReadback->LockRect(&lockedRect, nullptr, D3DLOCK_READONLY), "LockRect");
+    unsigned wrong = 0;
+    for (uint32_t y = 0; y < target.height; ++y) {
+      const uint8_t* pRow = (const uint8_t*) lockedRect.pBits + size_t(y) * lockedRect.Pitch;
+      for (uint32_t x = 0; x < target.width; ++x) {
+        const uint32_t expected[4] = { (x + ticket) & 255u, (y + layer * 37u) & 255u, (x ^ y) & 255u, 255u };
+        bool same = true;
+        if (target.format == D3DFMT_A16B16G16R16F) {
+          const uint16_t* pTexel = (const uint16_t*) pRow + size_t(x) * 4;
+          for (int c = 0; c < 4; ++c) {
+            same = same && halfToFloat(pTexel[c]) == float(expected[c]) / 256.0f;
+          }
+        } else {
+          const uint32_t texel = ((const uint32_t*) pRow)[x];
+          same = texel == ((expected[3] << 24) | (expected[0] << 16) | (expected[1] << 8) | expected[2]);
+        }
+        wrong += same ? 0 : 1;
+      }
+    }
+    check(target.pReadback->UnlockRect(), "UnlockRect");
+    if (wrong != 0) {
+      std::printf("  %u of %u texels differ from the pattern.\n", wrong, target.width * target.height);
+      throw std::runtime_error("The GI result differs from the pattern");
+    }
+  }
+
+  void testSolve(IDirect3DDevice9* pDevice, const Target& target, uint32_t layer) {
+    uint32_t ticket = 0;
+    check(g_solve(target.pTexture.Get(), layer, 0, &ticket), "RemixBridge_GiSolve");
+    const unsigned polls = waitForTicket(pDevice, ticket);
+    checkPattern(pDevice, target, layer, ticket);
+    expect(g_poll(ticket), D3DERR_INVALIDCALL, "RemixBridge_GiPoll of a finished ticket");
+    const auto values = counters();
+    std::printf("  %ux%u %s layer %u matched after %u polls: worker %u us, upload %u us.\n", target.width, target.height,
+                target.format == D3DFMT_A16B16G16R16F ? "A16B16G16R16F" : "A8R8G8B8", layer, polls,
+                values[kGpuUsLast], values[kUploadUsLast]);
+  }
+
+  // Time from the first of eight 2048x2048 A16B16G16R16F copies to their event on the server's renderer, which is the
+  // frame's GPU work without the Present wait. First the worker is idle, then a 512x512 pass (one dispatch) is always queued.
+  void measureLoad(IDirect3DDevice9* pDevice, const Target& busyTarget) {
+    logLine("Measuring frame time with the worker idle and busy...");
+    ComPtr<IDirect3DSurface9> pA;
+    ComPtr<IDirect3DSurface9> pB;
+    check(pDevice->CreateRenderTarget(2048, 2048, D3DFMT_A16B16G16R16F, D3DMULTISAMPLE_NONE, 0, FALSE, &pA, nullptr), "CreateRenderTarget (load)");
+    check(pDevice->CreateRenderTarget(2048, 2048, D3DFMT_A16B16G16R16F, D3DMULTISAMPLE_NONE, 0, FALSE, &pB, nullptr), "CreateRenderTarget (load)");
+    ComPtr<IDirect3DQuery9> pQuery;
+    check(pDevice->CreateQuery(D3DQUERYTYPE_EVENT, &pQuery), "CreateQuery");
+    LARGE_INTEGER frequency;
+    QueryPerformanceFrequency(&frequency);
+    for (int busy = 0; busy < 2; ++busy) {
+      std::vector<double> frames;
+      uint32_t ticket = 0;
+      unsigned passes = 0;
+      for (int frame = 0; frame < 150; ++frame) {
+        if (busy && (ticket == 0 || g_poll(ticket) != S_FALSE)) {
+          check(g_solve(busyTarget.pTexture.Get(), frame & 7, 0, &ticket), "RemixBridge_GiSolve (load)");
+          ++passes;
+        }
+        LARGE_INTEGER start;
+        LARGE_INTEGER end;
+        QueryPerformanceCounter(&start);
+        for (int i = 0; i < 8; ++i) {
+          check(pDevice->StretchRect((i & 1) ? pB.Get() : pA.Get(), nullptr, (i & 1) ? pA.Get() : pB.Get(), nullptr, D3DTEXF_LINEAR), "StretchRect");
+        }
+        check(pQuery->Issue(D3DISSUE_END), "Issue");
+        while (pQuery->GetData(nullptr, 0, D3DGETDATA_FLUSH) == S_FALSE) {
+        }
+        QueryPerformanceCounter(&end);
+        check(pDevice->Present(nullptr, nullptr, nullptr, nullptr), "Present");
+        if (frame >= 30) {
+          frames.push_back(double(end.QuadPart - start.QuadPart) * 1000.0 / double(frequency.QuadPart));
+        }
+      }
+      if (ticket != 0 && g_poll(ticket) == S_FALSE) {
+        waitForTicket(pDevice, ticket);
+      }
+      std::sort(frames.begin(), frames.end());
+      double sum = 0;
+      for (double ms : frames) {
+        sum += ms;
+      }
+      std::printf("  Worker %s: copies mean %.2f ms, median %.2f ms, p95 %.2f ms, max %.2f ms over %zu frames, %u passes.\n",
+                  busy ? "busy" : "idle", sum / frames.size(), frames[frames.size() / 2], frames[frames.size() * 95 / 100],
+                  frames.back(), frames.size(), passes);
+    }
+  }
+
+  // Presents between calls, as a game does, so the open command reaches the server.
+  HRESULT openGi(IDirect3DDevice9* pDevice, uint32_t& level) {
+    const ULONGLONG deadline = GetTickCount64() + 10000;
+    HRESULT result;
+    while ((result = g_open(&level)) == S_FALSE) {
+      if (GetTickCount64() >= deadline) {
+        throw std::runtime_error("The GI server did not answer within ten seconds");
+      }
+      check(pDevice->Present(nullptr, nullptr, nullptr, nullptr), "Present");
+      Sleep(5);
+    }
+    return result;
+  }
+
+  void runOn(IDirect3DDevice9* pDevice) {
+    logLine("Opening the GI server...");
+    uint32_t level = 0;
+    check(openGi(pDevice, level), "RemixBridge_GiOpen");
+    auto values = counters();
+    std::printf("  Level %u, capabilities 0x%x, device BehaviorFlags 0x%08x.\n", level, values[kCapBits], values[kBehaviorFlags]);
+    if (level == 0) {
+      throw std::runtime_error("The GI server reported level none");
+    }
+
+    logLine("Testing passes into A16B16G16R16F and A8R8G8B8 targets...");
+    const Target patch = createTarget(pDevice, 64, 64, D3DFMT_A16B16G16R16F);
+    const Target lightBuffer = createTarget(pDevice, 200, 200, D3DFMT_A16B16G16R16F);  // 320 KB, a light buffer of 40 k texels
+    const Target colour = createTarget(pDevice, 256, 256, D3DFMT_A8R8G8B8);
+    const Target large = createTarget(pDevice, 512, 512, D3DFMT_A16B16G16R16F);        // 2 MB, more than the default budget
+    testSolve(pDevice, patch, 3);
+    testSolve(pDevice, lightBuffer, 0);
+    testSolve(pDevice, lightBuffer, 1);
+    testSolve(pDevice, colour, 5);
+    testSolve(pDevice, large, 2);
+
+    logLine("Testing a superseded solve, a cancel and the refusals...");
+    uint32_t first = 0;
+    uint32_t second = 0;
+    check(g_solve(patch.pTexture.Get(), 7, 0, &first), "RemixBridge_GiSolve (first)");
+    check(g_solve(patch.pTexture.Get(), 7, 0, &second), "RemixBridge_GiSolve (second)");
+    waitForTicket(pDevice, second);
+    waitForTicket(pDevice, first);
+    checkPattern(pDevice, patch, 7, second);
+
+    uint32_t cancelled = 0;
+    check(g_solve(colour.pTexture.Get(), 9, 0, &cancelled), "RemixBridge_GiSolve (cancel)");
+    check(g_cancel(cancelled), "RemixBridge_GiCancel");
+    expect(g_poll(cancelled), D3DERR_INVALIDCALL, "RemixBridge_GiPoll of a cancelled ticket");
+    testSolve(pDevice, colour, 4);
+
+    expect(g_poll(0x7fffffff), D3DERR_INVALIDCALL, "RemixBridge_GiPoll of an unknown ticket");
+    ComPtr<IDirect3DTexture9> pManaged;
+    check(pDevice->CreateTexture(16, 16, 1, 0, D3DFMT_A8R8G8B8, D3DPOOL_MANAGED, &pManaged, nullptr), "CreateTexture (managed)");
+    uint32_t refused = 0;
+    expect(g_solve(pManaged.Get(), 0, 0, &refused), D3DERR_INVALIDCALL, "RemixBridge_GiSolve (managed)");
+
+    measureLoad(pDevice, large);
+
+    values = counters();
+    std::printf("  Jobs %u queued, %u answered; longest upload %u us; largest copy %u bytes; heartbeat %u.\n",
+                values[kJobsQueued], values[kJobsDone], values[kUploadUsMax], values[kUploadBytesMax], values[kHeartbeat]);
+  }
+}
+
+int main() {
+  std::setvbuf(stdout, nullptr, _IONBF, 0);
+  char mode[8] = {};
+  GetEnvironmentVariableA("REMIX_GI_TEST_CASE", mode, sizeof(mode));
+  const std::string testCase = mode[0] ? mode : "on";
+  char dxvk[MAX_PATH] = {};
+  GetEnvironmentVariableA("REMIX_GI_TEST_DXVK", dxvk, sizeof(dxvk));
+  const HWND hWnd = createWindow();
+  if (hWnd == nullptr) {
+    logLine("FAILED: Could not create a test window.");
+    return 1;
+  }
+  bool passed = false;
+  try {
+    // The client and the server read their options from .trex/bridge.conf, as in test_query_event_device.
+    std::ofstream config(".trex/bridge.conf", std::ios::app);
+    config << "client.giServer = " << (testCase == "off" ? "False" : "True") << "\n"
+           << "server.giServer = " << (testCase == "stock" ? "False" : "True") << "\n"
+           << "sendCreateFunctionServerResponses = True\n";
+    if (dxvk[0] != 0) {
+      if (!CopyFileA(dxvk, ".trex\\d3d9vk_x64.dll", FALSE)) {
+        throw std::runtime_error("Could not copy REMIX_GI_TEST_DXVK");
+      }
+      config << "server.useVanillaDxvk = True\n";
+    }
+    config.close();
+    std::printf("Mode %s, server renderer %s.\n", testCase.c_str(), dxvk[0] ? "DXVK" : "system Direct3D 9");
+    const HMODULE hClient = loadBridgeClient();
+    if (hClient == nullptr) {
+      throw std::runtime_error("loadBridgeClient");
+    }
+    g_open = reinterpret_cast<PFN_GiOpen>(GetProcAddress(hClient, "RemixBridge_GiOpen"));
+    g_solve = reinterpret_cast<PFN_GiSolve>(GetProcAddress(hClient, "RemixBridge_GiSolve"));
+    g_poll = reinterpret_cast<PFN_GiTicket>(GetProcAddress(hClient, "RemixBridge_GiPoll"));
+    g_cancel = reinterpret_cast<PFN_GiTicket>(GetProcAddress(hClient, "RemixBridge_GiCancel"));
+    g_readCounters = reinterpret_cast<PFN_GiReadCounters>(GetProcAddress(hClient, "RemixBridge_GiReadCounters"));
+    if (g_open == nullptr || g_solve == nullptr || g_poll == nullptr || g_cancel == nullptr || g_readCounters == nullptr) {
+      throw std::runtime_error("The client does not export the GI functions");
+    }
+    const auto pfnCreate = reinterpret_cast<PFN_Direct3DCreate9>(GetProcAddress(hClient, "Direct3DCreate9"));
+    ComPtr<IDirect3D9> pD3D;
+    pD3D.Attach(pfnCreate != nullptr ? pfnCreate(D3D_SDK_VERSION) : nullptr);
+    if (pD3D == nullptr) {
+      throw std::runtime_error("Direct3DCreate9");
+    }
+    D3DPRESENT_PARAMETERS present = {};
+    present.Windowed = TRUE;
+    present.SwapEffect = D3DSWAPEFFECT_DISCARD;
+    present.BackBufferFormat = D3DFMT_UNKNOWN;
+    present.BackBufferWidth = kWindowSize;
+    present.BackBufferHeight = kWindowSize;
+    present.hDeviceWindow = hWnd;
+    // The flags of test_async_readback_device. Without D3DCREATE_MULTITHREADED the client's first Present here
+    // can find no implicit swap chain, with or without the GI exports.
+    ComPtr<IDirect3DDevice9> pDevice;
+    check(pD3D->CreateDevice(D3DADAPTER_DEFAULT, D3DDEVTYPE_HAL, hWnd, D3DCREATE_SOFTWARE_VERTEXPROCESSING | D3DCREATE_MULTITHREADED,
+                              &present, &pDevice), "CreateDevice");
+
+    uint32_t level = 0;
+    if (testCase == "off") {
+      logLine("Testing that the exports refuse while client.giServer is off...");
+      expect(g_open(&level), E_NOTIMPL, "RemixBridge_GiOpen (off)");
+    } else if (testCase == "stock") {
+      logLine("Testing that a server without GI support reports level none...");
+      expect(openGi(pDevice.Get(), level), S_OK, "RemixBridge_GiOpen (stock)");
+      if (level != 0) {
+        throw std::runtime_error("A server without GI support reported a level");
+      }
+      const Target target = createTarget(pDevice.Get(), 16, 16, D3DFMT_A8R8G8B8);
+      uint32_t ticket = 0;
+      expect(g_solve(target.pTexture.Get(), 0, 0, &ticket), E_NOTIMPL, "RemixBridge_GiSolve (stock)");
+    } else {
+      runOn(pDevice.Get());
+    }
+    passed = true;
+  } catch (const std::exception& error) {
+    std::printf("FAILED: %s.\n", error.what());
+  }
+  DestroyWindow(hWnd);
+  logLine(passed ? "PASSED" : "FAILED");
+  return passed ? 0 : 1;
+}
