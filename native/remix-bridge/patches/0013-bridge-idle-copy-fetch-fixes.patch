+static uint32_t crcOf(const uint8_t* p, size_t n) {
+  uint32_t c = 0xFFFFFFFFu;
+  size_t i = 0;
+  for (; i + 4 <= n; i += 4) {
+    uint32_t v;
+    memcpy(&v, p + i, 4);
+    c = _mm_crc32_u32(c, v);
+  }
