+// client.freeIdleManagedCopiesSec / freeIdleBufferCopiesSec: whether a freed copy of this size can come back in one server
+// response. The response holds up to 4 words of metadata, the blob's length word and the blob, which a wrap at the end of the
+// ring can precede with up to the blob's size in skipped words; the server exits when one response does not fit its data
+// ring (syncDataQueue). So the blob gets at most half of the ring left after 8 words reserved for the metadata.
+static bool fitsOneServerResponse(const size_t size) {
+  constexpr size_t kWordSize = sizeof(uint32_t);
+  constexpr size_t kMetadataWords = 8;
+  // The client's reader ring is the server's writer ring: the same shared memory, so the same size.
+  const size_t ringWords = Bridge<BridgeId::Device>::getReaderChannel().data->get_total_size();
+  const size_t blobWords = (size + kWordSize - 1) / kWordSize;
+  return ringWords > kMetadataWords && blobWords <= (ringWords - kMetadataWords) / 2;
+}
