diff --git a/bridge/test/rtx/unit/test_idle_copy_device.cpp b/bridge/test/rtx/unit/test_idle_copy_device.cpp
new file mode 100644
index 00000000..5f8279bc
--- /dev/null
+++ b/bridge/test/rtx/unit/test_idle_copy_device.cpp
@@ -0,0 +1,185 @@
+// Drives the idle copy fetch of the bridge client (patches 0003, 0008, 0013) through the built bridge pair: the client
+// frees the copy of a MANAGED texture level and of a static vertex buffer that were not locked for a while, and the
+// next lock fetches it back from the server.
+// The server holds the first surface readback for kDelayMs (debugDelayFirstReadbackMs), as a stalled server does.
+// With bridge timeouts on (commandTimeout below) that fetch times out: the lock must fail cleanly with a null pointer,
+// and the next lock of the same level must drop the late answer and fetch the right bytes. With timeouts off the
+// first lock waits and succeeds.
+
+#include <cstdio>
+#include <cstring>
+#include <fstream>
+#include <sstream>
+#include <stdexcept>
+#include <string>
+
+#include <wrl/client.h>
+
+#include "test_remix_api_bridge_app.h"
+
+using Microsoft::WRL::ComPtr;
+using namespace bridge_app_test;
+
+namespace {
+  constexpr UINT kSize = 64;
+  constexpr UINT kTextureSize = 256;       // 256 KB in A8R8G8B8: a VirtualAlloc'd copy, which an idle pass frees
+  constexpr UINT kBufferSize = 128 * 1024; // between 64 KB and 4 MB: a freeable buffer copy
+  constexpr DWORD kDelayMs = 15000;
+
+  void check(const HRESULT result, const char* pCall) {
+    if (FAILED(result)) {
+      std::printf("FAILED: %s returned 0x%08lX.\n", pCall, static_cast<unsigned long>(result));
+      throw std::runtime_error(pCall);
+    }
+  }
+
+  void expect(const bool condition, const char* pWhat) {
+    std::printf("%s: %s\n", condition ? "ok" : "FAILED", pWhat);
+    if (!condition) {
+      throw std::runtime_error(pWhat);
+    }
+  }
+
+  uint32_t pattern(const uint32_t i, const uint32_t seed) {
+    return (i + seed) * 2654435761u;
+  }
+
+  bool holds(const uint8_t* pData, const UINT pitch, const UINT width, const UINT rows, const uint32_t seed) {
+    for (UINT y = 0; y < rows; y++) {
+      const uint32_t* const pRow = reinterpret_cast<const uint32_t*>(pData + size_t(y) * pitch);
+      for (UINT x = 0; x < width; x++) {
+        if (pRow[x] != pattern(y * width + x, seed)) {
+          return false;
+        }
+      }
+    }
+    return true;
+  }
+
+  bool timeoutsDisabled() {
+    std::ifstream config(".trex/bridge.conf");
+    std::stringstream text;
+    text << config.rdbuf();
+    return text.str().find("disableTimeouts = True") != std::string::npos;
+  }
+}
+
+int main() {
+  std::setvbuf(stdout, nullptr, _IONBF, 0);
+  const bool noTimeouts = timeoutsDisabled();
+  std::printf("TEST: idle copy fetch through the bridge, timeouts %s\n", noTimeouts ? "off" : "on");
+
+  WNDCLASSW windowClass = {};
+  windowClass.lpfnWndProc = DefWindowProcW;
+  windowClass.hInstance = GetModuleHandleW(nullptr);
+  windowClass.lpszClassName = L"BridgeIdleCopyTest";
+  RegisterClassW(&windowClass);
+  const HWND hWnd = CreateWindowExW(0, windowClass.lpszClassName, L"", WS_OVERLAPPEDWINDOW, 0, 0, kSize, kSize,
+                                    nullptr, nullptr, windowClass.hInstance, nullptr);
+  if (hWnd == nullptr) {
+    return 1;
+  }
+
+  bool passed = false;
+  try {
+    {
+      std::ofstream config(".trex/bridge.conf", std::ios::app);
+      config << "client.freeIdleManagedCopiesSec = 1\n";
+      config << "client.freeIdleManagedCopiesMs = 100\n";
+      config << "client.freeIdleBufferCopiesSec = 1\n";
+      config << "debugDelayFirstReadbackMs = " << kDelayMs << "\n";
+      // With timeouts on, a wait gives up after 300 peeks of 20 ms (about 10 s at the 15.6 ms tick), before the held
+      // readback is answered.
+      config << "commandTimeout = 20\n";
+    }
+    const HMODULE hClient = loadBridgeClient();
+    if (hClient == nullptr) {
+      throw std::runtime_error("loadBridgeClient");
+    }
+    const auto pfnCreate = reinterpret_cast<PFN_Direct3DCreate9>(GetProcAddress(hClient, "Direct3DCreate9"));
+    ComPtr<IDirect3D9> pD3D;
+    pD3D.Attach(pfnCreate != nullptr ? pfnCreate(D3D_SDK_VERSION) : nullptr);
+    if (pD3D == nullptr) {
+      throw std::runtime_error("Direct3DCreate9");
+    }
+    D3DPRESENT_PARAMETERS present = {};
+    present.Windowed = TRUE;
+    present.SwapEffect = D3DSWAPEFFECT_DISCARD;
+    present.BackBufferFormat = D3DFMT_UNKNOWN;
+    present.BackBufferWidth = kSize;
+    present.BackBufferHeight = kSize;
+    present.hDeviceWindow = hWnd;
+    ComPtr<IDirect3DDevice9> pDevice;
+    // As the game: no D3DCREATE_MULTITHREADED.
+    check(pD3D->CreateDevice(D3DADAPTER_DEFAULT, D3DDEVTYPE_HAL, hWnd, D3DCREATE_SOFTWARE_VERTEXPROCESSING, &present, &pDevice),
+          "CreateDevice");
+
+    ComPtr<IDirect3DTexture9> pTexture;
+    ComPtr<IDirect3DVertexBuffer9> pBuffer;
+    check(pDevice->CreateTexture(kTextureSize, kTextureSize, 1, 0, D3DFMT_A8R8G8B8, D3DPOOL_MANAGED, &pTexture, nullptr), "CreateTexture");
+    check(pDevice->CreateVertexBuffer(kBufferSize, 0, 0, D3DPOOL_MANAGED, &pBuffer, nullptr), "CreateVertexBuffer");
+    D3DLOCKED_RECT rect = {};
+    check(pTexture->LockRect(0, &rect, nullptr, 0), "LockRect");
+    for (UINT y = 0; y < kTextureSize; y++) {
+      for (UINT x = 0; x < kTextureSize; x++) {
+        reinterpret_cast<uint32_t*>(static_cast<uint8_t*>(rect.pBits) + size_t(y) * rect.Pitch)[x] = pattern(y * kTextureSize + x, 1);
+      }
+    }
+    check(pTexture->UnlockRect(0), "UnlockRect");
+    void* pData = nullptr;
+    check(pBuffer->Lock(0, 0, &pData, 0), "Lock");
+    for (UINT i = 0; i < kBufferSize / 4; i++) {
+      static_cast<uint32_t*>(pData)[i] = pattern(i, 2);
+    }
+    check(pBuffer->Unlock(), "Unlock");
+
+    // Idle passes run in Present: past both thresholds the client copies are freed.
+    const auto frames = [&](const DWORD ms) {
+      const ULONGLONG end = GetTickCount64() + ms;
+      while (GetTickCount64() < end) {
+        check(pDevice->Clear(0, nullptr, D3DCLEAR_TARGET, 0xff102030, 1.0f, 0), "Clear");
+        check(pDevice->Present(nullptr, nullptr, nullptr, nullptr), "Present");
+        Sleep(10);
+      }
+    };
+    frames(2500);
+
+    // The first fetch: the server holds its answer.
+    rect.pBits = reinterpret_cast<void*>(0x1);
+    const ULONGLONG lockStart = GetTickCount64();
+    const HRESULT first = pTexture->LockRect(0, &rect, nullptr, D3DLOCK_READONLY);
+    std::printf("first lock after the idle passes: 0x%08lX, pBits %p, %llu ms\n", static_cast<unsigned long>(first), rect.pBits,
+                GetTickCount64() - lockStart);
+    if (noTimeouts) {
+      expect(SUCCEEDED(first) && holds(static_cast<const uint8_t*>(rect.pBits), rect.Pitch, kTextureSize, kTextureSize, 1),
+             "timeouts off: the held fetch is waited for and brings the level back");
+      check(pTexture->UnlockRect(0), "UnlockRect");
+    } else {
+      expect(first == E_FAIL && rect.pBits == nullptr, "timeouts on: the held fetch fails the lock with a null pointer");
+      // The server is still holding the answer; nothing waits on it meanwhile.
+      Sleep(kDelayMs);
+      rect.pBits = nullptr;
+      check(pTexture->LockRect(0, &rect, nullptr, D3DLOCK_READONLY), "LockRect after the timed-out fetch");
+      expect(holds(static_cast<const uint8_t*>(rect.pBits), rect.Pitch, kTextureSize, kTextureSize, 1),
+             "timeouts on: the next lock drops the late answer and fetches the right bytes");
+      check(pTexture->UnlockRect(0), "UnlockRect");
+    }
+
+    pData = nullptr;
+    check(pBuffer->Lock(0, 0, &pData, D3DLOCK_READONLY), "Lock of the freed buffer");
+    expect(holds(static_cast<const uint8_t*>(pData), kBufferSize, kBufferSize / 4, 1, 2), "the freed buffer copy comes back with the right bytes");
+    check(pBuffer->Unlock(), "Unlock");
+    frames(200);
+    passed = true;
+  } catch (const std::exception& error) {
+    std::printf("FAILED: %s\n", error.what());
+  }
+  if (!passed) {
+    // A failed run can leave the bridge waiting, so it does not unwind.
+    std::printf("FAILED\n");
+    TerminateProcess(GetCurrentProcess(), 1);
+  }
+  DestroyWindow(hWnd);
+  std::printf("PASSED\n");
+  return 0;
+}
