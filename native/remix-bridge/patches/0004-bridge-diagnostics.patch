+          if (inExe(v) && isCallReturn(v)) {
+            out[n++] = v;
+          }
+        }
+        return n;
+      }
+
+      // TS3W's device wrapper, texture and DDS code (docs/40): every texture create and release passes through it
+      constexpr uintptr_t kDevLo = 0x60C000, kDevHi = 0x61B000;
+      Chain chainOf(const uintptr_t* c, int n, uintptr_t inner) {
+        Chain ch = {};
+        ch.inner = inner;
+        int i = 0;
+        while (i < n && c[i] >= kDevLo && c[i] < kDevHi) {
+          ++i;
+        }
+        for (int k = 0; k < 4 && i < n; ++k, ++i) {
+          ch.o[k] = c[i];
+        }
+        const uintptr_t parts[5] = { ch.inner, ch.o[0], ch.o[1], ch.o[2], ch.o[3] };
+        uint32_t h = 2166136261u;
+        for (const uintptr_t v : parts) {
+          h = (h ^ uint32_t(v)) * 16777619u;
+        }
+        ch.key = h | 0x80000000u;  // never 0, 1 or 2 (the special site values)
+        return ch;
+      }
+      thread_local Chain t_chain = {};
+
+      struct LockSite { uintptr_t ret; int64_t locks, newCopies, newBytes, liveCopyBytes; };
+      LockSite s_lockSites[kMaxSites];
+      uint32_t s_lockSiteCount = 0;
+      std::mutex s_lockSiteLock;
+
+      std::mutex s_uploadLock;
+      std::unordered_map<uint64_t, uint64_t> s_uploadSeen;  // fingerprint -> time of its last upload, ms
+      int64_t s_uploadsN = 0, s_uploadsBytes = 0, s_repeatsN = 0, s_repeatsBytes = 0;
+      constexpr uint64_t kRepeatWindowMs = 60000;
+      std::unordered_map<uint64_t, uint64_t> s_contentSeen;  // content key -> time of its last upload, ms
+      std::unordered_map<uint64_t, uint64_t> s_released;     // content key -> time its surface was destroyed, ms
+      int64_t s_fullRepeatsN = 0, s_fullRepeatsBytes = 0, s_sampledOnlyN = 0;
