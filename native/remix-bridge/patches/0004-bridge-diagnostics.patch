+          std::ostringstream sd;
+          sd << std::fixed << std::setprecision(1) << "[BridgeDiag] client create site detail, " << (all ? "all" : "top 12 by created")
+             << " (textures: inner game frame<first four TS3W frames outside the device code, others: game caller<its callers, via hook; last desc WxH fmt levels usage pool; this interval: +created, upload MB, full-data"
+             << " repeat %, re-created after a destroy, of those within 1 s):";
+          shown = 0;
+          for (const CreateSite& s : v) {
