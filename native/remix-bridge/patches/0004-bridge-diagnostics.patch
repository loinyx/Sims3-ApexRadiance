+      constexpr uint64_t kBucketMs[4] = { 1000, 5000, 30000, 60000 };
+
+      struct DiagFrame {
+        int64_t lastT = 0;
+        uint64_t cmd = 0, resp = 0, present = 0, readback = 0;
+        double maxMs = 0, worstSend = 0, worstWait = 0, worstPresent = 0, worstReadback = 0;
+        uint32_t over50 = 0, over100 = 0, over250 = 0;
+      } s_df;
+      uint32_t s_diagLogs = 0;
+      constexpr uint32_t kAllSitesEvery = 30;  // every 30th log lists every site, the others the top ones
+
+      // slot for ret in a site table (caller holds its lock): an existing one, a new one, or the overflow slot
+      template<typename SiteT>
+      uint8_t slotFor(SiteT* table, uint32_t& count, uintptr_t ret) {
+        for (uint32_t i = 0; i < count; ++i) {
+          if (table[i].ret == ret) {
+            return uint8_t(i);
+          }
+        }
+        if (count < kMaxSites - 1) {
+          table[count] = {};
+          table[count].ret = ret;
+          return uint8_t(count++);
+        }
+        table[kMaxSites - 1].ret = 1;  // 0x00000001 in the log: sites beyond the table
+        return uint8_t(kMaxSites - 1);
+      }
+
+      void appendMem(std::ostringstream& ss) {
+        PROCESS_MEMORY_COUNTERS_EX pmc = {};
+        pmc.cb = sizeof(pmc);
+        if (K32GetProcessMemoryInfo(GetCurrentProcess(), reinterpret_cast<PROCESS_MEMORY_COUNTERS*>(&pmc), sizeof(pmc))) {
+          ss << " privMB=" << uint64_t(pmc.PrivateUsage) / 1048576 << " wsMB=" << uint64_t(pmc.WorkingSetSize) / 1048576;
+        }
+#ifndef _WIN64
+        // the address space walk: the game dies when no free block is big enough, so the largest one is the number that matters
+        uint64_t big = 0, total = 0;
+        uintptr_t a = 0x10000;
+        MEMORY_BASIC_INFORMATION mbi;
+        while (VirtualQuery(reinterpret_cast<void*>(a), &mbi, sizeof(mbi)) == sizeof(mbi)) {
+          if (mbi.State == MEM_FREE) {
+            big = std::max<uint64_t>(big, mbi.RegionSize);
+            total += mbi.RegionSize;
+          }
+          const uintptr_t next = uintptr_t(mbi.BaseAddress) + mbi.RegionSize;
+          if (next <= a) {
+            break;
+          }
+          a = next;
+        }
+        ss << " bigFreeMB=" << big / 1048576 << " freeMB=" << total / 1048576;
+#endif
+      }
+
+      void diagFrame(int64_t t) {
+        const uint64_t cmd = s_cmdTicks.load(std::memory_order_relaxed);
+        const uint64_t resp = s_diagRespTicks.load(std::memory_order_relaxed);
+        const uint64_t present = s_presentWaitTicks.load(std::memory_order_relaxed);
+        const uint64_t readback = s_diagReadbackUs.load(std::memory_order_relaxed);
+        DiagFrame& f = s_df;
+        if (f.lastT) {
+          const double ms = toUs(uint64_t(t - f.lastT)) / 1e3;
+          f.over50 += ms > 50.0 ? 1 : 0;
+          f.over100 += ms > 100.0 ? 1 : 0;
+          f.over250 += ms > 250.0 ? 1 : 0;
+          if (ms > f.maxMs) {
+            f.maxMs = ms;
+            // s_cmdTicks and s_presentWaitTicks restart at 0 each interval
+            f.worstSend = toUs(cmd >= f.cmd ? cmd - f.cmd : cmd) / 1e3;
+            f.worstWait = toUs(resp - f.resp) / 1e3;
+            f.worstPresent = toUs(present >= f.present ? present - f.present : present) / 1e3;
+            f.worstReadback = double(readback - f.readback) / 1e3;
+          }
+        }
+        f.lastT = t;
+        f.cmd = cmd;
+        f.resp = resp;
+        f.present = present;
+        f.readback = readback;
+      }
+
