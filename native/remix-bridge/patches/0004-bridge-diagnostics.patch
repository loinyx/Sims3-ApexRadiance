+
+    thread_local uintptr_t t_lockSite = 0;
+
+    void setSite(void* ret, uint64_t bytes) {
+      t_site = uintptr_t(ret);
+      t_siteBytes = bytes;
+      t_siteVia = t_siteUp = t_siteUp2 = 0;
+      t_chain = {};
+      t_hasDesc = false;  // a failed create must not leave its desc to the next object
+      if (!enabled()) {
+        return;
+      }
+      uintptr_t c[3] = {};
+      gameCallers(c);
+      if (inExe(t_site)) {
+        const bool self = c[0] == t_site;
+        t_siteUp = self ? c[1] : c[0];
+        t_siteUp2 = self ? c[2] : c[1];
+      } else if (c[0]) {  // called through a hook: the game's caller is the site, the hook goes in via
+        t_siteVia = t_site;
+        t_site = c[0];
+        t_siteUp = c[1];
+        t_siteUp2 = c[2];
+      }
+    }
+
+    void setSiteDesc(uint32_t w, uint32_t h, uint32_t fmt, uint32_t levels, uint32_t usage, uint32_t pool) {
+      t_desc[0] = w;
+      t_desc[1] = h;
+      t_desc[2] = fmt;
+      t_desc[3] = levels;
+      t_desc[4] = usage;
+      t_desc[5] = pool;
+      t_hasDesc = true;
+      if (enabled() && t_site) {  // textures are keyed by their chain, so package loads split by who asked
+        uintptr_t c[8] = {};
+        const int n = gameCallers(c);
+        t_chain = chainOf(c, n, t_site);
+        t_site = t_chain.key;
+      }
+    }
+
+    uint8_t takeSite(uint32_t& bytes) {
+      const uintptr_t ret = t_site;
+      t_site = 0;
+      if (!ret || !enabled()) {
+        bytes = 0;
+        t_hasDesc = false;
+        return 0xFF;
+      }
+      bytes = uint32_t(std::min<uint64_t>(t_siteBytes, UINT32_MAX));
+      std::lock_guard<std::mutex> lock(s_siteLock);
+      const uint8_t i = slotFor(s_sites, s_siteCount, ret);
+      CreateSite& s = s_sites[i];
+      s.type = -1;  // set by the noteObject call that follows
+      s.idx = i;
+      s.via = t_siteVia;
+      s.up = t_siteUp;
+      s.up2 = t_siteUp2;
+      s.chain = t_hasDesc ? t_chain : Chain{};
+      if (t_hasDesc) {
+        s.w = t_desc[0];
+        s.h = t_desc[1];
+        s.fmt = t_desc[2];
+        s.levels = t_desc[3];
+        s.usage = t_desc[4];
+        s.pool = t_desc[5];
+      }
+      t_hasDesc = false;
+      return i;
+    }
+
+    void noteObject(int type, int delta, uint8_t site, uint32_t bytes) {
+      if (type >= 0 && type < kTypes) {
+        s_typeLive[type].fetch_add(delta, std::memory_order_relaxed);
+      }
+      if (site == 0xFF) {
+        return;
+      }
+      std::lock_guard<std::mutex> lock(s_siteLock);
+      CreateSite& s = s_sites[site];
+      if (delta > 0 && s.type < 0) {
+        s.type = type;
+      }
+      s.live += delta;
+      s.liveBytes += int64_t(delta) * int64_t(bytes);
+      (delta > 0 ? s.created : s.released)++;
+    }
+
+    uint8_t noteLock(uintptr_t site, bool newCopy, uint32_t bytes) {
+      std::lock_guard<std::mutex> lock(s_lockSiteLock);
+      const uint8_t i = slotFor(s_lockSites, s_lockSiteCount, site ? site : 2);  // 0x00000002: lock with no recorded caller
+      LockSite& s = s_lockSites[i];
+      s.locks++;
+      if (newCopy) {
+        s.newCopies++;
+        s.newBytes += bytes;
+        s.liveCopyBytes += bytes;
+      }
+      return i;
+    }
+
+    void noteCopyFreed(uint8_t site, uint32_t bytes) {
+      if (site == 0xFF) {
+        return;
+      }
+      std::lock_guard<std::mutex> lock(s_lockSiteLock);
+      s_lockSites[site].liveCopyBytes -= bytes;
+    }
+
+    uint64_t noteUploadData(const uint8_t* p, int pitch, uint32_t rowSize, uint32_t numRows, uint32_t w, uint32_t h, uint32_t fmt,
+                            uint8_t site) {
+      if (!p || !rowSize || !numRows) {
+        return 0;
+      }
+      // FNV-1a over the size, the format and 64 bytes of up to 16 rows spread over the image: cheap, and a repeat upload of the same
+      // texture matches; two different images that agree on every sampled byte also match (counted as a repeat)
+      uint64_t fp = 1469598103934665603ull;
+      const auto mix = [&fp](uint64_t v) {
+        for (int b = 0; b < 8; ++b) {
+          fp = (fp ^ ((v >> (8 * b)) & 0xFF)) * 1099511628211ull;
+        }
+      };
+      mix(w);
+      mix(h);
+      mix(fmt);
+      const uint32_t samples = std::min<uint32_t>(numRows, 16);
+      const uint32_t n = std::min<uint32_t>(rowSize, 64);
+      for (uint32_t i = 0; i < samples; ++i) {
+        const uint64_t row = samples > 1 ? uint64_t(i) * (numRows - 1) / (samples - 1) : 0;
+        const uint8_t* r = p + ptrdiff_t(row) * pitch;
+        for (uint32_t b = 0; b < n; ++b) {
+          fp = (fp ^ r[b]) * 1099511628211ull;
+        }
+      }
+      // CRC32C of every uploaded byte, four interleaved lanes (crc32 has a 3-cycle latency but issues once per cycle)
+      uint32_t c[4] = { 1, 2, 3, 4 };
+      for (uint32_t row = 0; row < numRows; ++row) {
+        const uint8_t* r = p + ptrdiff_t(row) * pitch;
+        uint32_t i = 0;
+        for (; i + 16 <= rowSize; i += 16) {
+          uint32_t v[4];
+          memcpy(v, r + i, 16);
+          c[0] = _mm_crc32_u32(c[0], v[0]);
+          c[1] = _mm_crc32_u32(c[1], v[1]);
+          c[2] = _mm_crc32_u32(c[2], v[2]);
+          c[3] = _mm_crc32_u32(c[3], v[3]);
+        }
+        for (; i < rowSize; ++i) {
+          c[0] = _mm_crc32_u8(c[0], r[i]);
+        }
