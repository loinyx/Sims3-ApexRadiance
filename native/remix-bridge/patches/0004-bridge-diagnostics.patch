+             << " repeats (same sampled fingerprint within 60 s): n=" << s_repeatsN << " MB=" << double(s_repeatsBytes) / 1048576.0
+             << " fingerprints=" << s_uploadSeen.size()
+             << " | full-data repeats within 60 s: n=" << s_fullRepeatsN << " MB=" << double(s_fullRepeatsBytes) / 1048576.0
+             << " sampledOnly=" << s_sampledOnlyN << " contents=" << s_contentSeen.size()
+             << " | re-uploaded after its surface was destroyed: n=" << s_recreatedN << " MB=" << double(s_recreatedBytes) / 1048576.0
+             << " after <1s/1-5s/5-30s/30-60s/60-300s=" << s_recreatedBucket[0] << "/" << s_recreatedBucket[1] << "/"
+             << s_recreatedBucket[2] << "/" << s_recreatedBucket[3] << "/" << s_recreatedBucket[4] << " released=" << s_released.size();
+          s_uploadsN = s_uploadsBytes = s_repeatsN = s_repeatsBytes = 0;
+          s_fullRepeatsN = s_fullRepeatsBytes = s_sampledOnlyN = s_recreatedN = s_recreatedBytes = 0;
+          for (int64_t& b : s_recreatedBucket) {
