+               << " L=" << s.levels << " u=" << format_string("0x%x", s.usage) << " p=" << s.pool << " +" << s.created
+               << " upMB=" << double(u.bytes) / 1048576.0 << " rep=" << (u.bytes ? 100.0 * double(u.repBytes) / double(u.bytes) : 0.0)
