+          sum[k] += double(view.texels[j].albedo[k]) * pScales[l * 3 + k] * (pDirect[at] + pIndirect[at]) / view.rays;
+        }
+      }
+    }
+    for (int k = 0; k < 3; ++k) {
+      out[k] = float(sum[k]);
+    }
+  }
