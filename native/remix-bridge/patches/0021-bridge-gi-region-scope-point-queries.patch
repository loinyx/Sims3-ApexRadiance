+  // Counts the texels of a sum layer over 0.5/255 and their box.
+  uint32_t litTexels(const SceneView& view, const float* pDirect, const float* pIndirect, float box[6]) {
+    uint32_t count = 0;
+    for (size_t i = 0; i < view.texels.size(); ++i) {
+      float value = 0.0f;
+      for (int c = 0; c < 3; ++c) {
+        value = std::max(value, pDirect[i * 4 + c] + (pIndirect != nullptr ? pIndirect[i * 4 + c] : 0.0f));
+      }
+      if (value <= 0.5f / 255.0f) {
+        continue;
+      }
+      for (int c = 0; c < 3; ++c) {
+        box[c] = count ? std::min(box[c], view.texels[i].position[c]) : view.texels[i].position[c];
+        box[c + 3] = count ? std::max(box[c + 3], view.texels[i].position[c]) : view.texels[i].position[c];
+      }
+      ++count;
+    }
+    return count;
+  }
+
+  // Reads a lamp's touch box and checks it against the texels its sum layer lights.
+  uint32_t checkTouch(const SceneView& view, uint32_t lamp, const float* pDirect, const float* pIndirect, const char* pName) {
+    float box[6] = {};
+    uint32_t texels = 0;
+    expect(g_readTouch(lamp, box, &texels), S_OK, "RemixBridge_GiReadTouch");
+    float expectedBox[6] = {};
+    const uint32_t expected = litTexels(view, pDirect, pIndirect, expectedBox);
+    float boxDifference = 0.0f;
+    for (int c = 0; c < 6; ++c) {
+      boxDifference = std::max(boxDifference, std::fabs(box[c] - expectedBox[c]));
+    }
+    // The layer read back is half float, so a texel at the threshold may count on one side only.
+    const uint32_t slack = 2 + expected / 100;
+    if (texels + slack < expected || texels > expected + slack || (expected > 0 && boxDifference > 1.0f)) {
+      std::printf("    %s: touch box of %u texels (%.1f %.1f %.1f .. %.1f %.1f %.1f), the layer lights %u, box off by %.2f m.\n", pName, texels,
+                  box[0], box[1], box[2], box[3], box[4], box[5], expected, boxDifference);
+      throw std::runtime_error("A touch box differs from the texels its layer lights");
+    }
+    return texels;
+  }
