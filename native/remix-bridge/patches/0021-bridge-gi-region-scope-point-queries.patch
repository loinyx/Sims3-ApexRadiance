+      };
+      double total = 0.0;
+      for (double us : gpuUs) {
+        total += us;
+      }
+      std::printf("    a layer (direct + 16 gathers): GPU %.0f us median, %.0f us p90, %.0f us max, all %u layers %.1f ms; longest slice %u us.\n",
+                  pct(gpuUs, 0.5), pct(gpuUs, 0.9), pct(gpuUs, 1.0), file.lamps, total / 1000.0, sliceMax);
+      std::printf("    touch box: median %.0f texels, max %.0f; the offline unscoped layer lights median %.0f, max %.0f.\n", pct(touched, 0.5), pct(touched, 1.0),
+                  pct(offline, 0.5), pct(offline, 1.0));
+      std::printf("    inside the boxes %.3f %% of %zu texel values within 1/255 of the offline solve; %zu lit texels outside a box; layers hash %016llx.\n",
+                  100.0 * double(inside - off) / double(inside), inside, leaks, static_cast<unsigned long long>(hash));
+      if (leaks != 0) {
+        throw std::runtime_error("A scoped lamp lit a texel outside its box");
+      }
+    }
+  }
