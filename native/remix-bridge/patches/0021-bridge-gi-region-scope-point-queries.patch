+  // Sends a query and waits for its answer, presenting as a game does. Returns the poll's result.
+  HRESULT queryPoints(IDirect3DDevice9* pDevice, const std::vector<float>& points, const std::vector<float>& scales, uint32_t sceneTicket,
+                      std::vector<float>& irradiance) {
+    uint32_t ticket = 0;
+    check(g_queryPoints(points.data(), uint32_t(points.size() / 6), scales.data(), uint32_t(scales.size() / 3), sceneTicket, &ticket), "RemixBridge_GiQueryPoints");
+    uint32_t second = 0;
+    expect(g_queryPoints(points.data(), 1, nullptr, 0, sceneTicket, &second), D3DERR_WASSTILLDRAWING, "RemixBridge_GiQueryPoints while one is in flight");
+    irradiance.assign(points.size() / 6 * 4, -1.0f);
+    const ULONGLONG deadline = GetTickCount64() + 30000;
+    HRESULT result;
+    while ((result = g_readPoints(ticket, irradiance.data(), uint32_t(points.size() / 6))) == S_FALSE) {
+      if (GetTickCount64() >= deadline) {
+        throw std::runtime_error("The GI query was not answered within thirty seconds");
+      }
+      check(pDevice->Present(nullptr, nullptr, nullptr, nullptr), "Present");
+    }
+    return result;
+  }
