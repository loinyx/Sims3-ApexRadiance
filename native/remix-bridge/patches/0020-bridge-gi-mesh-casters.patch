+
+#pragma comment(lib, "shell32.lib")
+
+// Server side of RemixBridge_GiObjects (mesh casters, MC-2). The GI worker builds the package index once, at the first
+// batch (batches sent meanwhile wait in its queue), and resolves each object's LITE to its model's caster mesh
+// (ts3_meshes.h: the shadow LOD, else LOD 0). The play thread hands the meshes and the placed objects to the per-pixel
+// pass (gi_pixel_server.h). The game's data is read from the player's install; nothing of it leaves the process.
+//   server.giMeshGame: the game's folder (default: three levels up from this executable's folder, Game\Bin\.trex)
+//   server.giMeshMods: the Mods folder (default: Documents\Electronic Arts\The Sims 3\Mods; "off": none)
+namespace gi_objects {
+  using bridge_util::GiObject;
+
+  struct Mesh {
+    std::vector<float> pos;     // xyz a vertex, model space
+    std::vector<uint32_t> tri;  // abc a triangle
+  };
+  struct Placed {
+    uint32_t mesh;  // index into g_meshes
+    float m[12];
+  };
+
+  // Written by the worker, read by the play thread, both under g_mutex
+  inline std::mutex g_mutex;
+  inline std::deque<Mesh> g_meshes;                  // append-only
+  inline std::unordered_map<uint64_t, Placed> g_placed;  // the objects with a mesh, by id
+  inline uint32_t g_generation = 0;                   // grows with every change of the two above
+
+  // Worker only
+  constexpr uint32_t kMissing = ~0u;
+  constexpr size_t kMaxObjects = 1u << 16;  // shortcut: a table over 65536 live objects refuses new ones; raise if the counter shows drops
+  inline std::unique_ptr<ts3mesh::Library> g_library;
+  inline std::unordered_map<uint64_t, uint32_t> g_liteMesh;  // LITE instance -> mesh, or kMissing
+  inline std::map<ts3mesh::Key, uint32_t> g_modelMesh;       // MODL -> mesh (two LITEs may name one model)
+  inline std::unordered_map<uint64_t, uint64_t> g_live;      // every placed object (with a mesh or not) -> its LITE
+
+  inline std::filesystem::path gameFolder() {
+    const std::string option = bridge_util::Config::getOption<std::string>("server.giMeshGame", "");
+    if (!option.empty()) {
+      return std::filesystem::u8path(option);
+    }
+    wchar_t exe[MAX_PATH] = {};
+    GetModuleFileNameW(nullptr, exe, MAX_PATH);
+    return std::filesystem::path(exe).parent_path().parent_path().parent_path().parent_path();
+  }
+
+  inline std::filesystem::path modsFolder() {
+    const std::string option = bridge_util::Config::getOption<std::string>("server.giMeshMods", "");
+    if (option == "off") {
+      return {};
+    }
+    if (!option.empty()) {
+      return std::filesystem::u8path(option);
+    }
+    PWSTR documents = nullptr;
+    std::filesystem::path path;
+    if (SUCCEEDED(SHGetKnownFolderPath(FOLDERID_Documents, 0, nullptr, &documents))) {
+      path = std::filesystem::path(documents) / L"Electronic Arts" / L"The Sims 3" / L"Mods";
+    }
+    CoTaskMemFree(documents);
+    return path;
+  }
+
+  inline void buildIndex(bridge_util::GiSharedBlock* pBlock) {
+    const auto start = std::chrono::steady_clock::now();
+    g_library = std::make_unique<ts3mesh::Library>();
+    std::error_code ec;
+    g_library->AddFolder(gameFolder(), true);
+    const uint32_t gamePackages = g_library->GetStats().packages;
+    const std::filesystem::path mods = modsFolder();
+    if (!mods.empty() && std::filesystem::is_directory(mods, ec)) {
+      g_library->AddFolder(mods, false);
+    }
+    const ts3mesh::Library::Stats& stats = g_library->BuildLinks();
+    const uint32_t ms = uint32_t(std::chrono::duration_cast<std::chrono::milliseconds>(std::chrono::steady_clock::now() - start).count());
+    pBlock->objectCounters[bridge_util::GiIndexLinks] = uint32_t(g_library->LinkCount());
+    pBlock->objectCounters[bridge_util::GiIndexMs] = ms;
+    pBlock->objectCounters[bridge_util::GiIndexReady] = gamePackages != 0 ? 1 : 2;
+    bridge_util::Logger::info(bridge_util::format_string(
+      "[GiMesh] Package index: %u packages (%u of the game, %u unreadable), %u LITEs linked to a model, %u ms.", stats.packages, gamePackages,
+      stats.unreadablePackages, uint32_t(g_library->LinkCount()), ms));
+    if (gamePackages == 0) {
+      bridge_util::Logger::warn("[GiMesh] No game package was found (server.giMeshGame), so no object gets a mesh.");
+    }
+  }
+
+  // The mesh of a LITE, read once; kMissing when the index has no model for it or the model has no readable mesh
+  inline uint32_t resolve(uint64_t lite, bridge_util::GiSharedBlock* pBlock) {
+    const auto known = g_liteMesh.find(lite);
+    if (known != g_liteMesh.end()) {
+      return known->second;
+    }
+    uint32_t index = kMissing;
+    if (const ts3mesh::Key* pModel = g_library->ModelOfLite(lite)) {
+      const auto shared = g_modelMesh.find(*pModel);
+      if (shared != g_modelMesh.end()) {
+        index = shared->second;
+      } else {
+        ts3mesh::Mesh mesh;
+        if (g_library->Load(*pModel, mesh, true)) {
+          std::lock_guard<std::mutex> lock(g_mutex);
+          g_meshes.push_back(Mesh { std::move(mesh.pos), std::move(mesh.tri) });
+          index = uint32_t(g_meshes.size() - 1);
+        }
+        g_modelMesh.emplace(*pModel, index);
+      }
+    }
+    g_liteMesh.emplace(lite, index);
+    ++pBlock->objectCounters[index != kMissing ? bridge_util::GiModelsResolved : bridge_util::GiModelsMissing];
+    return index;
+  }
+
+  // Worker: one batch of GiObject records, in order
+  inline void apply(const std::vector<uint8_t>& blob) {
+    bridge_util::GiSharedBlock* const pBlock = bridge_util::giBlock();
+    if (pBlock == nullptr || blob.size() % sizeof(GiObject) != 0) {
+      return;
+    }
+    if (!g_library) {
+      buildIndex(pBlock);
+    }
+    const size_t count = blob.size() / sizeof(GiObject);
+    for (size_t i = 0; i < count; ++i) {
+      GiObject object;
+      std::memcpy(&object, blob.data() + i * sizeof(GiObject), sizeof(GiObject));
+      if (object.flags & bridge_util::GiObjectRemoved) {
+        g_live.erase(object.id);
+        std::lock_guard<std::mutex> lock(g_mutex);
+        g_generation += g_placed.erase(object.id) != 0 ? 1 : 0;
+        continue;
+      }
+      bool finite = true;
+      for (float v : object.m) {
+        finite = finite && std::isfinite(v) && std::fabs(v) < 1e6f;
+      }
+      if (!finite || (g_live.size() >= kMaxObjects && g_live.count(object.id) == 0)) {
+        ++pBlock->objectCounters[bridge_util::GiObjectsDropped];
+        continue;
+      }
+      g_live[object.id] = object.lite;
+      const uint32_t mesh = resolve(object.lite, pBlock);
+      std::lock_guard<std::mutex> lock(g_mutex);
+      if (mesh != kMissing) {
+        Placed& placed = g_placed[object.id];
+        placed.mesh = mesh;
+        std::memcpy(placed.m, object.m, sizeof(placed.m));
+      } else {
+        g_placed.erase(object.id);  // (its LITE changed to one without a mesh)
+      }
+      ++g_generation;
+    }
+    pBlock->objectCounters[bridge_util::GiObjectsLive] = uint32_t(g_live.size());
+  }
+}
