+// Sends placed objects through RemixBridge_GiObjects and checks what the server made of them: the package index of the
+// game's folder, a chair's LITE resolved to its caster mesh, an unknown LITE counted missing, a removed object gone.
+// With the per-pixel pass on (REMIX_GI_TEST_CASE=on, a DXVK with external passes and ray queries in REMIX_GI_TEST_DXVK),
+// the chair then shadows the floor: each quarter pixel's share of the lamp's 16 rays that pass the chair (den with the
+// chair over den without it) is compared with a CPU ray cast of the same rays against the same triangles.
+// REMIX_GI_MESH_GAME: the game's folder. REMIX_GI_MESH_OBJECTS: the chair's file of meshes_check.cpp --objects (its
+// LITE and its caster mesh, which the server must read the same).
+
+#include <algorithm>
+#include <cmath>
+#include <cstdio>
+#include <cstring>
+#include <fstream>
+#include <stdexcept>
+#include <string>
+#include <vector>
+
+#include <DirectXMath.h>
+#include <wrl/client.h>
+
+#include "test_remix_api_bridge_app.h"
+#include "../../../src/util/gi_pixel_block.h"
+
+using Microsoft::WRL::ComPtr;
+using namespace bridge_app_test;
+using namespace DirectX;
+
+namespace {
+  struct GiObject {  // util_gi.h
+    uint64_t id;
+    uint64_t lite;
+    float m[12];
+    uint32_t flags;
+    uint32_t reserved;
+  };
+  static_assert(sizeof(GiObject) == 72, "GiObject layout");
+
+  using PFN_GiOpen = HRESULT (__stdcall*)(uint32_t*);
+  using PFN_GiObjects = HRESULT (__stdcall*)(const GiObject*, uint32_t);
+  using PFN_GiReadCounters = HRESULT (__stdcall*)(uint32_t*, uint32_t);
+  using PFN_GiPixelOpen = HRESULT (__stdcall*)(uint32_t*);
+  using PFN_GiPixelPass = HRESULT (__stdcall*)(const void*, uint32_t, IDirect3DTexture9*, IDirect3DTexture9*, IDirect3DTexture9* const*);
+  using PFN_GiPixelReadCounters = HRESULT (__stdcall*)(uint32_t*, uint32_t);
+
+  // Words of RemixBridge_GiReadCounters: 14 + GiObjectCounter
+  enum { kLive = 14, kResolved, kMissing, kReady, kLinks, kIndexMs, kDropped, kWords = 22 };
+
+  constexpr UINT kWidthFull = 640;
+  constexpr UINT kHeightFull = 360;
+  constexpr UINT kWidthQuarter = kWidthFull / 4;
+  constexpr UINT kHeightQuarter = kHeightFull / 4;
+  constexpr uint64_t kUnknownLite = 0x0123456789ABCDEFull;
+
+  PFN_GiOpen g_giOpen = nullptr;
+  PFN_GiObjects g_objects = nullptr;
+  PFN_GiReadCounters g_giCounters = nullptr;
+  PFN_GiPixelOpen g_pixelOpen = nullptr;
+  PFN_GiPixelPass g_pass = nullptr;
+  PFN_GiPixelReadCounters g_pixelCounters = nullptr;
+
+  void check(HRESULT result, const char* pCall) {
+    if (FAILED(result)) {
+      std::printf("FAILED: %s returned 0x%08lX.\n", pCall, static_cast<unsigned long>(result));
+      throw std::runtime_error(pCall);
+    }
+  }
+
+  void require(bool condition, const char* pWhat) {
+    if (!condition) {
+      std::printf("FAILED: %s.\n", pWhat);
+      throw std::runtime_error(pWhat);
+    }
+  }
+
+  float halfToFloat(uint16_t half) {
+    const int exponent = (half >> 10) & 31;
+    const int mantissa = half & 1023;
+    const float value = exponent == 0 ? std::ldexp(float(mantissa), -24) : std::ldexp(float(mantissa | 1024), exponent - 25);
+    return (half & 0x8000) ? -value : value;
+  }
+
+  struct Chair {
+    uint64_t lite = 0;
+    std::vector<float> pos;
+    std::vector<uint32_t> tri;
+  };
+
+  // meshes_check.cpp --objects: "MCOB", LITE (u64), vertices (u32), triangles (u32), xyz each, abc each
+  Chair readChair(const char* pPath) {
+    std::ifstream f(pPath, std::ios::binary);
+    char magic[4] = {};
+    uint32_t vertices = 0;
+    uint32_t triangles = 0;
+    Chair chair;
+    f.read(magic, 4);
+    f.read(reinterpret_cast<char*>(&chair.lite), 8);
+    f.read(reinterpret_cast<char*>(&vertices), 4);
+    f.read(reinterpret_cast<char*>(&triangles), 4);
+    require(f && std::memcmp(magic, "MCOB", 4) == 0 && vertices > 0 && vertices < (1u << 20) && triangles > 0 && triangles < (1u << 20),
+            "The objects file reads");
+    chair.pos.resize(size_t(vertices) * 3);
+    chair.tri.resize(size_t(triangles) * 3);
+    f.read(reinterpret_cast<char*>(chair.pos.data()), chair.pos.size() * 4);
+    f.read(reinterpret_cast<char*>(chair.tri.data()), chair.tri.size() * 4);
+    require(bool(f), "The objects file reads");
+    return chair;
+  }
+
+  // The chair turned by 30 degrees about the vertical and moved: model to world, three rows of four.
+  void chairMatrix(float m[12]) {
+    const float c = std::cos(0.5235988f);
+    const float s = std::sin(0.5235988f);
+    const float rows[12] = { c, 0, s, 0.2f, 0, 1, 0, 0, -s, 0, c, 0.1f };
+    std::memcpy(m, rows, sizeof(rows));
+  }
+
+  struct Scene {
+    XMMATRIX view;
+    XMMATRIX projection;
+    XMMATRIX viewProj;
+    XMVECTOR eye;
+    GiPixelBlock block = {};
+
+    Scene() {
+      eye = XMVectorSet(0.3f, 3.5f, -2.5f, 1);
+      view = XMMatrixLookAtLH(eye, XMVectorSet(0.2f, 0, 0.3f, 1), XMVectorSet(0, 1, 0, 0));
+      projection = XMMatrixPerspectiveFovLH(XM_PI / 3, float(kWidthFull) / kHeightFull, 0.1f, 50.0f);
+      viewProj = view * projection;
+      XMStoreFloat4x4(reinterpret_cast<XMFLOAT4X4*>(block.invViewProj), XMMatrixInverse(nullptr, viewProj));
+      XMStoreFloat3(reinterpret_cast<XMFLOAT3*>(block.cam), eye);
+      XMStoreFloat3(reinterpret_cast<XMFLOAT3*>(block.viewZ), XMVector3Normalize(XMVectorSubtract(XMVectorSet(0.2f, 0, 0.3f, 1), eye)));
+      block.ambient = 0.05f;
+      block.zFar = 50.0f;
+      block.bias = 0.01f;
+      block.radiusScale = 1.0f;
+      block.samples = 16;
+      block.lamps = 1;
+      block.lamp[0] = { { 0.5f, 2.2f, 0.4f }, 0.08f, { 10, 10, 10 }, 0 };
+      // No capsule and no caster bounds: the chair's mesh bounds alone must make the pass trace (XR-08).
+      block.capsules = 0;
+      block.casters = 0;
+    }
+  };
+
+  struct Targets {
+    ComPtr<IDirect3DTexture9> pDepth;
+    ComPtr<IDirect3DSurface9> pDepthSurface;
+    ComPtr<IDirect3DTexture9> pColor;
+    ComPtr<IDirect3DSurface9> pColorSurface;
+    ComPtr<IDirect3DTexture9> outputs[kGiPixelOutputs];
+
+    void create(IDirect3DDevice9* pDevice) {
+      check(pDevice->CreateTexture(kWidthFull, kHeightFull, 1, D3DUSAGE_DEPTHSTENCIL, static_cast<D3DFORMAT>(MAKEFOURCC('I', 'N', 'T', 'Z')),
+                                   D3DPOOL_DEFAULT, &pDepth, nullptr), "CreateTexture (INTZ)");
+      check(pDepth->GetSurfaceLevel(0, &pDepthSurface), "GetSurfaceLevel (depth)");
+      check(pDevice->CreateTexture(kWidthFull, kHeightFull, 1, D3DUSAGE_RENDERTARGET, D3DFMT_A8R8G8B8, D3DPOOL_DEFAULT, &pColor, nullptr),
+            "CreateTexture (color)");
+      check(pColor->GetSurfaceLevel(0, &pColorSurface), "GetSurfaceLevel (color)");
+      for (auto& pOutput : outputs) {
+        check(pDevice->CreateTexture(kWidthQuarter, kHeightQuarter, 1, D3DUSAGE_RENDERTARGET, D3DFMT_A16B16G16R16F, D3DPOOL_DEFAULT,
+                                     &pOutput, nullptr), "CreateTexture (output)");
+      }
+    }
+  };
+
+  // The floor alone goes into the depth: the chair is a caster only, so the floor under it is shaded too.
+  void draw(IDirect3DDevice9* pDevice, const Targets& targets, const Scene& scene) {
+    static const float kFloor[4][3] = { { -8, 0, -8 }, { -8, 0, 8 }, { 8, 0, -8 }, { 8, 0, 8 } };
+    check(pDevice->SetRenderTarget(0, targets.pColorSurface.Get()), "SetRenderTarget");
+    check(pDevice->SetDepthStencilSurface(targets.pDepthSurface.Get()), "SetDepthStencilSurface");
+    check(pDevice->Clear(0, nullptr, D3DCLEAR_TARGET | D3DCLEAR_ZBUFFER, 0, 1.0f, 0), "Clear");
+    check(pDevice->BeginScene(), "BeginScene");
+    XMFLOAT4X4 matrix;
+    XMStoreFloat4x4(&matrix, scene.view);
+    pDevice->SetTransform(D3DTS_VIEW, reinterpret_cast<D3DMATRIX*>(&matrix));
+    XMStoreFloat4x4(&matrix, scene.projection);
+    pDevice->SetTransform(D3DTS_PROJECTION, reinterpret_cast<D3DMATRIX*>(&matrix));
+    pDevice->SetRenderState(D3DRS_LIGHTING, FALSE);
+    pDevice->SetRenderState(D3DRS_CULLMODE, D3DCULL_NONE);
+    pDevice->SetRenderState(D3DRS_ZENABLE, TRUE);
+    pDevice->SetFVF(D3DFVF_XYZ);
+    check(pDevice->DrawPrimitiveUP(D3DPT_TRIANGLESTRIP, 2, kFloor, 12), "DrawPrimitiveUP");
+    check(pDevice->EndScene(), "EndScene");
+  }
+
+  // Returns the red channel of output `which` (2 num, 3 den) after a 16-sample pass, quarter resolution; with `pass` false
+  // reads the outputs of the last pass again.
+  std::vector<float> passRed(IDirect3DDevice9* pDevice, const Targets& targets, const Scene& scene, IDirect3DSurface9* pReadback, int which, bool pass = true) {
+    IDirect3DTexture9* const outputs[kGiPixelOutputs] = { targets.outputs[0].Get(), targets.outputs[1].Get(), targets.outputs[2].Get(),
+                                                          targets.outputs[3].Get() };
+    for (int frame = 0; pass && frame < 2; ++frame) {
+      draw(pDevice, targets, scene);
+      check(g_pass(&scene.block, sizeof(scene.block), targets.pDepth.Get(), nullptr, outputs), "RemixBridge_GiPixelPass");
+      check(pDevice->Present(nullptr, nullptr, nullptr, nullptr), "Present");
+    }
+    ComPtr<IDirect3DSurface9> pSurface;
+    check(targets.outputs[which]->GetSurfaceLevel(0, &pSurface), "GetSurfaceLevel (output)");
+    check(pDevice->GetRenderTargetData(pSurface.Get(), pReadback), "GetRenderTargetData");
+    D3DLOCKED_RECT locked;
+    check(pReadback->LockRect(&locked, nullptr, D3DLOCK_READONLY), "LockRect");
+    std::vector<float> den(size_t(kWidthQuarter) * kHeightQuarter);
+    for (UINT y = 0; y < kHeightQuarter; ++y) {
+      const uint16_t* const pRow = reinterpret_cast<const uint16_t*>(static_cast<const uint8_t*>(locked.pBits) + y * locked.Pitch);
+      for (UINT x = 0; x < kWidthQuarter; ++x) {
+        den[y * kWidthQuarter + x] = halfToFloat(pRow[x * 4]);
+      }
+    }
+    pReadback->UnlockRect();
+    return den;
+  }
+
+  // Möller-Trumbore, two-sided: the segment from o along the unit d up to tMax.
+  bool hits(const float* o, const float* d, float tMax, const float* a, const float* b, const float* c) {
+    const float e1[3] = { b[0] - a[0], b[1] - a[1], b[2] - a[2] };
+    const float e2[3] = { c[0] - a[0], c[1] - a[1], c[2] - a[2] };
+    const float p[3] = { d[1] * e2[2] - d[2] * e2[1], d[2] * e2[0] - d[0] * e2[2], d[0] * e2[1] - d[1] * e2[0] };
+    const float det = e1[0] * p[0] + e1[1] * p[1] + e1[2] * p[2];
+    if (std::fabs(det) < 1e-12f) {
+      return false;
+    }
+    const float inv = 1.0f / det;
+    const float s[3] = { o[0] - a[0], o[1] - a[1], o[2] - a[2] };
+    const float u = (s[0] * p[0] + s[1] * p[1] + s[2] * p[2]) * inv;
+    if (u < 0 || u > 1) {
+      return false;
+    }
+    const float q[3] = { s[1] * e1[2] - s[2] * e1[1], s[2] * e1[0] - s[0] * e1[2], s[0] * e1[1] - s[1] * e1[0] };
+    const float v = (d[0] * q[0] + d[1] * q[1] + d[2] * q[2]) * inv;
+    if (v < 0 || u + v > 1) {
+      return false;
+    }
+    const float t = (e2[0] * q[0] + e2[1] * q[1] + e2[2] * q[2]) * inv;
+    return t > 0 && t < tMax;
+  }
+
+  // The kernel's rays for one quarter pixel (pixel_shadow.comp: the block's least-depth pixel, the biased origin, the
+  // Fibonacci set of 16 points on the emitter ball), cast on the CPU. Returns how many pass the chair, or -1 off the floor.
+  int cpuUnblocked(const Scene& scene, const std::vector<float>& world, int gx, int gy) {
+    const XMMATRIX inverse = XMMatrixInverse(nullptr, scene.viewProj);
+    float best = 4.0f;
+    float point[3] = {};
+    for (int j = 0; j < 4; ++j) {
+      for (int i = 0; i < 4; ++i) {
+        const float ndcX = (float(gx * 4 + i) + 0.5f) / kWidthFull * 2 - 1;
+        const float ndcY = 1 - (float(gy * 4 + j) + 0.5f) / kHeightFull * 2;
+        const XMVECTOR nearPoint = XMVector3TransformCoord(XMVectorSet(ndcX, ndcY, 0, 1), inverse);
+        const XMVECTOR farPoint = XMVector3TransformCoord(XMVectorSet(ndcX, ndcY, 1, 1), inverse);
+        const float y0 = XMVectorGetY(nearPoint);
+        const float y1 = XMVectorGetY(farPoint);
+        if (y0 <= 0 || y1 >= 0) {
+          continue;
+        }
+        const XMVECTOR onFloor = XMVectorLerp(nearPoint, farPoint, y0 / (y0 - y1));
+        const XMVECTOR clip = XMVector4Transform(XMVectorSetW(onFloor, 1), scene.viewProj);
+        const float depth = XMVectorGetZ(clip) / XMVectorGetW(clip);
+        if (depth < best - 1e-7f) {
+          best = depth;
+          XMStoreFloat3(reinterpret_cast<XMFLOAT3*>(point), onFloor);
+        }
+      }
+    }
+    // Only the floor around the chair.
+    if (best >= 1.0f || std::hypot(point[0] - 0.2f, point[2] - 0.1f) > 3.0f) {
+      return -1;
+    }
+    const float toCam = std::sqrt((scene.block.cam[0] - point[0]) * (scene.block.cam[0] - point[0]) + (scene.block.cam[1] - point[1]) * (scene.block.cam[1] - point[1]) +
+                                  (scene.block.cam[2] - point[2]) * (scene.block.cam[2] - point[2]));
+    const float origin[3] = { point[0], point[1] + scene.block.bias * (1 + 0.25f * toCam), point[2] };
+    const GiPixelLamp& lamp = scene.block.lamp[0];
+    int unblocked = 0;
+    for (int n = 0; n < 16; ++n) {
+      const float y = 1 - (2 * float(n) + 1) / 16;
+      const float r = std::sqrt(1 - y * y);
+      const float a = 2.39996323f * float(n);
+      const float e[3] = { lamp.pos[0] + lamp.radius * r * std::cos(a) - origin[0], lamp.pos[1] + lamp.radius * y - origin[1],
+                           lamp.pos[2] + lamp.radius * r * std::sin(a) - origin[2] };
+      const float length = std::sqrt(e[0] * e[0] + e[1] * e[1] + e[2] * e[2]);
+      const float d[3] = { e[0] / length, e[1] / length, e[2] / length };
+      bool blocked = false;
+      for (size_t t = 0; t + 9 <= world.size() && !blocked; t += 9) {
+        blocked = hits(origin, d, length - 1e-3f, &world[t], &world[t + 3], &world[t + 6]);
+      }
+      unblocked += blocked ? 0 : 1;
+    }
+    return unblocked;
+  }
+
+  void present(IDirect3DDevice9* pDevice) {
+    pDevice->Present(nullptr, nullptr, nullptr, nullptr);
+    Sleep(5);
+  }
+
+  void readCounters(uint32_t* pWords) {
+    check(g_giCounters(pWords, kWords), "RemixBridge_GiReadCounters");
+  }
+
+  // Presents until the server's object counters satisfy the condition, at most two minutes (a cold index takes seconds).
+  template <class F> void waitCounters(IDirect3DDevice9* pDevice, uint32_t* pWords, F&& done, const char* pWhat) {
+    for (int frame = 0; frame < 24000; ++frame) {
+      readCounters(pWords);
+      if (done(pWords)) {
+        return;
+      }
+      present(pDevice);
+    }
+    std::printf("FAILED: %s: objects=%u resolved=%u missing=%u indexReady=%u.\n", pWhat, pWords[kLive], pWords[kResolved], pWords[kMissing], pWords[kReady]);
+    throw std::runtime_error(pWhat);
+  }
+
+  void runMeshes(IDirect3DDevice9* pDevice, const Chair& chair, bool pixel) {
+    uint32_t level = 0;
+    HRESULT opened = S_FALSE;
+    for (int frame = 0; frame < 2000 && opened == S_FALSE; ++frame) {
+      opened = g_giOpen(&level);
+      check(opened, "RemixBridge_GiOpen");
+      present(pDevice);
+    }
+    require(opened == S_OK, "RemixBridge_GiOpen answers");
+    std::printf("GI level %u.\n", level);
+
+    GiObject objects[4] = {};
+    objects[0].id = 1, objects[0].lite = chair.lite;
+    chairMatrix(objects[0].m);
+    objects[1].id = 2, objects[1].lite = kUnknownLite;
+    chairMatrix(objects[1].m);
+    objects[2].id = 3, objects[2].lite = chair.lite;
+    chairMatrix(objects[2].m);
+    objects[2].m[3] = 5, objects[2].m[11] = 5;
+    objects[3] = objects[2];
+    objects[3].flags = 1;  // GiObjectRemoved
+    check(g_objects(objects, 4), "RemixBridge_GiObjects");
+    present(pDevice);
+
+    uint32_t words[kWords] = {};
+    waitCounters(pDevice, words, [](const uint32_t* w) { return w[kReady] != 0 && w[kLive] == 2; }, "The index is built and two objects live");
+    std::printf("[GiMesh] objects=%u resolved=%u missing=%u indexReady=%u links=%u indexMs=%u dropped=%u\n", words[kLive], words[kResolved],
+                words[kMissing], words[kReady], words[kLinks], words[kIndexMs], words[kDropped]);
+    require(words[kReady] == 1 && words[kLinks] > 0, "The index found the game's packages");
+    require(words[kResolved] == 1 && words[kMissing] == 1 && words[kDropped] == 0, "The chair resolved once, the unknown LITE is missing");
+    if (!pixel) {
+      return;
+    }
+
+    uint32_t state = 0;
+    HRESULT pixelOpened = S_FALSE;
+    for (int frame = 0; frame < 600 && pixelOpened == S_FALSE; ++frame) {
+      pixelOpened = g_pixelOpen(&state);
+      check(pixelOpened, "RemixBridge_GiPixelOpen");
+      present(pDevice);
+    }
+    require(pixelOpened == S_OK && state == 1, "The per-pixel pass is on");
+
+    Scene scene;
+    Targets targets;
+    targets.create(pDevice);
+    ComPtr<IDirect3DSurface9> pReadback;
+    check(pDevice->CreateOffscreenPlainSurface(kWidthQuarter, kHeightQuarter, D3DFMT_A16B16G16R16F, D3DPOOL_SYSTEMMEM, &pReadback, nullptr),
+          "CreateOffscreenPlainSurface");
+    const std::vector<float> den = passRed(pDevice, targets, scene, pReadback.Get(), 3);
+    const std::vector<float> num = passRed(pDevice, targets, scene, pReadback.Get(), 2, false);
+    uint32_t pixelWords[11] = {};
+    check(g_pixelCounters(pixelWords, 11), "RemixBridge_GiPixelReadCounters");
+    std::printf("[GiPixel] passes=%u faults=%u meshes=%u models=%u\n", pixelWords[1], pixelWords[2], pixelWords[9], pixelWords[10]);
+    require(pixelWords[2] == 0 && pixelWords[9] == 1 && pixelWords[10] == 1, "One mesh instance of one model, no fault");
+
+    // The same pass without the chair: no caster at all, so no pixel traces.
+    objects[0].flags = 1;
+    check(g_objects(objects, 1), "RemixBridge_GiObjects (removal)");
+    waitCounters(pDevice, words, [](const uint32_t* w) { return w[kLive] == 1; }, "The chair is removed");
+    const std::vector<float> without = passRed(pDevice, targets, scene, pReadback.Get(), 3);
+    check(g_pixelCounters(pixelWords, 11), "RemixBridge_GiPixelReadCounters");
+    require(pixelWords[9] == 0, "No mesh instance after the removal");
+    require(std::all_of(without.begin(), without.end(), [](float v) { return v == 0; }), "No pixel traces without a caster");
+
+    // The chair in the world, for the CPU rays.
+    float m[12];
+    chairMatrix(m);
+    std::vector<float> world;
+    for (uint32_t index : chair.tri) {
+      const float* p = &chair.pos[size_t(index) * 3];
+      for (int row = 0; row < 3; ++row) {
+        world.push_back(m[row * 4] * p[0] + m[row * 4 + 1] * p[1] + m[row * 4 + 2] * p[2] + m[row * 4 + 3]);
+      }
+    }
+    // The chair is a delta caster (MC-2, XR-08): den counts every sample that reached the lamp past the static occluders
+    // (all 16 here), num the share of those the chair blocked; a pixel out of the chair's reach traces nothing (den 0).
+    uint32_t compared = 0, shadowed = 0, off = 0, missed = 0;
+    double sumDiff = 0;
+    for (int gy = 0; gy < int(kHeightQuarter); ++gy) {
+      for (int gx = 0; gx < int(kWidthQuarter); ++gx) {
+        const int cpu = cpuUnblocked(scene, world, gx, gy);
+        if (cpu < 0) {
+          continue;
+        }
+        const float full = den[gy * kWidthQuarter + gx];
+        if (full <= 0) {
+          missed += cpu < 16 ? 1 : 0;
+          continue;
+        }
+        const float gpu = 16 - num[gy * kWidthQuarter + gx] / full * 16;
+        const float diff = std::fabs(gpu - float(cpu));
+        ++compared;
+        shadowed += cpu < 16 ? 1 : 0;
+        off += diff > 2.5f ? 1 : 0;
+        sumDiff += diff / 16;
+      }
+    }
+    const double mean = compared ? sumDiff / compared : 1;
+    std::printf("Chair shadow against the CPU rays: %u pixels compared, %u shadowed on the CPU, %u off by more than 2 of 16 rays, mean difference %.4f, "
+                "%u shadowed pixels out of reach.\n", compared, shadowed, off, mean, missed);
+    require(compared > 500 && shadowed > 100, "The chair shadows a part of the floor (pixels in its reach)");
+    require(missed == 0, "Every pixel the chair shadows is in the reach of its mesh bounds");
+    require(off <= compared / 100 && mean < 0.01, "The chair's shadow equals the CPU rays within tolerance");
+  }
+}
+
+int main() {
+  std::setvbuf(stdout, nullptr, _IONBF, 0);
+  char dxvk[MAX_PATH] = {};
+  GetEnvironmentVariableA("REMIX_GI_TEST_DXVK", dxvk, sizeof(dxvk));
+  char testCase[16] = {};
+  GetEnvironmentVariableA("REMIX_GI_TEST_CASE", testCase, sizeof(testCase));
+  char game[MAX_PATH] = {};
+  GetEnvironmentVariableA("REMIX_GI_MESH_GAME", game, sizeof(game));
+  char objectsFile[MAX_PATH] = {};
+  GetEnvironmentVariableA("REMIX_GI_MESH_OBJECTS", objectsFile, sizeof(objectsFile));
+  const bool pixel = std::string(testCase) == "on";
+  WNDCLASSW windowClass = {};
+  windowClass.lpfnWndProc = DefWindowProcW;
+  windowClass.hInstance = GetModuleHandleW(nullptr);
+  windowClass.lpszClassName = L"BridgeGiMeshTest";
+  RegisterClassW(&windowClass);
+  const HWND hWnd = CreateWindowExW(0, windowClass.lpszClassName, L"", WS_OVERLAPPEDWINDOW, 0, 0, 64, 64, nullptr, nullptr, windowClass.hInstance, nullptr);
+  if (hWnd == nullptr) {
+    logLine("FAILED: Could not create a test window.");
+    return 1;
+  }
+  bool passed = false;
+  try {
+    require(game[0] != 0 && objectsFile[0] != 0, "REMIX_GI_MESH_GAME and REMIX_GI_MESH_OBJECTS are set");
+    const Chair chair = readChair(objectsFile);
+    std::ofstream config(".trex/bridge.conf", std::ios::app);
+    config << "sendCreateFunctionServerResponses = True\n";
+    config << "client.giServer = True\n";
+    config << "server.giMeshGame = \"" << game << "\"\n";  // (a value with spaces needs the quotes)
+    config << "server.giMeshMods = off\n";
+    if (dxvk[0] != 0) {
+      if (!CopyFileA(dxvk, ".trex\\d3d9vk_x64.dll", FALSE)) {
+        throw std::runtime_error("Could not copy REMIX_GI_TEST_DXVK");
+      }
+      config << "server.useVanillaDxvk = True\n";
+    }
+    config.close();
+    std::printf("Chair LITE %016llX, %zu triangles; per-pixel pass %s.\n", static_cast<unsigned long long>(chair.lite), chair.tri.size() / 3,
+                pixel ? "on" : "not checked");
+    const HMODULE hClient = loadBridgeClient();
+    if (hClient == nullptr) {
+      throw std::runtime_error("loadBridgeClient");
+    }
+    g_giOpen = reinterpret_cast<PFN_GiOpen>(GetProcAddress(hClient, "RemixBridge_GiOpen"));
+    g_objects = reinterpret_cast<PFN_GiObjects>(GetProcAddress(hClient, "RemixBridge_GiObjects"));
+    g_giCounters = reinterpret_cast<PFN_GiReadCounters>(GetProcAddress(hClient, "RemixBridge_GiReadCounters"));
+    g_pixelOpen = reinterpret_cast<PFN_GiPixelOpen>(GetProcAddress(hClient, "RemixBridge_GiPixelOpen"));
+    g_pass = reinterpret_cast<PFN_GiPixelPass>(GetProcAddress(hClient, "RemixBridge_GiPixelPass"));
+    g_pixelCounters = reinterpret_cast<PFN_GiPixelReadCounters>(GetProcAddress(hClient, "RemixBridge_GiPixelReadCounters"));
+    if (!g_giOpen || !g_objects || !g_giCounters || !g_pixelOpen || !g_pass || !g_pixelCounters) {
+      throw std::runtime_error("The client does not export the GI object functions");
+    }
+    const auto pfnCreate = reinterpret_cast<PFN_Direct3DCreate9>(GetProcAddress(hClient, "Direct3DCreate9"));
+    ComPtr<IDirect3D9> pD3D;
+    pD3D.Attach(pfnCreate != nullptr ? pfnCreate(D3D_SDK_VERSION) : nullptr);
+    if (pD3D == nullptr) {
+      throw std::runtime_error("Direct3DCreate9");
+    }
+    D3DPRESENT_PARAMETERS present = {};
+    present.Windowed = TRUE;
+    present.SwapEffect = D3DSWAPEFFECT_DISCARD;
+    present.BackBufferFormat = D3DFMT_UNKNOWN;
+    present.BackBufferWidth = 64;
+    present.BackBufferHeight = 64;
+    present.hDeviceWindow = hWnd;
+    ComPtr<IDirect3DDevice9> pDevice;
+    check(pD3D->CreateDevice(D3DADAPTER_DEFAULT, D3DDEVTYPE_HAL, hWnd, D3DCREATE_SOFTWARE_VERTEXPROCESSING | D3DCREATE_MULTITHREADED,
+                              &present, &pDevice), "CreateDevice");
+    runMeshes(pDevice.Get(), chair, pixel);
+    passed = true;
+  } catch (const std::exception& error) {
+    std::printf("FAILED: %s.\n", error.what());
+  }
+  DestroyWindow(hWnd);
+  logLine(passed ? "PASSED" : "FAILED");
+  return passed ? 0 : 1;
+}
