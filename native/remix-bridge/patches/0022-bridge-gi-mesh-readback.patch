+  // One fetch through RemixBridge_GiMeshFetch / RemixBridge_GiMeshRead. Polls without presenting first, then with.
+  // Returns the read's result and the wall time in microseconds.
+  HRESULT fetchOne(IDirect3DDevice9* pDevice, uint64_t lite, std::vector<float>& pos, std::vector<uint32_t>& tri, double& us, bool& presented) {
+    const auto start = std::chrono::steady_clock::now();
+    uint32_t ticket = 0;
+    check(g_meshFetch(lite, &ticket), "RemixBridge_GiMeshFetch");
+    pos.assign(size_t(65536) * 3, 0.0f);
+    tri.assign(size_t(65536) * 3, 0u);
+    uint32_t vertices = 0;
+    uint32_t triangles = 0;
+    presented = false;
+    while (std::chrono::steady_clock::now() - start < std::chrono::seconds(10)) {  // time-bound: 24000 Sleep(0) rounds can pass in under 20 ms
+      const HRESULT hr = g_meshRead(ticket, pos.data(), 65536, tri.data(), 65536, &vertices, &triangles);
+      if (hr != S_FALSE) {
+        us = std::chrono::duration<double, std::micro>(std::chrono::steady_clock::now() - start).count();
+        pos.resize(size_t(vertices) * 3);
+        tri.resize(size_t(triangles) * 3);
+        return hr;
+      }
+      if (std::chrono::steady_clock::now() - start > std::chrono::milliseconds(20)) {
+        present(pDevice);
+        presented = true;
+      } else {
+        Sleep(0);
+      }
+    }
+    throw std::runtime_error("RemixBridge_GiMeshRead never answered");
+  }
