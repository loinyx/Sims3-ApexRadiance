0010: Render target 0 is the implicit swapchain's back buffer 0 object (internal 0016): GetRenderTarget(0) and GetBackBuffer(0, 0) return the same IDirect3DSurface9, as in d3d9 and DXVK. Upstream made a separate place-holder linked to the back buffer (LinkBackBuffer), so code that compares the two by pointer (Apex Radiance's PostScene) never saw the scene and drew a black picture (Sims3-ApexRadiance#59).

Applies after 0001-0009 on NVIDIAGameWorks/dxvk-remix f35b86a (bridge/ only).

diff --git a/bridge/src/client/d3d9_device.cpp b/bridge/src/client/d3d9_device.cpp
index 1441038..7e067a7 100644
--- a/bridge/src/client/d3d9_device.cpp
+++ b/bridge/src/client/d3d9_device.cpp
@@ -4033,28 +4033,18 @@ void Direct3DDevice9Ex_LSS<EnableSync>::initImplicitSwapchain(const D3DPRESENT_P
 
 template<bool EnableSync>
 void Direct3DDevice9Ex_LSS<EnableSync>::initImplicitRenderTarget() {
+  // Render target 0 is the implicit swapchain's back buffer 0 object itself, as in d3d9 and DXVK: GetRenderTarget(0)
+  // and GetBackBuffer(0, 0) return the same IDirect3DSurface9. A separate place-holder linked to the back buffer
+  // (upstream) made them two objects, and code that compares them by pointer (Apex Radiance's PostScene: RT0 == back
+  // buffer before it counts scene draws) never saw the scene: black picture, gates at "RT0 other" (Sims3-ApexRadiance#59).
+  // The swapchain's GetBackBuffer already maps this object's id to the server's back buffer, so no LinkBackBuffer.
   IDirect3DSurface9* pRenderTarget = nullptr;
-
-  // Creating a place-holder surface
-  D3DSURFACE_DESC desc;
-  desc.Width = GET_PRES_PARAM().BackBufferWidth;
-  desc.Height = GET_PRES_PARAM().BackBufferHeight;
-  desc.Format = GET_PRES_PARAM().BackBufferFormat;
-  desc.MultiSampleType = GET_PRES_PARAM().MultiSampleType;
-  desc.MultiSampleQuality = GET_PRES_PARAM().MultiSampleQuality;
-  desc.Usage = D3DUSAGE_RENDERTARGET;
-  desc.Pool = D3DPOOL_DEFAULT;
-  desc.Type = D3DRTYPE_SURFACE;
-
-  // Insert our own IDirect3DSurface9 interface implementation
-  Direct3DSurface9_LSS* pLssSurface = trackWrapper(new Direct3DSurface9_LSS(this, desc));
-  pRenderTarget = (IDirect3DSurface9*) pLssSurface;
-
-  m_pImplicitRenderTarget = bridge_cast<Direct3DSurface9_LSS*>(pRenderTarget);
-  {
-    ClientMessage c(Commands::IDirect3DDevice9Ex_LinkBackBuffer, getId());
-    c.send_many(0, m_pImplicitRenderTarget->getId());
+  if (FAILED(m_pSwapchain->GetBackBuffer(0, D3DBACKBUFFER_TYPE_MONO, &pRenderTarget)) || pRenderTarget == nullptr) {
+    Logger::err("initImplicitRenderTarget: the implicit swapchain gave no back buffer 0");
+    return;
   }
+
+  m_pImplicitRenderTarget = bridge_cast<Direct3DSurface9_LSS*>(pRenderTarget); // holds the reference GetBackBuffer took
   m_state.renderTargets[0] = MakeD3DAutoPtr(m_pImplicitRenderTarget);
   m_implicitRefCnt++;
 }
@@ -4090,10 +4080,13 @@ void Direct3DDevice9Ex_LSS<EnableSync>::initImplicitDepthStencil() {
 template<bool EnableSync>
 void Direct3DDevice9Ex_LSS<EnableSync>::destroyImplicitObjects() {
   // Release implicit RenderTarget
-  const auto rtRefCnt = m_pImplicitRenderTarget->Release();
