+
+#include <cstdio>
+#include <stdexcept>
+
+#include <wrl/client.h>
+
+#include "test_remix_api_bridge_app.h"
+
+using Microsoft::WRL::ComPtr;
+using namespace bridge_app_test;
+
+namespace {
+  constexpr UINT kSize = 128;
+
+  void check(HRESULT result, const char* pCall) {
+    if (FAILED(result)) {
+      std::printf("FAILED: %s returned 0x%08lX.\n", pCall, static_cast<unsigned long>(result));
+      throw std::runtime_error(pCall);
+    }
+  }
+
+  void expect(bool condition, const char* pWhat) {
+    if (!condition) {
+      std::printf("FAILED: %s.\n", pWhat);
+      throw std::runtime_error(pWhat);
+    }
+  }
+
+  HWND createWindow() {
+    WNDCLASSW windowClass = {};
+    windowClass.lpfnWndProc = DefWindowProcW;
+    windowClass.hInstance = GetModuleHandleW(nullptr);
+    windowClass.lpszClassName = L"BridgeDeviceRefCountTest";
+    RegisterClassW(&windowClass);
+    return CreateWindowExW(0, windowClass.lpszClassName, L"", WS_OVERLAPPEDWINDOW,
+                           0, 0, kSize, kSize, nullptr, nullptr, windowClass.hInstance, nullptr);
+  }
+
+  // A CreateDevice hook that takes and returns a reference, such as a Windows compatibility shim, must leave the
+  // new device's implicit swapchain alive.
+  void testAddRefRelease(IDirect3D9* pD3D, HWND hWnd, BOOL autoDepthStencil) {
+    D3DPRESENT_PARAMETERS present = {};
+    present.Windowed = TRUE;
+    present.SwapEffect = D3DSWAPEFFECT_DISCARD;
+    present.BackBufferFormat = D3DFMT_UNKNOWN;
+    present.BackBufferWidth = kSize;
+    present.BackBufferHeight = kSize;
+    present.hDeviceWindow = hWnd;
+    present.EnableAutoDepthStencil = autoDepthStencil;
+    present.AutoDepthStencilFormat = D3DFMT_D24S8;
+    IDirect3DDevice9* pDevice = nullptr;
+    check(pD3D->CreateDevice(D3DADAPTER_DEFAULT, D3DDEVTYPE_HAL, hWnd, D3DCREATE_SOFTWARE_VERTEXPROCESSING,
+                             &present, &pDevice), "CreateDevice");
+    const ULONG added = pDevice->AddRef();
+    const ULONG released = pDevice->Release();
+    std::printf("  AddRef returned %lu, Release returned %lu.\n", added, released);
+    expect(added == 2 && released == 1, "a new device counts its creator's reference");
+    {
+      ComPtr<IDirect3DSurface9> pBackBuffer;
+      check(pDevice->GetBackBuffer(0, 0, D3DBACKBUFFER_TYPE_MONO, &pBackBuffer), "GetBackBuffer");
+      ComPtr<IDirect3DSurface9> pRenderTarget;
+      check(pDevice->GetRenderTarget(0, &pRenderTarget), "GetRenderTarget");
+      expect(pBackBuffer.Get() == pRenderTarget.Get(), "render target 0 is back buffer 0");
+    }
+    check(pDevice->Clear(0, nullptr, D3DCLEAR_TARGET, 0xff000000, 1.0f, 0), "Clear");
+    check(pDevice->Present(nullptr, nullptr, nullptr, nullptr), "Present");
+    expect(pDevice->Release() == 0, "the creator's Release destroys the device");
+  }
+}
+
+int main() {
+  std::setvbuf(stdout, nullptr, _IONBF, 0);
+  const HWND hWnd = createWindow();
+  if (hWnd == nullptr) {
+    logLine("FAILED: Could not create a test window.");
+    return 1;
+  }
+  bool passed = false;
+  try {
+    const HMODULE hClient = loadBridgeClient();
+    if (hClient == nullptr) {
+      throw std::runtime_error("loadBridgeClient");
+    }
+    const auto pfnCreate = reinterpret_cast<PFN_Direct3DCreate9>(GetProcAddress(hClient, "Direct3DCreate9"));
+    ComPtr<IDirect3D9> pD3D;
+    pD3D.Attach(pfnCreate != nullptr ? pfnCreate(D3D_SDK_VERSION) : nullptr);
+    if (pD3D == nullptr) {
+      throw std::runtime_error("Direct3DCreate9");
+    }
+    logLine("Testing an AddRef and a Release on a new device without a depth buffer...");
+    testAddRefRelease(pD3D.Get(), hWnd, FALSE);
+    logLine("Testing an AddRef and a Release on a new device with a depth buffer...");
+    testAddRefRelease(pD3D.Get(), hWnd, TRUE);
+    passed = true;
+  } catch (const std::exception&) {
+  }
+  DestroyWindow(hWnd);
+  logLine(passed ? "PASSED" : "FAILED");
+  return passed ? 0 : 1;
+}
