diff --git a/bridge/test/rtx/unit/test_device_refcount_device.cpp b/bridge/test/rtx/unit/test_device_refcount_device.cpp
new file mode 100644
index 00000000..bcf5f1cb
--- /dev/null
+++ b/bridge/test/rtx/unit/test_device_refcount_device.cpp
@@ -0,0 +1,121 @@
