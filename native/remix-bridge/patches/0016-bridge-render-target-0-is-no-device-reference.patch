0016: render target 0 is not counted as a reference to the device. Patch 0010 made it the swapchain's back buffer 0, which references the swapchain, but left it in the device's count of implicit references. A new device then had one reference less than its creator held: AddRef returned 1, and the Release after it found the count at the implicit references, destroyed the implicit swapchain and depth surface and returned 0. The next call through the device read a null swapchain (GetBackBuffer crashed). A mod or an overlay that takes and returns a reference inside its CreateDevice hook was enough. With the count right the last Release of the game also destroys the device, which leaked before. The test hunk extends test_rewind_device.cpp of patch 0015.
Applies after 0001-0015 on NVIDIAGameWorks/dxvk-remix f35b86a (bridge/ only).
diff --git a/bridge/src/client/d3d9_device.cpp b/bridge/src/client/d3d9_device.cpp
index 796e9d65..8b8e7fe5 100644
--- a/bridge/src/client/d3d9_device.cpp
+++ b/bridge/src/client/d3d9_device.cpp
@@ -4069,7 +4069,8 @@ void Direct3DDevice9Ex_LSS<EnableSync>::initImplicitRenderTarget() {
 
   m_pImplicitRenderTarget = bridge_cast<Direct3DSurface9_LSS*>(pRenderTarget); // holds the reference GetBackBuffer took
   m_state.renderTargets[0] = MakeD3DAutoPtr(m_pImplicitRenderTarget);
-  m_implicitRefCnt++;
+  // Not counted in m_implicitRefCnt: a back buffer references its swapchain, not the device. Counted, the device took its
+  // creator's reference for an implicit one, and the first AddRef and Release on it destroyed the implicit objects.
 }
 
 template<bool EnableSync>
@@ -4108,7 +4109,6 @@ void Direct3DDevice9Ex_LSS<EnableSync>::destroyImplicitObjects() {
   if (m_pImplicitRenderTarget) {
     m_pImplicitRenderTarget->Release();
     m_pImplicitRenderTarget = nullptr;
-    --m_implicitRefCnt;
   }
   m_state.renderTargets[0].reset(nullptr);
 
diff --git a/bridge/test/rtx/unit/test_rewind_device.cpp b/bridge/test/rtx/unit/test_rewind_device.cpp
index ce540826..53f80ec5 100644
--- a/bridge/test/rtx/unit/test_rewind_device.cpp
+++ b/bridge/test/rtx/unit/test_rewind_device.cpp
@@ -118,6 +118,16 @@ int main() {
     check(pD3D->CreateDevice(D3DADAPTER_DEFAULT, D3DDEVTYPE_HAL, hWnd,
                               D3DCREATE_SOFTWARE_VERTEXPROCESSING | D3DCREATE_MULTITHREADED,
                               &present, &pDevice), "CreateDevice");
+    {
+      // The creator holds one reference. A hook that takes and returns a second one must leave the device whole.
+      const ULONG added = pDevice->AddRef();
+      const ULONG released = pDevice->Release();
+      ComPtr<IDirect3DSurface9> pBackBuffer;
+      const HRESULT result = added == 2 && released == 1
+        ? pDevice->GetBackBuffer(0, 0, D3DBACKBUFFER_TYPE_MONO, &pBackBuffer)
+        : E_FAIL;
+      expect(SUCCEEDED(result), "a new device survives an AddRef and a Release");
+    }
     ComPtr<IDirect3DTexture9> pOldTexture;
     // Made by the second thread while the client is parked, released by this one.
     ComPtr<IDirect3DSurface9> pNewSurface;
