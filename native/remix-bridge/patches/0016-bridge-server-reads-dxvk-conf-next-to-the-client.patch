0016: the server's DXVK reads the dxvk.conf next to the client d3d9.dll (DXVK_CONFIG_FILE), not the one in the folder the game was started in. A start from another folder (a shortcut, a launcher or a command line elsewhere) found no dxvk.conf: the game saw the real card id, a new lastdevice, and reset Options.ini.
Applies after 0001-0015 on NVIDIAGameWorks/dxvk-remix f35b86a (bridge/ only).
diff --git a/bridge/src/client/d3d9_lss.cpp b/bridge/src/client/d3d9_lss.cpp
--- a/bridge/src/client/d3d9_lss.cpp
+++ b/bridge/src/client/d3d9_lss.cpp
@@ -313,6 +313,17 @@ void InitServer() {
   cmdSS << " " << BRIDGE_VERSION;
   cmdSS << " " << std::string(GetCommandLineA());
   const std::string command = cmdSS.str();
+  // DXVK in the server reads dxvk.conf from the working folder, which is whatever folder the game was started in. Point it
+  // at the dxvk.conf next to this d3d9.dll instead, so every way of starting the game reads the same file. A
+  // DXVK_CONFIG_FILE set by the player is kept. The server inherits this environment.
+  {
+    const std::filesystem::path conf = dxvk::util::RtxFileSys::remixPath() / "dxvk.conf";
+    std::error_code ec;
+    if (GetEnvironmentVariableW(L"DXVK_CONFIG_FILE", nullptr, 0) == 0 && std::filesystem::is_regular_file(conf, ec)) {
+      SetEnvironmentVariableW(L"DXVK_CONFIG_FILE", conf.wstring().c_str());
+      Logger::info("DXVK_CONFIG_FILE for the server: " + conf.string());
+    }
+  }
   gpServer = new Process(command.c_str(), OnServerExited);
 
   if (ClientOptions::getEnableDpiAwareness()) {
