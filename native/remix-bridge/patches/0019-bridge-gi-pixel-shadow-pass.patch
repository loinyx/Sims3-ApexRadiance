+ * FROM, OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER
+ * DEALINGS IN THE SOFTWARE.
+ */
+#pragma once
+
+#include <cstring>
+#include <unordered_map>
+
+#include <d3d9.h>
+
+#include "gi_pixel_spv.h"
+#include "gi_pixel_pass.h"
+#include "log/log.h"
+#include "util_gi_pixel.h"
+
+// Server side of the RemixBridge_GiPixel* exports: the per-pixel shadow pass on the renderer's own Vulkan device
+// (gi_pixel_pass.h, which records through DXVK's ID3D9VkExternalPass). Everything here runs on the play thread.
+namespace gi_pixel {
+  using ResourceMap = std::unordered_map<uint32_t, IDirect3DResource9*>;
+
+  inline GiPixelPass g_pass;
+  inline uint32_t g_loggedAt = 0;  // pass count of the last counter line
+
+  inline void publish(bool log) {
+    bridge_util::GiPixelShared* const pShared = bridge_util::giPixelShared();
+    if (pShared == nullptr) {
+      return;
+    }
+    const GiPixelCounters c = g_pass.counters();
+    pShared->passes = c.passes;
+    pShared->faults = c.faults;
+    pShared->raysLow = (uint32_t) c.rays;
+    pShared->raysHigh = (uint32_t) (c.rays >> 32);
+    pShared->raysLast = c.raysLast;
+    pShared->gpuUs = c.gpuUs;
+    pShared->width = c.width;
+    pShared->height = c.height;
+    if (log && c.passes != g_loggedAt) {
+      g_loggedAt = c.passes;
+      char line[256];
+      g_pass.line(line, sizeof(line));
+      bridge_util::Logger::info(line);
+    }
+  }
+
+  // Bridge_GiPixelOpen: answers once whether the renderer can run the pass.
+  inline void open(const std::unordered_map<uint32_t, IDirect3DDevice9*>& devices) {
+    bridge_util::GiPixelShared* const pShared = bridge_util::giPixelShared();
+    if (pShared == nullptr || g_pass.ready()) {
+      return;
+    }
+    const char* const why = devices.empty() ? "no device" : g_pass.init(devices.begin()->second);
+    uint32_t state = bridge_util::GiPixelOn;
+    if (why != nullptr) {
+      state = std::strncmp(why, "stock", 5) == 0 ? bridge_util::GiPixelOffStockRenderer
+            : std::strncmp(why, "no ray", 6) == 0 ? bridge_util::GiPixelOffNoRayQuery : bridge_util::GiPixelOffOther;
+      bridge_util::Logger::info(bridge_util::format_string("[GiPixel] off: %s", why));
+    } else {
+      bridge_util::Logger::info("[GiPixel] on: the renderer records external passes and has ray queries.");
+    }
+    pShared->state.store(state, std::memory_order_release);
+  }
+
+  inline IDirect3DBaseTexture9* find(const ResourceMap& resources, uint32_t id) {
+    const auto it = id != 0 ? resources.find(id) : resources.end();
+    if (it == resources.end() || it->second == nullptr || it->second->GetType() != D3DRTYPE_TEXTURE) {
+      return nullptr;
+    }
+    return static_cast<IDirect3DTexture9*>(it->second);
+  }
+
+  // Bridge_GiPixelPass. A refused pass counts as a fault; the client reads the counter.
+  inline void pass(const ResourceMap& resources, uint32_t depthId, uint32_t classId, const uint32_t* outputIds, const void* pBlock, uint32_t size) {
+    if (!g_pass.ready() || pBlock == nullptr || size != sizeof(GiPixelBlock)) {
+      return;
+    }
+    IDirect3DBaseTexture9* outputs[kGiPixelOutputs];
+    IDirect3DBaseTexture9* const pClass = find(resources, classId);
+    // An id that names no texture must not pass as "absent": the run below would then succeed without it.
+    bool known = classId == 0 || pClass != nullptr;
+    for (uint32_t i = 0; i < kGiPixelOutputs; ++i) {
+      outputs[i] = find(resources, outputIds[i]);
+      known = known && (outputIds[i] == 0 || outputs[i] != nullptr);
+    }
+    const HRESULT hr = g_pass.run(*static_cast<const GiPixelBlock*>(pBlock), known ? find(resources, depthId) : nullptr, pClass, outputs);
+    const GiPixelCounters c = g_pass.counters();
+    // The first line after a second of frames (the device answers late), then one a minute at 60 frames a second.
+    publish(FAILED(hr) ? c.faults == 1 : c.passes == 60 || c.passes % 3600 == 0);
+  }
+
+  // A texture is about to go: the pass must not keep a view of it.
+  inline void forget(const ResourceMap& resources, uint32_t id) {
+    const auto it = resources.find(id);
+    if (it != resources.end() && it->second != nullptr) {
+      g_pass.forget(it->second);
+    }
+  }
+
+  // Before a device reset: frees the pass objects; the next pass builds them again.
+  inline void dropAll() {
+    if (g_pass.ready()) {
+      publish(true);
+      g_pass.drop();
+    }
+  }
+
+  // Before the device is destroyed: also lets go of the renderer's interfaces. A new device needs a new open.
+  inline void close() {
+    dropAll();
+    g_pass.close();
+  }
+}
