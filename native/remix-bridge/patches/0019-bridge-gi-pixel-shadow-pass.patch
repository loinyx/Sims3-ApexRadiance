+// Sends the per-pixel shadow pass through RemixBridge_GiPixelOpen / RemixBridge_GiPixelPass: a floor drawn into an INTZ
+// depth texture, one lamp, two capsules and one static box. Reads the four outputs back with GetRenderTargetData and
+// checks three floor points, again after 100 one-sample frames and with a second set of textures.
+// A device reset is not part of this test: with these textures the server's reset fails on a DXVK renderer with one
+// resource left alive, also when no pass is sent. The pass frees its objects the same way for a reset and for a
+// destroyed depth texture, and native/dxvk/test/dxvk_gi_pixel_pass.cpp covers the reset without the bridge.
+// REMIX_GI_TEST_DXVK: a d3d9vk_x64.dll for the server. With a library that records external passes and has ray queries
+// the state must be on. Without the variable, or with a stock library, the state must be off (stock renderer) and the
+// pass export must refuse.
+
+#include <cmath>
+#include <cstdio>
+#include <cstring>
+#include <fstream>
+#include <stdexcept>
+#include <string>
+
+#include <DirectXMath.h>
+#include <wrl/client.h>
+
+#include "test_remix_api_bridge_app.h"
+#include "../../../src/util/gi_pixel_block.h"
+
+using Microsoft::WRL::ComPtr;
+using namespace bridge_app_test;
+using namespace DirectX;
+
+namespace {
+  using PFN_GiPixelOpen = HRESULT (__stdcall*)(uint32_t*);
+  using PFN_GiPixelPass = HRESULT (__stdcall*)(const void*, uint32_t, IDirect3DTexture9*, IDirect3DTexture9*, IDirect3DTexture9* const*);
+  using PFN_GiPixelReadCounters = HRESULT (__stdcall*)(uint32_t*, uint32_t);
+
+  // Word indices of RemixBridge_GiPixelReadCounters (util_gi_pixel.h).
+  enum Counter { kState, kPasses, kFaults, kRaysLow, kRaysHigh, kRaysLast, kGpuUs, kWidth, kHeight, kCounterCount };
+
+  constexpr UINT kWidthFull = 640;
+  constexpr UINT kHeightFull = 360;
+  constexpr UINT kWidthQuarter = kWidthFull / 4;
+  constexpr UINT kHeightQuarter = kHeightFull / 4;
+
+  PFN_GiPixelOpen g_open = nullptr;
+  PFN_GiPixelPass g_pass = nullptr;
+  PFN_GiPixelReadCounters g_readCounters = nullptr;
+
+  void check(HRESULT result, const char* pCall) {
+    if (FAILED(result)) {
+      std::printf("FAILED: %s returned 0x%08lX.\n", pCall, static_cast<unsigned long>(result));
+      throw std::runtime_error(pCall);
+    }
+  }
+
+  void require(bool condition, const char* pWhat) {
+    if (!condition) {
+      std::printf("FAILED: %s.\n", pWhat);
+      throw std::runtime_error(pWhat);
+    }
+  }
+
+  float halfToFloat(uint16_t half) {
+    const int exponent = (half >> 10) & 31;
+    const int mantissa = half & 1023;
+    const float value = exponent == 0 ? std::ldexp(float(mantissa), -24) : std::ldexp(float(mantissa | 1024), exponent - 25);
+    return (half & 0x8000) ? -value : value;
+  }
+
+  struct Scene {
+    XMMATRIX view;
+    XMMATRIX projection;
+    XMVECTOR eye;
+    GiPixelBlock block = {};
+
+    Scene() {
+      eye = XMVectorSet(0, 6, -6, 1);
+      view = XMMatrixLookAtLH(eye, XMVectorZero(), XMVectorSet(0, 1, 0, 0));
+      projection = XMMatrixPerspectiveFovLH(XM_PI / 3, float(kWidthFull) / kHeightFull, 0.1f, 50.0f);
+      XMStoreFloat4x4(reinterpret_cast<XMFLOAT4X4*>(block.invViewProj), XMMatrixInverse(nullptr, view * projection));
+      XMStoreFloat3(reinterpret_cast<XMFLOAT3*>(block.cam), eye);
+      XMStoreFloat3(reinterpret_cast<XMFLOAT3*>(block.viewZ), XMVector3Normalize(XMVectorNegate(eye)));
+      block.ambient = 0.05f;
+      block.zFar = 50.0f;
+      block.bias = 0.01f;
+      block.radiusScale = 1.0f;
+      block.samples = 16;
+      block.lamps = 1;
+      block.lamp[0] = { { 2, 3, 0 }, 0.05f, { 10, 10, 10 }, 0 };
+      block.capsules = 2;
+      block.casters = 2;
+      block.boxes = 1;
+      block.capsule[0] = { { 0, 0.3f, 0 }, 0.25f, { 0, 1.3f, 0 }, 0 };
+      block.caster[0] = { { -0.25f, 0.05f, -0.25f }, 0, { 0.25f, 1.55f, 0.25f }, 0 };
+      // The second capsule stands where the static box hides the lamp, so its floor is traced with no light left to shadow.
+      block.capsule[1] = { { 3.77f, 0.2f, 0 }, 0.15f, { 3.77f, 0.5f, 0 }, 0 };
+      block.caster[1] = { { 3.62f, 0.05f, -0.15f }, 0, { 3.92f, 0.65f, 0.15f }, 0 };
+      const float box[12] = { 0.6f, 0, 0, 3.0f, 0, 0.6f, 0, 0.5f, 0, 0, 0.6f, -0.3f };
+      std::memcpy(block.box[0].m, box, sizeof(box));
+    }
+
+    // The quarter-resolution pixel of a world point.
+    void pixel(const float* pPoint, int& x, int& y) const {
+      const XMVECTOR clip = XMVector4Transform(XMVectorSet(pPoint[0], pPoint[1], pPoint[2], 1), view * projection);
+      const float w = XMVectorGetW(clip);
+      x = int((XMVectorGetX(clip) / w * 0.5f + 0.5f) * kWidthQuarter);
+      y = int((0.5f - XMVectorGetY(clip) / w * 0.5f) * kHeightQuarter);
+    }
+  };
+
+  struct Targets {
+    ComPtr<IDirect3DTexture9> pDepth;
+    ComPtr<IDirect3DSurface9> pDepthSurface;
+    ComPtr<IDirect3DTexture9> pColor;
+    ComPtr<IDirect3DSurface9> pColorSurface;
+    ComPtr<IDirect3DTexture9> outputs[kGiPixelOutputs];
+
+    void create(IDirect3DDevice9* pDevice) {
+      check(pDevice->CreateTexture(kWidthFull, kHeightFull, 1, D3DUSAGE_DEPTHSTENCIL, static_cast<D3DFORMAT>(MAKEFOURCC('I', 'N', 'T', 'Z')),
+                                   D3DPOOL_DEFAULT, &pDepth, nullptr), "CreateTexture (INTZ)");
+      check(pDepth->GetSurfaceLevel(0, &pDepthSurface), "GetSurfaceLevel (depth)");
+      check(pDevice->CreateTexture(kWidthFull, kHeightFull, 1, D3DUSAGE_RENDERTARGET, D3DFMT_A8R8G8B8, D3DPOOL_DEFAULT, &pColor, nullptr),
+            "CreateTexture (color)");
+      check(pColor->GetSurfaceLevel(0, &pColorSurface), "GetSurfaceLevel (color)");
+      for (auto& pOutput : outputs) {
+        check(pDevice->CreateTexture(kWidthQuarter, kHeightQuarter, 1, D3DUSAGE_RENDERTARGET, D3DFMT_A16B16G16R16F, D3DPOOL_DEFAULT,
+                                     &pOutput, nullptr), "CreateTexture (output)");
+      }
+    }
+  };
+
+  void draw(IDirect3DDevice9* pDevice, const Targets& targets, const Scene& scene) {
+    static const float kFloor[4][3] = { { -8, 0, -8 }, { -8, 0, 8 }, { 8, 0, -8 }, { 8, 0, 8 } };
+    check(pDevice->SetRenderTarget(0, targets.pColorSurface.Get()), "SetRenderTarget");
+    check(pDevice->SetDepthStencilSurface(targets.pDepthSurface.Get()), "SetDepthStencilSurface");
+    check(pDevice->Clear(0, nullptr, D3DCLEAR_TARGET | D3DCLEAR_ZBUFFER, 0, 1.0f, 0), "Clear");
+    check(pDevice->BeginScene(), "BeginScene");
+    XMFLOAT4X4 matrix;
+    XMStoreFloat4x4(&matrix, scene.view);
+    pDevice->SetTransform(D3DTS_VIEW, reinterpret_cast<D3DMATRIX*>(&matrix));
+    XMStoreFloat4x4(&matrix, scene.projection);
+    pDevice->SetTransform(D3DTS_PROJECTION, reinterpret_cast<D3DMATRIX*>(&matrix));
+    pDevice->SetRenderState(D3DRS_LIGHTING, FALSE);
+    pDevice->SetRenderState(D3DRS_CULLMODE, D3DCULL_NONE);
+    pDevice->SetRenderState(D3DRS_ZENABLE, TRUE);
+    pDevice->SetFVF(D3DFVF_XYZ);
+    check(pDevice->DrawPrimitiveUP(D3DPT_TRIANGLESTRIP, 2, kFloor, 12), "DrawPrimitiveUP");
+    check(pDevice->EndScene(), "EndScene");
+  }
+
+  void sendPass(const Scene& scene, const Targets& targets) {
+    IDirect3DTexture9* const outputs[kGiPixelOutputs] = { targets.outputs[0].Get(), targets.outputs[1].Get(), targets.outputs[2].Get(),
+                                                          targets.outputs[3].Get() };
+    check(g_pass(&scene.block, sizeof(scene.block), targets.pDepth.Get(), nullptr, outputs), "RemixBridge_GiPixelPass");
+  }
+
+  // Reads the outputs back and checks three floor points.
+  void checkOutputs(IDirect3DDevice9* pDevice, const Targets& targets, const Scene& scene, IDirect3DSurface9* pReadback, const char* pWhen) {
+    // In the first capsule's shadow, away from every caster, behind the static box.
+    const float points[3][3] = { { -0.73f, 0, 0 }, { -4, 0, 3 }, { 3.77f, 0, 0 } };
+    float texel[kGiPixelOutputs][3][4];
+    for (uint32_t output = 0; output < kGiPixelOutputs; ++output) {
+      ComPtr<IDirect3DSurface9> pSurface;
+      check(targets.outputs[output]->GetSurfaceLevel(0, &pSurface), "GetSurfaceLevel (output)");
+      check(pDevice->GetRenderTargetData(pSurface.Get(), pReadback), "GetRenderTargetData");
+      D3DLOCKED_RECT locked;
+      check(pReadback->LockRect(&locked, nullptr, D3DLOCK_READONLY), "LockRect");
+      for (int point = 0; point < 3; ++point) {
+        int x = 0;
+        int y = 0;
+        scene.pixel(points[point], x, y);
+        const uint16_t* const pHalf = reinterpret_cast<const uint16_t*>(static_cast<const uint8_t*>(locked.pBits) + y * locked.Pitch) + x * 4;
+        for (int channel = 0; channel < 4; ++channel) {
+          texel[output][point][channel] = halfToFloat(pHalf[channel]);
+        }
+      }
+      pReadback->UnlockRect();
+    }
+    std::printf("%s: raw %.3f / %.3f / %.3f, den.r %.4f / %.4f / %.4f, rays %.0f / %.0f / %.0f.\n", pWhen, texel[0][0][0], texel[0][1][0],
+                texel[0][2][0], texel[3][0][0], texel[3][1][0], texel[3][2][0], texel[3][0][3], texel[3][1][3], texel[3][2][3]);
+    require(texel[0][0][0] < 0.5f && texel[0][0][2] == 1.0f && texel[2][0][0] > 0 && texel[3][0][0] > 0, "The shadow point is blocked and traced");
+    require(texel[0][1][0] == 1.0f && texel[0][1][2] == 0 && texel[3][1][3] == 0, "The far point is lit and traces no ray");
+    require(texel[0][2][2] == 1.0f && texel[3][2][0] == 0 && texel[3][2][3] > 0, "The point behind the static box is traced and no light reaches it");
+    for (int point = 0; point < 3; ++point) {
+      require(texel[1][point][1] > 0.99f && texel[1][point][3] > 0 && texel[1][point][3] < 1, "The guide holds the floor's normal and depth");
+    }
+  }
+
+  // Calls the open export until the server has answered. The command reaches the server with a Present.
+  uint32_t openPass(IDirect3DDevice9* pDevice) {
+    uint32_t state = 0;
+    for (int frame = 0; frame < 600; ++frame) {
+      const HRESULT result = g_open(&state);
+      check(result, "RemixBridge_GiPixelOpen");
+      if (result == S_OK) {
+        return state;
+      }
+      pDevice->Present(nullptr, nullptr, nullptr, nullptr);
+      Sleep(5);
+    }
+    throw std::runtime_error("The server did not answer RemixBridge_GiPixelOpen");
+  }
+
+  void runOn(IDirect3DDevice9* pDevice) {
+    Scene scene;
+    ComPtr<IDirect3DSurface9> pReadback;
+    check(pDevice->CreateOffscreenPlainSurface(kWidthQuarter, kHeightQuarter, D3DFMT_A16B16G16R16F, D3DPOOL_SYSTEMMEM, &pReadback, nullptr),
+          "CreateOffscreenPlainSurface");
+    // The second round has new textures: the server frees its pass objects when the first depth texture goes.
+    for (int round = 0; round < 2; ++round) {
+      Targets targets;
+      targets.create(pDevice);
+      scene.block.samples = 16;
+      draw(pDevice, targets, scene);
+      sendPass(scene, targets);
+      checkOutputs(pDevice, targets, scene, pReadback.Get(), round == 0 ? "16 samples" : "New targets, 16 samples");
+      scene.block.samples = 1;
+      for (uint32_t frame = 0; frame < 100; ++frame) {
+        scene.block.frame = frame;
+        draw(pDevice, targets, scene);
+        sendPass(scene, targets);
+        check(pDevice->Present(nullptr, nullptr, nullptr, nullptr), "Present");
+      }
+      checkOutputs(pDevice, targets, scene, pReadback.Get(), round == 0 ? "After 100 frames" : "New targets, 100 frames");
+      uint32_t counters[kCounterCount] = {};
+      check(g_readCounters(counters, kCounterCount), "RemixBridge_GiPixelReadCounters");
+      std::printf("[GiPixel] passes=%u rays=%u raysLast=%u gpuUs=%u size=%ux%u faults=%u\n", counters[kPasses], counters[kRaysLow],
+                  counters[kRaysLast], counters[kGpuUs], counters[kWidth], counters[kHeight], counters[kFaults]);
+      require(counters[kPasses] >= 60 && counters[kRaysLow] > 0 && counters[kFaults] == 0, "The counters show passes, rays and no fault");
+    }
+  }
+}
+
+int main() {
+  std::setvbuf(stdout, nullptr, _IONBF, 0);
+  char dxvk[MAX_PATH] = {};
+  GetEnvironmentVariableA("REMIX_GI_TEST_DXVK", dxvk, sizeof(dxvk));
+  char expectOn[8] = {};
+  GetEnvironmentVariableA("REMIX_GI_TEST_CASE", expectOn, sizeof(expectOn));
+  const bool on = std::string(expectOn) == "on";
+  WNDCLASSW windowClass = {};
+  windowClass.lpfnWndProc = DefWindowProcW;
+  windowClass.hInstance = GetModuleHandleW(nullptr);
+  windowClass.lpszClassName = L"BridgeGiPixelTest";
+  RegisterClassW(&windowClass);
+  const HWND hWnd = CreateWindowExW(0, windowClass.lpszClassName, L"", WS_OVERLAPPEDWINDOW, 0, 0, 64, 64, nullptr, nullptr, windowClass.hInstance, nullptr);
+  if (hWnd == nullptr) {
+    logLine("FAILED: Could not create a test window.");
+    return 1;
+  }
+  bool passed = false;
+  try {
+    std::ofstream config(".trex/bridge.conf", std::ios::app);
+    config << "sendCreateFunctionServerResponses = True\n";
+    if (dxvk[0] != 0) {
+      if (!CopyFileA(dxvk, ".trex\\d3d9vk_x64.dll", FALSE)) {
+        throw std::runtime_error("Could not copy REMIX_GI_TEST_DXVK");
+      }
+      config << "server.useVanillaDxvk = True\n";
+    }
+    config.close();
+    std::printf("Expecting the pass %s, server renderer %s.\n", on ? "on" : "off", dxvk[0] ? "DXVK" : "system Direct3D 9");
+    const HMODULE hClient = loadBridgeClient();
+    if (hClient == nullptr) {
+      throw std::runtime_error("loadBridgeClient");
+    }
+    g_open = reinterpret_cast<PFN_GiPixelOpen>(GetProcAddress(hClient, "RemixBridge_GiPixelOpen"));
+    g_pass = reinterpret_cast<PFN_GiPixelPass>(GetProcAddress(hClient, "RemixBridge_GiPixelPass"));
+    g_readCounters = reinterpret_cast<PFN_GiPixelReadCounters>(GetProcAddress(hClient, "RemixBridge_GiPixelReadCounters"));
+    if (g_open == nullptr || g_pass == nullptr || g_readCounters == nullptr) {
+      throw std::runtime_error("The client does not export the per-pixel pass functions");
+    }
+    const auto pfnCreate = reinterpret_cast<PFN_Direct3DCreate9>(GetProcAddress(hClient, "Direct3DCreate9"));
+    ComPtr<IDirect3D9> pD3D;
+    pD3D.Attach(pfnCreate != nullptr ? pfnCreate(D3D_SDK_VERSION) : nullptr);
+    if (pD3D == nullptr) {
+      throw std::runtime_error("Direct3DCreate9");
+    }
+    D3DPRESENT_PARAMETERS present = {};
+    present.Windowed = TRUE;
+    present.SwapEffect = D3DSWAPEFFECT_DISCARD;
+    present.BackBufferFormat = D3DFMT_UNKNOWN;
+    present.BackBufferWidth = 64;
+    present.BackBufferHeight = 64;
+    present.hDeviceWindow = hWnd;
+    // The flags of test_gi_device.
+    ComPtr<IDirect3DDevice9> pDevice;
+    check(pD3D->CreateDevice(D3DADAPTER_DEFAULT, D3DDEVTYPE_HAL, hWnd, D3DCREATE_SOFTWARE_VERTEXPROCESSING | D3DCREATE_MULTITHREADED,
+                              &present, &pDevice), "CreateDevice");
+    const uint32_t state = openPass(pDevice.Get());
+    std::printf("State %u.\n", state);
+    if (on) {
+      require(state == 1, "The state is on");
+      runOn(pDevice.Get());
+    } else {
+      require(state == 2, "The state is off (stock renderer)");
+      GiPixelBlock block = {};
+      ComPtr<IDirect3DTexture9> pDepth;
+      check(pDevice->CreateTexture(64, 64, 1, D3DUSAGE_RENDERTARGET, D3DFMT_A8R8G8B8, D3DPOOL_DEFAULT, &pDepth, nullptr), "CreateTexture");
+      require(g_pass(&block, sizeof(block), pDepth.Get(), nullptr, nullptr) == E_NOTIMPL, "The pass export refuses while the state is off");
+    }
+    passed = true;
+  } catch (const std::exception& error) {
+    std::printf("FAILED: %s.\n", error.what());
+  }
+  DestroyWindow(hWnd);
+  logLine(passed ? "PASSED" : "FAILED");
+  return passed ? 0 : 1;
+}
