+ * IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY,
+ * FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT.  IN NO EVENT SHALL
+ * THE AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER
+ * LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING
+ * FROM, OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER
+ * DEALINGS IN THE SOFTWARE.
+ */
+#pragma once
+
+#include <atomic>
+#include <cstdint>
+#include <memory>
+#include <mutex>
+
+#include "log/log.h"
+#include "util_sharedmemory.h"
+
+// Per-pixel shadow pass (RemixBridge_GiPixel* exports): the words the server publishes and the client reads without a command.
+namespace bridge_util {
+  enum GiPixelState : uint32_t {
+    GiPixelUnanswered = 0,
+    GiPixelOn = 1,
+    GiPixelOffStockRenderer = 2,  // the renderer has no external pass interface
+    GiPixelOffNoRayQuery = 3,
+    GiPixelOffOther = 4,
+  };
+
+  struct GiPixelShared {
+    static constexpr uint32_t kWords = 16;
+    std::atomic<uint32_t> state;  // GiPixelState, written last by the server on Bridge_GiPixelOpen
+    uint32_t passes;
+    uint32_t faults;              // passes refused or failed
+    uint32_t raysLow;             // rays since the pass objects were created, 64 bits
+    uint32_t raysHigh;
+    uint32_t raysLast;            // of a recent pass
+    uint32_t gpuUs;               // dispatch time of a recent pass by device timestamps, microseconds
+    uint32_t width;               // of the outputs
+    uint32_t height;
+    uint32_t reserved[7];
+  };
+  static_assert(sizeof(GiPixelShared) == GiPixelShared::kWords * 4, "GiPixelShared must have the same layout in both processes");
+
+  // Maps the words on first use; nullptr when the mapping failed.
+  inline GiPixelShared* giPixelShared() {
+    static std::once_flag once;
+    static std::unique_ptr<SharedMemory> s_memory;
+    std::call_once(once, [] {
+      s_memory = std::make_unique<SharedMemory>("GiPixel", sizeof(GiPixelShared));
+      if (s_memory->data() == nullptr) {
+        Logger::err("[GiPixel] The counter block could not be mapped, so the per-pixel pass is off.");
+      }
+    });
+    return static_cast<GiPixelShared*>(s_memory->data());
+  }
+}
