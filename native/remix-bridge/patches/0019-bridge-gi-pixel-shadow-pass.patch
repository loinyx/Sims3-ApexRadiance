+ * FROM, OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER
+ * DEALINGS IN THE SOFTWARE.
+ */
+#include "pch.h"
+
+#include "d3d9_texture.h"
+#include "gi_pixel_block.h"
+#include "util_devicecommand.h"
+#include "util_gi_pixel.h"
+
+// Per-pixel shadow pass exports. The server records a ray-query compute pass into its renderer's command stream, so a
+// draw sent after RemixBridge_GiPixelPass samples that pass's outputs. Nothing waits and nothing is read back.
+//
+// RemixBridge_GiPixelOpen(&state) asks the server once whether its renderer can run the pass:
+//   S_FALSE until the server has answered (the command may only reach it with the next Present). Call again a frame later.
+//   S_OK with the state: 1 on, 2 off (stock renderer), 3 off (no ray queries), 4 off (other; the server's log has the reason).
+//   D3DERR_DEVICELOST without a server.
+// RemixBridge_GiPixelPass(block, size, depth, class, outputs) sends one pass:
+//   block is a GiPixelBlock (gi_pixel_block.h) and size its size; depth is the INTZ depth texture; class is the motion
+//   class texture or null; outputs are four A16B16G16R16F render target textures of a quarter of the depth's size, any
+//   of them null.
+//   S_OK when sent. E_NOTIMPL unless the state is on. D3DERR_INVALIDCALL for a wrong size or no depth.
+//   A pass the server refuses shows in the fault counter, not here.
+// RemixBridge_GiPixelReadCounters(out, count) copies the server's words (util_gi_pixel.h GiPixelShared), state first.
+// The server drops its pass objects at device reset; the next pass builds them again.
+
+namespace {
+  bool s_openSent = false;
+
+  bridge_util::GiPixelShared* answered() {
+    bridge_util::GiPixelShared* const pShared = bridge_util::giPixelShared();
+    return pShared != nullptr && pShared->state.load(std::memory_order_acquire) != bridge_util::GiPixelUnanswered ? pShared : nullptr;
+  }
+}
+
+// Exported by name through d3d9_lss.def.
+extern "C" {
+
+  HRESULT __stdcall RemixBridge_GiPixelOpen(uint32_t* pState) {
+    if (pState == nullptr) {
+      return D3DERR_INVALIDCALL;
+    }
+    if (bridge_util::giPixelShared() == nullptr) {
+      return E_NOTIMPL;
+    }
+    if (!gbBridgeRunning) {
+      return D3DERR_DEVICELOST;
+    }
+    if (!s_openSent) {
+      s_openSent = true;
+      ClientMessage { Commands::Bridge_GiPixelOpen, 0, Commands::FlagBits::AsyncResult };
+    }
+    bridge_util::GiPixelShared* const pShared = answered();
+    if (pShared == nullptr) {
+      return S_FALSE;
+    }
+    *pState = pShared->state.load(std::memory_order_acquire);
+    return S_OK;
+  }
+
+  HRESULT __stdcall RemixBridge_GiPixelPass(const void* pBlock, uint32_t size, IDirect3DTexture9* pDepth, IDirect3DTexture9* pClass,
+                                            IDirect3DTexture9* const* ppOutputs) {
+    if (pBlock == nullptr || size != sizeof(GiPixelBlock) || pDepth == nullptr) {
+      return D3DERR_INVALIDCALL;
+    }
+    bridge_util::GiPixelShared* const pShared = s_openSent ? answered() : nullptr;
+    if (pShared == nullptr || pShared->state.load(std::memory_order_acquire) != bridge_util::GiPixelOn) {
+      return E_NOTIMPL;
+    }
+    if (!gbBridgeRunning) {
+      return D3DERR_DEVICELOST;
+    }
+    ClientMessage c(Commands::Bridge_GiPixelPass, bridge_cast<Direct3DTexture9_LSS*>(pDepth)->getId(), Commands::FlagBits::AsyncResult);
+    c.send_data(pClass != nullptr ? bridge_cast<Direct3DTexture9_LSS*>(pClass)->getId() : 0u);
+    for (uint32_t i = 0; i < kGiPixelOutputs; ++i) {
+      IDirect3DTexture9* const pOutput = ppOutputs != nullptr ? ppOutputs[i] : nullptr;
+      c.send_data(pOutput != nullptr ? bridge_cast<Direct3DTexture9_LSS*>(pOutput)->getId() : 0u);
+    }
+    c.send_data(size, pBlock);
+    return S_OK;
+  }
+
+  HRESULT __stdcall RemixBridge_GiPixelReadCounters(uint32_t* pCounters, uint32_t count) {
+    if (pCounters == nullptr) {
+      return D3DERR_INVALIDCALL;
+    }
+    bridge_util::GiPixelShared* const pShared = s_openSent ? answered() : nullptr;
+    if (pShared == nullptr) {
+      return E_NOTIMPL;
+    }
+    const uint32_t* const pWords = reinterpret_cast<const uint32_t*>(pShared);
+    for (uint32_t i = 0; i < count && i < bridge_util::GiPixelShared::kWords; ++i) {
+      pCounters[i] = pWords[i];
+    }
+    return S_OK;
+  }
+}
