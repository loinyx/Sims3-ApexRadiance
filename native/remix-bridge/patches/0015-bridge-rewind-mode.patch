+// Rewind mode (util_rewind.h, rewind_mode.h): the Op whose answer was sent. It is finished after its command, once the
+// command's data position has been checked and published.
+static uint32_t gRewindOp = 0;
+static bool gRewindOpSucceeded = false;
+
+static void finishRewind() {
+  using namespace bridge_util::rewind;
+  // Data queue positions at the snapshot of the device and module bridges, reader then writer.
+  static size_t pos[4] = {};
+  static uint64_t absPos[4] = {};
+  bridge_util::DataQueue* const queues[4] = {
+    DeviceBridge::getReaderChannel().data, DeviceBridge::getWriterChannel().data,
+    ModuleBridge::getReaderChannel().data, ModuleBridge::getWriterChannel().data,
+  };
+  const uint32_t op = gRewindOp;
+  const bool rewound = op == kRewind && gRewindOpSucceeded;
+  gRewindOp = 0;
+  for (size_t i = 0; i < 4; i++) {
+    if (op == kSnapshot && gRewindOpSucceeded) {
+      pos[i] = queues[i]->get_pos();
+      absPos[i] = queues[i]->get_abs_pos();
+    } else if (rewound) {
+      queues[i]->set_pos(pos[i], absPos[i]);
+    }
+  }
+  if (rewound) {
+    DeviceBridge::publishReadPos();
+    ResetEvent(events().resume);
+    SetEvent(events().applied);
+  }
+  SetEvent(events().done);
+  if (!rewound) {
+    return;
+  }
+  // The client's process is still the abandoned run until its host has put it back to the snapshot.
+  // A command read before that would be run against the wrong state, so the next one is read after the client's signal.
+  const ULONGLONG start = GetTickCount64();
+  while (gbBridgeRunning && WaitForSingleObject(events().resume, 50) == WAIT_TIMEOUT) {
+    if (GetTickCount64() - start >= kResumeTimeoutMs) {
+      Logger::err(format_string("[Rewind] The client did not come back within %lu s of a rewind. Reading commands again.", kResumeTimeoutMs / 1000));
+      break;
+    }
+  }
+}
