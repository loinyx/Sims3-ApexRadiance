+// Rewind mode (util_rewind.h). Nothing here acts unless a snapshot is held, and none is taken while the mode is off.
+namespace rewind_mode {
+  // Contents kept past this size make the snapshot refuse a rewind.
+  constexpr size_t kMaxSavedBytes = size_t(1) << 30;
+
+  enum class Kind { VertexBuffer, IndexBuffer, Surface };
+
+  struct Saved {
+    Kind kind;
+    std::vector<uint8_t> bytes;
+  };
+
+  struct DeviceState {
+    IDirect3DStateBlock9* pBlock = nullptr;
+    IDirect3DSurface9* pTargets[4] = {};
+    IDirect3DSurface9* pDepthStencil = nullptr;
+  };
+
+  struct Snapshot {
+    bool held = false;
+    std::string refused;
+    decltype(gpD3DDevices) devices;
+    decltype(gpD3DResources) resources;
+    decltype(gpD3DVolumes) volumes;
+    decltype(gpD3DVertexDeclarations) vertexDeclarations;
+    decltype(gpD3DStateBlocks) stateBlocks;
+    decltype(gpD3DVertexShaders) vertexShaders;
+    decltype(gpD3DPixelShaders) pixelShaders;
+    decltype(gpD3DSwapChains) swapChains;
+    decltype(gpD3DQuery) queries;
+    // Every object alive at the snapshot. A destroy of one of them is deferred, so a rewind can bring it back.
+    std::unordered_set<IUnknown*> objects;
+    std::unordered_set<IUnknown*> tombstones;
+    // What a buffer or surface held at the snapshot, taken before the first upload after it. Each entry holds a reference.
+    std::unordered_map<IUnknown*, Saved> saved;
+    std::unordered_map<uint32_t, DeviceState> deviceStates;
+    size_t savedBytes = 0;
+    uint32_t notRestored = 0;
+    // Data queue positions of the device and module bridges, reader then writer.
+    size_t pos[4] = {};
+    uint64_t absPos[4] = {};
+  };
+
+  static Snapshot gSnapshot;
+
+  template<typename Fn>
+  static void forEachMap(Fn&& fn) {
+    fn(gpD3DDevices, gSnapshot.devices);
+    fn(gpD3DResources, gSnapshot.resources);
+    fn(gpD3DVolumes, gSnapshot.volumes);
+    fn(gpD3DVertexDeclarations, gSnapshot.vertexDeclarations);
+    fn(gpD3DStateBlocks, gSnapshot.stateBlocks);
+    fn(gpD3DVertexShaders, gSnapshot.vertexShaders);
+    fn(gpD3DPixelShaders, gSnapshot.pixelShaders);
+    fn(gpD3DSwapChains, gSnapshot.swapChains);
+    fn(gpD3DQuery, gSnapshot.queries);
+  }
+
+  static void refuse(const char* reason) {
+    if (gSnapshot.refused.empty()) {
+      gSnapshot.refused = reason;
+      Logger::warn(format_string("[Rewind] the snapshot can no longer be returned to: %s", reason));
+    }
+  }
+
+  // Returns true when the object was alive at the snapshot. Its destroy is then deferred.
+  static bool keeps(IUnknown* pObj) {
+    if (!gSnapshot.held || pObj == nullptr || gSnapshot.objects.count(pObj) == 0) {
+      return false;
+    }
+    gSnapshot.tombstones.insert(pObj);
+    return true;
+  }
+
+  // Counts the writes whose old contents are not kept, and the events no rewind can cross.
+  static void note(const Commands::D3D9Command command) {
+    if (!gSnapshot.held) {
+      return;
+    }
+    switch (command) {
+    case IDirect3DDevice9Ex_UpdateSurface:
+    case IDirect3DDevice9Ex_UpdateTexture:
+    case IDirect3DDevice9Ex_StretchRect:
+    case IDirect3DDevice9Ex_ColorFill:
+    case IDirect3DBaseTexture9_GenerateMipSubLevels:
+    case IDirect3DSurface9_GetDC:
+    case IDirect3DVolume9_UnlockBox:
+      ++gSnapshot.notRestored;
+      break;
+    case IDirect3D9Ex_CreateDevice:
+    case IDirect3D9Ex_CreateDeviceEx:
+    case IDirect3DDevice9Ex_Reset:
+    case IDirect3DDevice9Ex_ResetEx:
+    case IDirect3DDevice9Ex_Destroy:
+      refuse("a device was made, reset or destroyed after the snapshot");
+      break;
+    default:
+      break;
+    }
+  }
+
+  static void store(IUnknown* pObj, const Kind kind, const void* pData, const size_t size) {
+    if (pData == nullptr || gSnapshot.savedBytes + size > kMaxSavedBytes) {
+      ++gSnapshot.notRestored;
+      if (pData != nullptr) {
+        refuse("the contents kept since the snapshot passed 1 GB");
+      }
+      return;
+    }
+    Saved& saved = gSnapshot.saved[pObj];
+    saved.kind = kind;
+    saved.bytes.assign(static_cast<const uint8_t*>(pData), static_cast<const uint8_t*>(pData) + size);
+    gSnapshot.savedBytes += size;
+    pObj->AddRef();
+  }
+
+  // Keeps what a buffer holds before the first upload after the snapshot.
+  template<typename BufferT, typename DescT>
+  static void keepBuffer(BufferT* pBuffer, const Kind kind) {
+    if (!gSnapshot.held || pBuffer == nullptr || gSnapshot.objects.count(pBuffer) == 0 || gSnapshot.saved.count(pBuffer) != 0) {
+      return;
+    }
+    DescT desc;
+    void* pData = nullptr;
+    if (FAILED(pBuffer->GetDesc(&desc)) || FAILED(pBuffer->Lock(0, 0, &pData, D3DLOCK_READONLY))) {
+      ++gSnapshot.notRestored;
+      return;
+    }
+    store(pBuffer, kind, pData, desc.Size);
+    pBuffer->Unlock();
+  }
+
+  // Keeps what a surface holds before the first upload after the snapshot.
+  // A texture level counts as alive at the snapshot when its texture was.
+  static void keepSurface(IDirect3DSurface9* pSurface) {
+    if (!gSnapshot.held || pSurface == nullptr || gSnapshot.saved.count(pSurface) != 0) {
+      return;
+    }
+    IUnknown* pOwner = pSurface;
+    IDirect3DBaseTexture9* pTexture = nullptr;
+    if (SUCCEEDED(pSurface->GetContainer(__uuidof(IDirect3DBaseTexture9), reinterpret_cast<void**>(&pTexture))) && pTexture != nullptr) {
+      pOwner = pTexture;
+      pTexture->Release();
+    }
+    if (gSnapshot.objects.count(pOwner) == 0) {
+      return;
+    }
+    D3DSURFACE_DESC desc;
+    D3DLOCKED_RECT lockedRect;
+    if (FAILED(pSurface->GetDesc(&desc)) || FAILED(pSurface->LockRect(&lockedRect, nullptr, D3DLOCK_READONLY))) {
+      ++gSnapshot.notRestored;
+      return;
+    }
+    store(pSurface, Kind::Surface, lockedRect.pBits, size_t(lockedRect.Pitch) * bridge_util::calcStride(desc.Height, desc.Format));
+    pSurface->UnlockRect();
+  }
+
+  static void putBack(IUnknown* pObj, const Saved& saved) {
+    void* pData = nullptr;
+    switch (saved.kind) {
+    case Kind::VertexBuffer:
+    {
+      const auto pBuffer = static_cast<IDirect3DVertexBuffer9*>(pObj);
+      if (SUCCEEDED(pBuffer->Lock(0, 0, &pData, 0)) && pData != nullptr) {
+        memcpy(pData, saved.bytes.data(), saved.bytes.size());
+        pBuffer->Unlock();
+      }
+      break;
+    }
+    case Kind::IndexBuffer:
+    {
+      const auto pBuffer = static_cast<IDirect3DIndexBuffer9*>(pObj);
+      if (SUCCEEDED(pBuffer->Lock(0, 0, &pData, 0)) && pData != nullptr) {
+        memcpy(pData, saved.bytes.data(), saved.bytes.size());
+        pBuffer->Unlock();
+      }
+      break;
+    }
+    case Kind::Surface:
+    {
+      const auto pSurface = static_cast<IDirect3DSurface9*>(pObj);
+      D3DLOCKED_RECT lockedRect;
+      if (SUCCEEDED(pSurface->LockRect(&lockedRect, nullptr, 0)) && lockedRect.pBits != nullptr) {
+        memcpy(lockedRect.pBits, saved.bytes.data(), saved.bytes.size());
+        pSurface->UnlockRect();
+      }
+      break;
+    }
+    }
+  }
+
+  // Lets go of an object made after the snapshot. One Release matches the reference its create left in the map.
+  // Too few releases leak the object. Too many would free an object the snapshot still needs.
+  static void drop(IUnknown* pObj) {
+    pObj->Release();
+  }
+
+  // A texture level belongs to its texture, as with Bridge_UnlinkResource.
+  static void drop(IDirect3DResource9* pResource) {
+    if (pResource->GetType() == D3DRTYPE_SURFACE) {
+      IDirect3DBaseTexture9* pTexture = nullptr;
+      if (SUCCEEDED(static_cast<IDirect3DSurface9*>(pResource)->GetContainer(__uuidof(IDirect3DBaseTexture9), reinterpret_cast<void**>(&pTexture))) && pTexture != nullptr) {
+        pTexture->Release();
+        return;
+      }
+    }
+    pResource->Release();
+  }
+
+  // A volume belongs to its volume texture, as with Bridge_UnlinkVolumeResource.
+  static void drop(IDirect3DVolume9*) {
+  }
+
+  // Frees what the held snapshot kept alive.
+  static void release() {
+    for (auto& [pObj, saved] : gSnapshot.saved) {
+      pObj->Release();
+    }
+    for (auto& [handle, state] : gSnapshot.deviceStates) {
+      if (state.pBlock != nullptr) {
+        state.pBlock->Release();
+      }
+      for (IDirect3DSurface9* pTarget : state.pTargets) {
+        if (pTarget != nullptr) {
+          pTarget->Release();
+        }
+      }
+      if (state.pDepthStencil != nullptr) {
+        state.pDepthStencil->Release();
+      }
+    }
+    for (IUnknown* pObj : gSnapshot.tombstones) {
+      while (static_cast<LONG>(pObj->Release()) > 0);
+    }
+    gSnapshot = Snapshot();
+  }
+
+  static void take() {
+    release();
+    forEachMap([](auto& live, auto& kept) {
+      kept = live;
+      for (const auto& [handle, pObj] : live) {
+        if (pObj != nullptr) {
+          gSnapshot.objects.insert(pObj);
+        }
+      }
+    });
+    gSnapshot.held = true;
+    for (const auto& [handle, pDevice] : gpD3DDevices) {
+      if (pDevice == nullptr) {
+        continue;
+      }
+      DeviceState& state = gSnapshot.deviceStates[handle];
+      if (FAILED(pDevice->CreateStateBlock(D3DSBT_ALL, &state.pBlock))) {
+        refuse("the device state could not be captured");
+      }
+      for (DWORD i = 0; i < 4; i++) {
+        pDevice->GetRenderTarget(i, &state.pTargets[i]);
+      }
+      pDevice->GetDepthStencilSurface(&state.pDepthStencil);
+    }
+    if (!gPendingSurfaceLocks.empty()) {
+      refuse("a surface upload was in progress at the snapshot");
+    }
+  }
+
+  static void apply() {
+    for (const auto& [pObj, saved] : gSnapshot.saved) {
+      putBack(pObj, saved);
+    }
+    forEachMap([](auto& live, auto& kept) {
+      for (const auto& [handle, pObj] : live) {
+        if (pObj != nullptr && gSnapshot.objects.count(pObj) == 0) {
+          drop(pObj);
+        }
+      }
+      live = kept;
+    });
+    gSnapshot.tombstones.clear();
+    gPendingSurfaceLocks.clear();
+    for (const auto& [handle, state] : gSnapshot.deviceStates) {
+      const auto pDevice = gpD3DDevices[handle];
+      for (DWORD i = 0; i < 4; i++) {
+        if (i != 0 || state.pTargets[i] != nullptr) {
+          pDevice->SetRenderTarget(i, state.pTargets[i]);
+        }
+      }
+      pDevice->SetDepthStencilSurface(state.pDepthStencil);
+      if (state.pBlock != nullptr) {
+        state.pBlock->Apply();
+      }
+    }
+  }
+
+  // Runs one Op and fills the Stat numbers. The numbers describe the time before a rewind was applied.
+  static HRESULT run(const uint32_t op, uint32_t* pStats) {
+    using namespace bridge_util::rewind;
+    if (!enabled()) {
+      return E_NOTIMPL;
+    }
+    if (op == kSnapshot) {
+      take();
+    }
+    if (!gSnapshot.held) {
+      pStats[kStatRefused] = 1;
+      return E_FAIL;
+    }
+    uint32_t dropped = 0;
+    uint32_t buffers = 0;
+    forEachMap([&](auto& live, auto&) {
+      for (const auto& [handle, pObj] : live) {
+        dropped += pObj != nullptr && gSnapshot.objects.count(pObj) == 0;
+      }
+    });
+    for (const auto& [pObj, saved] : gSnapshot.saved) {
+      buffers += saved.kind != Kind::Surface;
+    }
+    pStats[kStatKept] = static_cast<uint32_t>(gSnapshot.objects.size());
+    pStats[kStatRevived] = static_cast<uint32_t>(gSnapshot.tombstones.size());
+    pStats[kStatDropped] = dropped;
+    pStats[kStatBuffers] = buffers;
+    pStats[kStatSurfaces] = static_cast<uint32_t>(gSnapshot.saved.size()) - buffers;
+    pStats[kStatSavedKB] = static_cast<uint32_t>(gSnapshot.savedBytes >> 10);
+    pStats[kStatNotRestored] = gSnapshot.notRestored;
+    pStats[kStatRefused] = !gSnapshot.refused.empty();
+    Logger::info(format_string("[Rewind] op %u: kept %u, revive %u, drop %u, buffers %u, surfaces %u, saved %u KB, not restored %u%s%s",
+                               op, pStats[kStatKept], pStats[kStatRevived], pStats[kStatDropped], pStats[kStatBuffers],
+                               pStats[kStatSurfaces], pStats[kStatSavedKB], pStats[kStatNotRestored],
+                               gSnapshot.refused.empty() ? "" : ", refused: ", gSnapshot.refused.c_str()));
+    if (!gSnapshot.refused.empty()) {
+      return E_FAIL;
+    }
+    if (op == kRewind) {
+      apply();
+      gSnapshot.notRestored = 0;
+    }
+    return S_OK;
+  }
+
+  // Runs after the answer was sent. The client waits for the done event before its host touches the game process.
+  static void finish(const uint32_t op, const bool succeeded) {
+    using namespace bridge_util::rewind;
+    const ULONGLONG start = GetTickCount64();
+    while (!DeviceBridge::getWriterChannel().commands->isEmpty() && GetTickCount64() - start < 10'000) {
+      Sleep(0);
+    }
+    bridge_util::DataQueue* const queues[4] = {
+      DeviceBridge::getReaderChannel().data, DeviceBridge::getWriterChannel().data,
+      ModuleBridge::getReaderChannel().data, ModuleBridge::getWriterChannel().data,
+    };
+    for (size_t i = 0; i < 4; i++) {
+      if (op == kSnapshot && succeeded) {
+        gSnapshot.pos[i] = queues[i]->get_pos();
+        gSnapshot.absPos[i] = queues[i]->get_abs_pos();
+      } else if (op == kRewind && succeeded) {
+        queues[i]->set_pos(gSnapshot.pos[i], gSnapshot.absPos[i]);
+      }
+    }
+    DeviceBridge::publishReadPos();
+    SetEvent(doneEvent());
+  }
+}
