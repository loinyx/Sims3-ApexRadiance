+// Rewind mode (util_rewind.h). Runs at the end of a Present with gPresentMutex held.
+// Each op the host writes is sent to the server and waited for, then op is cleared as the acknowledgement.
+static void parkForRewind() {
+  using namespace bridge_util::rewind;
+  static Coop* const pCoop = createCoop();
+  if (pCoop == nullptr) {
+    return;
+  }
+  const uint32_t tick = ++pCoop->tick;
+  const auto wanted = [&]() {
+    return pCoop->request || (pCoop->parkAtTick && tick >= pCoop->parkAtTick);
+  };
+  const auto runOp = [&]() {
+    const uint32_t op = pCoop->op;
+    if (!op) {
+      return;
+    }
+    int32_t result = -1;
+    if (gbBridgeRunning) {
+      UID currentUID = 0;
+      {
+        ClientMessage c(Commands::Bridge_Rewind, 0);
+        currentUID = c.get_uid();
+        c.send_data(op);
+      }
+      if (Result::Success == DeviceBridge::waitForCommand(Commands::Bridge_Response, GlobalOptions::getCommandTimeout(), nullptr, true, currentUID)) {
+        result = (int32_t) DeviceBridge::get_data();
+        for (uint32_t i = 0; i < kStatCount; i++) {
+          pCoop->bridgeStats[i] = (uint32_t) DeviceBridge::get_data();
+        }
+        DeviceBridge::consumeResponse();
+        // The server moves its queue positions only after its answer has left the queue.
+        if (WaitForSingleObject(doneEvent(), 15'000) != WAIT_OBJECT_0) {
+          result = -2;
+        }
+      }
+    }
+    pCoop->bridgeResult = result;
+    pCoop->op = 0;
+  };
+  if (!wanted()) {
+    return;
+  }
+  runOp();
+  pCoop->parked = 1;
+  while (wanted()) {
+    runOp();
+    Sleep(1);
+  }
+  pCoop->parked = 0;
+}
