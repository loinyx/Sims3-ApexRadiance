diff --git a/bridge/src/util/util_rewind.h b/bridge/src/util/util_rewind.h
new file mode 100644
index 00000000..da887f52
--- /dev/null
+++ b/bridge/src/util/util_rewind.h
@@ -0,0 +1,118 @@
+#pragma once
+
+// Rewind mode, for test harnesses only. Off unless bridge.conf sets rewindMode = True on both sides.
+//
+// A test host snapshots the 32-bit game process and later puts its memory back, so one world load serves many test
+// runs that start from the same state. The game then holds the D3D9 state of the snapshot again, and the server has to
+// return to that state too. The host asks through the cooperation block below. The client answers at the end of a
+// Present: it sends one synchronous Bridge_Rewind command and parks its thread until the host is done. While parked it
+// holds the send locks of both channels, so no other thread of the game can send (client/d3d9_swapchain.cpp).
+// The server side is server/rewind_mode.h.
+
+#include <windows.h>
+#include <cstdint>
+#include <cstdio>
+
+#include "config/global_options.h"
+#include "log/log.h"
+#include "util_guid.h"
+
+extern bridge_util::Guid gUniqueIdentifier;
+
+namespace bridge_util::rewind {
+
+  enum Op : uint32_t {
+    kSnapshot = 1, // the server remembers its state as of this command
+    kRewind = 2,   // the server returns to the remembered state
+    kPlan = 3,     // the server only reports what a rewind would do now
+    kDrop = 4,     // the server lets the remembered state go
+  };
+
+  // The answer to an Op is an HRESULT:
+  //   S_OK       done
+  //   E_FAIL     refused, nothing was changed (the reason is in the log of the side that refused)
+  //   E_NOTIMPL  the mode is off on the server, nothing was changed
+  //   E_ABORT    a rewind failed part-way: the D3D9 state is undefined and the host has to end the game
+  // The client reports -1 when no answer came and -2 when the server did not finish. The host treats both as E_ABORT.
+
+  // Numbers the server returns with each answer.
+  enum Stat : uint32_t {
+    kStatKept,          // objects alive at the snapshot
+    kStatRevived,       // objects destroyed since the snapshot that a rewind brings back
+    kStatDropped,       // objects created since the snapshot that a rewind lets go of
+    kStatBuffers,       // vertex and index buffers whose contents at the snapshot are kept
+    kStatSurfaces,      // surfaces whose contents at the snapshot are kept, render targets and depth surfaces included
+    kStatSavedKB,       // memory the snapshot keeps alive: kept contents and destroyed objects
+    kStatNotRestored,   // cursor commands since the snapshot, which a rewind does not undo
+    kStatRefused,       // 1: the server refuses a rewind to this snapshot
+    kStatCount
+  };
+
+#pragma pack(push, 4)
+  // Named mapping "Local\rewind-coop-<client pid>", created by the client. The first 40 bytes are the layout the host
+  // tool also uses for other test targets.
+  struct Coop {
+    uint32_t magic, version;       // 'RWND', 1
+    uint32_t self;                 // address of this block in the client process
+    volatile int32_t request;      // host -> client: 1 = park at the end of the next Present
+    volatile int32_t parked;       // client -> host: 1 = parked, no thread can send
+    volatile int32_t audioOn;      // unused here
+    volatile uint32_t tick;        // presents so far
+    volatile uint32_t parkAtTick;  // host -> client: park when tick reaches this (0 = off)
+    volatile int64_t skewQpc;      // unused here
+    volatile uint32_t op;          // host -> client: the Op this park is for (0 = park only); the client clears it
+    volatile int32_t bridge;       // client -> host: 1 = a bridge client answers here
+    volatile int32_t bridgeResult; // client -> host: the answer to op
+    volatile uint32_t bridgeStats[kStatCount];
+  };
+#pragma pack(pop)
+
+  constexpr uint32_t kCoopMagic = 0x444E5752; // 'RWND'
+
+  // Time the server waits after a rewind for the client to be back at the snapshot.
+  constexpr DWORD kResumeTimeoutMs = 60'000;
+
+  inline bool enabled() {
+    return GlobalOptions::getRewindMode();
+  }
+
+  // Auto-reset events shared by the client and the server.
+  struct Events {
+    HANDLE done;    // server: the Op is finished and its queue positions are final
+    HANDLE applied; // server: a rewind was applied; seen by the client only once its process is back at the snapshot
+    HANDLE resume;  // client: back at the snapshot; the server reads no command between a rewind and this
+  };
+
+  inline const Events& events() {
+    static const Events events = {
+      CreateEventA(nullptr, FALSE, FALSE, gUniqueIdentifier.toString("RewindDone").c_str()),
+      CreateEventA(nullptr, FALSE, FALSE, gUniqueIdentifier.toString("RewindApplied").c_str()),
+      CreateEventA(nullptr, FALSE, FALSE, gUniqueIdentifier.toString("RewindResume").c_str()),
+    };
+    return events;
+  }
+
+  // Null when the mode is off or the block cannot be made.
+  inline Coop* createCoop() {
+    if (!enabled()) {
+      return nullptr;
+    }
+    char name[64];
+    sprintf_s(name, "Local\\rewind-coop-%lu", GetCurrentProcessId());
+    const HANDLE hMap = CreateFileMappingA(INVALID_HANDLE_VALUE, nullptr, PAGE_READWRITE, 0, 4096, name);
+    Coop* const coop = hMap ? static_cast<Coop*>(MapViewOfFile(hMap, FILE_MAP_WRITE, 0, 0, 0)) : nullptr;
+    if (coop == nullptr) {
+      Logger::err(format_string("[Rewind] The cooperation block %s could not be made (error %lu), so rewind mode stays off.", name, GetLastError()));
+      return nullptr;
+    }
+    // The events exist before any snapshot, so a process put back to one still holds them.
+    events();
+    coop->version = 1;
+    coop->self = static_cast<uint32_t>(reinterpret_cast<uintptr_t>(coop));
+    coop->bridge = 1;
+    coop->magic = kCoopMagic;
+    Logger::info(format_string("[Rewind] Rewind mode is on. Cooperation block: %s", name));
+    return coop;
+  }
+
+}
