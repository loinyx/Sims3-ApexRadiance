diff --git a/bridge/test/rtx/unit/test_rewind_device.cpp b/bridge/test/rtx/unit/test_rewind_device.cpp
new file mode 100644
index 00000000..ce540826
--- /dev/null
+++ b/bridge/test/rtx/unit/test_rewind_device.cpp
@@ -0,0 +1,213 @@
+// Drives rewind mode through the bridge as a test host does, as far as that goes without putting this process back to
+// a snapshot: the park at the end of Present, the Ops that change nothing on the server (snapshot, plan, drop), and the
+// send locks that stop the other threads of the game while the client is parked.
+// With REMIX_REWIND_TEST_CASE=off the mode stays off, and the test checks that the client then publishes nothing.
+// The rewind itself is covered on the server side by test_rewind_server.cpp.
+
+#include <atomic>
+#include <cstdio>
+#include <cstring>
+#include <fstream>
+#include <stdexcept>
+#include <thread>
+
+#include <wrl/client.h>
+
+#include "test_remix_api_bridge_app.h"
+#include "../../../src/util/util_rewind.h"
+
+using Microsoft::WRL::ComPtr;
+using namespace bridge_app_test;
+using namespace bridge_util::rewind;
+
+// util_rewind.h names its events with the bridge's identifier, which this test never uses.
+bridge_util::Guid gUniqueIdentifier;
+
+namespace {
+  constexpr UINT kSize = 64;
+
+  void check(const HRESULT result, const char* pCall) {
+    if (FAILED(result)) {
+      std::printf("FAILED: %s returned 0x%08lX.\n", pCall, static_cast<unsigned long>(result));
+      throw std::runtime_error(pCall);
+    }
+  }
+
+  void expect(const bool condition, const char* pWhat) {
+    std::printf("%s: %s\n", condition ? "ok" : "FAILED", pWhat);
+    if (!condition) {
+      throw std::runtime_error(pWhat);
+    }
+  }
+
+  bool waitFor(const volatile int32_t& value, const int32_t wanted) {
+    const ULONGLONG deadline = GetTickCount64() + 10000;
+    while (value != wanted && GetTickCount64() < deadline) {
+      Sleep(1);
+    }
+    return value == wanted;
+  }
+
+  // Writes one Op as the host and returns the client's answer.
+  int32_t runOp(Coop* pCoop, const uint32_t op) {
+    pCoop->bridgeResult = 0x7fffffff;
+    pCoop->op = op;
+    const ULONGLONG deadline = GetTickCount64() + 20000;
+    while (pCoop->op != 0 && GetTickCount64() < deadline) {
+      Sleep(1);
+    }
+    if (pCoop->op != 0) {
+      throw std::runtime_error("the client did not acknowledge the Op");
+    }
+    return pCoop->bridgeResult;
+  }
+
+  Coop* openCoop() {
+    char name[64];
+    sprintf_s(name, "Local\\rewind-coop-%lu", GetCurrentProcessId());
+    const HANDLE hMap = OpenFileMappingA(FILE_MAP_WRITE, FALSE, name);
+    return hMap != nullptr ? static_cast<Coop*>(MapViewOfFile(hMap, FILE_MAP_WRITE, 0, 0, 0)) : nullptr;
+  }
+}
+
+int main() {
+  std::setvbuf(stdout, nullptr, _IONBF, 0);
+  char testCase[8] = {};
+  GetEnvironmentVariableA("REMIX_REWIND_TEST_CASE", testCase, sizeof(testCase));
+  const bool modeOn = strcmp(testCase, "off") != 0;
+  std::printf("TEST: rewind mode through the bridge, mode %s\n", modeOn ? "on" : "off");
+
+  WNDCLASSW windowClass = {};
+  windowClass.lpfnWndProc = DefWindowProcW;
+  windowClass.hInstance = GetModuleHandleW(nullptr);
+  windowClass.lpszClassName = L"BridgeRewindTest";
+  RegisterClassW(&windowClass);
+  const HWND hWnd = CreateWindowExW(0, windowClass.lpszClassName, L"", WS_OVERLAPPEDWINDOW, 0, 0, kSize, kSize,
+                                    nullptr, nullptr, windowClass.hInstance, nullptr);
+  if (hWnd == nullptr) {
+    return 1;
+  }
+
+  bool passed = false;
+  std::atomic<bool> hostFailed { false };
+  std::atomic<int> stage { 0 };
+  std::thread host;
+  try {
+    if (modeOn) {
+      std::ofstream config(".trex/bridge.conf", std::ios::app);
+      config << "rewindMode = True\n";
+    }
+    const HMODULE hClient = loadBridgeClient();
+    if (hClient == nullptr) {
+      throw std::runtime_error("loadBridgeClient");
+    }
+    const auto pfnCreate = reinterpret_cast<PFN_Direct3DCreate9>(GetProcAddress(hClient, "Direct3DCreate9"));
+    ComPtr<IDirect3D9> pD3D;
+    pD3D.Attach(pfnCreate != nullptr ? pfnCreate(D3D_SDK_VERSION) : nullptr);
+    if (pD3D == nullptr) {
+      throw std::runtime_error("Direct3DCreate9");
+    }
+    D3DPRESENT_PARAMETERS present = {};
+    present.Windowed = TRUE;
+    present.SwapEffect = D3DSWAPEFFECT_DISCARD;
+    present.BackBufferFormat = D3DFMT_UNKNOWN;
+    present.BackBufferWidth = kSize;
+    present.BackBufferHeight = kSize;
+    present.hDeviceWindow = hWnd;
+    ComPtr<IDirect3DDevice9> pDevice;
+    check(pD3D->CreateDevice(D3DADAPTER_DEFAULT, D3DDEVTYPE_HAL, hWnd,
+                              D3DCREATE_SOFTWARE_VERTEXPROCESSING | D3DCREATE_MULTITHREADED,
+                              &present, &pDevice), "CreateDevice");
+    ComPtr<IDirect3DTexture9> pOldTexture;
+    // Made by the second thread while the client is parked, released by this one.
+    ComPtr<IDirect3DSurface9> pNewSurface;
+    check(pDevice->CreateTexture(16, 16, 1, 0, D3DFMT_A8R8G8B8, D3DPOOL_MANAGED, &pOldTexture, nullptr), "CreateTexture");
+    const auto frame = [&]() {
+      check(pDevice->Clear(0, nullptr, D3DCLEAR_TARGET, 0xff102030, 1.0f, 0), "Clear");
+      check(pDevice->Present(nullptr, nullptr, nullptr, nullptr), "Present");
+    };
+    frame();
+    frame();
+
+    Coop* const pCoop = openCoop();
+    if (!modeOn) {
+      expect(pCoop == nullptr, "mode off: the client publishes no cooperation block");
+      for (int i = 0; i < 20; i++) {
+        frame();
+      }
+      passed = true;
+    } else {
+      expect(pCoop != nullptr && pCoop->magic == kCoopMagic && pCoop->bridge == 1, "mode on: the client publishes its cooperation block");
+      const uint32_t* const pStats = const_cast<const uint32_t*>(pCoop->bridgeStats);
+
+      // The host. The main thread below keeps presenting, and stops inside Present while the host asks for it.
+      host = std::thread([&]() {
+        try {
+          pCoop->request = 1;
+          expect(waitFor(pCoop->parked, 1), "the client parks at the end of a Present");
+          expect(runOp(pCoop, kPlan) == E_FAIL, "plan without a snapshot is refused");
+          expect(runOp(pCoop, kSnapshot) == S_OK, "snapshot");
+          expect(pStats[kStatKept] > 0 && pStats[kStatRefused] == 0, "snapshot: the server kept its objects");
+
+          // Another thread of the game cannot send while the client is parked.
+          std::atomic<bool> sent { false };
+          std::thread sender([&]() {
+            pDevice->CreateOffscreenPlainSurface(8, 8, D3DFMT_A8R8G8B8, D3DPOOL_SYSTEMMEM, &pNewSurface, nullptr);
+            sent = true;
+          });
+          Sleep(500);
+          expect(!sent, "a command of another thread waits while the client is parked");
+          pCoop->request = 0;
+          sender.join();
+          expect(waitFor(pCoop->parked, 0) && pNewSurface != nullptr, "after the park the other thread's command goes through");
+
+          // The main thread destroys a texture from before the snapshot.
+          stage = 1;
+          while (stage != 2) {
+            Sleep(1);
+          }
+
+          pCoop->request = 1;
+          expect(waitFor(pCoop->parked, 1), "the client parks again");
+          expect(runOp(pCoop, kPlan) == S_OK, "plan");
+          expect(pStats[kStatRevived] == 1, "plan: the destroyed texture would come back");
+          expect(pStats[kStatDropped] >= 1, "plan: the new surface would be let go");
+          expect(runOp(pCoop, kDrop) == S_OK, "drop");
+          expect(runOp(pCoop, kPlan) == E_FAIL, "plan after the drop is refused");
+          pCoop->request = 0;
+          expect(waitFor(pCoop->parked, 0), "the client runs on");
+        } catch (const std::exception&) {
+          hostFailed = true;
+          pCoop->request = 0;
+        }
+        stage = 3;
+      });
+
+      while (stage != 3) {
+        if (stage == 1) {
+          pOldTexture.Reset();
+          stage = 2;
+        }
+        frame();
+      }
+      host.join();
+      for (int i = 0; i < 20; i++) {
+        frame();
+      }
+      passed = !hostFailed;
+    }
+  } catch (const std::exception& error) {
+    std::printf("FAILED: %s\n", error.what());
+    if (host.joinable()) {
+      host.detach();
+    }
+  }
+  if (!passed) {
+    // A failed run can leave a thread waiting on the bridge, so it does not unwind.
+    std::printf("FAILED\n");
+    TerminateProcess(GetCurrentProcess(), 1);
+  }
+  DestroyWindow(hWnd);
+  std::printf("PASSED\n");
+  return 0;
+}
diff --git a/bridge/test/rtx/unit/test_rewind_server.cpp b/bridge/test/rtx/unit/test_rewind_server.cpp
new file mode 100644
index 00000000..94356f05
--- /dev/null
+++ b/bridge/test/rtx/unit/test_rewind_server.cpp
@@ -0,0 +1,460 @@
+// Runs the server side of rewind mode (src/server/rewind_mode.h) on a D3D9 device, without a client or a game.
+// The tables below stand in for the server's, and destroy() for its destroy commands.
+// The device comes from the system's d3d9.dll, or from the library named by REWIND_TEST_D3D9 (a DXVK build, as the
+// server uses with server.useVanillaDxvk).
+
+#include <windows.h>
+#include <d3d9.h>
+
+#include <cstdio>
+#include <cstring>
+#include <vector>
+
+#include "rewind_mode.h"
+
+std::unordered_map<uint32_t, IDirect3DDevice9*> gpD3DDevices;
+std::unordered_map<uint32_t, IDirect3DResource9*> gpD3DResources;
+std::unordered_map<uint32_t, IDirect3DVolume9*> gpD3DVolumes;
+std::unordered_map<uint32_t, IDirect3DVertexDeclaration9*> gpD3DVertexDeclarations;
+std::unordered_map<uint32_t, IDirect3DStateBlock9*> gpD3DStateBlocks;
+std::unordered_map<uint32_t, IDirect3DVertexShader9*> gpD3DVertexShaders;
+std::unordered_map<uint32_t, IDirect3DPixelShader9*> gpD3DPixelShaders;
+std::unordered_map<uint32_t, IDirect3DSwapChain9*> gpD3DSwapChains;
+std::unordered_map<uint32_t, IDirect3DQuery9*> gpD3DQuery;
+bridge_util::Guid gUniqueIdentifier;
+bool gbBridgeRunning = true;
+
+using namespace bridge_util::rewind;
+
+namespace {
+  constexpr UINT kSize = 64;
+  constexpr uint32_t kDevice = 1;
+
+  int gFailures = 0;
+
+  void expect(const bool condition, const char* pWhat) {
+    std::printf("%s: %s\n", condition ? "ok" : "FAILED", pWhat);
+    std::fflush(stdout);
+    gFailures += !condition;
+  }
+
+  struct Vertex {
+    float x, y, z, rhw;
+    D3DCOLOR color;
+  };
+
+  HRESULT run(const uint32_t op, uint32_t* pStats = nullptr, const char* pBusy = nullptr) {
+    uint32_t stats[kStatCount] = {};
+    const HRESULT hresult = rewind_mode::run(op, stats, pBusy);
+    if (pStats != nullptr) {
+      memcpy(pStats, stats, sizeof(stats));
+    }
+    return hresult;
+  }
+
+  // As safeDestroy and a destroy command of the server.
+  void destroy(const uint32_t handle) {
+    IDirect3DResource9* const pResource = gpD3DResources[handle];
+    if (!rewind_mode::keeps(pResource, handle)) {
+      while (static_cast<LONG>(pResource->Release()) > 0);
+    }
+    gpD3DResources.erase(handle);
+  }
+
+  // As a vertex buffer upload of the server.
+  void fill(IDirect3DVertexBuffer9* pBuffer, const uint8_t value) {
+    D3DVERTEXBUFFER_DESC desc;
+    void* pData = nullptr;
+    pBuffer->GetDesc(&desc);
+    rewind_mode::keepBuffer<IDirect3DVertexBuffer9, D3DVERTEXBUFFER_DESC>(pBuffer, rewind_mode::Kind::VertexBuffer);
+    pBuffer->Lock(0, 0, &pData, 0);
+    memset(pData, value, desc.Size);
+    pBuffer->Unlock();
+  }
+
+  bool holds(IDirect3DVertexBuffer9* pBuffer, const uint8_t value) {
+    D3DVERTEXBUFFER_DESC desc;
+    void* pData = nullptr;
+    pBuffer->GetDesc(&desc);
+    if (FAILED(pBuffer->Lock(0, 0, &pData, D3DLOCK_READONLY))) {
+      return false;
+    }
+    bool same = true;
+    for (UINT i = 0; i < desc.Size; i++) {
+      same &= static_cast<const uint8_t*>(pData)[i] == value;
+    }
+    pBuffer->Unlock();
+    return same;
+  }
+
+  // As a surface upload of the server.
+  void fill(IDirect3DSurface9* pSurface, const D3DCOLOR color) {
+    D3DSURFACE_DESC desc;
+    D3DLOCKED_RECT lockedRect;
+    pSurface->GetDesc(&desc);
+    rewind_mode::keepSurface(pSurface);
+    pSurface->LockRect(&lockedRect, nullptr, 0);
+    for (UINT y = 0; y < desc.Height; y++) {
+      for (UINT x = 0; x < desc.Width; x++) {
+        reinterpret_cast<D3DCOLOR*>(static_cast<uint8_t*>(lockedRect.pBits) + y * lockedRect.Pitch)[x] = color;
+      }
+    }
+    pSurface->UnlockRect();
+  }
+
+  D3DCOLOR pixel(IDirect3DSurface9* pSurface) {
+    D3DLOCKED_RECT lockedRect;
+    if (FAILED(pSurface->LockRect(&lockedRect, nullptr, D3DLOCK_READONLY))) {
+      return 0xdeadbeef;
+    }
+    const D3DCOLOR color = *static_cast<D3DCOLOR*>(lockedRect.pBits);
+    pSurface->UnlockRect();
+    return color;
+  }
+
+  // Reads the middle pixel of a render target.
+  D3DCOLOR targetPixel(IDirect3DDevice9* pDevice, IDirect3DSurface9* pTarget) {
+    D3DSURFACE_DESC desc;
+    IDirect3DSurface9* pCopy = nullptr;
+    D3DLOCKED_RECT lockedRect;
+    D3DCOLOR color = 0xdeadbeef;
+    pTarget->GetDesc(&desc);
+    if (FAILED(pDevice->CreateOffscreenPlainSurface(desc.Width, desc.Height, desc.Format, D3DPOOL_SYSTEMMEM, &pCopy, nullptr))) {
+      return color;
+    }
+    if (SUCCEEDED(pDevice->GetRenderTargetData(pTarget, pCopy)) && SUCCEEDED(pCopy->LockRect(&lockedRect, nullptr, D3DLOCK_READONLY))) {
+      color = reinterpret_cast<D3DCOLOR*>(static_cast<uint8_t*>(lockedRect.pBits) + (desc.Height / 2) * lockedRect.Pitch)[desc.Width / 2] | 0xff000000;
+      pCopy->UnlockRect();
+    }
+    pCopy->Release();
+    return color;
+  }
+
+  void drawQuad(IDirect3DDevice9* pDevice, const float size, const float z, const D3DCOLOR color) {
+    const Vertex quad[4] = {
+      { 0.0f, 0.0f, z, 1.0f, color }, { size, 0.0f, z, 1.0f, color },
+      { 0.0f, size, z, 1.0f, color }, { size, size, z, 1.0f, color },
+    };
+    pDevice->BeginScene();
+    pDevice->SetFVF(D3DFVF_XYZRHW | D3DFVF_DIFFUSE);
+    pDevice->DrawPrimitiveUP(D3DPT_TRIANGLESTRIP, 2, quad, sizeof(Vertex));
+    pDevice->EndScene();
+  }
+
+  DWORD wait(IDirect3DQuery9* pQuery) {
+    DWORD pixels = 0;
+    const ULONGLONG start = GetTickCount64();
+    while (pQuery->GetData(&pixels, sizeof(pixels), D3DGETDATA_FLUSH) == S_FALSE && GetTickCount64() - start < 5000) {
+      Sleep(1);
+    }
+    return pixels;
+  }
+
+  IDirect3DDevice9* createDevice(IDirect3D9* pD3D, const HWND hWnd, const D3DSWAPEFFECT swapEffect, const bool depth) {
+    D3DPRESENT_PARAMETERS parameters = {};
+    parameters.Windowed = TRUE;
+    parameters.SwapEffect = swapEffect;
+    parameters.BackBufferWidth = kSize;
+    parameters.BackBufferHeight = kSize;
+    parameters.BackBufferFormat = D3DFMT_X8R8G8B8;
+    parameters.BackBufferCount = 1;
+    parameters.hDeviceWindow = hWnd;
+    parameters.EnableAutoDepthStencil = depth;
+    parameters.AutoDepthStencilFormat = D3DFMT_D24S8;
+    parameters.PresentationInterval = D3DPRESENT_INTERVAL_IMMEDIATE;
+    IDirect3DDevice9* pDevice = nullptr;
+    const HRESULT hresult = pD3D->CreateDevice(D3DADAPTER_DEFAULT, D3DDEVTYPE_HAL, hWnd, D3DCREATE_HARDWARE_VERTEXPROCESSING, &parameters, &pDevice);
+    if (FAILED(hresult)) {
+      std::printf("FAILED: CreateDevice returned 0x%08lx.\n", static_cast<unsigned long>(hresult));
+    }
+    return pDevice;
+  }
+
+  void clearTables() {
+    rewind_mode::forEachMap([](auto& live, auto&) {
+      live.clear();
+    });
+    rewind_mode::gSnapshot = rewind_mode::Snapshot();
+  }
+
+  // Tables, tombstones, kept contents, render targets, device state, queries, the memory limit and the failure paths.
+  void testObjects(IDirect3D9* pD3D, const HWND hWnd) {
+    IDirect3DDevice9* const pDevice = createDevice(pD3D, hWnd, D3DSWAPEFFECT_COPY, false);
+    if (pDevice == nullptr) {
+      gFailures++;
+      return;
+    }
+    gpD3DDevices[kDevice] = pDevice;
+
+    IDirect3DVertexBuffer9* pBuffer = nullptr;
+    IDirect3DTexture9* pTexture = nullptr;
+    IDirect3DTexture9* pTargetTexture = nullptr;
+    IDirect3DSurface9* pTextureLevel = nullptr;
+    IDirect3DSurface9* pTargetLevel = nullptr;
+    IDirect3DSurface9* pPlain = nullptr;
+    IDirect3DSurface9* pTarget = nullptr;
+    IDirect3DSurface9* pBackBuffer = nullptr;
+    IDirect3DQuery9* pQuery = nullptr;
+    pDevice->CreateVertexBuffer(256, 0, 0, D3DPOOL_MANAGED, &pBuffer, nullptr);
+    pDevice->CreateTexture(16, 16, 1, 0, D3DFMT_A8R8G8B8, D3DPOOL_MANAGED, &pTexture, nullptr);
+    pDevice->CreateTexture(32, 32, 1, D3DUSAGE_RENDERTARGET, D3DFMT_A8R8G8B8, D3DPOOL_DEFAULT, &pTargetTexture, nullptr);
+    pDevice->CreateOffscreenPlainSurface(32, 32, D3DFMT_A8R8G8B8, D3DPOOL_SYSTEMMEM, &pPlain, nullptr);
+    pDevice->CreateRenderTarget(32, 32, D3DFMT_A8R8G8B8, D3DMULTISAMPLE_NONE, 0, FALSE, &pTarget, nullptr);
+    pDevice->GetBackBuffer(0, 0, D3DBACKBUFFER_TYPE_MONO, &pBackBuffer);
+    const bool hasQuery = SUCCEEDED(pDevice->CreateQuery(D3DQUERYTYPE_OCCLUSION, &pQuery));
+    if (pBuffer == nullptr || pTexture == nullptr || pTargetTexture == nullptr || pPlain == nullptr || pTarget == nullptr || pBackBuffer == nullptr) {
+      expect(false, "the test objects were made");
+      return;
+    }
+    pTexture->GetSurfaceLevel(0, &pTextureLevel);
+    pTargetTexture->GetSurfaceLevel(0, &pTargetLevel);
+    gpD3DResources[10] = pBuffer;
+    gpD3DResources[11] = pTexture;
+    gpD3DResources[12] = pTargetTexture;
+    gpD3DResources[13] = pTargetLevel;
+    gpD3DResources[14] = pPlain;
+    gpD3DResources[15] = pTarget;
+    gpD3DResources[16] = pBackBuffer;
+    if (hasQuery) {
+      gpD3DQuery[20] = pQuery;
+    }
+
+    // The state to return to.
+    fill(pBuffer, 0xa1);
+    fill(pTextureLevel, 0xff111111);
+    fill(pPlain, 0xff222222);
+    pDevice->ColorFill(pTarget, nullptr, 0xffff0000);
+    pDevice->ColorFill(pTargetLevel, nullptr, 0xff00ff00);
+    pDevice->Clear(0, nullptr, D3DCLEAR_TARGET, 0xff0000ff, 1.0f, 0);
+    pDevice->SetRenderState(D3DRS_LIGHTING, FALSE);
+    pDevice->SetRenderState(D3DRS_ZENABLE, FALSE);
+    const D3DTEXTUREFILTERTYPE filterAtSnapshot = pTexture->GetAutoGenFilterType();
+    DWORD pixelsAtSnapshot = 0;
+    if (hasQuery) {
+      pQuery->Issue(D3DISSUE_BEGIN);
+      drawQuad(pDevice, 32.0f, 0.5f, 0xff0000ff);
+      pQuery->Issue(D3DISSUE_END);
+      pixelsAtSnapshot = wait(pQuery);
+      expect(pixelsAtSnapshot > 0, "the occlusion query counted pixels before the snapshot");
+    }
+
+    // With no snapshot every hook does nothing.
+    expect(!rewind_mode::keeps(pBuffer, 10), "no snapshot: a destroy is not deferred");
+    rewind_mode::note(Commands::IDirect3DDevice9Ex_Reset);
+    expect(rewind_mode::gSnapshot.state == rewind_mode::State::None && rewind_mode::gSnapshot.saved.empty(), "no snapshot: nothing is kept");
+    expect(run(kRewind) == E_FAIL && run(kPlan) == E_FAIL, "no snapshot: rewind and plan are refused");
+
+    uint32_t stats[kStatCount] = {};
+    expect(run(kSnapshot, stats) == S_OK, "snapshot");
+    expect(stats[kStatKept] == 8 + (hasQuery ? 1 : 0), "snapshot: every object in the tables is kept");
+    // The two render targets, the level of the render target texture and the back buffer (the swap chain copies).
+    expect(stats[kStatSurfaces] == 3, "snapshot: render targets are copied at once");
+
+    // Everything below happens after the snapshot and has to be undone.
+    fill(pBuffer, 0xb2);
+    fill(pTextureLevel, 0xff333333);
+    rewind_mode::keepSurface(pPlain);
+    pDevice->GetRenderTargetData(pTarget, pPlain);
+    rewind_mode::keepSurface(pTarget);
+    pDevice->ColorFill(pTarget, nullptr, 0xff00ffff);
+    pDevice->SetRenderTarget(0, pTargetLevel);
+    pDevice->Clear(0, nullptr, D3DCLEAR_TARGET, 0xffffffff, 1.0f, 0);
+    pDevice->SetRenderState(D3DRS_LIGHTING, TRUE);
+    rewind_mode::keepSettings(pTexture);
+    pTexture->SetAutoGenFilterType(D3DTEXF_POINT);
+    destroy(10);
+    expect(holds(pBuffer, 0xb2), "a destroyed vertex buffer from before the snapshot stays alive");
+    IDirect3DIndexBuffer9* pNewBuffer = nullptr;
+    IDirect3DTexture9* pNewTexture = nullptr;
+    pDevice->CreateIndexBuffer(64, 0, D3DFMT_INDEX16, D3DPOOL_MANAGED, &pNewBuffer, nullptr);
+    pDevice->CreateTexture(8, 8, 1, 0, D3DFMT_A8R8G8B8, D3DPOOL_MANAGED, &pNewTexture, nullptr);
+    // The client hands the freed id out again.
+    gpD3DResources[10] = pNewBuffer;
+    gpD3DResources[30] = pNewTexture;
+    pNewBuffer->AddRef();
+    if (hasQuery) {
+      rewind_mode::noteIssue(pQuery);
+      pQuery->Issue(D3DISSUE_BEGIN);
+      pQuery->Issue(D3DISSUE_END);
+      expect(wait(pQuery) == 0, "the occlusion query counts nothing after the snapshot");
+    }
+    rewind_mode::note(Commands::IDirect3DDevice9Ex_ShowCursor);
+
+    expect(run(kPlan, stats) == S_OK, "plan");
+    expect(stats[kStatRevived] == 1 && stats[kStatDropped] == 2, "plan: one object to revive, two to drop");
+    expect(stats[kStatBuffers] == 1 && stats[kStatSurfaces] == 5, "plan: the written buffer and surfaces are kept");
+    expect(stats[kStatNotRestored] == 1 && stats[kStatRefused] == 0, "plan: one cursor command, not refused");
+    expect(holds(pBuffer, 0xb2) && pixel(pTextureLevel) == 0xff333333, "plan: nothing was changed");
+
+    // A reason that only holds for now refuses the Op and leaves the snapshot alone.
+    expect(run(kRewind, nullptr, "test") == E_FAIL && rewind_mode::held() && holds(pBuffer, 0xb2), "a busy server refuses for now and changes nothing");
+
+    expect(run(kRewind) == S_OK, "rewind");
+    expect(gpD3DResources.size() == 7 && gpD3DResources[10] == pBuffer && gpD3DResources.count(30) == 0, "rewind: the tables are back, the reused id names the old buffer");
+    expect(holds(pBuffer, 0xa1), "rewind: vertex buffer contents");
+    expect(pixel(pTextureLevel) == 0xff111111, "rewind: texture contents");
+    expect(pixel(pPlain) == 0xff222222, "rewind: contents of a surface written by GetRenderTargetData");
+    expect(targetPixel(pDevice, pTarget) == 0xffff0000, "rewind: render target contents");
+    expect(targetPixel(pDevice, pTargetLevel) == 0xff00ff00, "rewind: render target texture contents");
+    expect(targetPixel(pDevice, pBackBuffer) == 0xff0000ff, "rewind: back buffer contents");
+    IDirect3DSurface9* pBound = nullptr;
+    DWORD lighting = TRUE;
+    pDevice->GetRenderTarget(0, &pBound);
+    pDevice->GetRenderState(D3DRS_LIGHTING, &lighting);
+    expect(pBound == pBackBuffer && lighting == FALSE, "rewind: the bound render target and the render states");
+    expect(pTexture->GetAutoGenFilterType() == filterAtSnapshot, "rewind: a texture's filter setting");
+    if (pBound != nullptr) {
+      pBound->Release();
+    }
+    expect(pNewBuffer->Release() == 0, "rewind: an object made after the snapshot is released once");
+    if (hasQuery) {
+      DWORD pixels = 0;
+      const HRESULT hresult = rewind_mode::queryData(pQuery, &pixels, sizeof(pixels), pQuery->GetData(&pixels, sizeof(pixels), 0));
+      expect(hresult == S_OK && pixels == pixelsAtSnapshot, "rewind: a query issued again answers with its result at the snapshot");
+      rewind_mode::noteIssue(pQuery);
+      pQuery->Issue(D3DISSUE_BEGIN);
+      pQuery->Issue(D3DISSUE_END);
+      expect(wait(pQuery) == 0 && rewind_mode::queryData(pQuery, &pixels, sizeof(pixels), S_FALSE) == S_FALSE, "the next issue ends that answer");
+    }
+
+    // The snapshot is still held, so the same state can be returned to again.
+    fill(pBuffer, 0xc3);
+    pDevice->ColorFill(pTarget, nullptr, 0xff123456);
+    expect(run(kRewind) == S_OK && holds(pBuffer, 0xa1) && targetPixel(pDevice, pTarget) == 0xffff0000, "a second rewind to the same snapshot");
+
+    // The memory limit: past it the snapshot is given up and frees what it kept.
+    const size_t limit = rewind_mode::gMaxKeptBytes;
+    rewind_mode::gMaxKeptBytes = rewind_mode::gSnapshot.savedBytes + 100;
+    fill(pBuffer, 0xd4);
+    rewind_mode::gMaxKeptBytes = limit;
+    expect(rewind_mode::gSnapshot.state == rewind_mode::State::Refused && rewind_mode::gSnapshot.saved.empty(), "past the memory limit the snapshot is given up and keeps nothing");
+    expect(run(kRewind, stats) == E_FAIL && stats[kStatRefused] == 1 && holds(pBuffer, 0xd4), "a rewind to it is refused and changes nothing");
+    expect(run(kPlan) == E_FAIL, "a plan for it is refused too");
+
+    // Destroyed objects count towards the limit and are freed with the snapshot.
+    expect(run(kSnapshot) == S_OK, "a new snapshot replaces the refused one");
+    rewind_mode::gMaxKeptBytes = rewind_mode::gSnapshot.savedBytes + 100;
+    destroy(11);
+    rewind_mode::gMaxKeptBytes = limit;
+    expect(rewind_mode::gSnapshot.state == rewind_mode::State::Refused && rewind_mode::gSnapshot.tombstones.empty(), "a destroyed object past the limit is freed with the snapshot");
+    pTextureLevel = nullptr;
+    pTexture = nullptr;
+
+    // A device reset cannot be crossed. The snapshot lets go of its copies before the reset runs.
+    expect(run(kSnapshot) == S_OK, "snapshot before a reset");
+    rewind_mode::note(Commands::IDirect3DDevice9Ex_Reset);
+    expect(rewind_mode::gSnapshot.state == rewind_mode::State::Refused && rewind_mode::gSnapshot.saved.empty() && run(kRewind) == E_FAIL, "a reset gives the snapshot up");
+
+    // Dropping a snapshot frees the destroyed objects it kept alive.
+    expect(run(kSnapshot) == S_OK, "snapshot before a drop");
+    destroy(14);
+    expect(rewind_mode::gSnapshot.tombstones.size() == 1, "the destroyed surface is kept alive");
+    expect(run(kDrop) == S_OK && rewind_mode::gSnapshot.state == rewind_mode::State::None, "drop");
+    pPlain = nullptr;
+
+    // A multisampled render target cannot be copied exactly, so a snapshot with one is refused.
+    IDirect3DSurface9* pMultisampled = nullptr;
+    if (SUCCEEDED(pDevice->CreateRenderTarget(32, 32, D3DFMT_A8R8G8B8, D3DMULTISAMPLE_4_SAMPLES, 0, FALSE, &pMultisampled, nullptr))) {
+      gpD3DResources[40] = pMultisampled;
+      expect(run(kSnapshot) == E_FAIL && rewind_mode::gSnapshot.saved.empty(), "a multisampled render target refuses the snapshot");
+      gpD3DResources.erase(40);
+      pMultisampled->Release();
+    } else {
+      std::printf("skipped: no 4x multisampled render target on this device\n");
+    }
+
+    // A rewind that fails part-way reports it, and every later Op does too.
+    IDirect3DSurface9* pLocked = nullptr;
+    D3DLOCKED_RECT lockedRect;
+    pDevice->CreateOffscreenPlainSurface(8, 8, D3DFMT_A8R8G8B8, D3DPOOL_SYSTEMMEM, &pLocked, nullptr);
+    gpD3DResources[41] = pLocked;
+    expect(run(kSnapshot) == S_OK, "snapshot before a failing rewind");
+    fill(pLocked, 0xff444444);
+    pLocked->LockRect(&lockedRect, nullptr, 0);
+    expect(run(kRewind, stats) == E_ABORT && stats[kStatRefused] == 1, "a rewind that cannot write a surface back fails with E_ABORT");
+    pLocked->UnlockRect();
+    expect(run(kPlan) == E_ABORT && run(kSnapshot) == E_ABORT, "after a failed rewind every Op answers E_ABORT");
+    expect(rewind_mode::gSnapshot.saved.empty() && rewind_mode::gSnapshot.tombstones.empty(), "after a failed rewind nothing is kept alive");
+
+    clearTables();
+    pLocked->Release();
+    pBackBuffer->Release();
+    pTarget->Release();
+    pTargetLevel->Release();
+    pTargetTexture->Release();
+    pBuffer->Release();
+    if (pQuery != nullptr) {
+      pQuery->Release();
+    }
+    expect(pDevice->Release() == 0, "the device has no references left: nothing leaked");
+  }
+
+  // Depth contents, and a swap chain that discards its back buffer.
+  void testDepth(IDirect3D9* pD3D, const HWND hWnd) {
+    IDirect3DDevice9* const pDevice = createDevice(pD3D, hWnd, D3DSWAPEFFECT_DISCARD, true);
+    if (pDevice == nullptr) {
+      gFailures++;
+      return;
+    }
+    gpD3DDevices[kDevice] = pDevice;
+    IDirect3DSurface9* pBackBuffer = nullptr;
+    pDevice->GetBackBuffer(0, 0, D3DBACKBUFFER_TYPE_MONO, &pBackBuffer);
+    gpD3DResources[16] = pBackBuffer;
+    pDevice->SetRenderState(D3DRS_LIGHTING, FALSE);
+    pDevice->SetRenderState(D3DRS_ZENABLE, TRUE);
+    pDevice->SetRenderState(D3DRS_ZFUNC, D3DCMP_LESSEQUAL);
+    pDevice->Clear(0, nullptr, D3DCLEAR_TARGET | D3DCLEAR_ZBUFFER | D3DCLEAR_STENCIL, 0xff000000, 0.25f, 0);
+
+    uint32_t stats[kStatCount] = {};
+    const HRESULT hresult = run(kSnapshot, stats);
+    if (hresult == S_OK) {
+      expect(rewind_mode::gSnapshot.discarded.count(pBackBuffer) == 1 && stats[kStatSurfaces] == 1, "a discarded back buffer is not kept, the depth surface is");
+      pDevice->Clear(0, nullptr, D3DCLEAR_ZBUFFER, 0, 1.0f, 0);
+      expect(run(kRewind) == S_OK, "rewind with a depth surface");
+      // The quad lies behind the depth of the snapshot and in front of the later one.
+      pDevice->Clear(0, nullptr, D3DCLEAR_TARGET, 0xff000000, 1.0f, 0);
+      drawQuad(pDevice, static_cast<float>(kSize), 0.5f, 0xffffffff);
+      expect(targetPixel(pDevice, pBackBuffer) == 0xff000000, "rewind: depth contents");
+      expect(run(kDrop) == S_OK, "drop");
+    } else {
+      // This D3D9 does not copy the depth surface. Then the snapshot has to refuse and keep nothing.
+      expect(hresult == E_FAIL && rewind_mode::gSnapshot.state == rewind_mode::State::Refused && rewind_mode::gSnapshot.saved.empty(),
+             "a depth surface that cannot be copied refuses the snapshot");
+      std::printf("note: %s\n", rewind_mode::gSnapshot.reason.c_str());
+    }
+
+    clearTables();
+    pBackBuffer->Release();
+    expect(pDevice->Release() == 0, "the device has no references left: nothing leaked");
+  }
+}
+
+int main() {
+  char library[MAX_PATH] = "d3d9.dll";
+  GetEnvironmentVariableA("REWIND_TEST_D3D9", library, sizeof(library));
+  const HMODULE hD3D9 = LoadLibraryA(library);
+  const auto pfnCreate = hD3D9 != nullptr
+    ? reinterpret_cast<IDirect3D9* (WINAPI*)(UINT)>(GetProcAddress(hD3D9, "Direct3DCreate9"))
+    : nullptr;
+  IDirect3D9* const pD3D = pfnCreate != nullptr ? pfnCreate(D3D_SDK_VERSION) : nullptr;
+  if (pD3D == nullptr) {
+    std::printf("FAILED: no Direct3D 9 from %s (error %lu).\n", library, GetLastError());
+    return 1;
+  }
+  std::printf("TEST: rewind mode, server side, on %s\n", library);
+
+  WNDCLASSW windowClass = {};
+  windowClass.lpfnWndProc = DefWindowProcW;
+  windowClass.hInstance = GetModuleHandleW(nullptr);
+  windowClass.lpszClassName = L"BridgeRewindServerTest";
+  RegisterClassW(&windowClass);
+  const HWND hWnd = CreateWindowExW(0, windowClass.lpszClassName, L"", WS_OVERLAPPEDWINDOW, 0, 0, kSize, kSize, nullptr, nullptr, windowClass.hInstance, nullptr);
+
+  testObjects(pD3D, hWnd);
+  testDepth(pD3D, hWnd);
+
+  pD3D->Release();
+  DestroyWindow(hWnd);
+  std::printf(gFailures ? "FAILED: %d checks failed.\n" : "PASSED\n", gFailures);
+  return gFailures ? 1 : 0;
+}
