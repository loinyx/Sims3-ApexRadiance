+// Returns true once the server has run every command of the bridge and every answer has been read.
+// Waits a moment for another thread that is still reading its answer.
+template<typename BridgeT>
+static bool isQuiet() {
+  const auto& writer = BridgeT::getWriterChannel();
+  for (uint32_t i = 0; i < 250; i++) {
+    if (writer.commands->isEmpty() && BridgeT::getReaderChannel().commands->isEmpty() &&
+        writer.serverDataPos->load() == static_cast<int64_t>(writer.data->get_abs_pos())) {
+      return true;
+    }
+    Sleep(1);
+  }
+  return false;
+}
+
+// Rewind mode (util_rewind.h). Runs at the end of a Present with gPresentMutex held.
+//
+// Nothing limits D3D9 calls to this thread: each command only takes its channel's send lock, and Present does not take
+// the device lock. So the park holds the send locks of both bridges, which stops every other sender at its next command.
+// It lets go of the device bridge's lock only to send its own command, and checks afterwards that no other thread sent.
+// Each Op the host writes is sent to the server and waited for, then op is cleared as the acknowledgement.
+static void parkForRewind() {
+  using namespace bridge_util::rewind;
+  static Coop* const pCoop = createCoop();
+  if (pCoop == nullptr) {
+    return;
+  }
+  const uint32_t tick = ++pCoop->tick;
+  const auto wanted = [&]() {
+    return pCoop->request || (pCoop->parkAtTick && tick >= pCoop->parkAtTick);
+  };
+  if (!wanted()) {
+    return;
+  }
+
+  std::unique_lock moduleLock(ModuleBridge::getWriterChannel().m_mutex);
+  std::unique_lock deviceLock(DeviceBridge::getWriterChannel().m_mutex);
+  // True in the run that asked for a rewind. A process put back to its snapshot holds false again.
+  bool rewound = false;
+
+  // Sends one Op and returns the server's answer, or a negative number when none came.
+  const auto send = [&](const uint32_t op, UID& uid) {
+    int32_t result = -1;
+    {
+      ClientMessage c(Commands::Bridge_Rewind, 0);
+      uid = c.get_uid();
+      c.send_data(op);
+    }
+    if (Result::Success == DeviceBridge::waitForCommand(Commands::Bridge_Response, GlobalOptions::getCommandTimeout(), nullptr, true, uid)) {
+      result = static_cast<int32_t>(DeviceBridge::get_data());
+      for (uint32_t i = 0; i < kStatCount; i++) {
+        pCoop->bridgeStats[i] = static_cast<uint32_t>(DeviceBridge::get_data());
+      }
+      DeviceBridge::consumeResponse();
+      // The server sets its queue positions after its answer.
+      if (WaitForSingleObject(events().done, 15'000) != WAIT_OBJECT_0) {
+        result = -2;
+      }
+    }
+    return result;
+  };
+
+  const auto runOp = [&]() {
+    const uint32_t op = pCoop->op;
+    if (!op) {
+      return;
+    }
+    int32_t result = -1;
+    if (!gbBridgeRunning) {
+      Logger::warn(format_string("[Rewind] Op %u is not sent: the bridge is off.", op));
+    } else if (!isQuiet<ModuleBridge>()) {
+      result = E_FAIL;
+      Logger::warn(format_string("[Rewind] Op %u is refused, nothing was changed: another thread is waiting for a module command.", op));
+    } else {
+      deviceLock.unlock();
+      UID uid = 0;
+      result = send(op, uid);
+      deviceLock.lock();
+      if (op == kRewind) {
+        // What another thread sent since is undone with this process, and the server reads nothing until then.
+        rewound = rewound || result == S_OK;
+      } else if (result == S_OK && (DeviceBridge::Command::get_uid() != uid + 1 || !isQuiet<DeviceBridge>())) {
+        result = E_FAIL;
+        Logger::warn(format_string("[Rewind] Op %u is refused: another thread sent D3D9 commands during the park.", op));
+        if (op == kSnapshot) {
+          // The server's snapshot no longer matches this process.
+          deviceLock.unlock();
+          send(kDrop, uid);
+          deviceLock.lock();
+        }
+      }
+    }
+    pCoop->bridgeResult = result;
+    pCoop->op = 0;
+  };
+
+  // Lets the server read commands again after a rewind. Only a process that was put back to its snapshot gets here
+  // with the event set, and the server waits for it.
+  const auto resume = [&]() {
+    if (!rewound && WaitForSingleObject(events().applied, 0) == WAIT_OBJECT_0) {
+      SetEvent(events().resume);
+    }
+  };
+
+  runOp();
+  pCoop->parked = 1;
+  while (wanted()) {
+    runOp();
+    resume();
+    Sleep(1);
+  }
+  resume();
+  pCoop->parked = 0;
+}
