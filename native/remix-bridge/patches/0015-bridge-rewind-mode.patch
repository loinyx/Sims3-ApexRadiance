+#pragma once
+
+// Rewind mode, server side (util_rewind.h): what the server keeps while a snapshot is held and how it returns to it.
+// The code lives in this header so that test/rtx/unit/test_rewind_server.cpp runs it on a D3D9 device without a client.
+//
+// Every function returns at its first test unless a snapshot is held, and none is taken while the mode is off.
+// A rewind is exact or it does not happen: whatever cannot be put back makes the snapshot refuse, before anything changes.
+
+#include <d3d9.h>
+
+#include <algorithm>
+#include <string>
+#include <unordered_map>
+#include <unordered_set>
+#include <utility>
+#include <vector>
+
+#include "log/log.h"
+#include "util_commands.h"
+#include "util_rewind.h"
+#include "util_texture_and_volume.h"
+
+// The handle tables of main.cpp.
+extern std::unordered_map<uint32_t, IDirect3DDevice9*> gpD3DDevices;
+extern std::unordered_map<uint32_t, IDirect3DResource9*> gpD3DResources;
+extern std::unordered_map<uint32_t, IDirect3DVolume9*> gpD3DVolumes;
+extern std::unordered_map<uint32_t, IDirect3DVertexDeclaration9*> gpD3DVertexDeclarations;
+extern std::unordered_map<uint32_t, IDirect3DStateBlock9*> gpD3DStateBlocks;
+extern std::unordered_map<uint32_t, IDirect3DVertexShader9*> gpD3DVertexShaders;
+extern std::unordered_map<uint32_t, IDirect3DPixelShader9*> gpD3DPixelShaders;
+extern std::unordered_map<uint32_t, IDirect3DSwapChain9*> gpD3DSwapChains;
+extern std::unordered_map<uint32_t, IDirect3DQuery9*> gpD3DQuery;
+
+namespace rewind_mode {
+  using bridge_util::Logger;
+  using bridge_util::format_string;
+
+  // Bytes a held snapshot may keep alive: kept contents and destroyed objects. Past it the snapshot is given up.
+  inline size_t gMaxKeptBytes = size_t(1) << 30;
+  // The kept bytes are logged each time they grow by this much.
+  constexpr size_t kLogStepBytes = size_t(128) << 20;
+  // Time a snapshot waits for the results of the queries in flight.
+  constexpr ULONGLONG kQueryWaitMs = 500;
+
+  enum class State {
+    None,
+    Held,
+    Refused, // the snapshot was given up: nothing is kept, and each Op answers with the reason
+    Failed,  // a rewind failed part-way: the D3D9 state is undefined
+  };
+
+  enum class Kind { VertexBuffer, IndexBuffer, Surface, Target };
+
+  struct Saved {
+    Kind kind;
+    std::vector<uint8_t> bytes;         // what a locked buffer or surface held
+    IDirect3DSurface9* pCopy = nullptr; // Kind::Target: a surface on the device with the contents
+    size_t size = 0;
+  };
+
+  struct DeviceState {
+    IDirect3DStateBlock9* pBlock = nullptr;
+    IDirect3DSurface9* pTargets[4] = {};
+    IDirect3DSurface9* pDepthStencil = nullptr;
+    DWORD targetCount = 0;
+    D3DGAMMARAMP gamma = {};
+    BOOL softwareVertexProcessing = FALSE;
+  };
+
+  struct Snapshot {
+    State state = State::None;
+    std::string reason;
+    decltype(gpD3DDevices) devices;
+    decltype(gpD3DResources) resources;
+    decltype(gpD3DVolumes) volumes;
+    decltype(gpD3DVertexDeclarations) vertexDeclarations;
+    decltype(gpD3DStateBlocks) stateBlocks;
+    decltype(gpD3DVertexShaders) vertexShaders;
+    decltype(gpD3DPixelShaders) pixelShaders;
+    decltype(gpD3DSwapChains) swapChains;
+    decltype(gpD3DQuery) queries;
+    // Every object alive at the snapshot. A destroy of one of them is deferred, so a rewind can bring it back.
+    std::unordered_set<IUnknown*> objects;
+    // Deferred destroys, with the size each one keeps alive.
+    std::unordered_map<IUnknown*, size_t> tombstones;
+    // What a buffer or surface held at the snapshot. Each entry holds a reference.
+    // Render targets and depth surfaces are copied at the snapshot, the rest before the first write after it.
+    std::unordered_map<IUnknown*, Saved> saved;
+    // Back buffers of swap chains that discard: D3D9 leaves their contents undefined after a Present, so none are kept.
+    std::unordered_set<IDirect3DSurface9*> discarded;
+    std::unordered_map<uint32_t, DeviceState> deviceStates;
+    // SetLOD and SetAutoGenFilterType values at the snapshot of the textures that had one set after it.
+    std::unordered_map<IDirect3DBaseTexture9*, std::pair<DWORD, D3DTEXTUREFILTERTYPE>> textureSettings;
+    // Results at the snapshot of the queries that had one, and the queries whose result was still on its way.
+    std::unordered_map<IDirect3DQuery9*, std::vector<uint8_t>> queryResults;
+    std::unordered_set<IDirect3DQuery9*> queriesPending;
+    // Queries issued again since the snapshot. After a rewind queryAnswers gives them their old result back.
+    std::unordered_set<IDirect3DQuery9*> queriesIssued;
+    std::unordered_map<IDirect3DQuery9*, std::vector<uint8_t>> queryAnswers;
+    size_t savedBytes = 0;
+    size_t tombstoneBytes = 0;
+    size_t loggedBytes = 0;
+    uint32_t notRestored = 0;
+  };
+
+  inline Snapshot gSnapshot;
+
+  inline bool held() {
+    return gSnapshot.state == State::Held;
+  }
+
+  template<typename Fn>
+  inline void forEachMap(Fn&& fn) {
+    fn(gpD3DDevices, gSnapshot.devices);
+    fn(gpD3DResources, gSnapshot.resources);
+    fn(gpD3DVolumes, gSnapshot.volumes);
+    fn(gpD3DVertexDeclarations, gSnapshot.vertexDeclarations);
+    fn(gpD3DStateBlocks, gSnapshot.stateBlocks);
+    fn(gpD3DVertexShaders, gSnapshot.vertexShaders);
+    fn(gpD3DPixelShaders, gSnapshot.pixelShaders);
+    fn(gpD3DSwapChains, gSnapshot.swapChains);
+    fn(gpD3DQuery, gSnapshot.queries);
+  }
+
+  // Frees everything the snapshot keeps alive, the deferred destroys included, and forgets the snapshot.
+  inline void release() {
+    for (auto& [pObj, saved] : gSnapshot.saved) {
+      if (saved.pCopy != nullptr) {
+        saved.pCopy->Release();
+      }
+      pObj->Release();
+    }
+    for (auto& [handle, state] : gSnapshot.deviceStates) {
+      if (state.pBlock != nullptr) {
+        state.pBlock->Release();
+      }
+      for (IDirect3DSurface9* pTarget : state.pTargets) {
+        if (pTarget != nullptr) {
+          pTarget->Release();
+        }
+      }
+      if (state.pDepthStencil != nullptr) {
+        state.pDepthStencil->Release();
+      }
+    }
+    for (auto& [pObj, size] : gSnapshot.tombstones) {
+      while (static_cast<LONG>(pObj->Release()) > 0);
+    }
+    gSnapshot = Snapshot();
+  }
+
+  // Gives the snapshot up. Callers must not touch what the snapshot kept afterwards.
+  inline void refuse(const std::string& reason) {
+    if (!held()) {
+      return;
+    }
+    release();
+    gSnapshot.state = State::Refused;
+    gSnapshot.reason = reason;
+    Logger::warn(format_string("[Rewind] The snapshot is given up, a rewind to it is refused: %s", reason.c_str()));
+  }
+
+  // Sizes are estimates for the memory limit.
+  inline size_t approxSize(const UINT width, const UINT height, const D3DFORMAT format) {
+    const size_t pixels = size_t(width) * height;
+    switch (static_cast<DWORD>(format)) {
+    case D3DFMT_DXT1:
+    case MAKEFOURCC('A', 'T', 'I', '1'):
+      return pixels / 2;
+    case D3DFMT_DXT2:
+    case D3DFMT_DXT3:
+    case D3DFMT_DXT4:
+    case D3DFMT_DXT5:
+    case MAKEFOURCC('A', 'T', 'I', '2'):
+    case D3DFMT_A8:
+    case D3DFMT_L8:
+    case D3DFMT_P8:
+      return pixels;
+    case D3DFMT_R5G6B5:
+    case D3DFMT_X1R5G5B5:
+    case D3DFMT_A1R5G5B5:
+    case D3DFMT_A4R4G4B4:
+    case D3DFMT_A8L8:
+    case D3DFMT_V8U8:
+    case D3DFMT_L16:
+    case D3DFMT_D16:
+    case D3DFMT_D16_LOCKABLE:
+    case D3DFMT_R16F:
+      return pixels * 2;
+    case D3DFMT_A16B16G16R16:
+    case D3DFMT_A16B16G16R16F:
+    case D3DFMT_G32R32F:
+      return pixels * 8;
+    case D3DFMT_A32B32G32R32F:
+      return pixels * 16;
+    default:
+      return pixels * 4;
+    }
+  }
+
+  inline size_t approxSize(IDirect3DResource9* pResource) {
+    size_t size = 0;
+    switch (pResource->GetType()) {
+    case D3DRTYPE_SURFACE:
+    {
+      D3DSURFACE_DESC desc;
+      if (SUCCEEDED(static_cast<IDirect3DSurface9*>(pResource)->GetDesc(&desc))) {
+        size = approxSize(desc.Width, desc.Height, desc.Format) * std::max<DWORD>(1, desc.MultiSampleType);
+      }
+      break;
+    }
+    case D3DRTYPE_TEXTURE:
+    case D3DRTYPE_CUBETEXTURE:
+    {
+      const bool cube = pResource->GetType() == D3DRTYPE_CUBETEXTURE;
+      const DWORD levels = static_cast<IDirect3DBaseTexture9*>(pResource)->GetLevelCount();
+      for (DWORD level = 0; level < levels; level++) {
+        D3DSURFACE_DESC desc;
+        const HRESULT hresult = cube
+          ? static_cast<IDirect3DCubeTexture9*>(pResource)->GetLevelDesc(level, &desc)
+          : static_cast<IDirect3DTexture9*>(pResource)->GetLevelDesc(level, &desc);
+        if (SUCCEEDED(hresult)) {
+          size += approxSize(desc.Width, desc.Height, desc.Format) * (cube ? 6 : 1);
+        }
+      }
+      break;
+    }
+    case D3DRTYPE_VOLUMETEXTURE:
+    {
+      D3DVOLUME_DESC desc;
+      if (SUCCEEDED(static_cast<IDirect3DVolumeTexture9*>(pResource)->GetLevelDesc(0, &desc))) {
+        size = approxSize(desc.Width, desc.Height, desc.Format) * desc.Depth;
+      }
+      break;
+    }
+    case D3DRTYPE_VERTEXBUFFER:
+    {
+      D3DVERTEXBUFFER_DESC desc;
+      if (SUCCEEDED(static_cast<IDirect3DVertexBuffer9*>(pResource)->GetDesc(&desc))) {
+        size = desc.Size;
+      }
+      break;
+    }
+    case D3DRTYPE_INDEXBUFFER:
+    {
+      D3DINDEXBUFFER_DESC desc;
+      if (SUCCEEDED(static_cast<IDirect3DIndexBuffer9*>(pResource)->GetDesc(&desc))) {
+        size = desc.Size;
+      }
+      break;
+    }
+    default:
+      break;
+    }
+    return size;
+  }
+
+  // Applies the memory limit after the kept bytes grew.
+  inline void account() {
+    const size_t kept = gSnapshot.savedBytes + gSnapshot.tombstoneBytes;
+    if (kept > gMaxKeptBytes) {
+      refuse(format_string("it keeps %zu MB alive (%zu MB of contents, %zu MB of destroyed objects), the limit is %zu MB (rewindMaxKeptMB)",
+                           kept >> 20, gSnapshot.savedBytes >> 20, gSnapshot.tombstoneBytes >> 20, gMaxKeptBytes >> 20));
+    } else if (kept >= gSnapshot.loggedBytes + kLogStepBytes) {
+      gSnapshot.loggedBytes = kept;
+      Logger::info(format_string("[Rewind] The snapshot keeps %zu MB of contents and %zu MB of destroyed objects alive, the limit is %zu MB.",
+                                 gSnapshot.savedBytes >> 20, gSnapshot.tombstoneBytes >> 20, gMaxKeptBytes >> 20));
+    }
+  }
+
+  // Returns true when the object was alive at the snapshot. Its destroy is then deferred, and the caller leaves it alone.
+  inline bool keeps(IUnknown* pObj, const uint32_t handle) {
+    if (!held() || pObj == nullptr || gSnapshot.objects.count(pObj) == 0) {
+      return false;
+    }
+    size_t size = 0;
+    const auto resource = gpD3DResources.find(handle);
+    if (resource != gpD3DResources.end() && resource->second == pObj) {
+      size = approxSize(resource->second);
+    }
+    if (gSnapshot.tombstones.emplace(pObj, size).second) {
+      gSnapshot.tombstoneBytes += size;
+      account();
+    }
+    return true;
+  }
+
+  // Runs before each device command. Gives the snapshot up at a command that no rewind can cross.
+  inline void note(const Commands::D3D9Command command) {
+    if (!held()) {
+      return;
+    }
+    using namespace Commands;
+    switch (command) {
+    case IDirect3D9Ex_CreateDevice:
+    case IDirect3D9Ex_CreateDeviceEx:
+    case IDirect3DDevice9Ex_Reset:
+    case IDirect3DDevice9Ex_ResetEx:
+    case IDirect3DDevice9Ex_Destroy:
+      refuse("a device was made, reset or destroyed after the snapshot");
+      break;
+    case IDirect3DDevice9Ex_SetDialogBoxMode:
+      refuse(format_string("%s after the snapshot is not put back", toString(command).c_str()));
+      break;
+    case IDirect3DDevice9Ex_SetCursorProperties:
+    case IDirect3DDevice9Ex_SetCursorPosition:
+    case IDirect3DDevice9Ex_ShowCursor:
+      // The cursor follows the mouse, which no rewind moves back. Counted for the host.
+      ++gSnapshot.notRestored;
+      break;
+    default:
+      if (command >= RemixApi_CreateMaterial && command <= Bridge_SharedHeap_Dealloc) {
+        refuse(format_string("%s after the snapshot: Remix API objects and the shared heap are not covered", toString(command).c_str()));
+      }
+      break;
+    }
+  }
+
+  inline void store(IUnknown* pObj, const Kind kind, const void* pData, const size_t size) {
+    Saved& saved = gSnapshot.saved[pObj];
+    saved.kind = kind;
+    saved.size = size;
+    saved.bytes.assign(static_cast<const uint8_t*>(pData), static_cast<const uint8_t*>(pData) + size);
+    gSnapshot.savedBytes += size;
+    pObj->AddRef();
+    account();
+  }
+
+  // Keeps what a buffer holds before the first upload after the snapshot.
+  template<typename BufferT, typename DescT>
+  inline void keepBuffer(BufferT* pBuffer, const Kind kind) {
+    if (!held() || pBuffer == nullptr || gSnapshot.objects.count(pBuffer) == 0 || gSnapshot.saved.count(pBuffer) != 0) {
+      return;
+    }
+    DescT desc;
+    void* pData = nullptr;
+    if (FAILED(pBuffer->GetDesc(&desc)) || FAILED(pBuffer->Lock(0, 0, &pData, D3DLOCK_READONLY)) || pData == nullptr) {
+      refuse("a buffer written after the snapshot could not be read first");
+      return;
+    }
+    store(pBuffer, kind, pData, desc.Size);
+    pBuffer->Unlock();
+  }
+
+  // Copies a render target or depth surface on the device. Runs at the snapshot only: later the contents are no longer the snapshot's.
+  inline void keepTarget(IDirect3DSurface9* pSurface) {
+    if (!held() || pSurface == nullptr || gSnapshot.saved.count(pSurface) != 0 || gSnapshot.discarded.count(pSurface) != 0) {
+      return;
+    }
+    D3DSURFACE_DESC desc = {};
+    IDirect3DDevice9* pDevice = nullptr;
+    IDirect3DSurface9* pCopy = nullptr;
+    HRESULT hresult = pSurface->GetDesc(&desc);
+    if (SUCCEEDED(hresult) && static_cast<DWORD>(desc.Format) == MAKEFOURCC('N', 'U', 'L', 'L')) {
+      // A render target of this format has no contents.
+      return;
+    }
+    if (SUCCEEDED(hresult) && desc.MultiSampleType != D3DMULTISAMPLE_NONE) {
+      // A copy between multisampled surfaces may resolve them, which loses the samples.
+      refuse(format_string("a multisampled %ux%u %s cannot be copied exactly", desc.Width, desc.Height,
+                           (desc.Usage & D3DUSAGE_DEPTHSTENCIL) ? "depth surface" : "render target"));
+      return;
+    }
+    if (SUCCEEDED(hresult)) {
+      hresult = pSurface->GetDevice(&pDevice);
+    }
+    if (SUCCEEDED(hresult)) {
+      hresult = (desc.Usage & D3DUSAGE_DEPTHSTENCIL)
+        ? pDevice->CreateDepthStencilSurface(desc.Width, desc.Height, desc.Format, desc.MultiSampleType, desc.MultiSampleQuality, FALSE, &pCopy, nullptr)
+        : pDevice->CreateRenderTarget(desc.Width, desc.Height, desc.Format, desc.MultiSampleType, desc.MultiSampleQuality, FALSE, &pCopy, nullptr);
+    }
+    if (SUCCEEDED(hresult)) {
+      hresult = pDevice->StretchRect(pSurface, nullptr, pCopy, nullptr, D3DTEXF_NONE);
+    }
+    if (pDevice != nullptr) {
+      pDevice->Release();
+    }
+    if (FAILED(hresult)) {
+      if (pCopy != nullptr) {
+        pCopy->Release();
+      }
+      refuse(format_string("a %ux%u %s of format %d could not be copied (0x%08lx)", desc.Width, desc.Height,
+                           (desc.Usage & D3DUSAGE_DEPTHSTENCIL) ? "depth surface" : "render target",
+                           static_cast<int>(desc.Format), static_cast<unsigned long>(hresult)));
+      return;
+    }
+    Saved& saved = gSnapshot.saved[pSurface];
+    saved.kind = Kind::Target;
+    saved.pCopy = pCopy;
+    saved.size = approxSize(desc.Width, desc.Height, desc.Format);
+    gSnapshot.savedBytes += saved.size;
+    pSurface->AddRef();
+    account();
+  }
+
+  // Copies the surfaces of a resource that the device draws into.
+  inline void keepTargets(IDirect3DResource9* pResource) {
+    constexpr DWORD kTargetUsage = D3DUSAGE_RENDERTARGET | D3DUSAGE_DEPTHSTENCIL;
+    D3DSURFACE_DESC desc;
+    switch (pResource->GetType()) {
+    case D3DRTYPE_SURFACE:
+    {
+      const auto pSurface = static_cast<IDirect3DSurface9*>(pResource);
+      if (SUCCEEDED(pSurface->GetDesc(&desc)) && (desc.Usage & kTargetUsage) != 0) {
+        keepTarget(pSurface);
+      }
+      break;
+    }
+    case D3DRTYPE_TEXTURE:
+    {
+      const auto pTexture = static_cast<IDirect3DTexture9*>(pResource);
+      if (FAILED(pTexture->GetLevelDesc(0, &desc)) || (desc.Usage & kTargetUsage) == 0) {
+        break;
+      }
+      for (DWORD level = 0; level < pTexture->GetLevelCount() && held(); level++) {
+        IDirect3DSurface9* pSurface = nullptr;
+        if (SUCCEEDED(pTexture->GetSurfaceLevel(level, &pSurface))) {
+          keepTarget(pSurface);
+          pSurface->Release();
+        }
+      }
+      break;
+    }
+    case D3DRTYPE_CUBETEXTURE:
+    {
+      const auto pTexture = static_cast<IDirect3DCubeTexture9*>(pResource);
+      if (FAILED(pTexture->GetLevelDesc(0, &desc)) || (desc.Usage & kTargetUsage) == 0) {
+        break;
+      }
+      for (DWORD level = 0; level < pTexture->GetLevelCount(); level++) {
+        for (int face = D3DCUBEMAP_FACE_POSITIVE_X; face <= D3DCUBEMAP_FACE_NEGATIVE_Z && held(); face++) {
+          IDirect3DSurface9* pSurface = nullptr;
+          if (SUCCEEDED(pTexture->GetCubeMapSurface(static_cast<D3DCUBEMAP_FACES>(face), level, &pSurface))) {
+            keepTarget(pSurface);
+            pSurface->Release();
+          }
+        }
+      }
+      break;
+    }
+    default:
+      break;
+    }
+  }
+
+  // Keeps what a surface holds before the first write after the snapshot.
+  // A texture level counts as alive at the snapshot when its texture was.
+  inline void keepSurface(IDirect3DSurface9* pSurface) {
+    if (!held() || pSurface == nullptr || gSnapshot.saved.count(pSurface) != 0) {
+      return;
+    }
+    IUnknown* pOwner = pSurface;
+    IDirect3DBaseTexture9* pTexture = nullptr;
+    if (SUCCEEDED(pSurface->GetContainer(__uuidof(IDirect3DBaseTexture9), reinterpret_cast<void**>(&pTexture))) && pTexture != nullptr) {
+      pOwner = pTexture;
+      pTexture->Release();
+    }
+    if (gSnapshot.objects.count(pOwner) == 0 || gSnapshot.discarded.count(pSurface) != 0) {
+      return;
+    }
+    D3DSURFACE_DESC desc;
+    D3DLOCKED_RECT lockedRect;
+    if (FAILED(pSurface->GetDesc(&desc))) {
+      refuse("a surface written after the snapshot could not be described");
+      return;
+    }
+    if ((desc.Usage & (D3DUSAGE_RENDERTARGET | D3DUSAGE_DEPTHSTENCIL)) != 0) {
+      refuse("a render target or depth surface was not copied at the snapshot");
+      return;
+    }
+    if (FAILED(pSurface->LockRect(&lockedRect, nullptr, D3DLOCK_READONLY)) || lockedRect.pBits == nullptr) {
+      refuse(format_string("a %ux%u surface of format %d written after the snapshot could not be read first",
+                           desc.Width, desc.Height, static_cast<int>(desc.Format)));
+      return;
+    }
+    store(pSurface, Kind::Surface, lockedRect.pBits, size_t(lockedRect.Pitch) * bridge_util::calcStride(desc.Height, desc.Format));
+    pSurface->UnlockRect();
+  }
+
+  // Keeps every level of a texture that UpdateTexture is about to write.
+  inline void keepTexture(IDirect3DBaseTexture9* pTexture) {
+    if (!held() || pTexture == nullptr || gSnapshot.objects.count(pTexture) == 0) {
+      return;
+    }
+    const D3DRESOURCETYPE type = pTexture->GetType();
+    if (type != D3DRTYPE_TEXTURE && type != D3DRTYPE_CUBETEXTURE) {
+      refuse("a volume texture from before the snapshot was written");
+      return;
+    }
+    const DWORD faces = type == D3DRTYPE_CUBETEXTURE ? 6 : 1;
+    for (DWORD level = 0; level < pTexture->GetLevelCount(); level++) {
+      for (DWORD face = 0; face < faces && held(); face++) {
+        IDirect3DSurface9* pSurface = nullptr;
+        const HRESULT hresult = type == D3DRTYPE_CUBETEXTURE
+          ? static_cast<IDirect3DCubeTexture9*>(pTexture)->GetCubeMapSurface(static_cast<D3DCUBEMAP_FACES>(face), level, &pSurface)
+          : static_cast<IDirect3DTexture9*>(pTexture)->GetSurfaceLevel(level, &pSurface);
+        if (SUCCEEDED(hresult)) {
+          keepSurface(pSurface);
+          pSurface->Release();
+        }
+      }
+    }
+  }
+
+  // Volume contents are not kept, so a write into one from before the snapshot gives the snapshot up.
+  inline void noteVolumeWrite(IUnknown* pVolumeOrTexture) {
+    if (!held() || pVolumeOrTexture == nullptr) {
+      return;
+    }
+    IUnknown* pOwner = pVolumeOrTexture;
+    IDirect3DVolume9* pVolume = nullptr;
+    IDirect3DBaseTexture9* pTexture = nullptr;
+    if (SUCCEEDED(pVolumeOrTexture->QueryInterface(__uuidof(IDirect3DVolume9), reinterpret_cast<void**>(&pVolume))) && pVolume != nullptr) {
+      if (SUCCEEDED(pVolume->GetContainer(__uuidof(IDirect3DBaseTexture9), reinterpret_cast<void**>(&pTexture))) && pTexture != nullptr) {
+        pOwner = pTexture;
+        pTexture->Release();
+      }
+      pVolume->Release();
+    }
+    if (gSnapshot.objects.count(pOwner) != 0 || gSnapshot.objects.count(pVolumeOrTexture) != 0) {
+      refuse("a volume texture from before the snapshot was written");
+    }
+  }
+
+  // Keeps the SetLOD and SetAutoGenFilterType values of a texture before the first change after the snapshot.
+  inline void keepSettings(IDirect3DBaseTexture9* pTexture) {
+    if (!held() || pTexture == nullptr || gSnapshot.objects.count(pTexture) == 0) {
+      return;
+    }
+    gSnapshot.textureSettings.emplace(pTexture, std::make_pair(pTexture->GetLOD(), pTexture->GetAutoGenFilterType()));
+  }
+
+  // Runs before a query is issued.
+  inline void noteIssue(IDirect3DQuery9* pQuery) {
+    if (!held() || pQuery == nullptr) {
+      return;
+    }
+    gSnapshot.queryAnswers.erase(pQuery);
+    if (gSnapshot.objects.count(pQuery) == 0) {
+      return;
+    }
+    if (gSnapshot.queriesPending.count(pQuery) != 0) {
+      refuse("a query whose result was not ready at the snapshot was issued again");
+      return;
+    }
+    gSnapshot.queriesIssued.insert(pQuery);
+  }
+
+  // After a rewind a query that was issued again in the meantime answers with its result at the snapshot,
+  // until the game issues it again.
+  inline HRESULT queryData(IDirect3DQuery9* pQuery, void* pData, const DWORD size, const HRESULT hresult) {
+    if (!held()) {
+      return hresult;
+    }
+    const auto answer = gSnapshot.queryAnswers.find(pQuery);
+    if (answer == gSnapshot.queryAnswers.end()) {
+      return hresult;
+    }
+    if (pData != nullptr) {
+      memcpy(pData, answer->second.data(), std::min<size_t>(size, answer->second.size()));
+    }
+    return S_OK;
+  }
+
+  inline bool putBack(IUnknown* pObj, const Saved& saved) {
+    void* pData = nullptr;
+    switch (saved.kind) {
+    case Kind::VertexBuffer:
+    {
+      const auto pBuffer = static_cast<IDirect3DVertexBuffer9*>(pObj);
+      if (FAILED(pBuffer->Lock(0, 0, &pData, 0)) || pData == nullptr) {
+        return false;
+      }
+      memcpy(pData, saved.bytes.data(), saved.bytes.size());
+      return SUCCEEDED(pBuffer->Unlock());
+    }
+    case Kind::IndexBuffer:
+    {
+      const auto pBuffer = static_cast<IDirect3DIndexBuffer9*>(pObj);
+      if (FAILED(pBuffer->Lock(0, 0, &pData, 0)) || pData == nullptr) {
+        return false;
+      }
+      memcpy(pData, saved.bytes.data(), saved.bytes.size());
+      return SUCCEEDED(pBuffer->Unlock());
+    }
+    case Kind::Surface:
+    {
+      const auto pSurface = static_cast<IDirect3DSurface9*>(pObj);
+      D3DLOCKED_RECT lockedRect;
+      if (FAILED(pSurface->LockRect(&lockedRect, nullptr, 0)) || lockedRect.pBits == nullptr) {
+        return false;
+      }
+      memcpy(lockedRect.pBits, saved.bytes.data(), saved.bytes.size());
+      return SUCCEEDED(pSurface->UnlockRect());
+    }
+    case Kind::Target:
+    {
+      const auto pSurface = static_cast<IDirect3DSurface9*>(pObj);
+      IDirect3DDevice9* pDevice = nullptr;
+      if (FAILED(pSurface->GetDevice(&pDevice))) {
+        return false;
+      }
+      const HRESULT hresult = pDevice->StretchRect(saved.pCopy, nullptr, pSurface, nullptr, D3DTEXF_NONE);
+      pDevice->Release();
+      return SUCCEEDED(hresult);
+    }
+    }
+    return false;
+  }
+
+  // Lets go of an object made after the snapshot. One Release matches the reference its create left in the table.
+  // Too few releases leak the object. Too many would free an object the snapshot still needs.
+  inline void drop(IUnknown* pObj) {
+    pObj->Release();
+  }
+
+  // A texture level belongs to its texture, as with Bridge_UnlinkResource.
+  inline void drop(IDirect3DResource9* pResource) {
+    if (pResource->GetType() == D3DRTYPE_SURFACE) {
+      IDirect3DBaseTexture9* pTexture = nullptr;
+      if (SUCCEEDED(static_cast<IDirect3DSurface9*>(pResource)->GetContainer(__uuidof(IDirect3DBaseTexture9), reinterpret_cast<void**>(&pTexture))) && pTexture != nullptr) {
+        pTexture->Release();
+        return;
+      }
+    }
+    pResource->Release();
+  }
+
+  // A volume belongs to its volume texture, as with Bridge_UnlinkVolumeResource.
+  inline void drop(IDirect3DVolume9*) {
+  }
+
+  inline void take() {
+    release();
+    forEachMap([](auto& live, auto& kept) {
+      kept = live;
+      for (const auto& [handle, pObj] : live) {
+        if (pObj != nullptr) {
+          gSnapshot.objects.insert(pObj);
+        }
+      }
+    });
+    gSnapshot.state = State::Held;
+
+    for (const auto& [handle, pDevice] : gpD3DDevices) {
+      if (pDevice == nullptr) {
+        continue;
+      }
+      D3DCAPS9 caps = {};
+      DeviceState state;
+      pDevice->GetDeviceCaps(&caps);
+      state.targetCount = std::min<DWORD>(4, caps.NumSimultaneousRTs);
+      state.softwareVertexProcessing = pDevice->GetSoftwareVertexProcessing();
+      pDevice->GetGammaRamp(0, &state.gamma);
+      const HRESULT hresult = pDevice->CreateStateBlock(D3DSBT_ALL, &state.pBlock);
+      for (DWORD i = 0; i < state.targetCount; i++) {
+        pDevice->GetRenderTarget(i, &state.pTargets[i]);
+      }
+      pDevice->GetDepthStencilSurface(&state.pDepthStencil);
+      gSnapshot.deviceStates[handle] = state;
+      if (FAILED(hresult)) {
+        refuse(format_string("the device state could not be captured (0x%08lx)", static_cast<unsigned long>(hresult)));
+        return;
+      }
+      // The back buffers and the bound surfaces can be missing from the tables, like a depth surface the game never asked for.
+      for (UINT i = 0; i < pDevice->GetNumberOfSwapChains() && held(); i++) {
+        IDirect3DSwapChain9* pSwapChain = nullptr;
+        D3DPRESENT_PARAMETERS parameters = {};
+        if (FAILED(pDevice->GetSwapChain(i, &pSwapChain))) {
+          continue;
+        }
+        pSwapChain->GetPresentParameters(&parameters);
+        for (UINT buffer = 0; buffer < std::max<UINT>(1, parameters.BackBufferCount); buffer++) {
+          IDirect3DSurface9* pBackBuffer = nullptr;
+          if (FAILED(pSwapChain->GetBackBuffer(buffer, D3DBACKBUFFER_TYPE_MONO, &pBackBuffer))) {
+            continue;
+          }
+          if (parameters.SwapEffect == D3DSWAPEFFECT_DISCARD) {
+            gSnapshot.discarded.insert(pBackBuffer);
+          } else {
+            keepTarget(pBackBuffer);
+          }
+          pBackBuffer->Release();
+        }
+        pSwapChain->Release();
+      }
+      for (DWORD i = 0; i < state.targetCount && held(); i++) {
+        keepTarget(state.pTargets[i]);
+      }
+      keepTarget(state.pDepthStencil);
+      if (!held()) {
+        return;
+      }
+    }
+
+    for (const auto& [handle, pResource] : gpD3DResources) {
+      if (pResource != nullptr) {
+        keepTargets(pResource);
+      }
+      if (!held()) {
+        return;
+      }
+    }
+
+    const ULONGLONG start = GetTickCount64();
+    for (const auto& [handle, pQuery] : gpD3DQuery) {
+      // An event query has one possible result.
+      if (pQuery == nullptr || pQuery->GetType() == D3DQUERYTYPE_EVENT) {
+        continue;
+      }
+      std::vector<uint8_t> data(pQuery->GetDataSize());
+      HRESULT hresult = S_FALSE;
+      do {
+        hresult = pQuery->GetData(data.empty() ? nullptr : data.data(), static_cast<DWORD>(data.size()), D3DGETDATA_FLUSH);
+      } while (hresult == S_FALSE && GetTickCount64() - start < kQueryWaitMs);
+      if (hresult == S_OK) {
+        gSnapshot.queryResults.emplace(pQuery, std::move(data));
+      } else if (hresult == S_FALSE) {
+        gSnapshot.queriesPending.insert(pQuery);
+      }
+    }
+  }
+
+  // Returns the D3D9 objects to the snapshot. Returns false when a step failed, which leaves the state undefined.
+  inline bool apply() {
+    bool succeeded = true;
+    for (auto contents = gSnapshot.saved.begin(); contents != gSnapshot.saved.end();) {
+      succeeded &= putBack(contents->first, contents->second);
+      // A locked copy has done its work: the object holds the snapshot's contents again, and the next write keeps them anew.
+      if (contents->second.kind == Kind::Target) {
+        ++contents;
+      } else {
+        gSnapshot.savedBytes -= contents->second.size;
+        contents->first->Release();
+        contents = gSnapshot.saved.erase(contents);
+      }
+    }
+    forEachMap([](auto& live, auto& kept) {
+      for (const auto& [handle, pObj] : live) {
+        if (pObj != nullptr && gSnapshot.objects.count(pObj) == 0) {
+          drop(pObj);
+        }
+      }
+      live = kept;
+    });
+    gSnapshot.tombstones.clear();
+    gSnapshot.tombstoneBytes = 0;
+    for (const auto& [handle, state] : gSnapshot.deviceStates) {
+      const auto pDevice = gpD3DDevices[handle];
+      for (DWORD i = 0; i < state.targetCount; i++) {
+        if (i != 0 || state.pTargets[i] != nullptr) {
+          succeeded &= SUCCEEDED(pDevice->SetRenderTarget(i, state.pTargets[i]));
+        }
+      }
+      succeeded &= SUCCEEDED(pDevice->SetDepthStencilSurface(state.pDepthStencil));
+      succeeded &= SUCCEEDED(state.pBlock->Apply());
+      // Only a mixed device takes another value than its own, so the result says nothing here.
+      pDevice->SetSoftwareVertexProcessing(state.softwareVertexProcessing);
+      pDevice->SetGammaRamp(0, D3DSGR_NO_CALIBRATION, &state.gamma);
+    }
+    for (const auto& [pTexture, settings] : gSnapshot.textureSettings) {
+      pTexture->SetLOD(settings.first);
+      pTexture->SetAutoGenFilterType(settings.second);
+    }
+    gSnapshot.textureSettings.clear();
+    for (IDirect3DQuery9* pQuery : gSnapshot.queriesIssued) {
+      const auto result = gSnapshot.queryResults.find(pQuery);
+      if (result != gSnapshot.queryResults.end()) {
+        gSnapshot.queryAnswers[pQuery] = result->second;
+      }
+    }
+    gSnapshot.queriesIssued.clear();
+    gSnapshot.notRestored = 0;
+    return succeeded;
+  }
+
+  // Runs one Op and fills the Stat numbers, which describe the time before a rewind is applied.
+  // A non-null pBusy is the reason why the server cannot snapshot or rewind right now.
+  // Returns S_OK when the Op is done.
+  // Returns E_FAIL when it is refused: nothing was changed.
+  // Returns E_ABORT when a rewind failed part-way: the D3D9 state is undefined and the host has to end the game.
+  inline HRESULT run(const uint32_t op, uint32_t* pStats, const char* pBusy) {
+    using namespace bridge_util::rewind;
+    if (gSnapshot.state == State::Failed) {
+      pStats[kStatRefused] = 1;
+      Logger::err(format_string("[Rewind] Op %u is refused: %s", op, gSnapshot.reason.c_str()));
+      return E_ABORT;
+    }
+    if (op == kDrop) {
+      release();
+      Logger::info("[Rewind] Op 4: the snapshot is let go.");
+      return S_OK;
+    }
+    if (op != kSnapshot && op != kRewind && op != kPlan) {
+      pStats[kStatRefused] = 1;
+      return E_FAIL;
+    }
+    if (pBusy != nullptr) {
+      pStats[kStatRefused] = 1;
+      Logger::warn(format_string("[Rewind] Op %u is refused for now, nothing was changed: %s", op, pBusy));
+      return E_FAIL;
+    }
+    if (op == kSnapshot) {
+      take();
+    } else if (held()) {
+      for (const auto& [handle, pDevice] : gpD3DDevices) {
+        if (pDevice != nullptr && pDevice->TestCooperativeLevel() != D3D_OK) {
+          pStats[kStatRefused] = 1;
+          Logger::warn(format_string("[Rewind] Op %u is refused for now, nothing was changed: the device is lost", op));
+          return E_FAIL;
+        }
+      }
+    }
+    if (!held()) {
+      pStats[kStatRefused] = 1;
+      Logger::warn(format_string("[Rewind] Op %u is refused, nothing was changed: %s", op,
+                                 gSnapshot.state == State::Refused ? gSnapshot.reason.c_str() : "no snapshot is held"));
+      return E_FAIL;
+    }
+    uint32_t dropped = 0;
+    uint32_t buffers = 0;
+    forEachMap([&](auto& live, auto&) {
+      for (const auto& [handle, pObj] : live) {
+        dropped += pObj != nullptr && gSnapshot.objects.count(pObj) == 0;
+      }
+    });
+    for (const auto& [pObj, saved] : gSnapshot.saved) {
+      buffers += saved.kind == Kind::VertexBuffer || saved.kind == Kind::IndexBuffer;
+    }
+    pStats[kStatKept] = static_cast<uint32_t>(gSnapshot.objects.size());
+    pStats[kStatRevived] = static_cast<uint32_t>(gSnapshot.tombstones.size());
+    pStats[kStatDropped] = dropped;
+    pStats[kStatBuffers] = buffers;
+    pStats[kStatSurfaces] = static_cast<uint32_t>(gSnapshot.saved.size()) - buffers;
+    pStats[kStatSavedKB] = static_cast<uint32_t>((gSnapshot.savedBytes + gSnapshot.tombstoneBytes) >> 10);
+    pStats[kStatNotRestored] = gSnapshot.notRestored;
+    Logger::info(format_string("[Rewind] Op %u: kept %u, revive %u, drop %u, buffers %u, surfaces %u, kept alive %u KB, cursor commands %u",
+                               op, pStats[kStatKept], pStats[kStatRevived], pStats[kStatDropped], pStats[kStatBuffers],
+                               pStats[kStatSurfaces], pStats[kStatSavedKB], pStats[kStatNotRestored]));
+    if (op == kRewind && !apply()) {
+      release();
+      gSnapshot.state = State::Failed;
+      gSnapshot.reason = "a rewind failed part-way, the D3D9 state is undefined and the game has to be ended";
+      pStats[kStatRefused] = 1;
+      Logger::err(format_string("[Rewind] Op 2: %s", gSnapshot.reason.c_str()));
+      return E_ABORT;
+    }
+    return S_OK;
+  }
+}
