// Version information of ts3wrap.exe (Windows file properties), as ApexRadiance.rc: an unsigned exe with none weighs on
// antivirus heuristics (a test build of the relaunch was removed by an antivirus). The numbers come from apex_version.h.
#include <winver.h>
#include "../../apex_version.h"

#define APEX_RC_VERSION APEX_STRINGIZE(APEX_VERSION_MAJOR.APEX_VERSION_MINOR.APEX_VERSION_PATCH)

VS_VERSION_INFO VERSIONINFO
 FILEVERSION APEX_VERSION_MAJOR,APEX_VERSION_MINOR,APEX_VERSION_PATCH,0
 PRODUCTVERSION APEX_VERSION_MAJOR,APEX_VERSION_MINOR,APEX_VERSION_PATCH,0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "loinyx"
            VALUE "FileDescription", "Apex Radiance restart host: offers to start The Sims 3 again into the last save"
            VALUE "FileVersion", APEX_RC_VERSION
            VALUE "InternalName", "ts3wrap"
            VALUE "LegalCopyright", "Copyright (C) 2026 loinyx. Open source: github.com/loinyx/Sims3-ApexRadiance"
            VALUE "OriginalFilename", "ts3wrap.exe"
            VALUE "ProductName", "Apex Radiance"
            VALUE "ProductVersion", APEX_RC_VERSION
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
